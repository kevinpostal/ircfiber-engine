# {{ ansible_managed }}
# SigNoz — Foundry-based enterprise observability stack.
# Combined signoz image + PostgreSQL + ClickHouse Keeper + OTel collector.

x-logging-common: &logging-common
  restart: unless-stopped
  logging:
    driver: json-file
    options:
      max-size: "10m"
      max-file: "3"

services:
  postgres:
    <<: *logging-common
    image: {{ postgres_image }}
    container_name: {{ signoz_postgres_container }}
    hostname: signoz-postgres
    networks:
      - ircfiber_logging
    expose:
      - "5432"
    environment:
      - POSTGRES_DB=signoz
      - POSTGRES_USER=signoz
      - POSTGRES_PASSWORD=signoz
    volumes:
      - {{ signoz_postgres_data }}:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U signoz -d signoz"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    mem_limit: {{ signoz_postgres_mem }}
    cpus: 0.5

  clickhouse-keeper:
    <<: *logging-common
    image: {{ clickhouse_keeper_image }}
    container_name: {{ signoz_keeper_container }}
    hostname: signoz-keeper
    networks:
      - ircfiber_logging
    expose:
      - "2181"
      - "9181"
    volumes:
      - {{ signoz_keeper_data }}:/var/lib/clickhouse-keeper
      - /etc/ircfiber/signoz/keeper.yaml:/etc/clickhouse-keeper/keeper.yaml:ro
    mem_limit: {{ signoz_keeper_mem }}
    cpus: 0.5

  clickhouse:
    <<: *logging-common
    image: {{ clickhouse_image }}
    container_name: {{ signoz_clickhouse_container }}
    hostname: signoz-clickhouse
    networks:
      - ircfiber_logging
    expose:
      - "9000"
      - "8123"
    environment:
      - CLICKHOUSE_SKIP_USER_SETUP=1
    volumes:
      - {{ signoz_clickhouse_data }}:/var/lib/clickhouse
      # Bind-mount /var/log to a host directory so the clickhouse err.log
      # (which can hit hundreds of MB during OOM storms — observed 728 MB
      # on ircfiber-ovh during the parts-merge spike) doesn't bloat the
      # container's overlay layer. Logrotate on the host takes care of
      # the rest. Container still owns the file while the process runs.
      - /var/lib/ircfiber/signoz-clickhouse-logs:/var/log/clickhouse-server
      - /etc/ircfiber/signoz/clickhouse-cluster.xml:/etc/clickhouse-server/config.d/cluster.xml:ro
      - /etc/ircfiber/signoz/clickhouse-server-overrides.xml:/etc/clickhouse-server/config.d/server-overrides.xml:ro
    depends_on:
      clickhouse-keeper:
        condition: service_started
    mem_limit: {{ signoz_clickhouse_mem }}
    cpus: 1.0

  signoz:
    <<: *logging-common
    image: {{ signoz_image }}
    container_name: {{ signoz_container }}
    hostname: signoz-signoz
    networks:
      - ircfiber_logging
    expose:
      - "8080"
    environment:
      - SIGNOZ_SQLSTORE_PROVIDER=postgres
      - SIGNOZ_SQLSTORE_POSTGRES_DSN=postgres://signoz:signoz@signoz-postgres:5432/signoz?sslmode=disable
      - SIGNOZ_TELEMETRYSTORE_PROVIDER=clickhouse
      - SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN=tcp://signoz-clickhouse:9000
      # Retention (days) — bounded by the 2 GB ClickHouse container
      - SIGNOZ_DEFAULT_LOG_RETENTION_DAYS={{ signoz_logs_retention_days }}
      - SIGNOZ_DEFAULT_TRACES_RETENTION_DAYS={{ signoz_traces_retention_days }}
      - SIGNOZ_DEFAULT_METRICS_RETENTION_DAYS={{ signoz_metrics_retention_days }}
    depends_on:
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_started
    mem_limit: {{ signoz_signoz_mem }}
    cpus: 1.0

  migrator:
    image: {{ signoz_otel_collector_image }}
    container_name: signoz-migrator
    networks:
      - ircfiber_logging
    entrypoint: ["/bin/sh", "-c"]
    command:
      - "/signoz-otel-collector migrate ready && /signoz-otel-collector migrate bootstrap && /signoz-otel-collector migrate sync up && /signoz-otel-collector migrate async up"
    environment:
      - SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_DSN=tcp://signoz-clickhouse:9000
      - LOW_CARDINAL_EXCEPTION_GROUPING=false
    depends_on:
      clickhouse:
        condition: service_started
    restart: "no"

  ingester:
    <<: *logging-common
    image: {{ signoz_otel_collector_image }}
    container_name: {{ signoz_otel_collector_container }}
    hostname: signoz-ingester
    networks:
      - ircfiber_logging
    expose:
      - "4317"
      - "4318"
    entrypoint: ["/signoz-otel-collector"]
    command:
      - "--config=/etc/otel-collector-config.yaml"
    environment:
      - SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_DSN=tcp://signoz-clickhouse:9000
    volumes:
      - /etc/ircfiber/signoz/ingester.yaml:/etc/otel-collector-config.yaml:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
    depends_on:
      signoz:
        condition: service_started
    mem_limit: {{ signoz_ingester_mem }}
    cpus: 0.5

networks:
  ircfiber_logging:
    external: true

volumes:
  {{ signoz_postgres_data }}:
  {{ signoz_keeper_data }}:
  {{ signoz_clickhouse_data }}: