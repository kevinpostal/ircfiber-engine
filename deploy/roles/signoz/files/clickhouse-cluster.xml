<clickhouse>
    <zookeeper>
        <node index="1">
            <host>signoz-keeper</host>
            <port>9181</port>
        </node>
    </zookeeper>
    <remote_servers>
        <cluster>
            <shard>
                <replica>
                    <host>signoz-clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster>
    </remote_servers>
    <macros>
        <cluster>cluster</cluster>
        <shard>1</shard>
        <replica>1</replica>
    </macros>
</clickhouse>