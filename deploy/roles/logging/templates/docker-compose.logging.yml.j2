# {{ ansible_managed }}
# IRC Fiber — SigNoz-native observability stack.
#
#   Fluent Bit → signoz-ingester (OTLP HTTP) → signoz (combined image)
#                  ↓
#               clickhouse (separate, fed by the combined signoz image
#                            via SIGNOZ_CLICKHOUSE_HOST=clickhouse:9000)
#   Grafana reads from signoz:8080 (query-service API)
#
# The signoz service is the signoz/signoz combined image (query-service
# + frontend + alertmanager) — but unlike the "Foundry" builds, we run
# ClickHouse as a SEPARATE container (the clickhouse service below) and
# point the signoz image at it via env. This decouples ClickHouse from
# signoz so we can back up / scale / replace the image without losing
# telemetry data, and so the local-dev compose can use the same layout.
#
# The signoz-ingester is a separate otel/opentelemetry-collector-contrib
# container that accepts OTLP from Fluent Bit + the bridge collector and
# forwards to signoz. Running it as a sidecar lets us apply log
# redaction / sampling / New Relic entity model transforms in one place.
#
# All services run on the ircfiber_logging network (separate from
# ircfiber_net so observability traffic doesn't compete with IRC control).
#
# Resource budgets:
#   Fluent Bit:        128MB RAM, 0.5 CPU
#   Signoz-ingester:   256MB RAM, 0.5 CPU
#   Signoz (combined): 1GB  RAM, 1.0 CPU (query-svc + frontend + alertmanager)
#   ClickHouse:        1GB  RAM, 1.0 CPU
#   Grafana:           256MB RAM, 0.5 CPU
# Total:               ~2.6GB RAM, 3.5 CPU — fits on 7.7GB/4-core VPS.

x-logging-common: &logging-common
  restart: unless-stopped
  logging:
    driver: json-file
    options:
      max-size: "10m"
      max-file: "3"
  healthcheck:
    disable: true

services:
  # ────────────────────────────────────────────────────────────────────────
  # Grafana — query UI (unchanged datasource provisioning deferred to w3-t1)
  # ────────────────────────────────────────────────────────────────────────
  grafana:
    <<: *logging-common
    container_name: ${GRAFANA_CONTAINER_NAME:-ircfiber-grafana}
    image: ${GRAFANA_IMAGE:-grafana/grafana:11.3.0}
    hostname: ircfiber-grafana
    networks:
      - ircfiber_logging
    # Internal-only — Caddy proxies /grafana/* to this container port.
    expose:
      - "3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_DISABLE_SIGNUP=${GRAFANA_DISABLE_SIGNUP}
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_AUTH_PROXY_ENABLED=${GF_AUTH_PROXY_ENABLED}
      - GF_AUTH_PROXY_HEADER_NAME=X-WebAuth-User
      - GF_AUTH_PROXY_HEADER_PROPERTY=username
      - GF_AUTH_PROXY_AUTO_SIGN_UP=true
      - GF_AUTH_PROXY_LDAP_ENABLED=false
      - GF_AUTH_ANONYMOUS_ENABLED=false
      - GF_SESSION_LIFETIME=${GRAFANA_SESSION_LIFETIME_MINUTES:-10080}
      - GF_SECURITY_COOKIE_SECURE=true
      - GF_SECURITY_COOKIE_SAMESITE=strict
      - GF_SERVER_ROOT_URL=${GF_SERVER_ROOT_URL}
      - GF_SERVER_SERVE_FROM_SUB_PATH=true
      - GF_USERS_DEFAULT_THEME=dark
      - GF_INSTALL_PLUGINS=
      - GF_FEATURE_TOGGLES_ENABLE=traceQLSearch,traces
      - GF_ANALYTICS_REPORTING_ENABLED=false
      - GF_ANALYTICS_CHECK_FOR_UPDATES=false
    volumes:
      - ${GRAFANA_DATA_VOLUME}:/var/lib/grafana
      - /etc/ircfiber/grafana/provisioning:/etc/grafana/provisioning
      - /etc/ircfiber/grafana/dashboards:/var/lib/grafana/dashboards
      - ${GRAFANA_ALERTING_VOLUME}:/var/lib/grafana/alerting
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:3000/api/health | grep -q ok || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    mem_limit: 256m
    cpus: 0.5

  # ────────────────────────────────────────────────────────────────────────
  # Fluent Bit — container log shipper via OTLP HTTP.
  # ────────────────────────────────────────────────────────────────────────
  # Centralized (default): ships directly to k3s SigNoz over Tailscale
  # (k3s_tailscale_ip:4318). No local SigNoz dependency.
  # Local (fallback): ships to signoz-ingester on ircfiber_logging.
  fluent-bit:
    <<: *logging-common
    container_name: ${FLUENT_BIT_CONTAINER_NAME:-ircfiber-fluent-bit}
    image: ${FLUENT_BIT_IMAGE:-fluent/fluent-bit:3.2}
    hostname: ircfiber-fluent-bit
    networks:
      - ircfiber_logging
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - {{ fluent_bit_config_dir }}/fluent-bit.conf:/fluent-bit/etc/fluent-bit.conf:ro
      - {{ fluent_bit_config_dir }}/parsers.conf:/fluent-bit/etc/parsers.conf:ro
      - {{ fluent_bit_config_dir }}/container_name.lua:/fluent-bit/etc/container_name.lua:ro
    entrypoint:
      - /fluent-bit/bin/fluent-bit
      - -c
      - /fluent-bit/etc/fluent-bit.conf
    healthcheck:
      # Real check: Fluent Bit's own health endpoint (HTTP_Server/Health_Check in fluent-bit.conf).
      # Requires the -debug image (has curl, no wget); the distroless tag has no shell at all.
      test: ["CMD-SHELL", "curl -sf http://127.0.0.1:2020/api/v1/health | grep -q ok || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
{% if not (ovh_logs_centralize_to_k3s | default(true) | bool) %}
    depends_on:
      - signoz
{% endif %}
    mem_limit: ${FLUENT_BIT_MEMORY_LIMIT:-128m}
    cpus: ${FLUENT_BIT_CPU_LIMIT:-0.5}

  # ────────────────────────────────────────────────────────────────────────
  # SigNoz + ClickHouse + ingester — LOCAL ONLY.
  # When ovh_logs_centralize_to_k3s is true (default) these three services
  # are NOT deployed — OVH ships directly to k3s SigNoz via Tailscale and
  # the local 2.5 GB footprint is reclaimed. Set the flag to false to keep
  # a full local copy (useful for air-gapped debugging).
  # ────────────────────────────────────────────────────────────────────────
{% if not (ovh_logs_centralize_to_k3s | default(true) | bool) %}
  signoz:
    <<: *logging-common
    container_name: ${SIGNOZ_CONTAINER_NAME:-ircfiber-signoz}
    image: ${SIGNOZ_IMAGE:-signoz/signoz:{{ signoz_version }}}
    hostname: signoz
    networks:
      ircfiber_logging:
        aliases:
          - signoz
          - signoz-ingester
    ports:
      - "3301:3301"
      - "8080:8080"
    environment:
      SIGNOZ_INITIAL_ADMIN_EMAIL: admin@ircfiber.com
      SIGNOZ_INITIAL_ADMIN_PASSWORD: admin123
      SIGNOZ_TELEMETRYSTORE_PROVIDER: clickhouse
      SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN: tcp://clickhouse:9000
      TELEMETRY_ENABLED: "false"
      SIGNOZ_TOKENIZER_JWT_SECRET: ${SIGNOZ_JWT_SECRET}
    depends_on:
      - clickhouse
    volumes:
      - ${SIGNOZ_DATA_VOLUME:-ircfiber_signoz_data}:/var/lib/signoz
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -qO- http://localhost:8080/api/v1/health 2>&1 | grep -q ok || exit 1"
        ]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 120s
    mem_limit: 2g
    cpus: 2.0

  clickhouse:
    <<: *logging-common
    container_name: ${CLICKHOUSE_CONTAINER_NAME:-ircfiber-clickhouse}
    image: ${CLICKHOUSE_IMAGE:-{{ signoz_clickhouse_image }}}
    hostname: clickhouse
    networks:
      ircfiber_logging:
        aliases:
          - clickhouse
    expose:
      - "9000"
      - "8123"
    environment:
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
      CLICKHOUSE_SKIP_USER_SETUP: 1
      CLICKHOUSE_MAX_MEMORY_USAGE: 8000000000
    volumes:
      - ${CLICKHOUSE_DATA_VOLUME:-ircfiber_clickhouse_data}:/var/lib/clickhouse
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8123/ping | grep -q Ok || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s
    mem_limit: 1g
    cpus: 1.0

  signoz-ingester:
    <<: *logging-common
    container_name: ${SIGNOZ_INGESTER_CONTAINER_NAME:-ircfiber-signoz-ingester}
    image: ${SIGNOZ_INGESTER_IMAGE:-{{ signoz_ingester_image }}}
    hostname: signoz-ingester
    networks:
      ircfiber_logging:
        aliases:
          - signoz-ingester
    ports:
      - "4317:4317"
      - "4318:4318"
    volumes:
      - {{ fluent_bit_config_dir }}/otel-collector-config.yaml:/etc/otel-collector-config.yaml:ro
    command:
      - --config=/etc/otel-collector-config.yaml
    healthcheck:
      disable: true
    depends_on:
      clickhouse:
        condition: service_started
    mem_limit: 256m
    cpus: 0.5
{% else %}
  # Centralized: no local SigNoz/ClickHouse/ingester — Fluent Bit ships
  # straight to k3s SigNoz at k3s_tailscale_ip:4318 over Tailscale.
  # This block intentionally empty; the otel-collector config is not needed
  # when Fluent Bit targets k3s directly (verified: ircfiber_logging →
  # 100.94.116.56:4318 returns HTTP 200 from both bridge and host nets).
{% endif %}

networks:
  ircfiber_logging:
    name: ircfiber_logging
    external: true

# All volumes are pre-created by the logging role's
# `community.docker.docker_volume` task and tagged external so compose
# does NOT try to create or delete them on `down`.
volumes:
  ircfiber_grafana_data:
    external: true
  ircfiber_grafana_provisioning:
    external: true
  ircfiber_grafana_dashboards:
    external: true
  ircfiber_grafana_alerting:
    external: true
  ircfiber_grafana_plugins:
    external: true
  ircfiber_signoz_data:
    external: true
  ircfiber_clickhouse_data:
    external: true
