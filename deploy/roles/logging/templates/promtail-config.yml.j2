# {{ ansible_managed }}
# Promtail — collects logs from Docker containers and ships them to Loki.
#
# Goals:
#   1. Scrape EVERY container (ircfiber-* plus the logging stack itself)
#      without recursion. The docker_sd_configs filter matches anything
#      starting with ircfiber- (which catches the entire stack).
#   2. Tag each container's logs with a stable `component` label
#      (engine, gateway, holder, ircd, caddy, mongo, redis, cloudflared,
#       loki, promtail, grafana, …) so dashboards can pivot.
#   3. Extract structured JSON fields from engine logs (event, network,
#      nick, channel, level) as Loki labels, so dashboards can filter
#      on {event="join"} or {level="error"} without parsing the
#      payload at query time.
#   4. Recursion prevention: we drop the container we're currently
#      reading FROM (ircfiber-promtail) at the relabel stage. The
#      other stack containers (loki/grafana) don't read from their own
#      logs and are safe to keep.
#
# Pipeline stages per scrape:
#   - docker: unwraps Docker json-file wrapper → puts payload into `log`
#   - match on json parse: extract engine/gateway JSON fields as labels
#   - template: replace `log` with `msg` if JSON parsed successfully
#
# Output labels per stream (after pipelines):
#   job                static, = "ircfiber_containers"
#   container_name     the docker container name (e.g. ircfiber-engine-ovh)
#   service            same as container_name for now
#   component          com.ircfiber.component label if set, else derived from
#                      container_name
#   stream             stdout / stderr
#   project            docker compose project name (if any)
#   level              info / warn / error / debug (only if JSON parsed)
#   event              connection.tcp_open / protocol.join / etc (only if JSON)
#   network            IRC network name (only if JSON)
#   nick               IRC nick (only if JSON)
#   channel            IRC channel (only if JSON)

server:
  http_listen_port: 9080
  grpc_listen_port: 0
  log_level: info

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://ircfiber-loki:3100/loki/api/v1/push
    batchwait: 1s
    batchsize: 1048576
    backoff_config:
      min_period: 500ms
      max_period: 5m
      max_retries: 10
    timeout: 10s

scrape_configs:
  # ──────────────────────────────────────────────────────────────────────
  # 1. IRC Fiber containers (engine, gateway, holder, ircd, caddy, mongo,
  #    redis, cloudflared, loki, promtail, grafana — everything starting
  #    with `ircfiber-`).
  # ──────────────────────────────────────────────────────────────────────
  - job_name: ircfiber_containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 10s
        # Every container in the ircfiber stack — including the logging
        # stack itself (loki/promtail/grafana). Recursion is prevented
        # in the relabel_configs below by dropping the promtail
        # container's own log file from the scrape targets. Loki and
        # Grafana don't read their own logs (Loki writes to its boltdb
        # shipper, Grafana reads its own logs but the file is rotated
        # so we won't grow unbounded).
        filters:
          - name: name
            values: ["ircfiber-.+"]
    relabel_configs:
      # Pin the static `job` label. Required because dashboard queries
      # filter on `{job="ircfiber_containers"}`.
      - replacement: ircfiber_containers
        target_label: job

      # container_name = "ircfiber-engine-ovh" (strip the leading "/")
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: container_name

      # service label = container_name (used as the filter in dashboards)
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: service

      # component = com.ircfiber.component label (engine, gateway, etc.)
      # Falls back to container_name for stack containers (loki/promtail/grafana).
      - source_labels: ['__meta_docker_container_label_com_ircfiber_component']
        regex: (.+)
        target_label: component
      # Default component for logging-stack containers
      - source_labels: ['__meta_docker_container_name']
        regex: '/ircfiber-(loki|promtail|grafana|caddy|mongo|redis|cloudflared|ircd|engine.+|gateway|holder.+)'
        target_label: component

      # Compose project name (logging vs ircfiber)
      - source_labels: ['__meta_docker_container_label_com_docker_compose_project']
        target_label: project

      # stream = stdout / stderr
      - source_labels: ['__meta_docker_container_log_stream']
        target_label: stream

      # RECURSION GUARD — drop the promtail container's own log file.
      # Promtail's log lines include "Reloading configuration file" and
      # "finished transferring logs" which would otherwise grow the
      # scrape target's log file unbounded. Loki and Grafana don't have
      # this problem (they write to internal storage, not to their own
      # json-file log), so we keep them.
      - source_labels: ['__meta_docker_container_name']
        regex: '/ircfiber-promtail'
        action: drop

    pipeline_stages:
      # 1. Unwrap Docker json-file wrapper. After this stage, `log`
      #    contains the original payload string and docker.* labels are
      #    populated (container_image, container_label_*).
      - docker: {}

      # 2. Try to parse the payload as JSON (engine/gateway emit JSON).
      #    If successful, lift structured fields into labels and replace
      #    the displayed line with the `msg` field. If parsing fails
      #    (plain text logs), no labels are added and `log` is kept as-is.
      - match:
          selector: '{job="ircfiber_containers"}'
          stages:
            - json:
                expressions:
                  level: level
                  component: component
                  network: network
                  nick: nick
                  channel: channel
                  eid: eid
                  pid: pid
                  event: event
                  msg: msg
            - labels:
                level:
                event:
                network:
                nick:
                channel:
            # If the engine emitted a structured component field, prefer
            # it over the docker-label-derived one.
            - match:
                selector: '{component=~".+"}'
                stages:
                  - template:
                      source: component
                      target_label: component
            # If JSON parsed with a `msg` field, use it as the display line.
            - match:
                selector: '{event=~".+"}'
                stages:
                  - template:
                      source: msg
                      target_label: log

      # 3. Drop Promtail's own noisy internal labels that were attached
      #    by the `docker:` stage (we don't want them as Loki labels).
      - labeldrop:
          - __address__
          - __meta_docker_container_log_stream
          - __meta_docker_container_network_mode

  # ──────────────────────────────────────────────────────────────────────
  # 2. Docker host journald (for caddy, ssh, kernel — useful for forensics)
  # ──────────────────────────────────────────────────────────────────────
  - job_name: journal
    journal:
      max_age: 12h
      labels:
        job: journal
    relabel_configs:
      - source_labels: ['__journal__systemd_unit']
        target_label: unit

limits_config:
  # Promtail has no ingestion rate limit of its own; that's set on
  # Loki's side. We just configure the WAL.
  readline_rate: 10000
  readline_burst: 10000

# Disable the embedded scrape config validation that Promtail does on
# startup with newer versions — it's noisy in CI.
target_config:
  sync_period: 10s