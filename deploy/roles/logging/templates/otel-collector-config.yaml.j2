# {{ ansible_managed }}
# OTel collector config for the SigNoz ingester.
#
# TWO MODES (controlled by ovh_logs_centralize_to_k3s):
#
#   CENTRALIZED (default, true): OVH fully centralizes to k3s SigNoz.
#     This collector acts as a FORWARDER — it batches and forwards all
#     signals via OTLP to the k3s collector at k3s_tailscale_ip:4317/4318
#     over Tailscale. No local ClickHouse/SigNoz needed; fluent-bit ships
#     directly to k3s via this collector, and gateway/engine OTel SDKs do
#     the same (IRCFIBER_OTEL_ENDPOINT=http://k3s_tailscale_ip:4318).
#
#   LOCAL (false): Receives OTLP on 4317/4318 and exports to the local
#     ClickHouse via the signoz-otel-collector's ClickHouse exporters
#     (clickhousetraces / clickhouselogsexporter / signozclickhousemetrics).
#     Used only when explicitly keeping a local SigNoz copy.
#
# The health_check extension on 0.0.0.0:13133 is the Docker healthcheck probe.

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch:
    timeout: 5s
    send_batch_size: 1024

{% if ovh_logs_centralize_to_k3s | default(true) | bool %}
# ── CENTRALIZED: forward everything to k3s SigNoz via OTLP ────────────────
exporters:
  otlp/k3s:
    endpoint: {{ k3s_signoz_otlp_host | default(k3s_tailscale_ip | default('100.94.116.56')) }}:{{ k3s_signoz_otlp_grpc_port | default(4317) }}
    tls:
      insecure: true
    retry_on_failure:
      enabled: true
      initial_interval: 2s
      max_interval: 30s
      max_elapsed_time: 300s
    sending_queue:
      enabled: true
      queue_size: 5000
      num_consumers: 2
  otlphttp/k3s:
    endpoint: http://{{ k3s_signoz_otlp_host | default(k3s_tailscale_ip | default('100.94.116.56')) }}:{{ k3s_signoz_otlp_http_port | default(4318) }}
    tls:
      insecure: true
    retry_on_failure:
      enabled: true
      initial_interval: 2s
      max_interval: 30s
      max_elapsed_time: 300s
    sending_queue:
      enabled: true

extensions:
  health_check:
    endpoint: 0.0.0.0:13133

service:
  extensions: [health_check]
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlp/k3s]
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlp/k3s]
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlphttp/k3s]
{% else %}
# ── LOCAL: export to local ClickHouse (signoz image exporters) ───────────
# Use the correct exporter types for the signoz-otel-collector image:
#   clickhousetraces, clickhouselogsexporter, signozclickhousemetrics
exporters:
  clickhousetraces:
    dsn: tcp://clickhouse:9000/signoz_traces
    low_cardinal_exception_grouping: true
    use_new_schema: true
    timeout: 10s
    retry_on_failure:
      enabled: true
      initial_interval: 2s
      max_interval: 30s
      max_elapsed_time: 300s
  clickhouselogsexporter:
    dsn: tcp://clickhouse:9000/signoz_logs
    timeout: 10s
    retry_on_failure:
      enabled: true
      initial_interval: 2s
      max_interval: 30s
      max_elapsed_time: 300s
  signozclickhousemetrics:
    dsn: tcp://clickhouse:9000/signoz_metrics
    timeout: 10s
    retry_on_failure:
      enabled: true
      initial_interval: 2s
      max_interval: 30s
      max_elapsed_time: 300s

extensions:
  health_check:
    endpoint: 0.0.0.0:13133

service:
  extensions: [health_check]
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [clickhousetraces]
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [signozclickhousemetrics]
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [clickhouselogsexporter]
{% endif %}
