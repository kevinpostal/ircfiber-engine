apiVersion: 1

# Provision Grafana with SigNoz as the primary datasource.
# When ovh_logs_centralize_to_k3s is true (default), Grafana queries the
# k3s SigNoz instance via Tailscale ingress (https://signoz.ubuntu-docker…);
# otherwise it queries the local sidecar (http://signoz:8080).
deleteDatasources: []

datasources:
  # ─── SigNoz (unified logs + metrics + traces) ───────────────────────────
{% if ovh_logs_centralize_to_k3s | default(true) | bool %}
  # CENTRALIZED: query k3s SigNoz over Tailscale
  - name: SigNoz
    type: yesoreyeram-infinity-datasource
    access: proxy
    url: {{ k3s_signoz_api_url | default('https://signoz.ubuntu-docker.tail544547.ts.net') }}
    jsonData:
      allowUndeclaredFields: true
      apiKey: {{ signoz_grafana_api_key }}
    editable: false
{% else %}
  - name: SigNoz
    type: yesoreyeram-infinity-datasource
    access: proxy
    url: http://signoz:8080
    jsonData:
      allowUndeclaredFields: true
      apiKey: {{ signoz_grafana_api_key }}
    editable: false
{% endif %}
