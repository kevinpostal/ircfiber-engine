apiVersion: 1

# Disable all built-in datasources — we provision only ours.
deleteDatasources: []

datasources:
  - name: Loki
    type: loki
    access: proxy
    url: http://ircfiber-loki:3100
    jsonData:
      # Default query range — last 24h when user opens Explore.
      httpMethod: POST
      maxLines: 5000
      # Match all derivativive series by default.
      derivedFields:
        - name: ts
          matcherRegex: '(\d+)\s+(\d{4,})'
          url: '$${__value.time}'
    editable: false
    isDefault: true

# ─── Datasources for backend sources ───────────────────────────────────────
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://ircfiber-prometheus:9090
    jsonData:
      httpMethod: POST
      timeInterval: 30s
    editable: false