# {{ ansible_managed }}
# Environment variables for the logging stack (Loki + Promtail + Grafana).
# Sourced by docker-compose automatically when present in the same dir.

# ─── Grafana ──────────────────────────────────────────────────────────────
GRAFANA_CONTAINER_NAME={{ grafana_container_name }}
GRAFANA_IMAGE={{ grafana_image }}
GRAFANA_DATA_VOLUME={{ grafana_data_volume }}
GRAFANA_PROVISIONING_VOLUME={{ grafana_provisioning_volume }}
GRAFANA_DASHBOARDS_VOLUME={{ grafana_dashboards_volume }}
GRAFANA_ALERTING_VOLUME={{ grafana_alerting_volume }}
GRAFANA_PLUGIN_VOLUME={{ grafana_plugins_volume }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}
GRAFANA_DISABLE_SIGNUP={{ grafana_disable_signup | string | lower }}
GRAFANA_SESSION_LIFETIME_MINUTES={{ grafana_session_lifetime_days | default(7) * 1440 }}
# Trust the auth-proxy header (set by Caddy) instead of basic auth.
# Only safe when Caddy is the ONLY ingress to Grafana.
GF_AUTH_PROXY_ENABLED={{ grafana_auth_proxy_enabled | string | lower }}
GF_SERVER_ROOT_URL={{ grafana_root_url }}

# ─── Loki ────────────────────────────────────────────────────────────────
LOKI_CONTAINER_NAME={{ loki_container_name }}
LOKI_IMAGE={{ loki_image }}
LOKI_DATA_VOLUME={{ loki_data_volume }}
LOKI_CONFIG_VOLUME={{ loki_config_volume }}
LOKI_MEMORY_LIMIT={{ loki_memory_limit }}
LOKI_CPU_LIMIT={{ loki_cpu_limit }}

# ─── Promtail ────────────────────────────────────────────────────────────
PROMTAIL_CONTAINER_NAME={{ promtail_container_name }}
PROMTAIL_IMAGE={{ promtail_image }}
PROMTAIL_CONFIG_VOLUME={{ promtail_config_volume }}
PROMTAIL_POSITIONS_VOLUME={{ promtail_positions_volume }}
PROMTAIL_MEMORY_LIMIT={{ promtail_memory_limit }}
PROMTAIL_CPU_LIMIT={{ promtail_cpu_limit }}

# ─── Tempo (distributed tracing) ────────────────────────────────────────
TEMPO_CONTAINER_NAME={{ tempo_container_name }}
TEMPO_IMAGE={{ tempo_image }}
TEMPO_DATA_VOLUME={{ tempo_data_volume }}
TEMPO_CONFIG_VOLUME={{ tempo_config_volume }}
TEMPO_MEMORY_LIMIT={{ tempo_memory_limit }}
TEMPO_CPU_LIMIT={{ tempo_cpu_limit }}

# ─── OpenTelemetry Collector ───────────────────────────────────────────
OTEL_COLLECTOR_CONTAINER_NAME={{ otelcol_container_name }}
OTEL_COLLECTOR_IMAGE={{ otelcol_image }}
OTEL_COLLECTOR_CONFIG_VOLUME={{ otelcol_config_volume }}
OTEL_COLLECTOR_MEMORY_LIMIT={{ otelcol_memory_limit }}
OTEL_COLLECTOR_CPU_LIMIT={{ otelcol_cpu_limit }}

# ─── Prometheus ──────────────────────────────────────────────────────
PROMETHEUS_CONTAINER_NAME={{ prometheus_container_name }}
PROMETHEUS_IMAGE={{ prometheus_image }}
PROMETHEUS_DATA_VOLUME={{ prometheus_data_volume }}
PROMETHEUS_MEMORY_LIMIT={{ prometheus_memory_limit }}
PROMETHEUS_CPU_LIMIT={{ prometheus_cpu_limit }}