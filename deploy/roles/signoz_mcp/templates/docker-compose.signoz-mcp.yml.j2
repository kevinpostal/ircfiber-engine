# {{ ansible_managed }}
# SigNoz MCP server — HTTP sidecar to the IRC Fiber SigNoz stack.
# Joins the ircfiber_logging network so it can reach signoz-signoz:8080
# via Docker DNS. Exposes its MCP listener on the host's Tailscale IP
# only — never on the public interface.

x-logging-common: &logging-common
  restart: unless-stopped
  logging:
    driver: json-file
    options:
      max-size: "10m"
      max-file: "3"

services:
  signoz-mcp:
    <<: *logging-common
    image: {{ signoz_mcp_image }}
    container_name: {{ signoz_mcp_container }}
    hostname: signoz-mcp
    networks:
      - ircfiber_logging
    environment:
      - SIGNOZ_URL=http://signoz-signoz:8080
      - SIGNOZ_API_KEY={{ signoz_mcp_api_key }}
      - TRANSPORT_MODE=http
      - MCP_SERVER_PORT={{ signoz_mcp_container_port }}
      - LOG_LEVEL=info
    ports:
      # Tailscale-only. Override signoz_mcp_bind_address in host_vars
      # to bind to 0.0.0.0 if you need it reachable outside the tailnet.
      - "{{ signoz_mcp_bind_address }}:{{ signoz_mcp_port }}:{{ signoz_mcp_container_port }}"
    mem_limit: {{ signoz_mcp_mem }}
    cpus: {{ signoz_mcp_cpus }}
    healthcheck:
      # /livez is the shallow liveness probe — process is up and
      # serving HTTP. Doesn't depend on SigNoz or docs index.
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:{{ signoz_mcp_container_port }}/livez"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

networks:
  ircfiber_logging:
    external: true