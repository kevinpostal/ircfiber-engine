# {{ ansible_managed }}
# IRC Fiber — engine env file
# Each engine is identified by a unique IRCFIBER_SERVER_ID and (optionally)
# a dedicated bind address. Reaches Mongo/Redis via the Tailscale IP of
# the backend host.

IRCFIBER_SERVER_ID={{ ircfiber_engine_id }}
IRCFIBER_BIND_ADDRESS={{ ircfiber_engine_bind_address }}
IRCFIBER_ADMIN_PORT={{ ircfiber_engine_admin_port }}
IRCFIBER_LOG_LEVEL={{ ircfiber_engine_log_level }}

# Passwords are URL-encoded. The D libraries (vibe-d) decode percent-encoded
# characters in the connection-string userinfo. Keep underlying passwords
# URL-safe (alphanumeric) for compatibility.
#
# IMPORTANT: the D gateway/engine URL parser uses `lastIndexOf("/")` to
# extract the database name, so anything after the last `/` is treated as
# the DB name. Do NOT add `?authSource=...` query params — they get
# concatenated to the DB name. The user lives in the ircfiber DB so the
# default authSource is correct.
#
# Redis: the D library can't pass a password to connectRedis(); we rely
# on Tailscale network isolation (the redis container is bound only to
# the host's tailscale0 interface) instead of an in-protocol password.
IRCFIBER_REDIS_URL=redis://{{ backend_tailscale_ip }}:{{ redis_port }}/0
IRCFIBER_MONGO_URL=mongodb://{{ vault_mongo_app_username | urlencode }}:{{ vault_mongo_app_password | urlencode }}@{{ backend_tailscale_ip }}:{{ mongo_port }}/{{ mongo_initdb_database }}
