# {{ ansible_managed }}
# IRC Fiber — D engine env file
# Each engine is identified by a unique IRCFIBER_SERVER_ID and (optionally)
# a dedicated bind address. Reaches Redis via the Tailscale IP of the backend host.
#
# ── Hot-reload (graceful handoff) support ─────────────────────────────
# When IRCFIBER_RELOAD_FROM_PID is set to the PID of a running engine,
# the new engine will NOT load networks from MongoDB. Instead it will
# connect to the old engine's handoff Unix socket (at
# /tmp/ircfiber-handoff-<serverId>.sock) and adopt live IRC connections
# via SCM_RIGHTS FD transfer. Both processes must run on the same host
# (same Docker container, or bare-metal).
#
# The old engine is signalled to start serving via a gracefulReload
# control message sent to irc:control:<serverId> via redis-cli LPUSH.

IRCFIBER_SERVER_ID={{ ircfiber_engine_id }}
IRCFIBER_BIND_ADDRESS={{ ircfiber_engine_bind_address }}
IRCFIBER_ADMIN_PORT={{ ircfiber_engine_admin_port }}
IRCFIBER_LOG_LEVEL={{ ircfiber_engine_log_level }}
# Passwords are URL-encoded. The D libraries (vibe-d) decode percent-encoded
# characters in the connection-string userinfo, so urlencode is the right
# transform. Caveat: keep the underlying passwords URL-safe (alphanumeric).
#
# IMPORTANT: the D gateway/engine URL parser uses `lastIndexOf("/")` to
# extract the database name, so anything after the last `/` is treated as
# the DB name. Do NOT add `?authSource=...` query params — they get
# concatenated to the DB name. The user lives in the ircfiber DB so the
# default authSource is correct.
IRCFIBER_MONGO_URL=mongodb://{{ vault_mongo_app_username | urlencode }}:{{ vault_mongo_app_password | urlencode }}@{{ backend_tailscale_ip | default(host_tailscale_ip | default('127.0.0.1')) }}:{{ mongo_port }}/{{ mongo_initdb_database }}
IRCFIBER_REDIS_URL=redis://{{ backend_tailscale_ip | default(host_tailscale_ip | default('127.0.0.1')) }}:{{ redis_port }}/0
# Holder mode: route all TCP/TLS I/O through the long-lived holder daemon
# so engine restarts / binary upgrades / bug fixes don't drop IRC
# connections. The holder is a separate container; we share its Unix
# socket via the `ircfiber-holder-sockets-<engine_id>` volume. Setting
# `IRCFIBER_HOLDER_SOCK` to a path that exists flips the engine into
# holder mode — see source/conn_holder/holder_transport.d. If you run a
# holder-less deployment (no `deploy-holder.yml`), comment this line out.
IRCFIBER_HOLDER_SOCK={{ ircfiber_holder_sock | default('/var/run/ircfiber/holder.sock') }}
