# {{ ansible_managed }}
# IRC Fiber — Redis configuration
# Enterprise hardened: volatile-lru + firewall + renamed dangerous commands
# Bind to loopback + docker bridges only (not 0.0.0.0) to avoid internet FLUSHALL.
# If host firewall bypassed, FLUSHALL/FLUSHDB are renamed to "" (disabled).

bind 0.0.0.0
protected-mode no
port {{ redis_port }}
tcp-backlog 511
timeout 0
tcp-keepalive 60

# Auth disabled: the IRC Fiber D client (vibe-d RedisStorage) calls
# connectRedis(host, port) without an auth parameter, so it can't pass
# a password. Network-level isolation (bind + firewall + Tailscale ACL)
# provides the security boundary. If you enable requirepass, patch
# RedisStorage.connect() to call db.auth() after connect.
#
# requirepass {{ vault_redis_password }}

# Persistence
{% if redis_appendonly %}
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec
{% else %}
save 3600 1 300 100
{% endif %}

# Memory — volatile-lru protects critical non-TTL keys (irc:assignments,
# irc:servers, irc:server:ovh) from eviction. Only TTL keys (state,
# scrollback, dedup, leases) are evictable. Prior allkeys-lru evicted the
# assignments hash at 19:55Z 2026-08-20 (canonical 0 + mirror 20 => monitor
# killed engine). See monitor assignments_empty fix.
maxmemory {{ redis_maxmemory }}
maxmemory-policy volatile-lru

# Security — disable dangerous commands that can wedge or wipe prod.
# FLUSHALL/FLUSHDB wiped irc:assignments at 07:28:06Z 2026-08-25 via external
# 36.134.27.91 (host redis bound 0.0.0.0 protected-mode no). Rename to "" disables.
rename-command FLUSHALL ""
rename-command FLUSHDB ""
rename-command DEBUG ""
rename-command MONITOR ""
rename-command CONFIG "CONFIG_b8358f7a3c14"
client-output-buffer-limit normal 32mb 8mb 60
client-output-buffer-limit pubsub 32mb 8mb 60
databases 16
always-show-logo no
