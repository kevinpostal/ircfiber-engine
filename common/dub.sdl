name "irc-fiber-common"
description "IRC Fiber shared library — protocol, models, db, storage, observability"
authors "IRC Fiber Team"
copyright "Copyright © 2026 IRC Fiber"
license "MIT"
version "0.5.0"

compiler "ldc2"

targetType "library"
targetName "irc-fiber-common"

sourcePaths "source"
importPaths "source"

dependency "vibe-d" version="~>0.10.0"
dependency "vibe-d:redis" version="~>0.10.0"
dependency "vibe-d:mongodb" version="~>0.10.0"
dependency "diet-ng" version="~>1.8"
dependency "openssl" version="~>3.4.0"

configuration "library" {
    targetType "library"
}

// Fixture-only entropy hooks; production library has no injectable allocator.
configuration "routing-policy-test" {
    targetType "library"
    versions "VibeUseFibers" "RoutingPolicyTest"
}

// Native contract harnesses do not start Linux host diagnostic endpoints.
configuration "contract-test" {
    targetType "library"
    excludedSourceFiles "source/ircfiber/runtime_diagnostic.d"
}
configuration "unittest" {
    targetType "library"
    versions "VibeUseFibers"
    sourcePaths "source" "tests"
    importPaths "source" "tests"
}

configuration "buffer-dedup-test" {
    targetType "executable"
    sourcePaths "tests" "source"
    importPaths "source" "tests"
    mainSourceFile "tests/buffer_dedup_test.d"
    versions "VibeUseFibers"
}

configuration "device-registry-test" {
    targetType "executable"
    targetName "device-registry-test"
    sourcePaths "source"
    importPaths "source" "tests"
    mainSourceFile "tests/device_registry_test.d"
    versions "VibeUseFibers" "DeviceRegistryTest"
}

configuration "egress-admission-redis-test" {
    targetType "executable"
    targetName "egress-admission-redis-test"
    sourcePaths "source"
    importPaths "source" "tests"
    mainSourceFile "tests/egress_admission_redis_test.d"
    versions "VibeUseFibers" "EgressAdmissionRedisTest"
}

configuration "services-protocol-test" {
    targetType "executable"
    targetName "services-protocol-test"
    sourcePaths "source/ircfiber/services"
    sourceFiles "source/ircfiber/models/network.d" "source/ircfiber/redis/protocol.d"
    importPaths "source" "tests"
    mainSourceFile "tests/services_protocol_test.d"
    versions "VibeUseFibers" "ServicesProtocolTest"
    buildOptions "unittests"
}
