name "irc-fiber"
description "IRC Fiber: Professional D Lang Architecture & Implementation"
authors "IRC Fiber Team"
copyright "Copyright © 2026 IRC Fiber"
license "MIT"

compiler "ldc2"

targetType "executable"
targetName "irc-fiber"
excludedSourceFiles "source/app_engine.d" "source/session_queue_test.d"

dependency "vibe-d" version="~>0.10.0"
dependency "vibe-d:redis" version="~>0.10.0"
dependency "vibe-d:mongodb" version="~>0.10.0"
dependency "diet-ng" version="~>1.8"

configuration "debug" {
	targetType "executable"
	versions "VibeUseFibers" "DietUseLive"
	dflags "-d"
}

configuration "release" {
	targetType "executable"
	versions "VibeUseFibers"
	dflags "-d"
}

dependency "unit-threaded" version="~>2.2.0"

configuration "unittest" {
	targetType "executable"
	targetName "irc-fiber-test"
	mainSourceFile "source/app_test.d"
	versions "VibeUseFibers" "unitThreadedLight"
	excludedSourceFiles "source/app.d"
}

// Real-CI runner. Built with `-b unittest` so `__traits(getUnitTests)`
// returns the per-module unittests; everything with its own `main()`
// is excluded from this build to avoid linker conflicts. Rot-prone
// sources that fail to compile under current LDC/vibe-d are also
// excluded — their tests live in the per-module standalone drivers.
configuration "unit-test-real" {
	targetType "executable"
	targetName "irc-fiber-test-real"
	mainSourceFile "source/app_test_real.d"
	versions "VibeUseFibers" "unitThreadedLight"
	excludedSourceFiles "source/app.d" "source/app_engine.d" "source/prefs_test.d" "source/parser_test.d" "source/consumer_test.d" "source/logging_format_test.d" "source/logging_test.d" "source/handoff_test_runner.d" "source/exec_reload_test_runner.d" "source/draining_test_runner.d"
	// NOTE: ircfiber/tracing.d is deliberately NOT excluded here
	// even though the original intent was to keep unit-test-real
	// lightweight. `logging.d` (compiled by every config) now
	// imports `tracing.d` for `currentTraceId()` / `currentSpanId()`
	// in structured logs. If tracing.d is excluded, the linker
	// sees unresolved symbols from logging.o and fails. Keeping
	// tracing.d in the build adds < 1s to compile time and the
	// module has zero runtime side-effects until explicitly called.
}

configuration "prefs-test" {
	targetType "executable"
	targetName "prefs-test"
	mainSourceFile "source/prefs_test.d"
	versions "VibeUseFibers"
	dflags "-d"
	excludedSourceFiles "source/app.d"
}

