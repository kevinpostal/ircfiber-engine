name "irc-fiber"
description "IRC Fiber: Professional D Lang Architecture & Implementation"
authors "IRC Fiber Team"
copyright "Copyright © 2026 IRC Fiber"
license "MIT"

compiler "ldc2"

targetType "executable"
targetName "irc-fiber-engine"
sourcePaths "source"
importPaths "source"

dependency "irc-fiber-common" path="../common" version="~>0.3.0"
dependency "vibe-d" version="~>0.10.0"
dependency "vibe-d:redis" version="~>0.10.0"
dependency "vibe-d:mongodb" version="~>0.10.0"
dependency "diet-ng" version="~>1.8"

dependency "unit-threaded" version="~>2.2.0"

configuration "application" {
    targetType "executable"
    targetName "irc-fiber-engine"
    mainSourceFile "source/app_engine.d"
    versions "VibeUseFibers"
}

configuration "engine" {
    targetType "executable"
    targetName "irc-fiber-engine"
    mainSourceFile "source/app_engine.d"
    versions "VibeUseFibers" "EngineOnly"
}

// Kept for backwards compat — `dub --config=gateway` now lives in backend/
// Running it from engine/ will fail fast with a clear error; use backend/.
configuration "gateway" {
    targetType "executable"
    targetName "irc-fiber-gateway"
    mainSourceFile "../backend/source/app.d"
    versions "VibeUseFibers" "GatewayOnly"
}

configuration "debug" {
    targetType "executable"
    targetName "irc-fiber-engine"
    mainSourceFile "source/app_engine.d"
    versions "VibeUseFibers" "DietUseLive"
    dflags "-d"
}

configuration "release" {
    targetType "executable"
    targetName "irc-fiber-engine"
    mainSourceFile "source/app_engine.d"
    versions "VibeUseFibers"
    dflags "-d"
}

configuration "unittest" {
    targetType "executable"
    targetName "irc-fiber-test"
    mainSourceFile "source/app_test.d"
    versions "VibeUseFibers" "unitThreadedLight"
    // app_test.d imports both engine (chathistory) and backend (auth) — needs both.
    excludedSourceFiles "source/app_engine.d"
    dependency "irc-fiber-backend" path="../backend" configuration="library"
}

configuration "unit-test-real" {
    targetType "executable"
    targetName "irc-fiber-test-real"
    mainSourceFile "source/app_test_real.d"
    versions "VibeUseFibers" "unitThreadedLight"
    excludedSourceFiles "source/app_engine.d" "source/prefs_test.d" "source/parser_test.d" "source/consumer_test.d" "source/logging_format_test.d" "source/logging_test.d" "source/handoff_test_runner.d" "source/exec_reload_test_runner.d" "source/draining_test_runner.d"
    dependency "irc-fiber-backend" path="../backend" configuration="library"
}

configuration "prefs-test" {
    targetType "executable"
    targetName "prefs-test"
    mainSourceFile "source/prefs_test.d"
    versions "VibeUseFibers"
    dflags "-d"
}

configuration "dedup-test" {
    targetType "executable"
    targetName "dedup-test"
    mainSourceFile "source/dedup_test.d"
    versions "VibeUseFibers"
    dependency "irc-fiber-backend" path="../backend" configuration="library"
}

configuration "parser-test" {
    targetType "executable"
    targetName "parser-test"
    mainSourceFile "source/parser_test.d"
    versions "VibeUseFibers"
}

configuration "consumer-test" {
    targetType "executable"
    targetName "consumer-test"
    mainSourceFile "source/consumer_test.d"
    versions "VibeUseFibers"
}

configuration "connection-registration-test" {
    targetType "executable"
    targetName "connection-registration-test"
    mainSourceFile "source/connection_registration_test.d"
    versions "VibeUseFibers"
}

configuration "observability-test" {
    targetType "executable"
    targetName "observability-test"
    mainSourceFile "source/observability_test.d"
    versions "VibeUseFibers"
}

configuration "parser-fuzz-test" {
    targetType "executable"
    targetName "parser-fuzz-test"
    mainSourceFile "source/parser_fuzz_test.d"
    versions "VibeUseFibers"
}

configuration "sync" {
    targetType "executable"
    targetName "sync-redis-to-mongo"
    mainSourceFile "source/sync_redis_to_mongo.d"
    versions "VibeUseFibers"
}

configuration "handoff-test" {
    targetType "executable"
    targetName "handoff-test"
    mainSourceFile "source/handoff_test_runner.d"
}

configuration "exec-reload-test" {
    targetType "executable"
    targetName "exec-reload-test"
    mainSourceFile "source/exec_reload_test_runner.d"
}

configuration "exec-reload-integration" {
    targetType "executable"
    targetName "exec-reload-integration"
    mainSourceFile "source/exec_reload_integration.d"
    versions "VibeUseFibers"
}

configuration "draining-test" {
    targetType "executable"
    targetName "draining-test"
    mainSourceFile "source/draining_test_runner.d"
    versions "VibeUseFibers"
}

configuration "logging-test" {
    targetType "executable"
    targetName "logging-test"
    mainSourceFile "source/logging_format_test.d"
    versions "VibeUseFibers"
}

configuration "janitor-test" {
    targetType "executable"
    targetName "janitor-test"
    mainSourceFile "source/janitor_test.d"
    versions "VibeUseFibers"
}

configuration "janitor-lock-test" {
    targetType "executable"
    targetName "janitor-lock-test"
    mainSourceFile "source/janitor_lock_test.d"
    versions "VibeUseFibers"
}

configuration "janitor-safety-test" {
    targetType "executable"
    targetName "janitor-safety-test"
    mainSourceFile "source/janitor_safety_test.d"
    versions "VibeUseFibers"
}

configuration "janitor-migrate" {
    targetType "executable"
    targetName "janitor-migrate"
    mainSourceFile "source/tools/janitor_migrate.d"
    versions "VibeUseFibers"
}

configuration "ircfiber-default-migrate" {
    targetType "executable"
    targetName "ircfiber-default-migrate"
    mainSourceFile "source/tools/ircfiber_default_migrate.d"
    versions "VibeUseFibers"
    excludedSourceFiles "source/ircfiber/registry.d"
}

configuration "session-queue-test" {
    targetType "executable"
    targetName "session-queue-test"
    mainSourceFile "source/session_queue_test.d"
    versions "VibeUseFibers"
    dflags "-d"
    excludedSourceFiles "source/ircfiber/resource.d"
    dependency "irc-fiber-backend" path="../backend" configuration="library"
}

configuration "oob-test" {
    targetType "executable"
    targetName "oob-test"
    mainSourceFile "source/oob_test.d"
    versions "VibeUseFibers"
    dflags "-d"
    excludedSourceFiles "source/ircfiber/resource.d"
}

configuration "threadpool-test" {
    targetType "executable"
    targetName "threadpool-test"
    mainSourceFile "source/threadpool_test.d"
    versions "VibeUseFibers"
}

configuration "loadtest" {
    targetType "executable"
    targetName "ircfiber-loadtest"
    mainSourceFile "source/loadtest/main.d"
    versions "VibeUseFibers"
    dependency "vibe-d:redis" version="~>0.10.0"
}
