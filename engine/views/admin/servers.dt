doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title IRC Fiber — Servers & Routing
    style.
      :root {
        --adm-bg: #0a0e14; --adm-surface: #11161d; --adm-border: #1c2430;
        --adm-muted: #545d6e; --adm-text: #c8d2dd; --adm-heading: #ecf2f8;
        --adm-blue: #67e8f9; --adm-green: #4ade80; --adm-red: #f87171;
        --adm-sidebar: #0d1117; --adm-card-bg: #131820; --adm-amber: #fbbf24;
      }
      * { margin:0; padding:0; box-sizing:border-box; }
      body { font-family: Inter, -apple-system, sans-serif; background:var(--adm-bg); color:var(--adm-text); display:flex; min-height:100vh; }
      .adm-sidebar { width:240px; min-height:100vh; background:var(--adm-sidebar); border-right:1px solid var(--adm-border); padding:20px 0; flex-shrink:0; }
      .adm-brand { padding:0 20px 20px; font-size:15px; font-weight:600; color:var(--adm-blue); }
      .adm-nav-section { padding:8px 0; }
      .adm-nav-item { display:block; padding:8px 20px; font-size:14px; color:var(--adm-text); text-decoration:none; }
      .adm-nav-item:hover, .adm-nav-item.active { background:rgba(103,232,249,0.08); color:var(--adm-blue); }
      .adm-content { flex:1; padding:24px 32px; overflow:auto; }
      .adm-topbar { display:flex; justify-content:flex-end; padding:0 32px; border-bottom:1px solid var(--adm-border); background:var(--adm-sidebar); }
      .adm-topbar a { padding:12px 16px; font-size:13px; color:var(--adm-muted); text-decoration:none; }
      .adm-topbar a:hover { color:var(--adm-text); }
      .adm-header { margin-bottom:24px; }
      .adm-header h1 { font-size:22px; font-weight:600; color:var(--adm-heading); }
      .adm-stat-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:16px; margin-bottom:32px; }
      .adm-stat-card { background:var(--adm-card-bg); border:1px solid var(--adm-border); border-radius:8px; padding:20px; }
      .adm-stat-card .label { font-size:12px; color:var(--adm-muted); text-transform:uppercase; margin-bottom:4px; }
      .adm-stat-card .value { font-size:28px; font-weight:700; color:var(--adm-heading); }
      .adm-stat-card.green .value { color:var(--adm-green); }
      .adm-stat-card.amber .value { color:var(--adm-amber); }
      .adm-stat-card.red .value { color:var(--adm-red); }
      .adm-card { background:var(--adm-card-bg); border:1px solid var(--adm-border); border-radius:8px; overflow:hidden; margin-bottom:24px; }
      .adm-card h2 { font-size:16px; font-weight:600; color:var(--adm-heading); padding:16px 20px; border-bottom:1px solid var(--adm-border); }
      .adm-card h3 { font-size:14px; font-weight:600; color:var(--adm-heading); padding:12px 20px; }
      .adm-table { width:100%; border-collapse:collapse; }
      .adm-table th { text-align:left; padding:10px 16px; font-size:12px; font-weight:600; text-transform:uppercase; color:var(--adm-muted); border-bottom:1px solid var(--adm-border); }
      .adm-table td { padding:10px 16px; font-size:14px; border-bottom:1px solid rgba(28,36,48,0.5); }
      .adm-table tr:hover td { background:rgba(103,232,249,0.03); }
      .adm-badge { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:600; }
      .adm-badge-green { background:rgba(74,222,128,0.12); color:var(--adm-green); }
      .adm-badge-red { background:rgba(248,113,113,0.12); color:var(--adm-red); }
      .adm-badge-blue { background:rgba(103,232,249,0.12); color:var(--adm-blue); }
      .adm-health-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; }
      .adm-health-dot.green { background:var(--adm-green); }
      .adm-health-dot.red { background:var(--adm-red); }
      .adm-capacity-bar { display:flex; align-items:center; gap:8px; }
      .adm-capacity-bar .bar { flex:1; height:8px; background:var(--adm-border); border-radius:4px; overflow:hidden; }
      .adm-capacity-bar .fill { height:100%; border-radius:4px; transition:width 0.3s; }
      .adm-capacity-bar .fill.safe { background:var(--adm-green); }
      .adm-capacity-bar .fill.warn { background:var(--adm-amber); }
      .adm-capacity-bar .fill.danger { background:var(--adm-red); }
      .adm-capacity-bar .label { font-size:12px; color:var(--adm-muted); white-space:nowrap; min-width:32px; text-align:right; }
      .adm-form-row { display:flex; gap:12px; align-items:end; padding:16px 20px; }
      .adm-form-row label { font-size:13px; color:var(--adm-muted); margin-bottom:4px; display:block; }
      .adm-form-row input { background:var(--adm-surface); border:1px solid var(--adm-border); border-radius:6px; padding:8px 12px; font-size:14px; color:var(--adm-text); width:100px; }
      .adm-form-row input:focus { border-color:var(--adm-blue); outline:none; }
      .adm-btn { display:inline-block; padding:8px 16px; border-radius:6px; font-size:13px; font-weight:600; text-decoration:none; cursor:pointer; border:none; }
      .adm-btn-primary { background:var(--adm-blue); color:#0a0e14; }
      .adm-btn-primary:hover { opacity:0.9; }
      .adm-btn-danger { background:rgba(248,113,113,0.12); color:var(--adm-red); border:1px solid rgba(248,113,113,0.25); }
      .adm-btn-danger:hover { background:rgba(248,113,113,0.2); }
      .adm-btn-sm { padding:4px 10px; font-size:12px; }
      .adm-alert { padding:12px 20px; border-radius:6px; font-size:14px; margin-bottom:20px; }
      .adm-alert-success { background:rgba(74,222,128,0.10); color:var(--adm-green); border:1px solid rgba(74,222,128,0.2); }
      .adm-alert-error { background:rgba(248,113,113,0.10); color:var(--adm-red); border:1px solid rgba(248,113,113,0.2); }
      .adm-section-title { font-size:13px; font-weight:600; color:var(--adm-muted); text-transform:uppercase; padding:12px 20px 4px; }
      .adm-mono { font-family:"SF Mono",monospace; font-size:12px; color:var(--adm-muted); }
  body
    .adm-sidebar
      .adm-brand IRC Fiber
      a.adm-nav-item(href="/admin") Dashboard
      a.adm-nav-item.active(href="/admin/servers") Servers
      a.adm-nav-item(href="/admin/sessions") Sessions
      a.adm-nav-item(href="/admin/users") Users
      a.adm-nav-item(href="/admin/uploads") Uploads
      a.adm-nav-item(href="/", target="_blank") View Site →
    .adm-content
      .adm-topbar
        a(href="/admin/logout") Log out
      .adm-header
        h1 Servers &amp; Routing
      - if (message.length > 0)
        .adm-alert.adm-alert-success #{message}
      .adm-stat-grid
        .adm-stat-card
          .label Total Engines
          .value #{allServers.length}
        - auto healthyCount = 0; foreach (s; allServers) { if (healthyMap[s.serverId]) healthyCount++; }
        .adm-stat-card(class=healthyCount == allServers.length ? "green" : healthyCount > 0 ? "amber" : "red")
          .label Healthy Engines
          .value #{healthyCount}
        .adm-stat-card
          .label Max Conns/Host
          .value #{maxConns}
        - int totalNets; foreach (s; allServers) { totalNets += s.assignedNetworks.length; }
        .adm-stat-card
          .label Total Networks
          .value #{totalNets}

      // Engine overview cards
      .adm-card
        h2 Engine Status
        - foreach (s; allServers)
          - auto isH = healthyMap[s.serverId];
          .adm-card(style="margin:12px 16px; border:1px solid var(--adm-border)")
            div(style="padding:16px 20px; display:flex; align-items:center; gap:12px")
              span.adm-health-dot(class=isH ? "green" : "red")
              span(style="font-weight:600; color:var(--adm-heading)") #{s.serverId}
              span.adm-badge(class=isH ? "adm-badge-green" : "adm-badge-red") #{isH ? "Healthy" : "Unhealthy"}
              span(style="margin-left:auto; font-size:12px; color:var(--adm-muted)") #{s.bindAddress}:#{s.port}
            div(style="padding:0 20px 16px; display:flex; gap:24px; font-size:13px; color:var(--adm-muted); flex-wrap:wrap; align-items:start")
              - auto engCap = s.maxConnections > 0 ? s.maxConnections : 0;
              - auto pct = engCap > 0 ? (s.assignedNetworks.length * 100 / engCap) : 0;
              - auto fillClass = pct >= 100 ? "danger" : pct >= 75 ? "warn" : "safe";
              span(style="white-space:nowrap") Engine load: 
                .adm-capacity-bar(style="display:inline-flex; vertical-align:middle; width:80px; margin-left:4px")
                  .bar
                    .fill(class=fillClass, style="width:#{pct}%")
                  .label #{s.assignedNetworks.length}#{engCap > 0 ? "/" ~ engCap.to!string : ""}
              span(style="color:var(--adm-muted); font-size:11px") #{engCap > 0 ? "engine cap" : "no engine cap"}
              span Priority: 
                strong(style="color:var(--adm-text)") #{s.priority}
              - if (s.fallbackOnly)
                span.adm-badge(style="background:rgba(251,191,36,0.12); color:var(--adm-amber)") FALLBACK
              - import std.datetime : Clock, SysTime;
              - auto now = Clock.currTime.toUnixTime!long * 1000;
              - auto ageSec = (now - s.lastHeartbeat) / 1000;
              - string ageStr = ageSec < 60 ? ageSec.to!string ~ "s ago" : (ageSec/60).to!string ~ "m ago";
              span Last heartbeat: 
                strong(style="color:var(--adm-text)") #{ageStr}
              - if (s.assignedNetworks.length > 0)
                form(method="POST", action="/admin/servers/#{s.serverId}/reassign", style="margin-left:auto", onsubmit="return confirm('Reassign all #{s.assignedNetworks.length} networks from #{s.serverId}?')")
                  button.adm-btn.adm-btn-danger.adm-btn-sm(type="submit") Reassign All
            // Per-engine config form
            form(method="POST", action="/admin/servers/#{s.serverId}/config", style="padding:0 20px 16px; display:flex; gap:10px; align-items:end; flex-wrap:wrap; border-top:1px solid var(--adm-border); padding-top:12px")
              div
                label(style="font-size:11px; color:var(--adm-muted); display:block") Priority
                input(type="number", name="priority", value="#{s.priority}", style="background:var(--adm-surface); border:1px solid var(--adm-border); border-radius:4px; padding:4px 8px; font-size:13px; color:var(--adm-text); width:70px")
              div
                label(style="font-size:11px; color:var(--adm-muted); display:block") Engine Cap
                input(type="number", name="maxConns", value="#{s.maxConnections}", min="0", style="background:var(--adm-surface); border:1px solid var(--adm-border); border-radius:4px; padding:4px 8px; font-size:13px; color:var(--adm-text); width:70px")
                div(style="font-size:10px; color:var(--adm-muted); margin-top:2px") max networks total (0=unlimited)
              div
                label(style="font-size:11px; color:var(--adm-muted); display:block") Fallback
                select(name="fallbackOnly", style="background:var(--adm-surface); border:1px solid var(--adm-border); border-radius:4px; padding:4px 8px; font-size:13px; color:var(--adm-text)")
                  option(value="false", selected=(s.fallbackOnly ? false : true)) No
                  option(value="true", selected=(s.fallbackOnly ? true : false)) Yes
              button.adm-btn.adm-btn-primary.adm-btn-sm(type="submit", style="padding:5px 12px") Save

      // Host connection routing table
      .adm-card
        h2 Host Connection Routing
        div(style="padding:0 20px 12px; font-size:12px; color:var(--adm-muted); border-bottom:1px solid var(--adm-border)")
          | Per-host cap: 
          strong #{maxConns}
          |  connections per engine per IRC host (anti-ban). 
          | Per-engine cap: set per engine above via 
          strong Max Conns
          |  (0 = unlimited).
        - if (hostSummary.length > 0)
          table.adm-table
            thead
              tr
                th IRC Host
                th Total Connections
                th Servers
                th Status
            tbody
              - foreach (hcs; hostSummary)
                tr
                  td
                    a(href="/admin/servers/host/#{hcs.host}", style="font-family:monospace; font-size:13px; color:var(--adm-blue); text-decoration:none") #{hcs.host}
                  td
                    strong #{hcs.totalConns}
                  td
                    span(style="font-size:12px; color:var(--adm-muted)") #{hcs.serverIds.length}
                  td
                    - if (hcs.totalConns > 0)
                      span.adm-badge.adm-badge-green Active
                    - else
                      span.adm-badge(style="background:rgba(139,150,164,0.12); color:var(--adm-muted)") Idle
        - else
          div(style="text-align:center; padding:40px; color:var(--adm-muted)") No active host connections. Engines may be starting up.

      // Global routing config
      .adm-card
        h2 Routing Configuration
        form.adm-form-row(method="POST", action="/admin/routing")
          div
            label(for="maxConns") Max Connections Per Host (per engine IP)
            input#maxConns(type="number", name="maxConnsPerHost", value="#{maxConns}", min="1", max="20")
          button.adm-btn.adm-btn-primary(type="submit") Save
        div(style="padding:0 20px 16px; font-size:12px; color:var(--adm-muted)")
          | Each engine has a distinct outbound IP. This limit prevents any single engine from
          | exceeding the per-IP connection cap that IRC servers enforce (typically 3–5).
          | Set to 0 and save to clear the override (falls back to 
          code IRCFIBER_MAX_CONNS_PER_HOST
          |  env var).

      // Network assignments
      .adm-card
        h2 Network Assignments
        div(style="padding:10px 20px 14px; font-size:12px; color:var(--adm-muted); border-bottom:1px solid var(--adm-border); line-height:1.5")
          | Live routing table — one row per IRC network currently bound to an engine.
          | The gateway uses this to forward client commands to the right engine. Use
          strong Reassign
          |  to move a single network to a different engine, or
          strong Remove
          |  to clear the binding so the gateway re-picks on the next message.
          | Orphan rows (no owner) usually mean the network was deleted but the Redis entry wasn't cleaned.
        - if (assignments.length > 0)
          table.adm-table
            thead
              tr
                th Network
                th Owner
                th Assigned Server
                th(style="text-align:right") Actions
            tbody
              - foreach (a; assignments)
                tr
                  td
                    - auto label = a.networkName.length > 0 ? a.networkName : (a.networkHost.length > 0 ? a.networkHost : "(unnamed)");
                    div(style="font-weight:500; color:var(--adm-heading)") #{label}
                    div(style="display:flex; gap:6px; align-items:center; margin-top:2px")
                      - if (a.networkHost.length > 0 && a.networkHost != label)
                        span.adm-mono #{a.networkHost}
                      span.adm-mono(style="opacity:0.7") #{a.networkId}
                  td
                    - if (a.username.length > 0)
                      a(href="/admin/users/#{a.userId}", style="color:var(--adm-blue); text-decoration:none; font-weight:500") #{a.username}
                    - else
                      span(style="color:var(--adm-muted); font-size:12px") orphan
                  td
                    span.adm-badge.adm-badge-blue #{a.serverId}
                  td(style="text-align:right; white-space:nowrap")
                    form(method="POST", action="/admin/servers/assignments/#{a.networkId}/reassign", style="display:inline", onsubmit="return confirm('Reassign network #{label} from #{a.serverId} to a different engine?')")
                      button.adm-btn.adm-btn-sm(type="submit", style="background:var(--adm-surface); border:1px solid var(--adm-border); color:var(--adm-text); margin-right:4px") Reassign
                    form(method="POST", action="/admin/servers/assignments/#{a.networkId}/remove", style="display:inline", onsubmit="return admRemoveAssignment(event)")
                      button.adm-btn.adm-btn-danger.adm-btn-sm(type="submit") Remove
        - else
          div(style="text-align:center; padding:40px; color:var(--adm-muted)") No networks assigned yet. Engines may be starting up.

    script.
      // In-place Remove for the Network Assignments table. Posts via fetch
      // so the row can be animated out and the Total Networks stat decremented
      // without a full page reload. Falls back to native form submit if
      // anything goes wrong before fetch returns.
      window.admRemoveAssignment = async function(ev) {
        ev.preventDefault();
        var form = ev.currentTarget;
        if (!form) return false;

        if (!window.confirm('Remove this network assignment?\n\nThe gateway will re-route on the next message. The existing engine connection will be torn down on its next orphan-detection cycle.')) {
          return false;
        }

        var row = form.closest('tr');
        var btn = form.querySelector('button[type=submit]');
        var tbody = row ? row.parentNode : null;
        var card  = tbody ? tbody.closest('.adm-card') : null;

        if (btn) { btn.disabled = true; btn.textContent = 'Removing\u2026'; }

        try {
          var res = await fetch(form.action, {
            method: 'POST',
            headers: { 'X-Requested-With': 'fetch' },
            credentials: 'same-origin',
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);

          // Decrement the Total Networks stat if present
          var stats = document.querySelectorAll('.adm-stat-card .value');
          stats.forEach(function(el) {
            var n = parseInt(el.textContent, 10);
            if (!isNaN(n) && n > 0) el.textContent = String(n - 1);
          });

          // Fade the row out, then remove from DOM
          if (row) {
            row.style.transition = 'opacity 220ms, background 220ms';
            row.style.opacity = '0.35';
            row.style.background = 'rgba(248,113,113,0.10)';
            setTimeout(function() {
              row.remove();
              // If the table is now empty, swap in the empty-state placeholder
              if (tbody && tbody.children.length === 0 && card) {
                var empty = document.createElement('div');
                empty.style.cssText = 'text-align:center; padding:40px; color:var(--adm-muted)';
                empty.textContent = 'No networks assigned yet.';
                card.replaceChild(empty, card.querySelector('table'));
              }
            }, 220);
          }
        } catch (e) {
          if (btn) { btn.disabled = false; btn.textContent = 'Remove'; }
          window.alert('Remove failed: ' + (e && e.message ? e.message : e));
          // As a last resort, fall back to native submit so the request still goes through
          // (browser will follow the redirect normally).
          form.submit();
        }
        return false;
      };