doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title IRC Fiber — Users
    style.
      :root {
        --adm-bg: #0a0e14; --adm-surface: #11161d; --adm-border: #1c2430;
        --adm-muted: #545d6e; --adm-text: #c8d2dd; --adm-heading: #ecf2f8;
        --adm-blue: #67e8f9; --adm-green: #4ade80; --adm-red: #f87171;
        --adm-sidebar: #0d1117; --adm-card-bg: #131820;
      }
      * { margin:0; padding:0; box-sizing:border-box; }
      body { font-family: Inter, -apple-system, sans-serif; background:var(--adm-bg); color:var(--adm-text); display:flex; min-height:100vh; }
      .adm-sidebar { width:240px; min-height:100vh; background:var(--adm-sidebar); border-right:1px solid var(--adm-border); padding:20px 0; flex-shrink:0; }
      .adm-brand { padding:0 20px 20px; font-size:15px; font-weight:600; color:var(--adm-blue); }
      .adm-nav-item { display:block; padding:8px 20px; font-size:14px; color:var(--adm-text); text-decoration:none; }
      .adm-nav-item:hover, .adm-nav-item.active { background:rgba(103,232,249,0.08); color:var(--adm-blue); }
      .adm-content { flex:1; padding:24px 32px; overflow:auto; }
      .adm-topbar { display:flex; justify-content:flex-end; padding:0 32px; border-bottom:1px solid var(--adm-border); background:var(--adm-sidebar); }
      .adm-topbar a { padding:12px 16px; font-size:13px; color:var(--adm-muted); text-decoration:none; }
      .adm-topbar a:hover { color:var(--adm-text); }
      .adm-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
      .adm-header h1 { font-size:22px; font-weight:600; color:var(--adm-heading); }
      .adm-card { background:var(--adm-card-bg); border:1px solid var(--adm-border); border-radius:8px; overflow:hidden; }
      .adm-toolbar { display:flex; gap:12px; padding:16px 20px; border-bottom:1px solid var(--adm-border); }
      .adm-input { padding:8px 12px; background:var(--adm-bg); border:1px solid var(--adm-border); border-radius:6px; color:var(--adm-text); font-size:14px; outline:none; }
      .adm-input:focus { border-color:var(--adm-blue); }
      .adm-btn { display:inline-block; padding:8px 16px; border-radius:6px; font-size:13px; font-weight:500; text-decoration:none; cursor:pointer; border:1px solid var(--adm-border); background:var(--adm-surface); color:var(--adm-text); }
      .adm-btn:hover { background:rgba(103,232,249,0.08); }
      .adm-btn-primary { background:rgba(103,232,249,0.12); color:var(--adm-blue); border-color:rgba(103,232,249,0.2); }
      .adm-table { width:100%; border-collapse:collapse; }
      .adm-table th { text-align:left; padding:10px 16px; font-size:12px; font-weight:600; text-transform:uppercase; color:var(--adm-muted); border-bottom:1px solid var(--adm-border); }
      .adm-table td { padding:10px 16px; font-size:14px; border-bottom:1px solid rgba(28,36,48,0.5); }
      .adm-table tr:hover td { background:rgba(103,232,249,0.03); }
      .adm-table tr:last-child td { border-bottom:none; }
      .adm-badge { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:600; }
      .adm-badge-admin { background:rgba(103,232,249,0.12); color:var(--adm-blue); }
      .adm-badge-user { background:rgba(139,150,164,0.12); color:var(--adm-muted); }
      .adm-actions { display:flex; gap:8px; }
      .adm-link { color:var(--adm-blue); text-decoration:none; font-size:13px; }
      .adm-link:hover { text-decoration:underline; }
  body
    .adm-sidebar
      .adm-brand IRC Fiber
      a.adm-nav-item(href="/admin") Dashboard
      a.adm-nav-item(href="/admin/servers") Servers
      a.adm-nav-item(href="/admin/sessions") Sessions
      a.adm-nav-item.active(href="/admin/users") Users
      a.adm-nav-item(href="/admin/uploads") Uploads
      a.adm-nav-item(href="/", target="_blank") View Site →
    .adm-content
      .adm-topbar
        a(href="/admin/logout") Log out
      .adm-header
        h1 Users
        a.adm-btn.adm-btn-primary(href="/admin/users/new") + Add User
      .adm-card
        .adm-toolbar
          form(method="POST", action="/admin/users", style="display:flex; gap:12px; width:100%")
            input.adm-input(type="search", name="q", value=q, placeholder="Search by username or email…", style="flex:1; max-width:400px")
            button.adm-btn(type="submit") Search
        - if (users.length > 0)
          table.adm-table
            thead
              tr
                th Username
                th Email
                th Roles
                th Last Login IP
                th Last Login
                th
            tbody
              - foreach (u; users)
                tr
                  td #{u.username}
                  td #{u.email}
                  td
                    - foreach (r; u.roles)
                      - if (r == "admin")
                        span.adm-badge.adm-badge-admin #{r}
                      - else
                        span.adm-badge.adm-badge-user #{r}
                  td
                    span(style="font-family:monospace; font-size:12px; color:var(--adm-muted)") #{u.lastLoginIp.length > 0 ? u.lastLoginIp : "--"}
                  td
                    span(style="font-size:12px; color:var(--adm-muted)") #{u.lastLoginAt.toUnixTime() > 0 ? u.lastLoginAt.toSimpleString() : "--"}
                  td.adm-actions
                    a.adm-link(href="/admin/users/#{u.id}") Edit
                    a.adm-link(href="/admin/users/#{u.id}/impersonate", style="color:var(--adm-green)") Impersonate
        - else
          .adm-card(style="text-align:center; padding:40px; color:var(--adm-muted)")
            - if (q.length > 0)
              p No users matching "#{q}" found.
            - else
              p No users yet.
