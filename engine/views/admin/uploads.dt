doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title IRC Fiber — Uploads
    style.
      :root {
        --text-primary: #d1d5db;
        --text-secondary: #8b949e;
        --text-tertiary: #6e7681;
        --border: #2c2f35;
        --link: #58a6ff;
        --accent: #1E72FF;
        --input-bg: #1e2126;
        --danger: #f85149;
        --success: #238636;
        --success-hover: #2ea043;
        --card-bg: #1a1d21;
        --card-border: #2c2f35;
        --app-bg: #000;
        --body-bg: #333333;
        --surface: #0d1117;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        font-size: 14px;
        background: var(--body-bg);
        color: var(--text-primary);
        display: flex;
        min-height: 100vh;
        line-height: 1.4;
      }
      .adm-sidebar {
        width: 240px;
        min-height: 100vh;
        background: var(--app-bg);
        border-right: 1px solid var(--border);
        padding: 20px 0;
        flex-shrink: 0;
      }
      .adm-brand { padding: 0 20px 20px; font-size: 15px; font-weight: 600; color: var(--link); }
      .adm-nav-item { display: block; padding: 8px 20px; font-size: 13px; color: var(--text-secondary); text-decoration: none; }
      .adm-nav-item:hover, .adm-nav-item.active { background: rgba(88,166,255,0.08); color: var(--link); }
      .adm-content { flex: 1; padding: 24px 32px; overflow: auto; }
      .adm-topbar {
        display: flex; justify-content: flex-end;
        border-bottom: 1px solid var(--border);
        background: var(--app-bg);
      }
      .adm-topbar a { padding: 12px 16px; font-size: 13px; color: var(--text-secondary); text-decoration: none; }
      .adm-topbar a:hover { color: var(--text-primary); }
      .adm-breadcrumbs { font-size: 13px; color: var(--text-secondary); margin-bottom: 8px; }
      .adm-breadcrumbs a { color: var(--link); text-decoration: none; }
      .adm-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
      .adm-header h1 { font-size: 22px; font-weight: 600; color: var(--text-primary); }
      .adm-header .subtitle { font-size: 13px; color: var(--text-secondary); }
      .adm-alert {
        padding: 10px 16px; border-radius: 6px; font-size: 13px; margin-bottom: 16px;
        background: rgba(63,185,80,0.08); color: #3fb950;
        border: 1px solid rgba(63,185,80,0.15);
      }
      .adm-alert-error {
        background: rgba(248,81,73,0.08); color: var(--danger);
        border: 1px solid rgba(248,81,73,0.15);
      }

      /* Upload grid — card-based like the frontend file browser */
      .upload-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(400px, 100%), 1fr));
        gap: 22px 26px;
      }
      .upload-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 4px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 215px;
        position: relative;
      }
      .upload-card:hover { border-color: #55585c; }
      .upload-card__preview {
        flex: 1;
        background: var(--app-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 140px;
        overflow: hidden;
        position: relative;
      }
      .upload-card__preview img {
        max-width: 100%;
        max-height: 197px;
        object-fit: contain;
        display: block;
      }
      .upload-card__preview .file-icon {
        width: 48px; height: 48px; border-radius: 4px;
        border: 1px solid var(--border);
        display: flex; align-items: center; justify-content: center;
        font-size: 24px; color: var(--text-secondary);
      }
      .upload-card__info {
        padding: 14px 16px;
        background: #606366;
        border-top: 1px solid var(--card-border);
      }
      .upload-card__info .filename {
        font-family: 'Hack', 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin-bottom: 4px;
      }
      .upload-card__info .meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--text-primary);
        flex-wrap: wrap;
      }
      .upload-card__info .meta .user-link {
        color: var(--link);
        text-decoration: none;
      }
      .upload-card__info .meta .user-link:hover { text-decoration: underline; }
      .upload-card__info .meta .sep { color: var(--text-tertiary); }
      .upload-card__info .buffer-tag {
        font-family: 'Hack', 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
        font-size: 11px;
        color: var(--text-secondary);
        background: rgba(0,0,0,0.2);
        padding: 1px 6px;
        border-radius: 3px;
      }
      .upload-card__info .date {
        font-family: 'Hack', 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
        font-size: 12px;
        color: var(--text-primary);
        margin-top: 6px;
      }
      .upload-card__actions {
        position: absolute;
        top: 8px;
        right: 8px;
        display: none;
        gap: 6px;
        z-index: 5;
      }
      .upload-card:hover .upload-card__actions { display: flex; }
      .upload-card__actions .btn-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        border: none;
        color: #fff;
      }
      .btn-view { background: #4c83e8; }
      .btn-view:hover { background: #6396f2; }
      .btn-delete { background: #df3d43; }
      .btn-delete:hover { background: #e55; }

      /* Empty state */
      .upload-empty {
        text-align: center;
        padding: 80px 24px;
        color: var(--text-secondary);
        font-size: 14px;
      }
      .upload-empty .icon {
        font-size: 40px;
        margin-bottom: 12px;
        opacity: 0.4;
      }
      .upload-empty .text { margin-bottom: 4px; }
      .upload-empty .hint { font-size: 12px; color: var(--text-tertiary); }

      /* Pagination */
      .upload-pagination {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 16px 0;
        font-size: 13px;
      }
      .upload-pagination .info { color: var(--text-secondary); margin-right: auto; }
      .upload-pagination .page-btn {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        background: #2c2f35;
        border: 1px solid #3a3f47;
        color: var(--text-primary);
      }
      .upload-pagination .page-btn:hover { background: #3a3f47; }
      .upload-pagination .page-num {
        color: var(--text-secondary);
        font-size: 12px;
        padding: 0 4px;
      }
  body
    .adm-sidebar
      .adm-brand IRC Fiber
      a.adm-nav-item(href="/admin") Dashboard
      a.adm-nav-item(href="/admin/servers") Servers
      a.adm-nav-item(href="/admin/sessions") Sessions
      a.adm-nav-item(href="/admin/users") Users
      a.adm-nav-item.active(href="/admin/uploads") Uploads
      a.adm-nav-item(href="/", target="_blank") View Site →
    .adm-content
      .adm-topbar
        a(href="/admin/logout") Log out
      .adm-breadcrumbs
        a(href="/admin") Dashboard
        span  ›
        span Uploads
      .adm-header
        div
          h1 Uploads
          .subtitle #{total} file(s) uploaded
      - if (message.length > 0)
        .adm-alert #{message}
      - if (uploads.length > 0)
        .upload-grid
          - import std.datetime : SysTime, unixTimeToStdTime;
          - foreach (u; uploads)
            .upload-card
              .upload-card__preview
                - if (u.directUrl.length > 0 && (u.mimeType == "image/png" || u.mimeType == "image/jpeg" || u.mimeType == "image/gif" || u.mimeType == "image/webp"))
                  img(src=u.directUrl, alt=u.filename)
                - else
                  .file-icon &#x1F4CE;
              .upload-card__info
                .filename(title=u.filename) #{u.filename}
                .meta
                  a.user-link(href="/admin/users/#{u.userId}") #{u.username}
                  span.sep &middot;
                  span #{u.sizeLabel}
                  - if (u.buffer.length > 0)
                    span.sep &middot;
                    span.buffer-tag ##{u.buffer}
                .date #{SysTime(unixTimeToStdTime(u.createdAt / 1000)).toSimpleString()}
              .upload-card__actions
                - if (u.directUrl.length > 0)
                  a.btn-icon.btn-view(href=u.directUrl, target="_blank") View
                form(method="POST", action="/admin/uploads/#{u.id}/delete", onsubmit="return confirm('Delete upload #{u.filename}?')", style="display:inline")
                  button.btn-icon.btn-delete(type="submit") Delete
        .upload-pagination
          .info Showing #{uploads.length} of #{total} uploads
          - if (page > 0)
            a.page-btn(href="/admin/uploads?page=#{page - 1}&limit=#{limit}") &#x2190; Previous
          span.page-num Page #{page + 1}
          - if (page * limit + limit < total)
            a.page-btn(href="/admin/uploads?page=#{page + 1}&limit=#{limit}") Next &#x2192;
      - else
        .upload-empty
          .icon &#x1F4CE;
          .text No uploads found.
          .hint Uploaded files will appear here.
