doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title IRC Fiber — #{user.username}
    style.
      :root {
        --adm-bg: #0a0e14; --adm-surface: #11161d; --adm-border: #1c2430;
        --adm-muted: #545d6e; --adm-text: #c8d2dd; --adm-heading: #ecf2f8;
        --adm-blue: #67e8f9; --adm-green: #4ade80; --adm-red: #f87171;
        --adm-sidebar: #0d1117; --adm-card-bg: #131820;
      }
      * { margin:0; padding:0; box-sizing:border-box; }
      body { font-family: Inter, -apple-system, sans-serif; background:var(--adm-bg); color:var(--adm-text); display:flex; min-height:100vh; }
      .adm-sidebar { width:240px; min-height:100vh; background:var(--adm-sidebar); border-right:1px solid var(--adm-border); padding:20px 0; flex-shrink:0; }
      .adm-brand { padding:0 20px 20px; font-size:15px; font-weight:600; color:var(--adm-blue); }
      .adm-nav-item { display:block; padding:8px 20px; font-size:14px; color:var(--adm-text); text-decoration:none; }
      .adm-nav-item:hover, .adm-nav-item.active { background:rgba(103,232,249,0.08); color:var(--adm-blue); }
      .adm-content { flex:1; padding:24px 32px; overflow:auto; }
      .adm-topbar { display:flex; justify-content:flex-end; padding:0 32px; border-bottom:1px solid var(--adm-border); background:var(--adm-sidebar); }
      .adm-topbar a { padding:12px 16px; font-size:13px; color:var(--adm-muted); text-decoration:none; }
      .adm-breadcrumbs { font-size:13px; color:var(--adm-muted); margin-bottom:8px; }
      .adm-breadcrumbs a { color:var(--adm-blue); text-decoration:none; }
      .adm-header { margin-bottom:24px; display:flex; justify-content:space-between; align-items:center; }
      .adm-header h1 { font-size:22px; font-weight:600; color:var(--adm-heading); }
      .adm-card { background:var(--adm-card-bg); border:1px solid var(--adm-border); border-radius:8px; margin-bottom:24px; }
      .adm-card h2 { font-size:16px; font-weight:600; color:var(--adm-heading); padding:16px 20px; border-bottom:1px solid var(--adm-border); }
      .adm-card-body { padding:20px; }
      .adm-form-group { margin-bottom:16px; }
      .adm-form-group label { display:block; font-size:12px; font-weight:600; color:var(--adm-muted); text-transform:uppercase; margin-bottom:4px; }
      .adm-input { width:100%; padding:8px 12px; background:var(--adm-bg); border:1px solid var(--adm-border); border-radius:6px; color:var(--adm-text); font-size:14px; outline:none; }
      .adm-input:focus { border-color:var(--adm-blue); }
      .adm-input:disabled { opacity:0.5; cursor:not-allowed; }
      .adm-btn { display:inline-block; padding:8px 16px; border-radius:6px; font-size:13px; font-weight:500; text-decoration:none; cursor:pointer; border:1px solid var(--adm-border); background:var(--adm-surface); color:var(--adm-text); }
      .adm-btn:hover { background:rgba(103,232,249,0.08); }
      .adm-btn-primary { background:rgba(103,232,249,0.12); color:var(--adm-blue); border-color:rgba(103,232,249,0.2); }
      .adm-btn-danger { color:var(--adm-red); border-color:rgba(248,113,113,0.2); }
      .adm-alert { padding:10px 16px; border-radius:6px; font-size:13px; margin-bottom:16px; }
      .adm-alert-success { background:rgba(74,222,128,0.08); color:var(--adm-green); border:1px solid rgba(74,222,128,0.15); }
      .adm-badge { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:600; }
      .adm-badge-admin { background:rgba(103,232,249,0.12); color:var(--adm-blue); }
      .adm-badge-user { background:rgba(139,150,164,0.12); color:var(--adm-muted); }
      .adm-badge-green { background:rgba(74,222,128,0.12); color:var(--adm-green); }
      .adm-badge-muted { background:rgba(84,93,110,0.12); color:var(--adm-muted); }
      .adm-badge-away { background:rgba(251,191,36,0.12); color:#fbbf24; }
      .adm-field { margin-bottom:12px; }
      .adm-field label { font-size:12px; color:var(--adm-muted); text-transform:uppercase; display:block; }
      .adm-field .value { font-size:14px; color:var(--adm-heading); margin-top:2px; }
      .adm-btn-group { display:flex; gap:8px; margin-top:12px; }

      /* ── Networks & Channels card ── */
      .adm-network-item { border:1px solid var(--adm-border); border-radius:6px; margin-bottom:12px; overflow:hidden; }
      .adm-network-item.connected { border-left:3px solid var(--adm-green); }
      .adm-network-item.disconnected { border-left:3px solid var(--adm-muted); }
      .adm-network-header { padding:10px 14px; background:rgba(19,24,32,0.6); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; }
      .adm-net-status-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; flex-shrink:0; }
      .adm-net-status-dot.online { background:var(--adm-green); box-shadow:0 0 6px rgba(74,222,128,0.4); }
      .adm-net-status-dot.offline { background:var(--adm-muted); }
      .adm-network-name strong { color:var(--adm-heading); font-size:14px; }
      .adm-net-host { color:var(--adm-muted); font-size:12px; margin-left:12px; font-family:monospace; }
      .adm-net-nick { color:var(--adm-muted); font-size:12px; margin-left:8px; }
      .adm-network-meta { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
      .adm-channels { border-top:1px solid rgba(28,36,48,0.4); }
      .adm-channel-row { display:flex; align-items:center; gap:8px; padding:6px 14px; font-size:13px; border-bottom:1px solid rgba(28,36,48,0.2); flex-wrap:wrap; }
      .adm-channel-row:last-child { border-bottom:none; }
      .adm-channel-icon { color:var(--adm-blue); font-family:monospace; font-size:12px; width:14px; flex-shrink:0; }
      .adm-channel-name { color:var(--adm-text); font-family:monospace; font-size:13px; min-width:80px; }
      .adm-channel-topic { color:var(--adm-muted); font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:300px; }
      .adm-channel-users { color:var(--adm-muted); font-size:11px; margin-left:auto; }
      .adm-network-footer { padding:6px 14px; font-size:11px; color:var(--adm-muted); border-top:1px solid rgba(28,36,48,0.3); }
  body
    .adm-sidebar
      .adm-brand IRC Fiber
      a.adm-nav-item(href="/admin") Dashboard
      a.adm-nav-item(href="/admin/servers") Servers
      a.adm-nav-item(href="/admin/sessions") Sessions
      a.adm-nav-item.active(href="/admin/users") Users
      a.adm-nav-item(href="/admin/uploads") Uploads
      a.adm-nav-item(href="/", target="_blank") View Site →
    .adm-content
      .adm-topbar
        a(href="/admin/logout") Log out
      .adm-breadcrumbs
        a(href="/admin") Dashboard
        span  › 
        a(href="/admin/users") Users
        span  › 
        span #{user.username}
      .adm-header
        h1 #{user.username}
        .adm-btn-group
          a.adm-btn(href="/admin/users/#{user.id}/impersonate", style="color:var(--adm-green)") Impersonate
          - if (canEdit)
            form(method="POST", action="/admin/users/#{user.id}/delete", onsubmit="return confirm('Delete user #{user.username}?')", style="display:inline")
              button.adm-btn.adm-btn-danger(type="submit") Delete User
      - if (message != "")
        .adm-alert.adm-alert-success #{message}
      .adm-card
        h2 Edit User
        .adm-card-body
          form(method="POST", action="/admin/users/#{user.id}")
            .adm-form-group
              label Username
              input.adm-input(type="text", value=user.username, disabled)
            .adm-form-group
              label Email
              input.adm-input(type="email", name="email", value=user.email)
            .adm-form-group
              label Roles (comma-separated: admin, user)
              input.adm-input(type="text", name="roles", value=rolesStr)
            .adm-form-group
              .adm-field
                label Current Roles
                .value
                  - foreach (r; user.roles)
                    - if (r == "admin")
                      span.adm-badge.adm-badge-admin #{r}
                    - else
                      span.adm-badge.adm-badge-user #{r}
                    | &nbsp;
            button.adm-btn-primary(type="submit") Save Changes
      - if (networks.length > 0)
        .adm-card
          h2 Networks &amp; Channels (#{networks.length})
          .adm-card-body
            - foreach (i, net; networks)
              - auto snap = snapshots[i];
              .adm-network-item(class=snap.connected ? "connected" : "disconnected")
                .adm-network-header
                  .adm-network-name
                    span.adm-net-status-dot(class=snap.connected ? "online" : "offline")
                    strong #{net.name}
                    span.adm-net-host #{net.host}:#{net.port}
                  .adm-network-meta
                    - if (snap.connected)
                      span.adm-badge.adm-badge-green connected
                    - else if (snap.status.length > 0)
                      span.adm-badge.adm-badge-muted #{snap.status}
                    - else
                      span.adm-badge.adm-badge-muted offline
                    - if (snap.currentNick.length > 0)
                      span.adm-net-nick nick: #{snap.currentNick}
                    - if (snap.isAway)
                      span.adm-badge.adm-badge-away away
                - if (snap.buffers.length > 0)
                  .adm-channels
                    .adm-channel-row
                      span.adm-channel-name #{snap.buffers.length} buffer(s)
                - if (snap.caps.length > 0)
                  .adm-network-footer
                    span.adm-net-caps #{snap.caps.length} IRCv3 cap(s)
      - if (uploadCount > 0)
        .adm-card
          h2 Uploads (#{uploadCount})
          .adm-card-body
            - foreach (u; uploads)
              div(style="display:flex; align-items:center; gap:12px; padding:8px 0; border-bottom:1px solid rgba(28,36,48,0.3)")
                - if (u.directUrl.length > 0 && (u.mimeType == "image/png" || u.mimeType == "image/jpeg" || u.mimeType == "image/gif" || u.mimeType == "image/webp"))
                  img(src=u.directUrl, alt=u.filename, style="width:48px; height:48px; object-fit:cover; border-radius:4px; border:1px solid var(--adm-border); flex-shrink:0")
                - else
                  div(style="width:48px; height:48px; border-radius:4px; border:1px solid var(--adm-border); display:flex; align-items:center; justify-content:center; font-size:20px; color:var(--adm-muted); flex-shrink:0") &#x1F4CE;
                div(style="flex:1; min-width:0")
                  div(style="font-size:14px; color:var(--adm-heading); overflow:hidden; text-overflow:ellipsis; white-space:nowrap") #{u.filename}
                  div(style="font-size:12px; color:var(--adm-muted)") #{u.mimeType} &middot; #{u.size > 1048576 ? (u.size / 1048576).to!string ~ " MB" : u.size > 1024 ? (u.size / 1024).to!string ~ " KB" : u.size.to!string ~ " B"}
                  - if (u.buffer.length > 0)
                    div(style="font-size:11px; color:var(--adm-muted)") ##{u.buffer}
                div(style="display:flex; gap:6px; flex-shrink:0")
                  - if (u.directUrl.length > 0)
                    a.adm-btn.adm-btn-sm(href=u.directUrl, target="_blank", style="text-decoration:none") View
            div(style="text-align:right; padding-top:12px")
              a.adm-link(href="/admin/uploads") View all uploads →
      .adm-card
        h2 IP Addresses
        .adm-card-body
          .adm-field
            label Signup IP
            .value #{user.signupIp.length > 0 ? user.signupIp : "--"}
          .adm-field
            label Signup Date
            .value #{user.createdAt.toUnixTime() > 0 ? user.createdAt.toSimpleString() : "--"}
          .adm-field
            label Last Login IP
            .value #{user.lastLoginIp.length > 0 ? user.lastLoginIp : "--"}
          .adm-field
            label Last Login Date
            .value #{user.lastLoginAt.toUnixTime() > 0 ? user.lastLoginAt.toSimpleString() : "--"}
          - if (user.loginIps.length > 0)
            .adm-field
              label All Login IPs (#{user.loginIps.length})
              .value
                - foreach (ip; user.loginIps)
                  div(style="font-family:monospace; font-size:13px; margin:2px 0") #{ip}
      .adm-card
        h2 Reset Password
        .adm-card-body
          form(method="POST", action="/admin/users/#{user.id}/reset-password")
            .adm-form-group
              label New Password
              input.adm-input(type="password", name="password", placeholder="Enter new password…", required)
            button.adm-btn-primary(type="submit") Reset Password
