    /// W1-T01 (plan R1): substring-keyed map from disconnect reason
    /// text to structured (type, reason). Keys are matched
    /// case-insensitively against the disconnect reason. Order
    /// matters — more-specific entries must come before general
    /// ones (e.g. `"ssl_certificate_error"` before `"ssl_error"`).
    ///
    /// Each entry maps to one of the IRCCloud-style failInfo
    /// categories:
    ///   "connecting_failed" — the common case (DNS/TCP/TLS handshake)
    ///   "killed"            — server actively disconnected us
    private static immutable struct ReasonMapEntry {
        string substring;
        string type_;
        string reason;
    }
    private static immutable ReasonMapEntry[] reasonMap = [
        { "ssl_certificate_error",  "connecting_failed", "ssl_certificate_error" },
        { "ssl_verify_error",       "connecting_failed", "ssl_certificate_error" },
        { "ssl_error",              "connecting_failed", "ssl_error"             },
        { "nxdomain",               "connecting_failed", "nxdomain"              },
        { "econnrefused",           "connecting_failed", "econnrefused"          },
        { "etimedout",              "connecting_failed", "etimedout"             },
        { "timeout",                "connecting_failed", "etimedout"             },
        { "pool_lost",              "connecting_failed", "pool_lost"             },
        { "enetdown",               "connecting_failed", "enetdown"              },
        { "ehostunreach",           "connecting_failed", "ehostunreach"          },
        { "crash",                  "connecting_failed", "crash"                 },
        { "tls_read_error_post_001","connecting_failed", "ssl_error"             },
        { "welcome_timeout",        "connecting_failed", "etimedout"             },
        // Ban family — ZLINE/GLINE/KLINE/ELINE. Must come before the
        // generic "banned" catch so the specific ban type is preserved.
        // The frontend renders these as `connection_blocked` ("Connections
        // to this server have been blocked") which is the correct UX for
        // a ban: no countdown spin, just a clear blocked headline until
        // the ban expires or the user changes nick/IP.
        { "z-lined",                "connection_blocked", "zlined"               },
        { "z:lined",                "connection_blocked", "zlined"               },
        { "zline",                  "connection_blocked", "zlined"               },
        { "enter the void",         "connection_blocked", "zlined"               },
        { "g-lined",                "connection_blocked", "glined"               },
        { "g:lined",                "connection_blocked", "glined"               },
        { "gline",                  "connection_blocked", "glined"               },
        { "k-lined",                "connection_blocked", "klined"               },
        { "k:lined",                "connection_blocked", "klined"               },
        { "kline",                  "connection_blocked", "klined"               },
        { "e-lined",                "connection_blocked", "elined"               },
        { "eline",                  "connection_blocked", "elined"               },
        // Killed family — server actively disconnected us. The exact
        // reason key on the wire is "killed" so the frontend's
        // renderReasons.ts table can dispatch cleanly.
        { "killed",                 "killed",            "killed"                },
        // W1-T01-rev1: lowercase the three mixed-case entries that the
        // review flagged as dead mappings. The parser lowercases the
        // incoming reason (see parseReasonToFailInfo below) so these
        // substrings must also be lowercase to ever match. Mixed-case
        // form would have fallen through to the catch-all
        // "connecting_failed" branch in the previous commit.
        { "overridden",             "killed",            "killed"                },
        { "err_nicknameinuse",      "killed",            "killed"                },
        { "connection closed",      "connecting_failed", "closed"                },
    ];

    /// W1-T01: build a FailInfo from a disconnect reason text + the
    /// engine's lastErrorText (used for SSL verification detail).
    /// Substring matching is case-insensitive. When no keyword matches
    /// the defaults are `type="connecting_failed"`, `reason=<unchanged>`
    /// so unknown reasons still reach the frontend's renderReasons.ts
    /// table and render as the raw reason string (per plan TG1: unknown
    /// reasons pass through unchanged).
    package(ircfiber) FailInfo parseReasonToFailInfo(string reason, string lastErrorText) const {
        FailInfo info;
        if (reason.length == 0) {
            // Defensive: empty reason yields a generic connecting_failed
            // with a synthetic key so the frontend renders SOMETHING
            // (raw reason = "" would render as empty, which is worse).
            info.type_ = "connecting_failed";
            info.reason = "connection_lost";
            return info;
        }
        auto lower = toLower(reason);
        foreach (entry; reasonMap) {
            if (lower.canFind(entry.substring)) {
                info.type_ = entry.type_;
                info.reason = entry.reason;
                break;
            }
        }
        if (info.type_.length == 0) {
            // No keyword matched — emit as connecting_failed with the
            // raw reason so the frontend's renderReasons.ts table can
            // still look it up. Falls through to renderReason(reason)
            // which returns the input unchanged for unknown keys (the
            // "disconnect: {reason}" branch).
            info.type_ = "connecting_failed";
            info.reason = reason;
        }
        // For `type_=="killed"`, capture the kill description
        // (parenthesised fragment or full reason) into killedReason
        // so the Wave 3 banner renders "Disconnected - Killed: X".
        if (info.type_ == "killed") {
            auto parenStart = reason.indexOf('(');
            if (parenStart > 0 && reason.canFind(')')) {
                info.killedReason = reason[parenStart .. $].strip();
            } else {
                info.killedReason = reason;
            }
        }
        // For SSL verification errors, populate the nested
        // sslVerifyError object so the frontend's renderSSLVerify can
        // look up the human string. v1 does a best-effort extraction:
        // if lastErrorText contains a "(type, error)" pair we split
        // it; otherwise we use the full lastErrorText as the "error"
        // with a generic "bad_cert" type so the frontend renders
        // "bad_cert: <lastErrorText>" which is at least informative.
        if (info.reason == "ssl_certificate_error" && lastErrorText.length > 0) {
            // Best-effort: look for the vibe.d TLS error pattern
            // "certificate verify failed: <detail>". Anything inside
            // the first "(" is the structured (type, error) detail.
            string detail = lastErrorText;
            auto parenOpen = lastErrorText.indexOf('(');
            auto parenClose = lastErrorText.lastIndexOf(')');
            if (parenOpen >= 0 && parenClose > parenOpen) {
                detail = lastErrorText[parenOpen + 1 .. parenClose].strip();
            }
            // detail is typically "type: error" or just "error".
            string sslType  = "bad_cert";
            string sslError = detail;
            auto colon = detail.indexOf(':');
            if (colon > 0 && colon + 1 < detail.length) {
                sslType  = detail[0 .. colon].strip();
                sslError = detail[colon + 1 .. $].strip();
            }
            setSSLVerify(info, sslType, sslError);
        }
        return info;
    }

    private string buildFailureSummary(string[] reasons) {
        if (reasons.length == 0) return "";
        string[] parts;
        string current;
        int count;
        foreach (r; reasons) {
            if (r == current) {
                count++;
            } else {
                if (current.length > 0)
                    parts ~= current ~ (count > 1 ? " (x" ~ count.to!string ~ ")" : "");
                current = r;
                count   = 1;
            }
        }
        if (current.length > 0)
            parts ~= current ~ (count > 1 ? " (x" ~ count.to!string ~ ")" : "");
        return parts.join(", ");
    }

    // ── Public API ────────────────────────────────────────────────────────────

    /// Sends a raw IRC line. `fromClient` marks a line a client typed or
    /// sent (the `raw` command), whose WHO replies are published to it.
    void sendRaw(string line, bool fromClient = false) {
        sendRawAdmitted(line, fromClient);
    }

    private void sendRawAdmitted(string line, bool fromClient,
            BncCommandOwner owner = BncCommandOwner.init, string wireLabel = "",
            string expectedEpoch = "", string[string] clientTags = null) {
        const owned = owner.request.length != 0;
        bool attemptedOwnedWrite;
        scope (exit) if (owned && !attemptedOwnedWrite)
            bncState().reject(owner, "COMMAND_REJECTED", "Upstream command was rejected", wireLabel, expectedEpoch);
        if (owned && !preflightBncWrite(owner, wireLabel, expectedEpoch)) {
            attemptedOwnedWrite = true;
            return;
        }
        // Reserved FIBERMLS control never takes the generic paths below
        // (outbound queue across reconnects, optimistic bookkeeping): only a
        // well-formed private QUERY leaves, through its own paced queue.
        if (carriesFiberMls(line)) {
            if (owned) return;
            submitFiberProbe(line);
            return;
        }
        if (!admitServiceLine(line)) return;
        // A NickServ auth command leaving now (manual, alias, bouncer,
        // automatic IDENTIFY/GHOST) is remembered until its verdict.
        if (state == ConnectionState.connected || (state == ConnectionState.connecting && transportAlive)) {
            if (!gateLegacyAuth(() { services.noteManualLine(line); })) return;
        }
        if (fromClient && line.length > 6 && line[0 .. 6].toUpper() == "WHOIS ") {
            auto args = line[6 .. $].strip();
            const sp = args.lastIndexOf(' ');
            services.noteClientWhois(sp < 0 ? args : args[sp + 1 .. $]);
        }
        // Track own away status
        if (line == "AWAY" || line == "away") {
            isAway = false;
            awayMessage = "";
        } else if (line.startsWith("AWAY :") || line.startsWith("away :")) {
            isAway = true;
            awayMessage = line[6 .. $].strip();
        }
        // Optimistic nick update — prevent sync from clobbering the UI
        // before the server echoes back the NICK response. Save the
        // previous sessionNick so the NICK handler can correlate the
        // server's echo back to us even after this optimistic change.
        if (line.startsWith("NICK ") || line.startsWith("nick ")) {
            const newNick = line[5 .. $].strip();
            if (newNick.length > 0) {
                optimisticNickOld = sessionNick;
                sessionNick = newNick;
            }
        }
        // /LIST from any client path (web slash command, bouncer client, /raw).
        import std.uni : icmp;
        if (line.length >= 4 && icmp(line[0 .. 4], "LIST") == 0
            && (line.length == 4 || line[4] == ' ')) {
            // Owned query output is streamed privately, never folded into shared LIST chunks.
            if (!owned) beginChannelList(line.length > 5 ? line[5 .. $].strip() : "");
        }
        // Remember what we asked to join. Every JOIN — auto-join burst, a
        // sidebar click, /raw, a bouncer client — funnels through here, so
        // this is the one place that knows the target set the JOIN-throttle
        // retry has to re-send (421 names the command, never the channel).
        if (line.length >= 5 && icmp(line[0 .. 5], "JOIN ") == 0) {
            recordPendingJoins(line[5 .. $]);
        }
        // Every WHO — the engine's sweep and a client's own — funnels
        // through here too, in the order the server will answer them.
        if (line.length >= 4 && icmp(line[0 .. 4], "WHO ") == 0) {
            if (!owned) trackWho(line, fromClient);
        }
        if (owned) {
            attemptedOwnedWrite = true;
            bncState().writeOwned(tagPrefix("", clientTags) ~ line, owner, unixMsNow(), expectedEpoch, wireLabel);
            return;
        }
        if (state == ConnectionState.disconnected ||
            (state == ConnectionState.connecting && !transportAlive)) {
            if (outboundQueue.length < MAX_OUTBOUND_QUEUE) outboundQueue ~= line;
            return;
        }
        writeRaw(line);
    }

    /// Sends a PRIVMSG to a target, with optional client tags.
    void sendMessage(string target, string text, string[string] tags = null) {
        sendUserMessage("PRIVMSG", target, text, "", tags);
    }

    /// Sends a labeled PRIVMSG when labeled-response cap is active.
    /// The label is echoed back by the server on the echo-message, so
    /// correlation in `processLine()` can suppress the duplicate.
    void sendLabeledMessage(string target, string text, string label,
                            string[string] tags = null) {
        sendUserMessage("PRIVMSG", target, text, label, tags);
    }

    /// The `@tags ` prefix of an outgoing line: the label when the server
    /// negotiated labeled-response, plus every client tag the user
    /// attached when it negotiated message-tags, values escaped per the
    /// message-tags specification. Empty when there is nothing to send.
    private string tagPrefix(string label, const string[string] tags) {
        import ircfiber.irc.parser : escapeTagValue;
        string[] parts;
        if (label.length) parts ~= "label=" ~ label;
        if (tags.length && hasCap("message-tags")) {
            foreach (k, v; tags) parts ~= k ~ "=" ~ escapeTagValue(v);
        }
        return parts.length ? "@" ~ parts.join(";") ~ " " : "";
    }

    /// One logical user message → protocol lines on the wire.
    ///
    /// `text` may contain newlines and may exceed one line: this is the
    /// single place that decides how a message becomes IRC traffic.
    ///
    ///  1. CR/LF/NUL are stripped from every logical line, so a message body
    ///     can never inject a second command.
    ///  2. Lines are split to the server's real byte budget (ISUPPORT
    ///     `LINELEN` minus our own `nick!user@host` and the command
    ///     framing), never mid-code-point.
    ///  3. When the server negotiated `draft/multiline` and the whole
    ///     message fits its advertised `max-lines`/`max-bytes` (and the
    ///     channel's `+f` line ceiling), it goes out as ONE batch: the
    ///     server then treats it as a single message for flood purposes, so
    ///     it cannot trip `+f` or target-flood. A batch must be written
    ///     contiguously — `set::multiline::batch-timeout` aborts a slow one
    ///     — so it is admitted as a unit or not at all.
    ///  4. Otherwise the lines are queued behind the fake-lag pacer.
    private void sendUserMessage(string command, string target, string text,
                                 string label, string[string] tags = null,
                                 BncCommandOwner owner = BncCommandOwner.init,
                                 string wireLabel = "", string expectedEpoch = "") {
        const owned = owner.request.length != 0;
        bool attemptedOwnedWrite;
        scope (exit) if (owned && !attemptedOwnedWrite)
            bncState().reject(owner, "COMMAND_REJECTED", "Upstream command was rejected", wireLabel, expectedEpoch);
        if (owned && !preflightBncWrite(owner, wireLabel, expectedEpoch)) {
            attemptedOwnedWrite = true;
            return;
        }
        if (!target.length) return;
        foreach (character; target) if (character <= ' ' || character == '\x7f') return;
        // Reserved FIBERMLS discovery is never chat: no split, batch, label,
        // pacer queue or synthetic echo. An untagged PRIVMSG goes through the
        // same validated, per-recipient probe queue as a raw line; anything
        // else carrying the reserved command anywhere is dropped.
        if (carriesFiberMls(text)) {
            if (owned) return;
            if (command == "PRIVMSG" && tags.length == 0)
                submitFiberProbe("PRIVMSG " ~ target ~ " :" ~ text);
            return;
        }
        if (!admitServiceMessage(target, text)) return;
        if (command == "PRIVMSG" && !gateLegacyAuth(() { services.noteManualMessage(target, text); })) return;
        // A services credential or private memo is never echoed into chat
        // history by us; the server's own echo is intercepted on arrival.
        const sensitive = sensitiveServiceMessage(target, text, effectiveServices());
        const budget = linePayloadBudget(target, command);
        bool[] concat;
        auto lines = splitMessage(text, budget, concat);
        if (lines.length == 0) return;
        // A single empty line is only meaningful inside a multiline batch;
        // as a bare PRIVMSG it is an error on most servers.
        if (lines.length == 1 && lines[0].length == 0) return;

        const bool labeled = label.length > 0 && hasCap("labeled-response");
        if (label.length > 0)
            pendingLabels[label] = Clock.currTime.toUnixTime!long * 1000;

        const prefix = tagPrefix(labeled ? label : "", tags);
        const multiline = lines.length > 1
            ? tryMultilineBatch(command, target, lines, concat, prefix, owner, wireLabel, expectedEpoch)
            : MultilineAdmission.fallback;
        if (multiline == MultilineAdmission.rejected) {
            attemptedOwnedWrite = true;
            return;
        }
        if (multiline == MultilineAdmission.fallback) {
            string[] childLabels;
            if (owned) {
                size_t count;
                foreach (line; lines) if (line.length) ++count;
                if (pacedQueue.length + count > MAX_PACED_QUEUE) return;
                childLabels = new string[count];
                if (count == 1) childLabels[0] = wireLabel;
                else foreach (ref childLabel; childLabels) childLabel = "bnc-" ~ randomUUID().toString();
                if (count > 1 && !bncState().prepareOwnedGroup(owner, wireLabel, childLabels, expectedEpoch, unixMsNow())) {
                    attemptedOwnedWrite = true;
                    return;
                }
            }
            size_t child;
            foreach (i, line; lines) {
                if (!line.length) continue;
                const wire = (i == 0 || owned ? prefix : "") ~ command ~ " " ~ target ~ " :" ~ line;
                if (owned) enqueuePaced(wire, owner, expectedEpoch, childLabels[child++]);
                else enqueuePaced(wire);
            }
        }
        attemptedOwnedWrite = owned;

        if (!hasCap("echo-message") && !sensitive) {
            foreach (i, line; lines) {
                if (line.length == 0) continue;
                emitSyntheticSelfMessage(target, line, command,
                                         (label.length > 0 && i == 0) ? label : "");
            }
        }
    }

    private enum MultilineAdmission { fallback, sent, rejected }

    /// A refused write is distinct from an unsupported batch: never replay a partial batch.
    private MultilineAdmission tryMultilineBatch(string command, string target,
            string[] lines, bool[] concat, string prefix,
            BncCommandOwner owner = BncCommandOwner.init, string wireLabel = "", string expectedEpoch = "") {
        const ml = multilineLimits();
        if (!ml.usable()) return MultilineAdmission.fallback;
        if (state != ConnectionState.connected) return MultilineAdmission.fallback;

        // UnrealIRCd also clamps a batch to the channel's +f 'm'/'t' limit.
        int maxLines = ml.maxLines;
        auto floodLim = floodLimitFor(target);
        if (floodLim.valid() && (maxLines == 0 || floodLim.lines < maxLines))
            maxLines = floodLim.lines;
        if (maxLines > 0 && lines.length > maxLines) return MultilineAdmission.fallback;
        if (multilineByteCount(lines, concat) > cast(size_t)ml.maxBytes) return MultilineAdmission.fallback;

        // Anything already queued must go first, or the paste would arrive
        // out of order.
        if (pacedQueue.length > 0) return MultilineAdmission.fallback;

        const now = unixMsNow();
        if (!pacer.canStartBatch(now)) return MultilineAdmission.fallback;

        const ref_ = nextBatchRef();
        // The whole batch is one fake-lag lump, so the per-write charge in
        // writeRaw must stand down for its duration.
        chargeSuppressed = true;
        scope (exit) chargeSuppressed = false;
        try {
            auto open = "BATCH +" ~ ref_ ~ " draft/multiline " ~ target;
            if (owner.request.length) {
                if (!bncState().writeOwned(prefix ~ open, owner, now, expectedEpoch, wireLabel).length)
                    return MultilineAdmission.rejected;
            } else writeRaw(prefix ~ open);
            foreach (i, line; lines) {
                const bool isConcat = i < concat.length && concat[i];
                auto tags = isConcat
                    ? "@batch=" ~ ref_ ~ ";draft/multiline-concat "
                    : "@batch=" ~ ref_ ~ " ";
                writeRaw(tags ~ command ~ " " ~ target ~ " :" ~ line);
            }
            writeRaw("BATCH -" ~ ref_);
        } catch (Exception e) {
            logInfo("Multiline batch write failed for %s: %s", config.name, e.msg);
            if (owner.request.length)
                bncState().reject(owner, "UPSTREAM_UNAVAILABLE", "No connected upstream", wireLabel, expectedEpoch);
            return MultilineAdmission.rejected;
        }
        // The server charges the whole batch one clamped lump when it closes.
        pacer.chargeBatch(lines, now);
        lastPacedWriteMs = now;
        logJsonMap("debug", "connection",
            "Sent multiline batch",
            ["network":   config.name,
             "networkId": config.id.toString(),
             "target":    target,
             "lines":     lines.length.to!string,
             "bytes":     multilineByteCount(lines, concat).to!string,
             "event":     "multiline_batch_sent"]);
        recordCounter("ircfiber.multiline.batch", 1, ["network": config.name]);
        return MultilineAdmission.sent;
    }

    /// Batch reference tags must be unique per connection.
    private string nextBatchRef() {
        return "f" ~ (++batchSeq).to!string;
    }

    /// Whether the server advertised MONITOR support (ISUPPORT token).
    bool monitorSupported() {
        auto value = "MONITOR" in isupportMap;
        if (value is null) return false;
        if (!value.length) return true;
        bool positive;
        foreach (character; *value) {
            if (character < '0' || character > '9') return false;
            positive = positive || character != '0';
        }
        return positive;
    }

    /// ISUPPORT `MONITOR=<n>` — the most targets one list may hold; 0 when
    /// the server gives no number.
    private size_t monitorLimit() {
        if (auto v = "MONITOR" in isupportMap) {
            try {
                const n = (*v).to!long;
                if (n > 0) return cast(size_t) n;
            } catch (Exception) {}
        }
        return 0;
    }

    /// Sends a MONITOR command (IRCv3 monitor: + add, - remove,
    /// C clear, L list, S status query). Silent no-op when the server
    /// did not advertise MONITOR or the verb is invalid.
    void sendMonitor(string verb, string targets = "") {
        if (!monitorSupported()) return;
        auto line = buildMonitorLine(verb, targets);
        if (line is null) return;
        sendRaw(line);
    }

    /// Pushes a read marker upstream (`MARKREAD <target> timestamp=<iso>`)
    /// when draft/read-marker is negotiated on a live connection; the
    /// server keeps it only if it is newer than what it has.
    void sendMarkRead(string target, long timestampMs) {
        import ircfiber.irc.chathistory : isoTimestampMs;
        import std.algorithm.searching : any;
        if (target.length == 0 || timestampMs <= 0) return;
        // One IRC param: a space, CR, LF or NUL would inject a second command.
        if (target.any!(c => c == ' ' || c == '\r' || c == '\n' || c == '\0')) return;
        if (state != ConnectionState.connected || !hasCap("draft/read-marker")) return;
        sendRaw("MARKREAD " ~ target ~ " timestamp=" ~ isoTimestampMs(timestampMs));
    }

    /// Sends a labeled NOTICE when labeled-response cap is active.
    void sendLabeledNotice(string target, string text, string label) {
        sendUserMessage("NOTICE", target, text, label);
    }

    /// Emit a synthetic self-message event when the IRC server does not
    /// support echo-message. Without this, messages sent by the user are
    /// never persisted or replayed after refresh, because the server never
    /// echoes them back to us.
    private void emitSyntheticSelfMessage(string target, string text,
                                          string command, string label = "") {
        auto event = IRCRawEvent(config.name, command);
        event.networkId = config.id.toString();
        event.nick = sessionNick;
        event.prefix = sessionNick ~ "!~" ~ sessionNick ~ "@" ~ config.host;
        event.hostmask = "~" ~ sessionNick ~ "@" ~ config.host;
        event.text = text;
        event.setParams([target, text]);
        event.channel = target;
        event.addTag("self_echo", "true");
        event.addTag("synthetic", "true");
        if (label.length > 0) {
            event.addTag("label", label);
        }
        eventChannel.put(event);
    }

    /// Checks if a label is pending (awaiting echo from server).
    bool isPendingLabel(string label) const {
        return (label in pendingLabels) !is null;
    }

    /// Clears a pending label and returns true if it was found.
    bool clearPendingLabel(string label) {
        if (auto p = label in pendingLabels) {
            pendingLabels.remove(label);
            return true;
        }
        return false;
    }

    /// Drops pending labels older than `maxAgeMs` to bound the map's
    /// growth when the server never echoes (e.g. partial disconnect).
    void expireStalePendingLabels(long maxAgeMs = 30_000) {
        const now = Clock.currTime.toUnixTime!long * 1000;
        string[] stale;
        foreach (label, sentAt; pendingLabels) {
            if (now - sentAt > maxAgeMs) stale ~= label;
        }
        foreach (l; stale) pendingLabels.remove(l);
    }

    /// Records the latest/earliest msgid we've observed for a channel
    /// so CHATHISTORY pagination knows where to fetch next. Channel key
    /// is lowercased to match the rest of the codebase's conventions.
    void recordChannelMsgid(string channel, string msgid, long tsMs) {
        if (channel.length == 0 || msgid.length == 0) return;
        import std.uni : toLower;
        auto key = toLower(channel);
        // Msgids are opaque (no ordering); the server-time decides, and a
        // cursor moves only when the timestamp strictly does.
        if (key !in channelLatestMsgid || tsMs > channelLatestTs.get(key, long.min)) {
            channelLatestMsgid[key] = msgid;
            channelLatestTs[key] = tsMs;
        }
        if (key !in channelEarliestMsgid || tsMs < channelEarliestTs.get(key, long.max)) {
            channelEarliestMsgid[key] = msgid;
            channelEarliestTs[key] = tsMs;
        }
    }

    /// `msgid=<id>` / bare `<id>` (or a comma pair of them) rewritten as
    /// `timestamp=<iso>` when `<id>` is a cursor we recorded for `key`;
    /// anything else passes through untouched.
    private string msgidRefAsTimestamp(string key, string refMsgid) {
        import ircfiber.irc.chathistory : isoTimestampMs;
        alias iso = isoTimestampMs;
        string one(string r) {
            if (r.length == 0 || r == "*" || r.startsWith("timestamp=")) return r;
            const id = r.startsWith("msgid=") ? r["msgid=".length .. $] : r;
            if (channelLatestMsgid.get(key, "") == id)
                if (auto t = key in channelLatestTs) return "timestamp=" ~ iso(*t);
            if (channelEarliestMsgid.get(key, "") == id)
                if (auto t = key in channelEarliestTs) return "timestamp=" ~ iso(*t);
            return r;
        }
        const comma = refMsgid.indexOf(",");
        if (comma >= 0) return one(refMsgid[0 .. comma]) ~ "," ~ one(refMsgid[comma + 1 .. $]);
        return one(refMsgid);
    }

    /// Returns the latest msgid we've seen for the channel, or "" if none.
    string getLatestMsgid(string channel) const {
        if (channel.length == 0) return "";
        import std.uni : toLower;
        auto key = toLower(channel);
        return channelLatestMsgid.get(key, "");
    }

    /// Returns the earliest msgid we've seen for the channel, or "" if none.
    string getEarliestMsgid(string channel) const {
        if (channel.length == 0) return "";
        import std.uni : toLower;
        auto key = toLower(channel);
        return channelEarliestMsgid.get(key, "");
    }


    /// Sends a JOIN command. Ensures leading `#` so bare names like `testing`
    /// never become a PRIVMSG target (auto-join normalization defense).
    void joinChannel(string channel) {
        channel = channel.strip();
        if (channel.length > 0 && channel[0] != '#' && channel[0] != '&' && channel[0] != '+' && channel[0] != '!')
            channel = "#" ~ channel;
        if (channel.length > 0) channel = channel[0 .. 1] ~ channel[1 .. $].toLower();
        sendRaw("JOIN " ~ channel);
    }

    /// Sends a PART command.
    void partChannel(string channel, string reason = "") {
        if (reason.length > 0) sendRaw("PART " ~ channel ~ " :" ~ reason);
        else                    sendRaw("PART " ~ channel);
    }
}

@("server autojoin during registration retains its complete roster")
unittest {
    import vibe.core.net : listenTCP;

    // An IRCd can force-join its default channel before MOTD ends, or
    // append that JOIN/NAMES burst to the same read as 376. Joining the
    // channel again later produces no echo or NAMES: we are already in it.
    foreach (motdFirst; [false, true]) {
        const motd = ":s 376 me :End of MOTD\r\n";
        const names = ":me!u@h JOIN #autojoin\r\n"
            ~ ":s 353 me = #autojoin :@me alice\r\n"
            ~ ":s 353 me = #autojoin :+bob\r\n"
            ~ ":s 366 me #autojoin :End of NAMES\r\n";
        const wire = ":s 001 me :Welcome\r\n"
            ~ (motdFirst ? motd ~ names : names ~ motd);
        auto listener = listenTCP(0, (TCPConnection peer) {
            peer.write(wire);
            peer.flush();
        }, "127.0.0.1");
        scope(exit) listener.stopListening();
        auto ch = EngineEventChannel.create();
        scope(exit) ch.close();
        NetworkConfig cfg;
        cfg.nick = "me";
        auto c = new PersistentIRCClient(cfg, ch);
        c.connection = connectTCP("127.0.0.1", listener.bindAddress.port);
        scope(exit) c.connection.close();
        c.performRegistration();
        const roster = c.getChannelUsers().get("#autojoin", null);
        assert(roster.length == 3, "registration must consume the whole NAMES burst");
        // Our own entry may carry the JOIN echo's `!u@h` (kept across the
        // bare NAMES burst for peer identity checks); status still `@`.
        assert(roster.canFind!(e => nickPrefix(e) == "@" && stripNickPrefix(e) == "me")
            && roster.canFind("alice") && roster.canFind("+bob"),
            "self, ordinary and voiced members survive registration");
    }
}

@("isServerPrefix recognizes a bare server hostname even though the parser has nowhere else to put it but `nick`")
unittest {
    // Real traffic that triggered this: `:openwater.supernets.org NOTICE
    // Zodiac :slow down nerd` — parser.d has no "!user@host" to split off,
    // so `event.nick` ends up holding the server hostname itself.
    auto fromServer = IRCRawEvent("Super Nets", "NOTICE");
    fromServer.prefix = "openwater.supernets.org";
    fromServer.nick   = "openwater.supernets.org";
    assert(PersistentIRCClient.isServerPrefix(fromServer));

    auto fromUser = IRCRawEvent("Super Nets", "NOTICE");
    fromUser.prefix = "bob!bob@example.com";
    fromUser.nick   = "bob";
    assert(!PersistentIRCClient.isServerPrefix(fromUser));

    auto fromPseudoClient = IRCRawEvent("Super Nets", "NOTICE");
    fromPseudoClient.prefix = "NickServ";
    fromPseudoClient.nick   = "NickServ";
    assert(!PersistentIRCClient.isServerPrefix(fromPseudoClient),
           "a bare pseudo-client nick with no dot is still a nick, not a server");

    IRCRawEvent synthetic;
    assert(PersistentIRCClient.isServerPrefix(synthetic),
           "no prefix at all (synthetic/local event) still counts as server-sourced");
}

@("a real slow-down NOTICE from a bare server hostname is recognized as a flood complaint")
unittest {
    auto evt = IRCRawEvent("Super Nets", "NOTICE");
    evt.prefix = "openwater.supernets.org";
    evt.nick   = "openwater.supernets.org";
    evt.text   = "slow down nerd";
    assert(PersistentIRCClient.isServerPrefix(evt) && PersistentIRCClient.isFloodNotice(evt.text),
           "this is exactly the notice the pacer must arm on — regression for the nick==hostname bug");
}

@("trusted command immunity is revoked by a complaint without de-opering")
unittest {
    NetworkConfig cfg;
    cfg.nick = "me";
    auto ch = EngineEventChannel.create();
    scope(exit) ch.close();
    auto c = new PersistentIRCClient(cfg, ch);
    c.floodTrusted = true;
    c.trustedRate = CommandRateLimit(10, 1000, 70);
    c.setOperState(true, "test");
    const now = unixMsNow();
    foreach (_; 0 .. 4826) {
        assert(c.cmdBucket.waitMs(now, c.trustedRate, c.pacer.isImmune()) == 0);
        c.cmdBucket.record(now, c.trustedRate, 1, c.pacer.isImmune());
    }
    assert(c.cmdBucket.penaltyPoints() == 0);
    c.onFloodComplaint("test", "slow down");
    assert(c.isOper && !c.pacer.isImmune(),
        "a still-oper connection must not retain a disproved exemption");
    foreach (_; 0 .. 7) {
        assert(c.cmdBucket.waitMs(now, c.trustedRate, c.pacer.isImmune()) == 0);
        c.cmdBucket.record(now, c.trustedRate, 1, c.pacer.isImmune());
    }
    assert(c.cmdBucket.waitMs(now, c.trustedRate, c.pacer.isImmune()) == 1000,
        "after revocation the ordinary bounded rate resumes without exempt debt");
}

@("trusted effective immunity does not bypass an applicable channel flood gate")
unittest {
    NetworkConfig cfg;
    cfg.nick = "me";
    auto ch = EngineEventChannel.create();
    scope(exit) ch.close();
    auto c = new PersistentIRCClient(cfg, ch);
    c.state = ConnectionState.connected;
    c.floodTrusted = true;
    c.trustedRate = CommandRateLimit(10, 1000, 70);
    c.setOperState(true, "test");
    c.chanFloodLimit["#art"] = ChannelLineLimit(1, 5);
    c.chanFloodWindow["#art"] = LineRateWindow.init;
    // A future stamp keeps the cap full independently of test execution time.
    c.chanFloodWindow["#art"].record(long.max / 2);
    c.pacedQueue = [BncPendingWrite("PRIVMSG #art :still gated")];
    c.drainPacedQueue();
    assert(c.pacedQueue.length == 1 && c.linesOut == 0,
        "channel +f must retain the line before it can reach writeRaw");
}

@("SuperNets' flood-complaint numeric 405 (\"slow down nerd\") arms the pacer and keeps #superbowl pending for retry")
unittest {
    NetworkConfig cfg;
    cfg.nick = "Zodiac";
    auto ch = EngineEventChannel.create();
    auto c = new PersistentIRCClient(cfg, ch);
    assert(!c.pacer.isArmed(), "fresh client starts unarmed");
    // The autojoin burst recorded #superbowl as awaiting confirmation —
    // sendRaw is safe to call pre-connect, it just queues the line.
    c.sendRaw("JOIN #superbowl");
    assert(c.joinsAwaitingConfirm == ["#superbowl"], "JOIN must record the pending channel");
    c.processLine(":contra.supernets.org 405 Zodiac #superbowl :\x1F\x0304slow down nerd\x0F");
    assert(c.pacer.isArmed(),
           "a channel-targeted 405 carrying a flood phrase must tighten the pacer");
    // UNKNOWN_USER_LIMITS.penaltyMs=1000 doubled once by tighten() — the
    // retry's wait comes from pacer.waitMs(), which is driven by this
    // exact UnrealIRCd-documented formula, not a hardcoded guess.
    assert(c.pacer.limits().penaltyMs == 2000,
           "one complaint must double the modelled per-command penalty exactly as pacer.d documents");
    // Prod incident 2026-11-02: the old handler unconditionally called
    // clearPendingJoin here, so #superbowl was silently abandoned — 8 of
    // 9 SuperNets auto-join channels landed, this one never did and
    // nothing ever retried it.
    assert(c.joinsAwaitingConfirm == ["#superbowl"],
           "a flood complaint is not a real refusal — #superbowl must stay pending for the retry, not be abandoned");
    assert(c.joinThrottleRetryInFlight,
           "the flood complaint must schedule a bounded retry, mirroring the 421 throttle path");
    ch.close();
}

@("a genuine (non-flood) 405 ERR_TOOMANYCHANNELS still clears the pending join")
unittest {
    NetworkConfig cfg;
    cfg.nick = "Zodiac";
    auto ch = EngineEventChannel.create();
    auto c = new PersistentIRCClient(cfg, ch);
    c.sendRaw("JOIN #toomany");
    assert(c.joinsAwaitingConfirm == ["#toomany"]);
    c.processLine(":irc.example.net 405 Zodiac #toomany :You have joined too many channels");
    assert(!c.pacer.isArmed(), "a genuine ERR_TOOMANYCHANNELS is not a flood signal");
    assert(c.joinsAwaitingConfirm.length == 0,
           "a real refusal must still be cleared — waiting will not fix it");
    assert(!c.joinThrottleRetryInFlight, "no retry for a channel that was genuinely refused");
    ch.close();
}

@("scheduleJoinConfirmSweep arms once per auto-join burst and does not double-arm")
unittest {
    NetworkConfig cfg;
    cfg.nick = "Zodiac";
    auto ch = EngineEventChannel.create();
    auto c = new PersistentIRCClient(cfg, ch);
    // Prod incident 2026-11-03: #superbowl got no JOIN echo and no
    // numeric at all on two separate SuperNets reconnects — neither the
    // 421 throttle retry nor the 405 flood retry ever fires without one
    // of those replies, so the channel sat in joinsAwaitingConfirm
    // forever with isJoined still true and a frozen roster. The sweep is
    // the only thing that notices a reply that never arrives.
    c.sendRaw("JOIN #superbowl");
    assert(c.joinsAwaitingConfirm == ["#superbowl"]);
    assert(!c.joinConfirmSweepArmed, "fresh client starts unarmed");
    c.scheduleJoinConfirmSweep();
    assert(c.joinConfirmSweepArmed, "the sweep must arm for the pending channel");
    // A second auto-join burst in the same registration (batched JOINs
    // span more than one line) must not stack a second sweep task.
    c.scheduleJoinConfirmSweep();
    assert(c.joinConfirmSweepArmed, "double-arm is a no-op, not a crash");
    ch.close();
}

@("flood retry wait comes from the pacer's modelled minIntervalMs, not a naive penaltyMs read")
unittest {
    NetworkConfig cfg;
    cfg.nick = "Zodiac";
    auto ch = EngineEventChannel.create();
    auto c = new PersistentIRCClient(cfg, ch);
    // Three complaints: penaltyMs doubles to its own 8s ceiling while
    // minIntervalMs doubles to its OWN, separate 4s ceiling — pacer.d's
    // two independently-capped formulas. A naive "wait penaltyMs" read
    // (the pre-fix code) would wait 8s here; the real modelled wait
    // (what pacer.waitMs() returns, and what scheduleFloodJoinRetry now
    // asks for) is 4s, because minIntervalMs — not penaltyMs — is the
    // quantity that actually gates the next send.
    const now = 1_000_000L;
    c.pacer.tighten(now);
    c.pacer.tighten(now);
    c.pacer.tighten(now);
    assert(c.pacer.limits().penaltyMs == 8000, "penaltyMs doubles to its 8s ceiling after 3 complaints");
    assert(c.pacer.waitMs(100, now) == 4000,
           "the real gate is minIntervalMs's separate 4s ceiling — a naive penaltyMs read would wait twice as long as the server actually requires");
}


@("webircSwapSuppressed skips recently Z-lined addresses only")
unittest {
    assert(webircSuppressKey("irc.ircfiber.com", "1.2.3.4") == "irc.ircfiber.com|1.2.3.4");
    assert(!webircSwapSuppressed("irc.ircfiber.com", "9.9.9.9"),
           "an address never recorded is never suppressed");
    assert(!webircSwapSuppressed("", "1.2.3.4") && !webircSwapSuppressed("irc.ircfiber.com", ""));
    suppressWebircSwapFor("irc.ircfiber.com", "1.2.3.4");
    assert(webircSwapSuppressed("irc.ircfiber.com", "1.2.3.4"));
    assert(!webircSwapSuppressed("irc.ircfiber.com", "1.2.3.5"),
           "suppression is per-address");
    assert(!webircSwapSuppressed("irc.example.org", "1.2.3.4"),
           "suppression is per-host");
    suppressWebircSwapFor("irc.ircfiber.com", "5.6.7.8", 0);
    assert(!webircSwapSuppressed("irc.ircfiber.com", "5.6.7.8"),
           "a zero-duration record is already lapsed");
    suppressWebircSwapFor("", "");
    assert(!webircSwapSuppressed("irc.ircfiber.com", "9.9.9.9"),
           "empty records change nothing");
}

@("a DM follows its partner's NICK, never a stranger holding the nick")
unittest {
    import std.typecons : tuple;

    // Feeds raw lines to a fresh client nicked `me`; returns it with the
    // last channel-less (base) NICK event it emitted.
    static auto run(string[] lines) {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto c = new PersistentIRCClient(cfg, ch);
        foreach (l; lines) c.processLine(l);
        ch.close(); // an open, empty channel blocks tryConsumeOne
        IRCRawEvent nick, e;
        while (ch.tryConsumeOne(e))
            if (e.command == "NICK" && e.channel.length == 0) nick = e;
        return tuple(c, nick);
    }

    // The partner renames (same user@host): the DM and its history follow.
    auto partner = run([":bob!~b@h1.IP PRIVMSG me :hi", ":bob!~b@h1.IP NICK :robert"]);
    assert(partner[0].getQueryBuffers() == ["robert"]);
    assert(partner[1].getTag("query_follow") == "true");

    // Someone else holding the nick renames away (the p34c3 -> pizza`
    // report): the DM stays, and nothing downstream is told to move it.
    auto stranger = run([":p34c3!~user@788114F4.IP PRIVMSG me :whats up",
                         ":p34c3!~stillfree@B6A09300.IP NICK :pizza`"]);
    assert(stranger[0].getQueryBuffers() == ["p34c3"]);
    assert(stranger[1].getTag("query_follow") == "");

    // The services account decides when both sides carry one, and the
    // identity moves with the nick, so a second rename follows too.
    auto chain = run(["@account=p34c3 :p34c3!~user@1.IP PRIVMSG me :yo",
                      "@account=p34c3 :p34c3!~user@1.IP NICK :smirn0ff",
                      "@account=p34c3 :smirn0ff!~user@1.IP NICK :sm1rn0ff"]);
    assert(chain[0].getQueryBuffers() == ["sm1rn0ff"]);
    assert(chain[1].getTag("query_follow") == "true");

    // Only our own outgoing DMs: nobody's identity is known, so no follow.
    auto outgoing = run([":me!~me@h0.IP PRIVMSG carol :hello", ":carol!~c@h3.IP NICK :caroline"]);
    assert(outgoing[0].getQueryBuffers() == ["carol"]);
    assert(outgoing[1].getTag("query_follow") == "");
}

@("membership flap guard: churn is live, a storm is coalesced, downstream converges on the roster")
unittest {
    import std.algorithm : count, filter;
    import std.array : array;
    import std.conv : text;
    import std.typecons : tuple;

    // Feeds raw lines to a fresh client nicked `me`; `settle` then runs the
    // sweep as if the storm went quiet long ago. Returns the client and
    // every event it emitted, in order.
    static auto run(string[] lines, bool settle = false) {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto c = new PersistentIRCClient(cfg, ch);
        foreach (l; lines) c.processLine(l);
        if (settle) c.settleMemberFlaps(unixMsNow() + MEMBER_FLAP_MAX_HOLD_MS);
        ch.close(); // an open, empty channel blocks tryConsumeOne
        IRCRawEvent[] got;
        IRCRawEvent e;
        while (ch.tryConsumeOne(e)) got ~= e;
        return tuple(c, got);
    }
    static size_t n(IRCRawEvent[] evs, string command, string chan = null) {
        return evs.count!(e => e.command == command && (chan is null || e.channel == chan));
    }
    static bool inRoster(PersistentIRCClient c, string chan, string nick) {
        return c.getChannelUsers().get(chan, null).canFind!(u => stripNickPrefix(u) == nick);
    }
    // The 2026-10-31 shape: a client looping JOIN #support, JOIN #ircfiber,
    // QUIT — every echo with its own msgid.
    static string[] storm(int cycles) {
        string[] lines;
        foreach (i; 0 .. cycles) {
            const id = i.text;
            lines ~= "@msgid=s" ~ id ~ " :BoLiCy!u@h JOIN #support";
            lines ~= "@msgid=i" ~ id ~ " :BoLiCy!u@h JOIN #ircfiber";
            lines ~= "@msgid=q" ~ id ~ " :BoLiCy!u@h QUIT :bye";
        }
        return lines;
    }

    // Ordinary churn is untouched: quit + rejoin, /cycle, and our own
    // rejoins all publish live, every line.
    auto churn = run([":alice!u@h JOIN #c", ":alice!u@h QUIT :ping timeout", ":alice!u@h JOIN #c"])[1];
    assert(n(churn, "JOIN") == 2 && n(churn, "QUIT", "") == 1 && n(churn, "QUIT", "#c") == 1);
    auto cycle = run([":alice!u@h JOIN #c", ":alice!u@h PART #c", ":alice!u@h JOIN #c"])[1];
    assert(n(cycle, "JOIN") == 2 && n(cycle, "PART") == 1);
    string[] own;
    foreach (i; 0 .. 6) own ~= [":me!u@h JOIN #c", ":me!u@h PART #c"];
    assert(n(run(own)[1], "JOIN") == 6, "our own membership is never gated");

    // The incident: 80 cycles become BURST rows per channel, and the
    // roster is right throughout.
    auto s = run(storm(80));
    assert(n(s[1], "JOIN") == 4, "2 JOIN + 2 QUIT per channel, then held");
    assert(n(s[1], "QUIT", "") == 2 && n(s[1], "QUIT", "#support") == 2 && n(s[1], "QUIT", "#ircfiber") == 2);
    assert(!inRoster(s[0], "#support", "BoLiCy"));
    // It ended where downstream already is (gone): settling adds nothing.
    auto settled = run(storm(80), true)[1];
    assert(n(settled, "JOIN") == 4 && n(settled, "QUIT") == 6);

    // A storm that ends joined: held until it settles, then exactly one
    // JOIN per channel — the newest real line — so downstream converges.
    auto tail = storm(80) ~ ["@msgid=last-s :BoLiCy!u@h JOIN #support",
                             "@msgid=last-i :BoLiCy!u@h JOIN #ircfiber"];
    auto held = run(tail);
    assert(n(held[1], "JOIN") == 4);
    assert(inRoster(held[0], "#support", "BoLiCy") && inRoster(held[0], "#ircfiber", "BoLiCy"),
           "the roster takes held lines");
    auto conv = run(tail, true)[1];
    auto joins = conv.filter!(e => e.command == "JOIN").array;
    assert(joins.length == 6);
    assert([joins[4].getTag("msgid"), joins[5].getTag("msgid")].canFind("last-s")
           && [joins[4].getTag("msgid"), joins[5].getTag("msgid")].canFind("last-i"));

    // Pure echoes (JOIN while joined, in any case spelling) cost nothing.
    string[] echoes;
    foreach (i; 0 .. 10) echoes ~= "@msgid=e" ~ i.text ~ " :" ~ (i == 3 ? "bolicy" : "BoLiCy") ~ "!u@h JOIN #c";
    assert(n(run(echoes, true)[1], "JOIN") == 1);
    // Same for a repeated QUIT from a nick in none of our channels.
    string[] orphans;
    foreach (i; 0 .. 5) orphans ~= "@msgid=o" ~ i.text ~ " :ghost!u@h QUIT :bye";
    assert(n(run(orphans, true)[1], "QUIT", "") == 1);

    // A KICK is always relayed and supersedes the held JOIN.
    string[] kicked;
    foreach (i; 0 .. 5) kicked ~= [":bob!u@h JOIN #c", ":bob!u@h QUIT :x"];
    kicked ~= [":bob!u@h JOIN #c", ":op!u@h KICK #c Bob :out"];
    auto k = run(kicked, true)[1];
    assert(n(k, "KICK") == 1 && n(k, "JOIN") == 2, "nothing replayed for a kicked member");

    // A rename releases what is held for the old nick before the NICK row.
    string[] renamed;
    foreach (i; 0 .. 5) renamed ~= [":bob!u@h JOIN #c", ":bob!u@h QUIT :x"];
    renamed ~= [":bob!u@h JOIN #c", ":bob!u@h NICK :robert"];
    auto r = run(renamed)[1];
    assert(n(r, "JOIN") == 3);
    size_t lastJoin, firstNick = size_t.max;
    foreach (i, e; r) {
        if (e.command == "JOIN") lastJoin = i;
        if (e.command == "NICK" && firstNick == size_t.max) firstNick = i;
    }
    assert(lastJoin < firstNick);
}

@("draft/metadata-2: user/channel keys follow METADATA, NICK and QUIT; replies stay internal")
unittest {
    import std.typecons : tuple;

    // Feeds raw lines to a fresh client nicked `me`; returns it with every
    // event it published, in order.
    static auto run(string[] lines) {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto c = new PersistentIRCClient(cfg, ch);
        // Metadata subscriptions are for live counterparties, not a global
        // nick directory. Seed active conversations without adding UI rows.
        c.queryBuffers = ["alice", "carol", "a"];
        c.queryHosts["alice"] = "a@h";
        foreach (l; lines) c.processLine(l);
        ch.close(); // an open, empty channel blocks tryConsumeOne
        IRCRawEvent[] got;
        IRCRawEvent e;
        while (ch.tryConsumeOne(e)) got ~= e;
        return tuple(c, got);
    }
    static string meta(PersistentIRCClient c, string nick, string key) {
        if (auto row = nick in c.getUserMetadata()) return (*row).get(key, "");
        return "";
    }

    // The handler itself: a live update is published, routed to the server log.
    {
        auto c = run([])[0];
        auto direct = c.parseIRCLine(":srv METADATA alice avatar * :https://x/a.webp");
        assert(!c.handleMetadataLine(direct));
        assert(direct.channel == "");
        assert(meta(c, "alice", "avatar") == "https://x/a.webp");
        auto reply = c.parseIRCLine(":srv 761 me me avatar * :https://x/me.webp");
        assert(c.handleMetadataLine(reply), "761 is bookkeeping, not a live push");
    }

    // Through processLine: exactly one published event, on the server log.
    auto set = run([":srv METADATA alice avatar * :https://x/a.webp"]);
    assert(meta(set[0], "alice", "avatar") == "https://x/a.webp");
    assert(set[1].length == 1 && set[1][0].command == "METADATA" && set[1][0].channel == "");

    // Every user key we render is kept; NICK moves the entry, QUIT drops it.
    auto renamed = run([":srv METADATA alice avatar * :https://x/a.webp",
                        ":srv METADATA alice status * :on holiday",
                        ":alice!a@h NICK bob"]);
    assert(("alice" in renamed[0].getUserMetadata()) is null);
    assert(meta(renamed[0], "bob", "avatar") == "https://x/a.webp");
    assert(meta(renamed[0], "bob", "status") == "on holiday");
    auto quit = run([":srv METADATA alice avatar * :https://x/a.webp", ":alice!a@h NICK bob",
                     ":bob!a@h QUIT :bye"]);
    assert(("bob" in quit[0].getUserMetadata()) is null);

    // Invalid values and unknown keys are never stored; a valueless
    // METADATA clears the key.
    auto bad = run([":srv METADATA carol avatar * :javascript:alert(1)"]);
    assert(("carol" in bad[0].getUserMetadata()) is null, "non-http(s) avatar must be rejected");
    auto unknown = run([":s METADATA a x-secret * :v"]);
    assert(("a" in unknown[0].getUserMetadata()) is null, "keys outside USER_METADATA_KEYS are dropped");
    auto cleared = run([":srv METADATA carol avatar * :https://x/c.webp",
                        ":srv METADATA carol avatar *"]);
    assert(("carol" in cleared[0].getUserMetadata()) is null, "a valueless METADATA clears the key");

    // Channel keys: stored lowercase, published into the channel.
    auto chan = run([":s METADATA #C display-name * :Lobby"]);
    assert(chan[0].getChannelMetadata()["#c"]["display-name"] == "Lobby");
    assert(chan[1].length == 1 && chan[1][0].channel == "#C");
    auto chanBad = run([":s METADATA #c pronouns * :they/them"]);
    assert(("#c" in chanBad[0].getChannelMetadata()) is null, "user-only key on a channel is dropped");
    // A channel 761 answers a channel SET (possibly a bouncer client's): published.
    auto chanReply = run([":s 761 me #c display-name * :Lobby"]);
    assert(chanReply[0].getChannelMetadata()["#c"]["display-name"] == "Lobby");
    assert(chanReply[1].length == 1 && chanReply[1][0].command == "761");
    // Our own PART drops the channel's keys.
    auto parted = run([":me!u@h JOIN #c", ":s METADATA #c display-name * :Lobby", ":me!u@h PART #c"]);
    assert(("#c" in parted[0].getChannelMetadata()) is null);

    // 761/770/KEY_NOT_SET are bookkeeping only, never published.
    auto quiet = run([":srv 761 me me avatar * :https://x/me.webp", ":srv 770 me avatar",
                      ":srv FAIL METADATA KEY_NOT_SET me avatar :key not set"]);
    assert(meta(quiet[0], "me", "avatar") == "https://x/me.webp");
    assert(quiet[1].length == 0, "761/770/KEY_NOT_SET must not reach the frontend");
    auto self = run([":srv 761 me * avatar * :https://x/self.webp"]);
    assert(meta(self[0], "me", "avatar") == "https://x/self.webp", "`*` target means our own nick");

    // 900/901 track the services account the public registry is keyed by.
    auto login = run([":srv 900 me me!u@h acct :You are now logged in as acct"]);
    assert(login[0].servicesAccount == "acct");
    auto logout = run([":srv 900 me me!u@h acct :You are now logged in as acct",
                       ":srv 901 me me!u@h :You are now logged out"]);
    assert(logout[0].servicesAccount == "");
}

@("CTCP is direct-only, generic, quiet, and preserves ACTION")
unittest {
    import std.typecons : tuple;

    static auto run(string[] lines) {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto c = new PersistentIRCClient(cfg, ch);
        foreach (line; lines) c.processLine(line);
        ch.close();
        IRCRawEvent[] events;
        IRCRawEvent event;
        while (ch.tryConsumeOne(event)) events ~= event;
        return tuple(c, events);
    }
    auto direct = run([":alice!u@h PRIVMSG me :\x01VERSION\x01"]);
    assert(direct[1].length == 1, "a request must publish one diagnostic");
    assert(direct[1][0].channel == "_server" && direct[1][0].getTag("ctcp") == "VERSION");
    assert(direct[0].outboundQueue == ["NOTICE alice :\x01VERSION IRC Fiber\x01"]);

    foreach (target; ["#room", "@me", "someone"]) {
        auto channel = run([":alice!u@h PRIVMSG " ~ target ~ " :\x01VERSION\x01"]);
        assert(channel[1].length == 1 && channel[1][0].channel == "_server");
        assert(channel[0].outboundQueue.length == 0, "only our exact nick may elicit a reply");
        assert(channel[0].queryBuffers.length == 0);
    }
    auto replay = run(["BATCH +history chathistory me",
        "@batch=history :alice!u@h PRIVMSG me :\x01VERSION\x01", "BATCH -history"]);
    assert(replay[0].outboundQueue.length == 0);
    assert(replay[1].length == 1 && replay[1][0].getTag("batch") == "chathistory");

    auto diagnostics = run([
        "@msgid=secret;account=acct :alice!u@h PRIVMSG me :\x01DCC SEND private\x01",
        ":alice!u@h PRIVMSG me :\x01VERSION",
        ":alice!u@h NOTICE me :\x01PING private-token\x01",
        ":me!u@h NOTICE alice :\x01PING own-token\x01",
        ":me!u@h PRIVMSG alice :\x01PING own-token\x01"]);
    assert(diagnostics[1].length == 3, "own CTCP echoes must disappear");
    assert(diagnostics[1][0].getTag("ctcp") == "DCC");
    assert(diagnostics[1][1].getTag("ctcp") == "MALFORMED");
    assert(diagnostics[1][2].getTag("ctcp") == "PING");
    foreach (event; diagnostics[1]) assert(event.channel == "_server");
    assert(diagnostics[1][2].command == "NOTICE"
        && diagnostics[1][2].getParams()[0] == "me"
        && diagnostics[1][2].text == "\x01PING private-token\x01");
    assert(diagnostics[0].outboundQueue.length == 0);
    assert(diagnostics[0].queryBuffers.length == 0 && diagnostics[0].queryAccounts.length == 0
        && diagnostics[0].queryHosts.length == 0 && diagnostics[0].accounts.length == 0);
    assert(diagnostics[0].getLatestMsgid("alice").length == 0);

    auto action = run([":alice!u@h PRIVMSG #room :\x01ACTION waves\x01"]);
    assert(action[1].length == 1 && action[1][0].channel == "#room");
    assert(action[1][0].getTag("ctcp").length == 0 && action[1][0].text == "\x01ACTION waves\x01");
}

@("FIBERMLS: own prefix follows only server-confirmed identity and survives a swap snapshot")
unittest {

    static PersistentIRCClient fresh(out EngineEventChannel ch) {
        NetworkConfig cfg;
        cfg.nick = "me";
        ch = EngineEventChannel.create();
        return new PersistentIRCClient(cfg, ch);
    }

    EngineEventChannel ch;
    auto c = fresh(ch);
    // Self JOIN echo is the proof; it also lands whole on the roster.
    c.processLine(":me!~m@host.a JOIN #c");
    assert(c.ownPrefix == "me!~m@host.a");
    assert(c.getOwnPrefix() == "", "never exported while not registered");
    assert(c.channelUsers["#c"] == ["me!~m@host.a"]);
    // An optimistic /nick and its rejection never move the proof.
    c.sendRaw("NICK newme");
    assert(c.sessionNick == "newme" && c.ownPrefix == "me!~m@host.a");
    c.processLine(":s 433 me newme :Nickname is already in use");
    assert(c.sessionNick == "me" && c.ownPrefix == "me!~m@host.a");
    // The server's NICK for the identity we hold moves it.
    c.sendRaw("NICK newme");
    c.processLine(":me!~m@host.a NICK newme");
    assert(c.ownPrefix == "newme!~m@host.a");
    assert(c.channelUsers["#c"] == ["newme!~m@host.a"], "NICK keeps the roster's user@host");
    // CHGHOST from the identity we hold moves the host.
    c.processLine(":newme!~m@host.a CHGHOST ~m cloak.b");
    assert(c.ownPrefix == "newme!~m@cloak.b");
    // A replayed CHGHOST for our nick is no proof: dropped until WHO.
    c.processLine("@batch=h :newme!~m@cloak.b CHGHOST ~m old.host");
    assert(c.ownPrefix == "");
    c.processLine("@batch=h :s 352 newme #c ~m old.host s newme H :0 Me");
    assert(c.ownPrefix == "", "historical WHO cannot restore identity proof");
    // WHO for our confirmed nick restates it.
    c.processLine(":s 352 newme #c ~m cloak.b s newme H :0 Me");
    assert(c.ownPrefix == "newme!~m@cloak.b");
    // 396 carries no user: the proof is dropped, the budget host follows.
    c.processLine(":s 396 newme cloak.d :is now your displayed host");
    assert(c.ownPrefix == "" && c.ownHostmask == "newme!~m@cloak.d");
    c.processLine(":s 352 newme * ~m cloak.d s newme H :0 Me");
    assert(c.ownPrefix == "newme!~m@cloak.d");
    // Someone else holding the nick we optimistically asked for renames:
    // the bookkeeping misreads it as us, the proof must not follow it.
    c.sendRaw("NICK taken");
    c.processLine(":taken!x@evil NICK other");
    assert(c.ownPrefix == "", "a rename of another identity never becomes ours");
    // While a /nick awaits its echo a WHO row for that nick proves nothing.
    c.processLine(":s 352 other * x evil s other H :0 Evil");
    assert(c.ownPrefix == "");
    ch.close();

    // Hot-swap META carries the generation and the proof; a detached or
    // unregistered engine exports none, and a new socket forgets it.
    EngineEventChannel ch2;
    auto d = fresh(ch2);
    d.processLine(":me!~m@host.a JOIN #c");
    d.state = ConnectionState.connected;
    d.connectedAtMs = 1_700_000_000_123;
    auto snap = d.snapshotSession(true);
    assert(snap.connectedAtMs == 1_700_000_000_123 && snap.ownPrefix == "me!~m@host.a");
    d.detachedForHotSwap = true;
    assert(d.getOwnPrefix() == "" && d.snapshotSession(true).ownPrefix == "");
    d.detachedForHotSwap = false;
    d.state = ConnectionState.disconnected;
    d.resetConnectionTelemetry();
    assert(d.ownPrefix == "" && d.connectedAtMs == 0);
    // Sanitizing invalid UTF-8 grows bytes; only original wire lengths may
    // advance the holder replay fence.
    const historicalWho = ":s 352 me #c ~m stale.host s me H :0 Me";
    char[] backlog = (":a!u@h NOTICE me :\xFF\r\n" ~ historicalWho ~ "\r\n").dup;
    d.attachBacklogBytes = backlog.length;
    string replay;
    while (backlog.length) {
        const before = backlog.length;
        assert(popInboundLine(backlog, replay));
        d.processLine(replay, before - backlog.length);
    }
    assert(d.ownPrefix == "", "holder replay must not restore authoritative identity");
    d.processLine(":s 352 me #c ~m live.host s me H :0 Me");
    assert(d.ownPrefix == "me!~m@live.host");
    ch2.close();
}

@("Services identity: server-observed account, fresh epoch per generation and attach")
unittest {

    NetworkConfig cfg;
    cfg.nick = "me";
    // Configured SASL credentials are never identity evidence.
    cfg.sasl = SASLMechanism.plain;
    cfg.saslUsername = "configured";
    cfg.saslPassword = "pw";
    auto ch = EngineEventChannel.create();
    auto c = new PersistentIRCClient(cfg, ch);
    string[][] announced;
    void drain() {
        IRCRawEvent ev;
        while (ch.tryConsumeOne(ev, 0.msecs))
            if (ev.command == "SERVICES_STATE") announced ~= ev.getParams();
    }
    void live(long gen) {
        c.state = ConnectionState.connected;
        c.connectedAtMs = gen;
        c.beginServicesGeneration();
    }

    // Nothing is exported before registration, even with a SASL 900.
    c.processLine(":srv 900 me me!u@h acct :You are now logged in as acct");
    assert(c.servicesAccount == "acct" && c.getServicesAccount() == "");
    assert(c.getServicesAccountState() == ServicesAccountState.unknown && c.getConnectionEpoch() == "");
    drain();
    assert(announced.length == 0, "no live generation, nothing to announce");

    live(1_000);
    const epoch1 = c.getConnectionEpoch();
    assert(epoch1.length == 36 && epoch1 != "00000000-0000-0000-0000-000000000000");
    assert(c.getServicesAccountState() == ServicesAccountState.account && c.getServicesAccount() == "acct");
    drain();
    assert(announced.length == 1 && announced[0] == ["account", "acct", epoch1, "unknown"]);

    // 901 logs out; a live self ACCOUNT logs in; replays and others do not.
    c.processLine(":srv 901 me me!u@h :You are now logged out");
    assert(c.getServicesAccountState() == ServicesAccountState.none && c.getServicesAccount() == "");
    c.processLine(":me!u@h ACCOUNT acct2");
    assert(c.getServicesAccount() == "acct2");
    c.processLine("@batch=h :me!u@h ACCOUNT replayed");
    c.processLine(":bob!b@h ACCOUNT bobacct");
    assert(c.getServicesAccount() == "acct2", "only a live self ACCOUNT moves our login");
    c.processLine(":me!u@h ACCOUNT *");
    assert(c.getServicesAccountState() == ServicesAccountState.none);
    // A live self WHOX row restates it ("0" = none); a plain WHO cannot.
    c.processLine(":s 354 me 152 * ~u host me H acct3 :Me");
    assert(c.getServicesAccount() == "acct3");
    c.processLine(":s 352 me * ~u host s me H :0 Me");
    assert(c.getServicesAccount() == "acct3");
    c.processLine(":s 354 me 152 * ~u host me H 0 :Me");
    assert(c.getServicesAccountState() == ServicesAccountState.none);
    c.processLine(":s 354 me 152 * ~u host me H acct3 :Me");
    drain();
    assert(announced[$ - 1] == ["account", "acct3", epoch1, "unknown"]);
    assert(c.getServicesAccount() != cfg.saslUsername);

    // META carries the login, never the epoch; a detached engine exports
    // and announces nothing.
    auto snap = c.snapshotSession(true);
    assert(snap.servicesAccountState == "account" && snap.servicesAccount == "acct3");
    c.detachedForHotSwap = true;
    assert(c.getConnectionEpoch() == "" && c.getServicesAccount() == "");
    const before = announced.length;
    c.processLine(":srv 901 me me!u@h :You are now logged out");
    drain();
    assert(announced.length == before, "a detached engine stays silent");
    c.detachedForHotSwap = false;

    // Attach: the login survives only a graceful META of this generation,
    // and the attaching engine always mints its own epoch.
    auto d = new PersistentIRCClient(cfg, ch);
    d.connectedAtMs = snap.connectedAtMs;
    d.restoreServicesAccount(snap, true);
    assert(d.servicesAccountState == ServicesAccountState.account && d.servicesAccount == "acct3");
    d.restoreServicesAccount(snap, false);
    assert(d.servicesAccountState == ServicesAccountState.unknown && d.servicesAccount == "");
    d.connectedAtMs = snap.connectedAtMs + 1;
    d.restoreServicesAccount(snap, true);
    assert(d.servicesAccountState == ServicesAccountState.unknown, "another generation's META proves nothing");
    auto legacy = snap;
    legacy.servicesAccountState = "";
    d.connectedAtMs = snap.connectedAtMs;
    d.restoreServicesAccount(legacy, true);
    assert(d.servicesAccountState == ServicesAccountState.unknown, "an older engine's META is unknown");
    d.state = ConnectionState.connected;
    d.mintConnectionEpoch();
    assert(d.getConnectionEpoch().length == 36 && d.getConnectionEpoch() != epoch1,
        "a retained socket under a new engine gets a new epoch");
    drain();

    // A dropped socket clears everything and says so; the next one differs.
    c.state = ConnectionState.disconnected;
    c.resetConnectionTelemetry();
    assert(c.connectionEpoch == "" && c.servicesAccount == ""
        && c.servicesAccountState == ServicesAccountState.unknown);
    drain();
    assert(announced[$ - 1] == ["unknown", "", "", "unavailable"]);
    live(2_000);
    assert(c.getConnectionEpoch().length == 36 && c.getConnectionEpoch() != epoch1);
    assert(c.getServicesAccountState() == ServicesAccountState.unknown, "a new socket has no observed login state yet");
    drain();
    ch.close();
}

@("FIBERMLS: roster keeps user@host through JOIN, WHO, NICK and a bare NAMES resync")
unittest {

    NetworkConfig cfg;
    cfg.nick = "me";
    auto ch = EngineEventChannel.create();
    auto c = new PersistentIRCClient(cfg, ch);
    c.processLine(":me!~m@host.a JOIN #c");
    c.processLine(":a!~a@ha JOIN #c");
    assert(c.channelUsers["#c"] == ["me!~m@host.a", "a!~a@ha"]);
    c.processLine(":a!~a@ha NICK b");
    assert(c.channelUsers["#c"] == ["me!~m@host.a", "b!~a@ha"]);
    // A bare NAMES burst (no userhost-in-names) keeps the known hostmasks.
    c.processLine(":s 353 me = #c :@me b carol");
    c.processLine(":s 366 me #c :End of NAMES");
    assert(c.channelUsers["#c"] == ["@me!~m@host.a", "b!~a@ha", "carol"]);
    // WHO fills the bare one in and promotes it without losing the host.
    c.processLine(":s 352 me #c ~c hc s carol H@ :0 Carol");
    assert(c.channelUsers["#c"] == ["@me!~m@host.a", "b!~a@ha", "@carol!~c@hc"]);
    ch.close();
}

@("FIBERMLS a repeated requester cannot spend another peer's reply slot")
unittest {
    NetworkConfig cfg;
    auto ch = EngineEventChannel.create();
    auto c = new PersistentIRCClient(cfg, ch);
    assert(c.takeFiberReplySlot("alice!a@host"));
    foreach (_; 0 .. 64) assert(!c.takeFiberReplySlot("alice!a@host"));
    assert(c.takeFiberReplySlot("bob!b@host"));
    c.resetConnectionTelemetry();
    assert(c.fiberRequesterNotBeforeMs.length == 0);
    assert(c.takeFiberReplySlot("alice!a@host"));
    ch.close();
}

@("FIBERMLS control lines are consumed silently: no events, query tabs, replies or history")
unittest {
    import std.algorithm : filter;
    import std.array : array, replicate;
    import std.typecons : tuple;
    import ircfiber.irc.mls_peer : buildFiberMlsQuery;

    enum N1 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    enum T1 = "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210";
    string query = buildFiberMlsQuery(N1, "#c", 400);
    assert(query !is null);
    string id = "\x01FIBERMLS 1 ID " ~ N1 ~ " " ~ T1 ~ "\x01";

    static auto run(string[] lines) {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto c = new PersistentIRCClient(cfg, ch);
        foreach (line; lines) c.processLine(line);
        ch.close();
        IRCRawEvent[] events;
        IRCRawEvent event;
        while (ch.tryConsumeOne(event))
            if (event.command != "own_prefix") events ~= event;
        return tuple(c, events);
    }
    alias Run = typeof(run(null));
    static void quiet(Run r, string why) {
        assert(r[1].filter!(e => e.command == "PRIVMSG" || e.command == "NOTICE").array.length == 0, why);
        assert(r[0].queryBuffers.length == 0 && r[0].queryHosts.length == 0, why);
        // JOIN may queue its own WHO/WHOIS; nothing protocol-related may.
        assert(!r[0].outboundQueue.canFind!(l => l.indexOf("FIBERMLS") >= 0 || l.startsWith("NOTICE")),
            why);
        assert(r[0].getLatestMsgid("alice").length == 0, why);
    }
    enum join = ":me!~m@host.a JOIN #c";
    enum peer = ":alice!~a@ha JOIN #c";
    string[] outbound = [join, peer];

    quiet(run(outbound ~ [":alice!~a@ha PRIVMSG me :" ~ query]), "a live private QUERY");
    quiet(run(outbound ~ ["@msgid=m1 :alice!~a@ha PRIVMSG #c :" ~ query]), "channel-targeted");
    quiet(run(outbound ~ [":alice!~a@ha PRIVMSG @me :" ~ query]), "STATUSMSG-targeted");
    quiet(run(outbound ~ [":alice!~a@ha PRIVMSG someone :" ~ query]), "another nick");
    quiet(run(outbound ~ [":alice!~a@ha PRIVMSG me :\x01FIBERMLS 1 QUERY bad\x01"]), "malformed");
    quiet(run(outbound ~ [":alice!~a@ha PRIVMSG me :\x01FIBERMLS 2 QUERY " ~ N1 ~ " Iw\x01"]),
        "unsupported version");
    quiet(run(outbound ~ [":alice!~a@ha PRIVMSG me :\x01fibermls 1 QUERY " ~ N1 ~ " Iw\x01"]),
        "reserved in any case");
    quiet(run(outbound ~ [":alice!~a@ha PRIVMSG me :\x01FIBERMLS 1 QUERY " ~ N1 ~ " "
        ~ "A".replicate(600) ~ "\x01"]), "oversized");
    quiet(run(outbound ~ [":alice!~a@ha PRIVMSG me :\x01FIBERMLS 1 QUERY " ~ N1]), "unterminated");
    quiet(run(outbound ~ [":me!~m@host.a PRIVMSG alice :" ~ query]), "own echo");
    quiet(run(outbound ~ ["BATCH +h chathistory me", "@batch=h :alice!~a@ha PRIVMSG me :" ~ query,
        "BATCH -h"]), "chathistory replay");
    quiet(run(outbound ~ ["@time=2020-01-01T00:00:00.000Z :alice!~a@ha PRIVMSG me :" ~ query]),
        "stale server-time");
    quiet(run(outbound ~ ["BATCH +m draft/multiline me",
        "@batch=m :alice!~a@ha PRIVMSG me :\x01FIBER",
        "@batch=m;draft/multiline-concat :alice!~a@ha PRIVMSG me :" ~ query[6 .. $],
        "BATCH -m"]), "split across a multiline batch");
    quiet(run(outbound ~ [":alice!~a@ha NOTICE me :" ~ id]), "unsolicited ID");
    quiet(run([peer, ":alice!~a@ha PRIVMSG me :" ~ query]), "unverified own prefix");
    // Ordinary CTCP keeps its existing handling.
    auto version_ = run(outbound ~ [":alice!~a@ha PRIVMSG me :\x01VERSION\x01"]);
    assert(version_[1].filter!(e => e.getTag("ctcp") == "VERSION").array.length == 1);

    // An ID is redeemable once, only from the nick the probe went to.
    auto r = run(outbound);
    auto c = r[0];
    c.fiberProbesSent[N1] = SentFiberProbe("alice", "alice", "#c", unixMsNow());
    c.processLine(":bob!~b@hb NOTICE me :" ~ id);
    assert((N1 in c.fiberProbesSent) !is null, "a forged source leaves the genuine probe pending");
    c.processLine("@batch=x :alice!~a@ha NOTICE me :" ~ id);
    assert((N1 in c.fiberProbesSent) !is null, "a replayed reply is not the answer");
    c.processLine(":alice!~a@ha NOTICE me :" ~ id);
    assert((N1 in c.fiberProbesSent) is null, "the matching reply consumes the nonce");
    assert(c.queryBuffers.length == 0);
}

version (unittest) version = FiberMlsChecks;
version (FiberMlsWireHarness) version = FiberMlsChecks;
version (MemoryReliabilityHarness) version = FiberMlsChecks;

version (FiberMlsChecks) {
struct Ircv3Check {
    string name;
    bool passed;
}

version (MemoryReliabilityHarness)
Ircv3Check[] memoryIdentityRegressionChecks() {
    import vibe.data.json : parseJsonString;

    Ircv3Check[] checks;
    void check(string name, bool passed) { checks ~= Ircv3Check(name, passed); }
    NetworkConfig cfg;
    cfg.nick = "me";
    auto channel = EngineEventChannel.create();
    scope (exit) channel.close();
    auto client = new PersistentIRCClient(cfg, channel);
    IRCRawEvent[100] rows;
    size_t rowCount;
    void drain() {
        rows[0 .. rowCount] = IRCRawEvent.init;
        rowCount = 0;
        IRCRawEvent row;
        while (channel.bufferFill > 0 && channel.tryConsumeOne(row)) rows[rowCount++] = row;
    }
    void feed(string line) {
        client.processLine(line);
        drain();
    }
    bool cached(string nick) {
        const key = client.foldNick(nick);
        foreach (cache; [client.realnames, client.idents, client.accounts, client.away, client.bots])
            foreach (name; cache.byKey)
                if (client.foldNick(name) == key) return true;
        foreach (name; client.realnameProbed.byKey)
            if (client.foldNick(name) == key) return true;
        foreach (name; client.userMetadata.byKey)
            if (client.foldNick(name) == key) return true;
        return false;
    }
    bool sameCounts(ClientMemoryCounters before, ClientMemoryCounters after) {
        return before.members == after.members && before.namesMembers == after.namesMembers
            && before.realnames == after.realnames && before.realnameProbed == after.realnameProbed
            && before.idents == after.idents && before.accounts == after.accounts
            && before.away == after.away && before.bots == after.bots
            && before.userMetadata == after.userMetadata;
    }
    string canonical(Json value) {
        if (value.type == Json.Type.object) {
            string[] keys;
            foreach (string key, node; value) keys ~= key;
            sort(keys);
            string encoded = "{";
            foreach (key; keys)
                encoded ~= Json(key).toString() ~ ":" ~ canonical(value[key]) ~ ",";
            return encoded ~ "}";
        }
        if (value.type == Json.Type.array) {
            string encoded = "[";
            foreach (Json node; value) encoded ~= canonical(node) ~ ",";
            return encoded ~ "]";
        }
        return value.toString();
    }
    string serializedIdentity() {
        auto snapshot = client.snapshotSession();
        // Inspect the actual META serialization, not a second cache copier.
        auto encoded = parseJsonString(toJSON(snapshot).toString());
        auto identity = Json.emptyObject;
        foreach (key; ["channelUsers", "realnames", "idents", "accounts", "away", "bots", "userMetadata"])
            identity[key] = encoded[key];
        return canonical(identity);
    }

    // Reuse the registration harness's two-channel, host-bearing session.
    fiberCheckSession(client, 1_000);
    client.state = ConnectionState.disconnected; // writes stay in the in-memory wire queue
    drain();
    feed(":s 005 me WHOX BOT=b :are supported");
    feed(":s 354 me 152 #c ~a ha alice Gb stable :Alice Stable");
    feed(":s METADATA alice pronouns * :they/them");
    // Finish an actual initial WHO before freezing the steady-state
    // baseline: 315 legitimately marks every existing member as probed.
    client.sendRaw("WHO #c");
    feed(":s 315 me #c :End");
    const baselineCounts = client.memoryCounters();
    const baselineSnapshot = serializedIdentity();
    bool bounded = true;
    foreach (i; 0 .. 10_000) {
        const nick = "churn" ~ i.to!string;
        feed(":" ~ nick ~ "!new@host JOIN #c account :Churn Person");
        feed(":s 352 me #c new host s " ~ nick ~ " Gb :0 Churn Person");
        feed(":s METADATA " ~ nick ~ " pronouns * :they/them");
        feed(":" ~ nick ~ "!new@host QUIT :complete");
        bounded = sameCounts(baselineCounts, client.memoryCounters()) && bounded;
    }
    check("10,000 JOIN-WHO-QUIT cycles return every identity cardinality to the live-owner baseline", bounded);
    check("completed churn returns serialized META identity and rosters to baseline",
        serializedIdentity() == baselineSnapshot);

    // Late private WHO/WHOX/WHOIS rows still reach their requesting client
    // but neither retain a departed identity nor reinsert it into a roster.
    client.sendRaw("WHO #c", true);
    feed(":s 352 me #c old host s churn9999 G@ :0 Departed");
    bool deliveredWho = false;
    foreach (row; rows[0 .. rowCount]) deliveredWho = deliveredWho || row.command == "352";
    feed(":s 315 me #c :End");
    client.sendRaw("WHO #c %na", true);
    feed(":s 354 me churn9999 oldaccount");
    bool deliveredWhox = false;
    foreach (row; rows[0 .. rowCount]) deliveredWhox = deliveredWhox || row.command == "354";
    feed(":s 315 me #c :End");
    client.sendRaw("WHOIS churn9999", true);
    feed(":s 311 me churn9999 old host * :Departed");
    bool deliveredWhois = false;
    foreach (row; rows[0 .. rowCount]) deliveredWhois = deliveredWhois || row.command == "311";
    feed(":s 318 me churn9999 :End");
    check("late requested WHO/WHOX/WHOIS responses complete without recreating departed caches",
        deliveredWho && deliveredWhox && deliveredWhois && !cached("churn9999")
        && sameCounts(baselineCounts, client.memoryCounters()));

    feed(":wander!u@h JOIN #c acct :Wander");
    feed(":wander!u@h JOIN #d acct :Wander");
    feed(":s 354 me 152 #c u h wander Gb acct :Wander");
    feed(":s METADATA wander pronouns * :they/them");
    feed(":wander!u@h PART #c :first");
    check("PART preserves identity while another current channel owns it",
        cached("wander") && client.realnames.get("wander", "") == "Wander");
    feed(":wander!u@h PART #d :last");
    check("last PART removes all seven general identity maps",
        !cached("wander") && sameCounts(baselineCounts, client.memoryCounters()));
    feed(":kicked!u@h JOIN #c acct :Kicked");
    feed(":kicked!u@h JOIN #d acct :Kicked");
    feed(":s KICK #c kicked :first");
    const keptKick = cached("kicked");
    feed(":s KICK #d kicked :last");
    check("KICK preserves shared membership and reclaims only after the last owner",
        keptKick && !cached("kicked"));

    feed("@account=original :partner!old@host PRIVMSG me :conversation");
    feed(":partner!old@host JOIN #c original :Old Person");
    feed(":s 354 me 152 #c old host partner Gb original :Old Person");
    feed(":s METADATA partner pronouns * :old");
    feed(":partner!old@host QUIT :gone");
    check("QUIT clears the occupant even with an active query while preserving dedicated DM evidence",
        !cached("partner") && client.queryBuffers.canFind("partner")
        && client.queryAccounts.get("partner", "") == "original"
        && client.queryHosts.get("partner", "") == "old@host");
    feed(":partner!new@elsewhere JOIN #c newcomer :New Person");
    check("reused nick receives a different ident/realname without stale account, away, bot or profile",
        client.idents.get("partner", "") == "new" && client.realnames.get("partner", "") == "New Person"
        && client.accounts.get("partner", "") == "newcomer" && "partner" !in client.away
        && "partner" !in client.bots && "partner" !in client.userMetadata);
    feed(":partner!new@elsewhere NICK stranger");
    bool invalidFollow;
    foreach (row; rows[0 .. rowCount]) invalidFollow = invalidFollow || row.getTag("query_follow") == "true";
    check("a new occupant cannot drag the old DM conversation through NICK",
        !invalidFollow && client.queryBuffers.canFind("partner") && !client.queryBuffers.canFind("stranger")
        && client.realnames.get("stranger", "") == "New Person"
        && client.idents.get("stranger", "") == "new" && !cached("partner"));
    feed(":stranger!new@elsewhere QUIT :done");
    feed("@account=original :partner!old@host NICK trusted");
    bool validFollow;
    foreach (row; rows[0 .. rowCount]) validFollow = validFollow || row.getTag("query_follow") == "true";
    check("verified account/host evidence still follows a DM rename",
        validFollow && client.queryBuffers.canFind("trusted") && !client.queryBuffers.canFind("partner")
        && client.queryAccounts.get("trusted", "") == "original"
        && client.queryHosts.get("trusted", "") == "old@host");

    feed(":Brace[!u@h JOIN #c acct :Brace");
    feed(":s 354 me 152 #c u h brace{ Gb acct :Brace Updated");
    feed(":s METADATA BRACE{ pronouns * :they/them");
    feed(":bRaCe{!u@h NICK Renamed");
    check("CASEMAPPING-aware NICK moves realname/probe/ident/account/away/bot/profile keys together",
        !cached("brace[") && client.realnames.get("Renamed", "") == "Brace Updated"
        && client.realnameProbed.get("Renamed", false) && client.idents.get("Renamed", "") == "u"
        && client.accounts.get("Renamed", "") == "acct" && "Renamed" in client.away
        && "Renamed" in client.bots && "Renamed" in client.userMetadata);
    feed(":RENAMED!u@h PART #c :last");
    check("CASEMAPPING-aware last departure clears differently spelled keys", !cached("renamed"));
    feed(":s 005 me CASEMAPPING=ascii :are supported");
    feed(":Square[!u@h JOIN #c acct :Square Left");
    feed(":square{!v@h JOIN #c other :Square Right");
    feed(":square[!u@h PART #c :only left");
    check("ASCII CASEMAPPING does not reclaim a distinct brace identity",
        !cached("Square[") && client.realnames.get("square{", "") == "Square Right");
    feed(":square{!v@h QUIT :done");
    feed(":s 005 me CASEMAPPING=rfc1459 :are supported");

    feed(":s 353 me = #pending :@me Bursty!u@h");
    feed(":s 354 me 152 #pending u h bursty Gb acct :Burst Person");
    check("an in-progress NAMES roster owns identity before 366",
        cached("bursty") && "bursty" in client.realnameProbed);
    feed(":BURSTY!u@h QUIT :during names");
    feed(":s 366 me #pending :End");
    check("QUIT during NAMES cannot be resurrected by the authoritative replacement",
        !cached("bursty") && !client.rosterHas("#pending", "bursty"));
    feed(":me!~m@host.a PART #pending :done");
    feed(":vanished!u@h JOIN #c acct :Vanished");
    feed(":s METADATA vanished pronouns * :they/them");
    feed(":s 353 me = #c :me alice bob erin gina carol");
    feed(":s 366 me #c :End");
    check("authoritative 366 reclaims unseen departed identities across every map", !cached("vanished"));

    const beforeHistory = serializedIdentity();
    feed("BATCH +past chathistory #c");
    feed("@batch=past :ghost!old@host JOIN #c ancient :Past Person");
    feed("@batch=past :ghost!old@host SETNAME :Past Rename");
    feed("@batch=past :s 354 me 152 #c old host ghost Gb ancient :Past Person");
    feed("@batch=past :ghost!old@host PRIVMSG #c :historical response");
    bool historyDelivered;
    foreach (row; rows[0 .. rowCount])
        historyDelivered = historyDelivered || (row.command == "PRIVMSG"
            && row.text == "historical response" && row.getTag("batch") == "chathistory");
    feed("BATCH -past");
    check("history consumers still receive replay without mutating live identity ownership",
        historyDelivered && !cached("ghost") && serializedIdentity() == beforeHistory);

    feed(":me!~m@host.a PART #c :leave channel");
    check("own PART reconciles all departed members but preserves another channel's owners",
        !cached("bob") && !cached("erin") && !cached("gina") && cached("alice"));
    feed(":s KICK #d me :leave last channel");
    check("own KICK clears the final channel's unowned identity graphs", !cached("alice"));

    // Reuse the real private WHOIS/VERSION/services-frame transport checks,
    // including their event-channel non-disclosure and completion assertions.
    string[] serviceWire;
    foreach (result; servicesTransportWireChecks(serviceWire))
        check("identity lifetime preserves services: " ~ result.name, result.passed);
    return checks;
}

version (MemoryReliabilityHarness)
Ircv3Check[] metaPublicationRegressionChecks() {
    import std.algorithm : any;
    import vibe.core.net : listenTCP;
    import vibe.data.json : parseJsonString;
    import vibe.stream.operations : readLine;
    import ircfiber.services.config : ServicePin, ServiceId, ServicesProvider;
    import ircfiber.services.protocol : ServiceAction;

    Ircv3Check[] checks;
    void check(string name, bool passed) { checks ~= Ircv3Check(name, passed); }
    bool until(scope bool delegate() ready) {
        foreach (_; 0 .. 400) {
            if (ready()) return true;
            sleep(5.msecs);
        }
        return ready();
    }
    bool awaitCheck(string name, scope bool delegate() ready) {
        const passed = until(ready);
        check(name, passed);
        return passed;
    }

    // A real serialized holder control connection, with independently
    // delayed admission/ACK and explicit protocol errors, not a snapshot sink.
    TCPConnection[] controls;
    Json[] publications;
    string[] publicationIds;
    string rejectNext;
    string rejectAll;
    size_t metaAcksAllowed = size_t.max;
    bool statusAllowed = true;
    size_t statusSeen;
    auto controlListener = listenTCP(0, (TCPConnection peer) {
        controls ~= peer;
        try {
            while (!peer.empty) {
                const line = (cast(const(char)[]) peer.readLine((8 << 20) + 4096, "\n")).idup;
                if (line.startsWith("HELLO ")) {
                    peer.write("OK {\"proto\":1}\n");
                } else if (line == "STATUS") {
                    ++statusSeen;
                    while (!statusAllowed) sleep(1.msecs);
                    peer.write("OK {\"open\":2}\n");
                } else if (line.startsWith("META ")) {
                    auto payload = parseJsonString(line[5 .. $]);
                    const index = publications.length;
                    publications ~= payload["meta"];
                    publicationIds ~= payload["id"].get!string;
                    const rejection = rejectNext.length ? rejectNext : rejectAll;
                    rejectNext = "";
                    while (index >= metaAcksAllowed) sleep(1.msecs);
                    if (rejection.length)
                        peer.write("ERR {\"code\":\"" ~ rejection ~ "\",\"message\":\"fixture\"}\n");
                    else peer.write("OK {}\n");
                } else {
                    peer.write("ERR {\"code\":\"bad_request\"}\n");
                }
                peer.flush();
            }
        } catch (Exception) {}
        try peer.close(); catch (Exception) {}
    }, "127.0.0.1");
    string[] upstream;
    TCPConnection[] upstreamPeers;
    auto ircListener = listenTCP(0, (TCPConnection peer) {
        upstreamPeers ~= peer;
        try {
            while (!peer.empty) upstream ~= (cast(const(char)[]) peer.readLine()).idup;
        } catch (Exception) {}
        try peer.close(); catch (Exception) {}
    }, "127.0.0.1");
    auto channel = EngineEventChannel.create();
    NetworkConfig cfg;
    cfg.nick = "me";
    cfg.services.provider = ServicesProvider.anope;
    cfg.services.server = "services.test";
    cfg.services.pins[ServiceId.nickServ] = ServicePin("NickServ", "services", "services.test");
    auto c = new PersistentIRCClient(cfg, channel);
    auto other = new PersistentIRCClient(cfg, channel);
    auto holder = new HolderClient("meta-fixture",
        "tcp://127.0.0.1:" ~ controlListener.bindAddress.port.to!string);
    void cleanup() {
        statusAllowed = true;
        metaAcksAllowed = size_t.max;
        c.isShutdownRequested = other.isShutdownRequested = true;
        c.state = other.state = ConnectionState.disconnected;
        try c.services.onDisconnect(); catch (Exception) {}
        try clearServicesOperations(); catch (Exception) {}
        until(() => !c.ordinaryMetaPublisherRunning && !other.ordinaryMetaPublisherRunning);
        try c.connection.close(); catch (Exception) {}
        foreach (peer; controls) { try peer.close(); catch (Exception) {} }
        foreach (peer; upstreamPeers) { try peer.close(); catch (Exception) {} }
        try controlListener.stopListening(); catch (Exception) {}
        try ircListener.stopListening(); catch (Exception) {}
        sleep(10.msecs);
        channel.close();
    }
    scope (exit) cleanup();
    holder.connectControl();
    foreach (client; [c, other]) {
        client.holder = holder;
        client.holderConnId = client is c ? "held-a" : "held-b";
        client.state = ConnectionState.connected;
        client.connectedAtMs = unixMsNow();
        client.beginServicesGeneration();
    }
    c.connection = connectTCP("127.0.0.1", ircListener.bindAddress.port);
    c.channelState["#live"] = "";
    c.channelUsers["#live"] = ["me", "alice"];

    bool statusDone;
    void blockControl() {
        statusAllowed = false;
        statusDone = false;
        runTask({
            try holder.status(); catch (Exception) {}
            statusDone = true;
        });
    }
    blockControl();
    if (!awaitCheck("META fixture occupies control admission", () => statusSeen == 1)) return checks;
    foreach (_; 0 .. 100) {
        c.requestMetaPublication();
        other.requestMetaPublication();
    }
    check("ordinary requests coalesce to one task per client before admission",
        c.memoryCounters().ordinaryMetaPublishers == 1
        && other.memoryCounters().ordinaryMetaPublishers == 1);
    check("control waiters retain no built META",
        c.memoryCounters().metaBuilds + other.memoryCounters().metaBuilds == 0);
    c.sessionNick = "before-admission";
    other.sessionNick = "before-admission";
    metaAcksAllowed = 0;
    statusAllowed = true;
    if (!awaitCheck("ordinary META waits for its actual ACK", () => publications.length == 1)) return checks;
    check("one holder retains at most one built payload including delayed ACK",
        c.memoryCounters().metaBuilds + other.memoryCounters().metaBuilds == 1);
    check("ordinary dirty state remains pending until acknowledgment",
        c.metaDirty && other.metaDirty);
    c.sessionNick = "latest";
    foreach (_; 0 .. 100) c.requestMetaPublication();
    metaAcksAllowed = size_t.max;
    if (!awaitCheck("coalesced latest state is acknowledged and publishers finish",
        () => !c.ordinaryMetaPublisherRunning && !other.ordinaryMetaPublisherRunning)) return checks;
    Json lastA;
    size_t aWrites;
    foreach (index, id; publicationIds) if (id == "held-a") {
        ++aWrites;
        lastA = publications[index];
    }
    check("snapshot construction sees state after control admission",
        publications[0]["sessionNick"].get!string == "before-admission");
    check("delayed ACK coalesces repeated changes to the newest state",
        aWrites >= 1 && aWrites <= 2 && lastA["sessionNick"].get!string == "latest"
        && !c.metaDirty && c.metaBuildOperations == 0);

    // An already-waiting ordinary request must not overwrite the newer
    // marker, and the manual service command cannot precede strict ACK.
    blockControl();
    if (!awaitCheck("strict fixture blocks admission", () => statusSeen == 2)) return checks;
    const beforeStrict = publications.length;
    c.requestMetaPublication();
    sleep(5.msecs);
    const barrierBefore = c.metaBarrierGeneration;
    bool manualDone;
    runTask(() nothrow {
        try {
            c.sendRaw("PRIVMSG NickServ :IDENTIFY meta-canary-one", true);
            manualDone = true;
        } catch (Exception error) {
            check("first manual services write succeeds", false);
        }
    });
    if (!awaitCheck("strict request invalidates queued ordinary work",
        () => c.metaBarrierGeneration != barrierBefore)) return checks;
    metaAcksAllowed = beforeStrict;
    statusAllowed = true;
    if (!awaitCheck("strict marker reaches holder ahead of upstream auth",
        () => publications.length == beforeStrict + 1)) return checks;
    check("manual services write remains blocked before marker ACK",
        !manualDone && !upstream.any!(line => line.canFind("meta-canary-one"))
        && publications[beforeStrict]["servicesLegacyAuthPending"].get!long == 1);
    metaAcksAllowed = size_t.max;
    if (!awaitCheck("manual services write follows acknowledged marker",
        () => manualDone && upstream.any!(line => line.canFind("meta-canary-one"))
            && !c.ordinaryMetaPublisherRunning)) return checks;
    check("strict barrier invalidates older ordinary publication",
        publications.length == beforeStrict + 1 && !c.metaDirty);

    const beforeOversize = publications.length;
    rejectNext = "too_large";
    metaAcksAllowed = beforeOversize;
    manualDone = false;
    runTask(() nothrow {
        try {
            c.sendRaw("PRIVMSG NickServ :IDENTIFY meta-canary-two", true);
            manualDone = true;
        } catch (Exception error) {
            check("second manual services write succeeds", false);
        }
    });
    if (!awaitCheck("oversize fixture delays first strict payload",
        () => publications.length == beforeOversize + 1)) return checks;
    // Simulate another live auth marker changing while the holder replies.
    c.services.restoreLegacyAuth(3);
    c.requestMetaPublication();
    metaAcksAllowed = beforeOversize + 1;
    if (!awaitCheck("explicit too_large rebuilds once inside the same lock",
        () => publications.length == beforeOversize + 2)) return checks;
    const fallback = publications[beforeOversize + 1];
    check("oversize fallback omits members and captures the newest strict marker",
        !publications[beforeOversize]["usersDropped"].get!bool
        && fallback["usersDropped"].get!bool
        && fallback["channelUsers"].toString() == "{}"
        && fallback["servicesLegacyAuthPending"].get!long == 3);
    check("fallback ACK still blocks services and retains only one payload",
        !manualDone && !upstream.any!(line => line.canFind("meta-canary-two"))
        && c.metaBuildOperations == 1 && c.ordinaryMetaPublisherRunning);
    metaAcksAllowed = size_t.max;
    if (!awaitCheck("oversize barrier and coalesced publisher complete",
        () => manualDone && upstream.any!(line => line.canFind("meta-canary-two"))
            && !c.ordinaryMetaPublisherRunning)) return checks;
    check("ordinary follow-up never restores an older auth marker",
        publications[$ - 1]["servicesLegacyAuthPending"].get!long == 3
        && c.metaBuildOperations == 0);

    registerServicesOperation(ServiceAction.accountInfo, new WireInfoOperation);
    c.sessionNick = "me";
    c.processLine(":s 900 me me!u@h acct :You are now logged in as acct");
    auto typed = parseJsonString(`{"params":{"account":"acct"}}`);
    typed["requestId"] = randomUUID().toString();
    typed["action"] = "accountInfo";
    typed["expectedConnectionEpoch"] = c.getConnectionEpoch();
    typed["expectedActorAccount"] = "acct";
    const beforeTyped = publications.length;
    const upstreamBeforeTyped = upstream.length;
    metaAcksAllowed = beforeTyped;
    runTask(() nothrow {
        try {
            c.executeServices(ServicesRequest.fromJson(typed), (ServicesResult result) {});
        } catch (Exception error) {
            check("typed services execution succeeds", false);
        }
    });
    if (!awaitCheck("typed services marker awaits physical holder ACK",
        () => publications.length == beforeTyped + 1)) return checks;
    check("typed services probes and commands remain unsent before marker ACK",
        upstream.length == upstreamBeforeTyped && c.metaBuildOperations == 1);
    metaAcksAllowed = size_t.max;
    if (!awaitCheck("typed services transport starts after marker ACK",
        () => upstream.length > upstreamBeforeTyped && c.metaBuildOperations == 0)) return checks;
    // This fixture deliberately provides no service replies: end its probe
    // without leaving a transaction behind for the remaining META cases.
    c.services.onDisconnect();

    const beforeBusy = publications.length;
    rejectNext = "busy";
    check("non-oversize holder error fails strict barrier without fallback",
        !c.publishMetaStrict() && publications.length == beforeBusy + 1);
    const beforeRetries = publications.length;
    rejectAll = "busy";
    c.requestMetaPublication();
    if (!awaitCheck("failed ordinary META retries finish without spinning",
        () => !c.ordinaryMetaPublisherRunning)) return checks;
    rejectAll = "";
    check("ordinary failures retain dirty state with three bounded attempts",
        publications.length == beforeRetries + 3 && c.metaDirty && c.metaBuildOperations == 0);

    // A socket/epoch replacement or shutdown during control admission must
    // cancel without building or sending the previous session's state.
    blockControl();
    if (!awaitCheck("replacement fixture blocks admission", () => statusSeen == 3)) return checks;
    const beforeReplacement = publications.length;
    c.requestMetaPublication();
    sleep(5.msecs);
    c.connectionEpoch = "replacement-epoch";
    statusAllowed = true;
    if (!awaitCheck("stale epoch publisher completes without sending",
        () => !c.ordinaryMetaPublisherRunning && statusDone)) return checks;
    check("post-wait epoch check cancels stale payload construction",
        publications.length == beforeReplacement && c.metaBuildOperations == 0 && c.metaDirty);
    blockControl();
    if (!awaitCheck("shutdown fixture blocks admission", () => statusSeen == 4)) return checks;
    c.requestMetaPublication();
    sleep(5.msecs);
    c.requestMoveStop();
    check("retired generation is not quiescent while publisher waits", !c.getMoveQuiescent());
    statusAllowed = true;
    if (!awaitCheck("shutdown publisher relinquishes its task",
        () => !c.ordinaryMetaPublisherRunning && statusDone)) return checks;
    check("shutdown cancels META and then permits retirement",
        c.getMoveQuiescent() && publications.length == beforeReplacement
        && c.metaBuildOperations == 0);
    return checks;
}

/// Exercises the same parser, state transitions and publication channel as
/// the socket reader. Called explicitly by connection-registration-test.
Ircv3Check[] ircv3ProtocolChecks(out string[] wire) {
    Ircv3Check[] results;
    {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        foreach (line; [
            ":me!u@h JOIN #banned",
            ":op!u@h KICK #banned me :removed",
            ":s 353 me = #banned :@op!u@h alice!u@h",
        ]) {
            wire ~= line;
            client.processLine(line);
        }
        results ~= Ircv3Check("outside partial public NAMES creates neither membership nor live roster",
            "#banned" !in client.channelState && "#banned" !in client.channelUsers
            && "#banned" in client.namesBurst);
        foreach (line; [
            ":s 366 me #banned :End of NAMES",
            ":outsider!user@host JOIN #banned account :Outside Member",
        ]) {
            wire ~= line;
            client.processLine(line);
        }
        results ~= Ircv3Check("self KICK followed by public NAMES and another JOIN stays outside",
            "#banned" !in client.channelState && "#banned" !in client.channelUsers
            && "#banned" !in client.namesBurst && "#banned" !in client.namesBurstAt
            && "outsider" !in client.idents && "outsider" !in client.accounts
            && "outsider" !in client.realnames
            && !client.config.autoJoinChannels.canFind("#banned")
            && client.config.partedChannels.canFind("#banned"));
        ch.close();
        IRCRawEvent event;
        string[] published;
        while (ch.tryConsumeOne(event, Duration.zero))
            if (["JOIN", "KICK", "353", "366"].canFind(event.command))
                published ~= event.command;
        results ~= Ircv3Check("nonmember JOIN and public NAMES still publish normally",
            published == ["JOIN", "KICK", "353", "366", "JOIN"]);
    }
    foreach (numeric; ["403", "471", "473", "474", "475", "477", "489"]) {
        NetworkConfig cfg;
        cfg.nick = "me";
        cfg.autoJoinChannels = ["#refused", "#elsewhere"];
        cfg.partedChannels = ["#left"];
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.processLine(":me!u@h JOIN #refused");
        client.processLine(":alice!user@host JOIN #refused account :Alice");
        client.processLine(":s 353 me = #refused :me alice partial!user@host");
        client.recordPendingJoins("#REFUSED,#elsewhere");
        client.channelTopics["#refused"] = "retained topic";
        client.channelMetadata["#refused"]["url"] = "https://example.test/";
        client.gapNamesPending["#refused"] = true;
        client.memberFlaps[client.memberKey("#refused", "alice")] = MemberFlap.init;
        client.metaDirty = false;
        foreach (line; [
            ":s " ~ numeric ~ " me",
            ":s " ~ numeric ~ " me me :No channel",
            ":s " ~ numeric ~ " me :#refused invalid",
            ":s " ~ numeric ~ " me #refused,other :Not a single channel",
        ]) {
            wire ~= line;
            client.processLine(line);
        }
        results ~= Ircv3Check(numeric ~ " with a missing or invalid channel leaves observed state alone",
            "#refused" in client.channelState && "#refused" in client.channelUsers
            && client.joinsAwaitingConfirm.canFind("#refused") && !client.metaDirty);
        client.metaDirty = false;
        const refusal = ":s " ~ numeric ~ " me #REFUSED :Cannot join channel";
        wire ~= refusal;
        client.processLine(refusal);
        results ~= Ircv3Check(numeric ~ " clears normalized observed state and pending JOIN, preserving intent",
            "#refused" !in client.channelState && "#refused" !in client.channelUsers
            && "#refused" !in client.namesBurst && "#refused" !in client.namesBurstAt
            && "#refused" !in client.gapNamesPending && "#refused" !in client.channelTopics
            && "#refused" !in client.channelMetadata && client.memberFlaps.length == 0
            && "alice" !in client.idents && "alice" !in client.accounts
            && "alice" !in client.realnames && "partial" !in client.idents
            && client.joinsAwaitingConfirm == ["#elsewhere"]
            && client.config.autoJoinChannels == ["#refused", "#elsewhere"]
            && client.config.partedChannels == ["#left"] && client.metaDirty);
        client.processLine(":s 366 me #refused :End of old NAMES");
        results ~= Ircv3Check(numeric ~ " cannot recover from the refused partial burst's late 366",
            "#refused" !in client.channelState && "#refused" !in client.channelUsers);
        ch.close();
        IRCRawEvent event;
        bool published;
        while (ch.tryConsumeOne(event, Duration.zero))
            if (event.command == numeric && event.text == "Cannot join channel") published = true;
        results ~= Ircv3Check(numeric ~ " refusal remains visible on the event channel", published);
    }
    foreach (mapping; ["rfc1459", "strict-rfc1459", "ascii"]) {
        NetworkConfig cfg;
        cfg.nick = "m[e]";
        cfg.partedChannels = ["#recover"];
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.isupportMap["CASEMAPPING"] = mapping;
        client.recordPendingJoins("#recover");
        const self = mapping == "ascii" ? "@+M[E]!~self@host" : "@+M{E}!~self@host";
        const names = ":s 353 m[e] = #recover :" ~ self ~ " alice!u@h";
        wire ~= names;
        client.processLine(names);
        results ~= Ircv3Check(mapping ~ " partial self-containing NAMES cannot adopt or restore intent",
            "#recover" !in client.channelState && "#recover" !in client.channelUsers
            && client.config.partedChannels == ["#recover"]
            && client.config.autoJoinChannels.length == 0
            && client.joinsAwaitingConfirm == ["#recover"]);
        const end = ":s 366 m[e] #recover :End of NAMES";
        wire ~= end;
        client.processLine(end);
        results ~= Ircv3Check(mapping ~ " completed prefixed userhost self evidence recovers membership and intent",
            "#recover" in client.channelState
            && client.channelUsers.get("#recover", null).canFind(self)
            && client.channelUsers.get("#recover", null).length == 2
            && client.config.autoJoinChannels == ["#recover"]
            && client.config.partedChannels.length == 0 && client.joinsAwaitingConfirm.length == 0
            && "#recover" !in client.namesBurst && "#recover" !in client.namesBurstAt);
        ch.close();
        IRCRawEvent event;
        while (ch.tryConsumeOne(event, Duration.zero)) {}
    }
    {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        foreach (line; [
            ":me!u@h JOIN #confirmed",
            ":alice!known@host JOIN #confirmed",
            ":s 353 me = #CONFIRMED :@alice",
            ":s 366 me #CONFIRMED :End of NAMES",
            ":s 366 me #unknown :End without a burst",
        ]) {
            wire ~= line;
            client.processLine(line);
        }
        results ~= Ircv3Check("confirmed self JOIN survives NAMES omission and preserves member metadata",
            "#confirmed" in client.channelState
            && client.channelUsers.get("#confirmed", null) == ["@alice!known@host"]);
        results ~= Ircv3Check("366 without an accumulated burst never invents unknown membership",
            "#unknown" !in client.channelState && "#unknown" !in client.channelUsers);
        ch.close();
        IRCRawEvent event;
        while (ch.tryConsumeOne(event, Duration.zero)) {}
    }
    {
        NetworkConfig cfg;
        cfg.nick = "old";
        cfg.autoJoinChannels = ["#gap"];
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.processLine(":old!u@h JOIN #gap");
        client.invalidateHolderGapState();
        const staleNames = ":s 353 old = #gap :old alice";
        client.attachBacklogBytes = staleNames.length + 2;
        wire ~= staleNames;
        client.processLine(staleNames);
        results ~= Ircv3Check("holder gap quarantines pre-gap self-containing NAMES",
            "#gap" !in client.channelState && "#gap" !in client.channelUsers
            && "#gap" !in client.namesBurst && "#gap" in client.gapNamesPending);
        // applyNamesBurst retains old metadata for an empty burst; that
        // retained self entry must never become fresh membership evidence.
        client.channelUsers["#gap"] = ["old!u@h"];
        client.namesBurst["#gap"] = null;
        client.namesBurstAt["#gap"] = 1;
        const emptyEnd = ":s 366 old #gap :End of empty NAMES";
        wire ~= emptyEnd;
        client.processLine(emptyEnd);
        results ~= Ircv3Check("holder gap requires self in the completed burst, not the retained roster",
            "#gap" !in client.channelState && "#gap" !in client.channelUsers
            && "#gap" !in client.gapNamesPending && "#gap" !in client.namesBurst
            && "#gap" !in client.namesBurstAt && client.config.autoJoinChannels == ["#gap"]);
        client.gapNamesPending["#gap"] = true;
        client.channelUsers["#gap"] = ["old!u@h"];
        client.processLine(":s 366 old #gap :End without a burst");
        results ~= Ircv3Check("holder gap 366 without a burst consumes pending proof and discards retained membership",
            "#gap" !in client.channelState && "#gap" !in client.channelUsers
            && "#gap" !in client.gapNamesPending);
        client.gapNamesPending["#gap"] = true;
        client.recordPendingJoins("#gap");
        const freshNames = ":s 353 new[nick] = #GAP :@NEW{NICK}!user@host alice";
        wire ~= freshNames;
        client.processLine(freshNames);
        results ~= Ircv3Check("holder gap fresh self-containing partial burst still cannot restore membership",
            "#gap" !in client.channelState && "#gap" !in client.channelUsers
            && "#gap" in client.gapNamesPending);
        const freshEnd = ":s 366 new[nick] #GAP :End of NAMES";
        wire ~= freshEnd;
        client.processLine(freshEnd);
        results ~= Ircv3Check("holder gap completion updates recipient nick before CASEMAPPING self proof",
            client.sessionNick == "new[nick]" && "#gap" in client.channelState
            && client.channelUsers.get("#gap", null) == ["@NEW{NICK}!user@host", "alice"]
            && "#gap" !in client.gapNamesPending && "#gap" !in client.namesBurst
            && "#gap" !in client.namesBurstAt && client.joinsAwaitingConfirm.length == 0);
        ch.close();
        IRCRawEvent event;
        while (ch.tryConsumeOne(event, Duration.zero)) {}
    }
    foreach (command; ["PRIVMSG", "NOTICE", "REDACT", "TAGMSG"]) {
        foreach (outgoing; [false, true]) {
            NetworkConfig cfg;
            cfg.nick = "m[e]";
            auto ch = EngineEventChannel.create();
            auto client = new PersistentIRCClient(cfg, ch);
            client.ackedCaps["echo-message"] = true;
            client.queryBuffers = ["B[ob]"];
            const source = outgoing ? "M{E}" : "b{OB}";
            const target = outgoing ? "b{ob}" : "M{E}";
            const suffix = command == "TAGMSG" ? "" : " :hello";
            const line = "@+typing=active;+reply=ref;+draft/react=x :" ~ source
                ~ "!u@h " ~ command ~ " " ~ target ~ suffix;
            wire ~= line;
            client.processLine(line);
            ch.close();
            IRCRawEvent event;
            bool found;
            while (ch.tryConsumeOne(event)) {
                if (event.command != command) continue;
                found = event.channel == "B[ob]";
            }
            results ~= Ircv3Check(command ~ (outgoing ? " own echo" : " incoming")
                ~ " uses the CASEMAPPING-equivalent canonical DM", found);
        }
    }
    foreach (target; ["#chan", "&chan", "+chan", "!chan"]) {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.isupportMap["CHANTYPES"] = "#&+!";
        client.processLine(":bob!u@h TAGMSG " ~ target);
        ch.close();
        IRCRawEvent event;
        bool found;
        while (ch.tryConsumeOne(event))
            if (event.command == "TAGMSG") found = event.channel == target;
        results ~= Ircv3Check("TAGMSG retains channel " ~ target, found);
    }
    foreach (line; ["TAGMSG me", ":bob!u@h TAGMSG", ":me!u@h TAGMSG :"]) {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.processLine(line);
        ch.close();
        IRCRawEvent event;
        bool empty = client.queryBuffers.length == 0;
        while (ch.tryConsumeOne(event))
            if (event.command == "TAGMSG") empty = empty && event.channel.length == 0;
        results ~= Ircv3Check("incomplete TAGMSG creates no phantom query: " ~ line, empty);
    }
    {
        import vibe.data.json : parseJsonString;
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.metaDirty = false;
        foreach (line; [
            ":s 005 * NETWORK=Example NICKLEN=30 FOO=bar",
            ":s 005 me NICKLEN=42",
            ":s 005 me -FOO",
            ":s 005 me NICKLEN=42 NETWORK=Example :custom server prose",
            ":s 005 me NICKLEN=42 :",
            ":s 005 me -NICKLEN",
            ":s 005 me -NICKLEN",
            ":s 005 me =bad BAD-KEY=x :ignored",
        ]) {
            wire ~= line;
            client.processLine(line);
        }
        ch.close();
        IRCRawEvent[] published;
        IRCRawEvent event;
        while (ch.tryConsumeOne(event))
            if (event.command == "ISUPPORT") published ~= event;
        results ~= Ircv3Check("005 publishes exactly the four effective changes", published.length == 4);
        if (published.length == 4) {
            const first = parseJsonString(published[0].text);
            const replacement = parseJsonString(published[1].text);
            const withdrawal = parseJsonString(published[2].text);
            const reset = parseJsonString(published[3].text);
            results ~= Ircv3Check("trailerless 005 retains its final real token",
                first["FOO"].get!string == "bar" && first["NICKLEN"].get!string == "30");
            results ~= Ircv3Check("same-size replacement publishes the complete updated map",
                replacement["NICKLEN"].get!string == "42" && replacement["FOO"].get!string == "bar");
            results ~= Ircv3Check("withdrawal publishes the full map without the removed token",
                withdrawal["FOO"].type == Json.Type.undefined && withdrawal["NETWORK"].get!string == "Example");
            results ~= Ircv3Check("withdrawn legacy value resets to its default",
                reset["NICKLEN"].type == Json.Type.undefined && client.serverFeatures.maxNickLen == ServerFeatures.init.maxNickLen);
        }
        results ~= Ircv3Check("effective ISUPPORT changes dirty the session snapshot", client.metaDirty);
    }
    {
        ServerFeatures features;
        string[string] support;
        bool valid = true;
        foreach (token; ["network=Example", "prefix=(ov)@+", "chanmodes=b,k,l,im",
                         "nicklen=42", "topiclen=300", "chanlimit=#:20"])
            valid = applyIsupport(features, support, token) && valid;
        valid = valid && features.network == "Example" && features.maxNickLen == 42
            && features.topicLen == 300 && features.maxChannels == 20;
        valid = !applyIsupport(features, support, "NICKLEN=42") && valid;
        valid = applyIsupport(features, support, "NICKLEN=invalid") && valid;
        valid = valid && features.maxNickLen == 42;
        foreach (key; ["NETWORK", "PREFIX", "CHANMODES", "NICKLEN", "TOPICLEN", "CHANLIMIT"])
            valid = applyIsupport(features, support, "-" ~ key) && valid;
        valid = valid && features == ServerFeatures.init && support.length == 0;
        foreach (token; ["", "-", "=bad", "-FOO=bar", "BAD KEY=x", "BAD-KEY=x", "-NETWORK"])
            valid = !applyIsupport(features, support, token) && valid;
        results ~= Ircv3Check("normalized legacy values, invalid numbers and effective withdrawals", valid);
    }
    {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.processLine(":me!u@h JOIN #profile");
        client.processLine(":alice!u@h JOIN #profile");
        const pronouns = "  they/them <b>verbatim</b>  ";
        client.processLine(":s METADATA alice pronouns * :" ~ pronouns);
        client.processLine(":s METADATA alice color * :#80a0ff");
        results ~= Ircv3Check("user metadata caches verbatim pronouns and valid color",
            client.userMetadata.get("alice", null).get("pronouns", "") == pronouns
            && client.userMetadata.get("alice", null).get("color", "") == "#80a0ff");
        client.processLine(":s METADATA alice pronouns * :she/they");
        client.processLine(":s METADATA alice color * :#ABCDEF");
        results ~= Ircv3Check("user metadata replacements replace both prior values",
            client.userMetadata.get("alice", null).get("pronouns", "") == "she/they"
            && client.userMetadata.get("alice", null).get("color", "") == "#ABCDEF");
        client.processLine(":s METADATA alice pronouns * :unsafe\x7fvalue");
        client.processLine(":s METADATA alice color * :#12345g");
        results ~= Ircv3Check("invalid incoming replacements cannot leave renderable profile values",
            "alice" !in client.userMetadata);
        client.processLine(":s METADATA alice pronouns * :" ~ pronouns);
        client.processLine(":s METADATA alice color * :#80a0ff");
        client.processLine(":alice!u@h NICK bob");
        results ~= Ircv3Check("NICK moves pronouns and color without retaining the old identity",
            "alice" !in client.userMetadata
            && client.userMetadata.get("bob", null).get("pronouns", "") == pronouns
            && client.userMetadata.get("bob", null).get("color", "") == "#80a0ff");
        client.processLine(":s METADATA bob pronouns * :");
        client.processLine(":s METADATA bob color *");
        results ~= Ircv3Check("empty and valueless metadata remove the profile keys",
            "bob" !in client.userMetadata);
        client.processLine(":s METADATA bob pronouns * :they/them");
        client.processLine(":s METADATA bob color * :#80a0ff");
        client.processLine(":bob!u@h QUIT :bye");
        results ~= Ircv3Check("QUIT removes both user profile values", "bob" !in client.userMetadata);
        client.processLine(":s METADATA #profile pronouns * :they/them");
        client.processLine(":s METADATA #profile color * :#80a0ff");
        results ~= Ircv3Check("pronouns and color remain invalid channel metadata",
            "#profile" !in client.channelMetadata);
        ch.close();
        IRCRawEvent event;
        while (ch.tryConsumeOne(event)) {}
    }
    {
        import ircfiber.engine.session_snapshot : HistoryCursor, HistoryRecovery;
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.connectionEpoch = "history-check";
        client.ackedCaps["draft/chathistory"] = true;
        client.ackedCaps["batch"] = true;
        client.processLine(":me!u@h JOIN #present");
        client.processLine(":alice!u@h JOIN #present");
        client.channelTopics["#present"] = "current";
        client.userMetadata["alice"]["pronouns"] = "current";
        client.historyPages = null;
        client.historyAutomaticQueue = null;
        client.outboundQueue = null;
        IRCRawEvent event;
        while (ch.tryConsumeOne(event, Duration.zero)) {}
        client.processLine("BATCH +outer labeled-response");
        client.processLine("@batch=outer BATCH +history chathistory #past");
        foreach (line; [":me!u@h JOIN #past", ":alice!u@h NICK old",
                       ":alice!u@h QUIT :gone", ":alice!u@h TOPIC #present :old",
                       ":s METADATA alice pronouns * :old", ":me!u@h PART #present"]) {
            client.processLine("@batch=history " ~ line);
        }
        client.processLine("@batch=history BATCH +multi draft/multiline #past");
        client.processLine("@batch=multi :me!u@h PRIVMSG me :first");
        client.processLine("@batch=multi :me!u@h PRIVMSG me :second");
        client.processLine("BATCH -multi");
        client.processLine("@batch=history;+typing=active :alice!u@h TAGMSG me");
        client.processLine(":live!u@h PRIVMSG me :live");
        client.processLine("BATCH -history");
        client.processLine("BATCH -outer");
        IRCRawEvent[] rows;
        while (ch.tryConsumeOne(event, Duration.zero)) rows ~= event;
        size_t historicalRows, liveRows, mergedRows;
        bool targetCorrect = true;
        foreach (row; rows) {
            if (row.getTag("batch") == "chathistory") {
                ++historicalRows;
                targetCorrect = targetCorrect && row.channel == "#past";
                if (row.command == "PRIVMSG" && row.text == "first\nsecond") ++mergedRows;
            } else if (row.command == "PRIVMSG" && row.channel == "live") ++liveRows;
        }
        results ~= Ircv3Check("nested replay preserves historical own/state rows and assembles multiline once",
            historicalRows == 7 && mergedRows == 1 && targetCorrect && liveRows == 1);
        results ~= Ircv3Check("historical identity, membership, metadata and topic cannot mutate current state",
            client.sessionNick == "me" && "#past" !in client.channelState
            && "#present" in client.channelState && client.channelUsers["#present"].length == 2
            && client.channelTopics["#present"] == "current"
            && client.userMetadata["alice"]["pronouns"] == "current"
            && !client.queryBuffers.canFind("old") && client.outboundQueue.length == 0);
        client.processLine("@batch=missing :alice!u@h PRIVMSG me :not live");
        client.processLine("BATCH +missing chathistory #past");
        client.processLine("@batch=missing :alice!u@h NICK forged");
        results ~= Ircv3Check("unknown and reused batch references stay quarantined",
            !ch.tryConsumeOne(event, Duration.zero) && client.sessionNick == "me");
        client.processLine("BATCH -missing");
        ch.close();
    }
    {
        import ircfiber.engine.session_snapshot : HistoryCursor, HistoryRecovery;
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.connectionEpoch = "pages-check";
        client.ackedCaps["draft/chathistory"] = true;
        client.isupportMap["CHATHISTORY"] = "20";
        client.isupportMap["MSGREFTYPES"] = "msgid,timestamp";
        HistoryRecovery coverage;
        coverage.target = "#gap";
        coverage.lowerBound = HistoryCursor("old", 1_700_000_000_000, true);
        coverage.state = "complete";
        client.historyRecovery["#gap"] = coverage;
        client.beginTargetRecovery("#gap");
        client.drainHistoryQueue();
        const firstId = client.historyPages.keys[0];
        client.processLine("BATCH +p chathistory #gap");
        client.processLine("@batch=p;time=2023-11-14T22:13:40.000Z;msgid=z :a!u@h PRIVMSG #gap :one");
        client.processLine("@batch=p;time=2023-11-14T22:13:40.000Z;msgid=a :a!u@h PRIVMSG #gap :two");
        client.processLine("BATCH -p");
        results ~= Ircv3Check("short nonempty history page awaits ordered storage checkpoint",
            client.historyPages[firstId].awaitingCommit && client.outboundQueue.length == 1
            && client.historyPages[firstId].proposed.state == "recovering");
        client.confirmHistoryPage(firstId, true);
        results ~= Ircv3Check("committed page continues BEFORE first opaque msgid across timestamp ties",
            client.outboundQueue.length == 2
            && client.outboundQueue[$ - 1] == "CHATHISTORY BEFORE #gap msgid=z 20"
            && client.historyRecovery["#gap"].lowerBound.msgid == "old");
        const secondId = client.historyPages.keys[0];
        client.processLine("@draft/chathistory-end BATCH +p2 chathistory #gap");
        client.processLine("@batch=p2;time=2023-11-14T22:13:00.000Z;msgid=older :a!u@h PRIVMSG #gap :older");
        client.processLine("BATCH -p2");
        client.failHistoryStorage(secondId, client.connectionEpoch);
        client.confirmHistoryPage(secondId, false);
        results ~= Ircv3Check("failed row storage cannot commit newer coverage",
            client.historyRecovery["#gap"].lowerBound.msgid == "old"
            && client.historyRecovery["#gap"].state == "stalled"
            && client.historyPages.length == 0);
        IRCRawEvent event;
        while (ch.tryConsumeOne(event, Duration.zero)) {}
        ch.close();
    }
    {
        import ircfiber.engine.session_snapshot : HistoryCursor, HistoryRecovery;
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        HistoryRecovery seed;
        seed.target = "history-peer";
        seed.lowerBound = HistoryCursor("seed", 1_700_000_000_000, true);
        seed.upperBound = seed.lowerBound;
        seed.state = "complete";
        auto pending = seed;
        pending.state = "stalled";
        pending.reasonCode = "storage_failure";
        pending.nextBefore = HistoryCursor("uncommitted-first", 1_700_000_020_000, true);
        pending.upperBound = HistoryCursor("uncommitted-last", 1_700_000_040_000, true);
        // Rehydrate META, then merge the older dedicated hash just as adoption
        // does after a failed page has closed and vanished from pending requests.
        client.historyRecovery["history-peer"] = pending;
        client.mergeCommittedHistoryCoverage("history-peer", seed);
        auto snapshot = client.snapshotSession();
        auto next = new PersistentIRCClient(cfg, ch);
        next.connectionEpoch = "failed-storage-adoption";
        next.ackedCaps["draft/chathistory"] = true;
        next.isupportMap["CHATHISTORY"] = "20";
        next.restoreHistoryState(snapshot);
        IRCRawEvent live;
        live.command = "PRIVMSG";
        live.channel = "history-peer";
        live.tagsJson = `{"msgid":"new-live","time":"2023-11-14T22:14:00.000Z"}`;
        next.noteAcceptedLiveHistory(live);
        results ~= Ircv3Check("complete Redis seed preserves closed failed-page DM intent and frozen coverage on adoption",
            next.historyRecovery["history-peer"].state == "stalled"
            && next.historyRecovery["history-peer"].reasonCode == "storage_failure"
            && next.historyRecovery["history-peer"].lowerBound.msgid == "seed"
            && !next.historyRecovery["history-peer"].nextBefore.msgid.length
            && ("history-peer" in next.historyRetryAt) !is null
            && next.historyPages.length == 0 && next.channelState.length == 0
            && next.queryBuffers.length == 0);
        next.beginTargetRecovery("history-peer");
        results ~= Ircv3Check("TARGETS rediscovery leaves adopted stalled retry scheduled without a duplicate request",
            next.historyAutomaticQueue.length == 0
            && ("history-peer" in next.historyRetryAt) !is null);
        next.historyRetryAt["history-peer"] = 0;
        next.tickHistoryRecovery();
        results ~= Ircv3Check("adopted failed first page retries DM LATEST without current channel or query membership",
            next.outboundQueue.length == 1
            && next.outboundQueue[0] == "CHATHISTORY LATEST history-peer * 20");
        const requestId = next.historyPages.keys[0];
        next.processLine("BATCH +retry chathistory history-peer");
        next.processLine("@batch=retry;time=2023-11-14T22:13:40.000Z;msgid=retry-first :history-peer!u@h PRIVMSG me :one");
        next.processLine("@batch=retry;time=2023-11-14T22:14:00.000Z;msgid=retry-last :history-peer!u@h PRIVMSG me :two");
        next.processLine("BATCH -retry");
        next.confirmHistoryPage(requestId, true);
        results ~= Ircv3Check("retried LATEST refreshes seed upper bound and continues the frozen gap with BEFORE",
            next.historyRecovery["history-peer"].lowerBound.msgid == "seed"
            && next.historyRecovery["history-peer"].upperBound.msgid == "retry-last"
            && next.outboundQueue[$ - 1] == "CHATHISTORY BEFORE history-peer msgid=retry-first 20");
        auto committed = pending;
        committed.state = "recovering";
        committed.reasonCode = "";
        committed.nextBefore = HistoryCursor("accepted-first", 1_700_000_030_000, true);
        committed.upperBound = HistoryCursor("accepted-last", 1_700_000_050_000, true);
        client.historyRecovery["history-peer"] = pending;
        client.mergeCommittedHistoryCoverage("history-peer", committed);
        results ~= Ircv3Check("newer committed page cursors win over stale META recovery cursors",
            client.historyRecovery["history-peer"].state == "recovering"
            && client.historyRecovery["history-peer"].nextBefore.msgid == "accepted-first"
            && client.historyRecovery["history-peer"].upperBound.msgid == "accepted-last");
        committed.state = "complete";
        committed.lowerBound = committed.upperBound;
        committed.nextBefore = HistoryCursor.init;
        client.mergeCommittedHistoryCoverage("history-peer", committed);
        results ~= Ircv3Check("conservative retry does not regress a newer committed completed bound",
            client.historyRecovery["history-peer"].state == "recovering"
            && client.historyRecovery["history-peer"].lowerBound.msgid == "accepted-last"
            && client.historyRecovery["history-peer"].upperBound.msgid == "accepted-last"
            && !client.historyRecovery["history-peer"].nextBefore.msgid.length);
        client.historyRecovery["history-peer"] = seed;
        client.mergeCommittedHistoryCoverage("history-peer", committed);
        snapshot = client.snapshotSession();
        auto complete = new PersistentIRCClient(cfg, ch);
        complete.restoreHistoryState(snapshot);
        results ~= Ircv3Check("complete META with complete committed coverage does not create an adoption retry",
            complete.historyRecovery["history-peer"].state == "complete"
            && complete.historyRetryAt.length == 0);
        IRCRawEvent event;
        while (ch.tryConsumeOne(event, Duration.zero)) {}
        ch.close();
    }
    {
        import ircfiber.engine.session_snapshot : HistoryCursor, HistoryRecovery;
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.connectionEpoch = "orphan-page-check";
        client.ackedCaps["draft/chathistory"] = true;
        client.ackedCaps["labeled-response"] = true;
        client.isupportMap["CHATHISTORY"] = "20";
        HistoryRecovery coverage;
        coverage.target = "#gap";
        coverage.lowerBound = HistoryCursor("covered", 1_700_000_000_000, true);
        coverage.state = "complete";
        client.historyRecovery["#gap"] = coverage;
        client.beginTargetRecovery("#gap");
        client.drainHistoryQueue();
        const request = client.historyPages.keys[0];
        const label = client.historyPages[request].label;
        client.processLine("@label=" ~ label ~ " :server BATCH +root labeled-response");
        client.processLine("@batch=root :server BATCH +page chathistory #gap");
        client.processLine("@batch=absent :server BATCH +orphan chathistory #gap");
        client.processLine("@batch=orphan;time=2023-11-14T22:13:40.000Z;msgid=untrusted :a!u@h PRIVMSG #gap :not coverage");
        client.processLine(":server BATCH -orphan");
        client.processLine(":server BATCH -page");
        client.processLine(":server BATCH -root");
        results ~= Ircv3Check("orphan history cannot turn its correlated empty root into completed coverage",
            client.historyRecovery["#gap"].state == "stalled"
            && client.historyRecovery["#gap"].lowerBound.msgid == "covered"
            && client.historyPages.length == 0);
        const writes = client.outboundQueue.length;
        client.beginTargetRecovery("#gap");
        client.drainHistoryQueue();
        results ~= Ircv3Check("TARGETS rediscovery cannot bypass a stalled page's scheduled retry",
            client.historyRecovery["#gap"].state == "stalled"
            && client.outboundQueue.length == writes && client.historyPages.length == 0);
        IRCRawEvent event;
        while (ch.tryConsumeOne(event, Duration.zero)) {}
        ch.close();
    }
    foreach (failure; ["INVALID_PARAMS", "INVALID_MSGID", "MSGID_EXPIRED"]) {
        import ircfiber.engine.session_snapshot : HistoryCursor, HistoryRecovery;
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.connectionEpoch = "expired-reference-check";
        client.ackedCaps["draft/chathistory"] = true;
        client.isupportMap["MSGREFTYPES"] = "msgid,timestamp";
        HistoryRecovery recovery;
        recovery.target = "#gap";
        recovery.lowerBound = HistoryCursor("covered", 1_700_000_000_000, true);
        recovery.nextBefore = HistoryCursor("expired", 1_700_000_020_000, true);
        recovery.state = "recovering";
        client.historyRecovery["#gap"] = recovery;
        client.queueAutomaticHistory("#gap", "BEFORE", "msgid=expired");
        client.drainHistoryQueue();
        client.processLine(":s FAIL CHATHISTORY " ~ failure ~ " #gap :Reference is no longer available");
        results ~= Ircv3Check(failure ~ " retries the retained boundary using timestamp overlap",
            client.outboundQueue.length == 2
            && client.outboundQueue[$ - 1].startsWith("CHATHISTORY BEFORE #gap timestamp=")
            && client.historyRecovery["#gap"].timestampFallback
            && client.historyRecovery["#gap"].lowerBound.msgid == "covered"
            && client.historyPages.length == 1);
        IRCRawEvent event;
        while (ch.tryConsumeOne(event, Duration.zero)) {}
        ch.close();
    }
    {
        import ircfiber.engine.session_snapshot : HistoryCursor, HistoryRecovery;
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto client = new PersistentIRCClient(cfg, ch);
        client.connectionEpoch = "timestamp-check";
        client.ackedCaps["draft/chathistory"] = true;
        client.isupportMap["CHATHISTORY"] = "3";
        client.isupportMap["MSGREFTYPES"] = "timestamp";
        HistoryRecovery coverage;
        coverage.target = "#ties";
        coverage.lowerBound = HistoryCursor("", 1_699_999_980_000, true);
        coverage.state = "complete";
        client.historyRecovery["#ties"] = coverage;
        client.beginTargetRecovery("#ties");
        client.drainHistoryQueue();
        const id = client.historyPages.keys[0];
        client.processLine("BATCH +t chathistory #ties");
        client.processLine("@batch=t;time=2023-11-14T22:13:20.000Z :a!u@h PRIVMSG #ties :tie one");
        client.processLine("@batch=t;time=2023-11-14T22:13:20.000Z :a!u@h PRIVMSG #ties :tie two");
        client.processLine("@batch=t;time=2023-11-14T22:13:21.000Z :a!u@h PRIVMSG #ties :newer");
        client.processLine("BATCH -t");
        client.confirmHistoryPage(id, true);
        results ~= Ircv3Check("timestamp-only mixed pages overlap the boundary group toward newer time",
            client.outboundQueue[$ - 1] == "CHATHISTORY BEFORE #ties timestamp=2023-11-14T22:13:21.000Z 3");
        client.processLine("BATCH +repeat chathistory #ties");
        foreach (_; 0 .. 3)
            client.processLine("@batch=repeat;time=2023-11-14T22:13:20.000Z :a!u@h PRIVMSG #ties :clipped tie");
        client.processLine("BATCH -repeat");
        results ~= Ircv3Check("clipped timestamp boundary remains stalled instead of skipping retained ties",
            client.historyRecovery["#ties"].state == "stalled"
            && client.historyRecovery["#ties"].reasonCode == "timestamp_boundary"
            && client.historyRecovery["#ties"].lowerBound.timestampMs == coverage.lowerBound.timestampMs);
        auto snapshot = client.snapshotSession();
        auto next = new PersistentIRCClient(cfg, ch);
        next.connectionEpoch = "adopted-check";
        next.ackedCaps["draft/chathistory"] = true;
        next.restoreHistoryState(snapshot);
        results ~= Ircv3Check("holder adoption retains scheduled retry for a closed stalled page",
            ("#ties" in next.historyRetryAt) !is null);
        next.historyRecovery["*targets"] = HistoryRecovery.init;
        next.historyRecovery["*targets"].target = "*targets";
        next.historyRecovery["*targets"].state = "stalled";
        next.historyRecovery["*targets"].discoveryUpperBoundMs = 1_700_000_010_000;
        next.historyRetryAt["*targets"] = 0;
        next.tickHistoryRecovery();
        results ~= Ircv3Check("discovery retry reconstructs bounded TARGETS rather than invalid channel history",
            next.outboundQueue.length == 1 && next.outboundQueue[0].startsWith("CHATHISTORY TARGETS timestamp="));
        IRCRawEvent event;
        while (ch.tryConsumeOne(event, Duration.zero)) {}
        ch.close();
    }
    {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto old = new PersistentIRCClient(cfg, ch);
        old.processLine("BATCH +history chathistory #past");
        old.processLine("@batch=history BATCH +partial draft/multiline #past");
        old.processLine("@batch=partial :me!u@h PRIVMSG me :before handoff");
        auto snapshot = old.snapshotSession(true);
        auto next = new PersistentIRCClient(cfg, ch);
        next.connectionEpoch = "reader-two";
        next.restoreHistoryState(snapshot);
        next.processLine("@batch=partial :me!u@h PRIVMSG me :after handoff");
        next.processLine("BATCH -partial");
        next.processLine("BATCH -history");
        IRCRawEvent event;
        IRCRawEvent[] rows;
        while (ch.tryConsumeOne(event, Duration.zero)) rows ~= event;
        results ~= Ircv3Check("retained ancestry and partial multiline assemble one historical own message after handoff",
            rows.length == 1 && rows[0].text == "before handoff\nafter handoff"
            && rows[0].channel == "#past" && rows[0].getTag("batch") == "chathistory");
        ch.close();
    }
    {
        import std.datetime : Clock;
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        scope(exit) ch.close();
        auto client = new PersistentIRCClient(cfg, ch);
        void feed(string line) {
            wire ~= line;
            client.processLine(line);
            IRCRawEvent event;
            while (ch.tryConsumeOne(event, Duration.zero)) {}
        }
        feed(":me!m@hm JOIN #linear");
        feed(":Case[fold]!old@ha JOIN #linear");
        feed(":s 353 me = #linear :@me +CASE{FOLD}");
        feed(":s 353 me = #linear :!~case[fold]!new@hb case{fold}");
        feed(":s 366 me #linear :End");
        results ~= Ircv3Check("NAMES duplicate folded spellings merge prefix and newer host without duplicating members",
            client.snapshotSession().channelUsers["#linear"]
                == ["@me!m@hm", "!~case[fold]!new@hb"]
            && client.getIdents().get("Case[fold]", "") == "new");
        feed(":s 353 me = #linear :me +CASE{FOLD}");
        feed(":s 366 me #linear :End");
        results ~= Ircv3Check("NAMES bare folded nick reuses the previous host but takes the burst's prefix",
            client.snapshotSession().channelUsers["#linear"] == ["me!m@hm", "+CASE{FOLD}!new@hb"]);
        feed(":s 353 me = #linear :me @Case{fold} transient!u@h tail");
        feed(":case[fold]!new@hb PART #linear :left during NAMES");
        feed(":transient!u@h QUIT :left during NAMES");
        feed(":Case[fold]!next@hc JOIN #linear");
        feed(":s 353 me = #linear :+case{fold} extra");
        feed(":Case[fold]!next@hc NICK Moved");
        feed(":s 353 me = #linear :@moved");
        feed(":s 366 me #linear :End");
        results ~= Ircv3Check("NAMES PART QUIT JOIN and NICK churn neither reuses departed positions nor old occupant hosts",
            client.snapshotSession().channelUsers["#linear"]
                == ["me!m@hm", "tail", "@Moved!next@hc", "extra"]
            && client.getIdents().get("Moved", "") == "next");
        feed(":s 353 me = #linear :me stale!old@host");
        client.namesBurstAt["#linear"] = Clock.currTime.toUnixTime!long
            - NAMES_BURST_STALE_SECS - 1;
        feed(":s 353 me = #linear :me fresh!new@host");
        feed(":s 366 me #linear :End");
        results ~= Ircv3Check("NAMES stale-burst replacement discards old members and their ident spellings",
            client.snapshotSession().channelUsers["#linear"] == ["me!m@hm", "fresh!new@host"]
            && "stale" !in client.getIdents());
        feed(":s 353 me = #linear :me abandoned!old@host");
        feed(":me!m@hm PART #linear :leave an incomplete burst");
        feed(":me!m@hm JOIN #linear");
        feed(":s 353 me = #linear :me survivor!u@h");
        feed(":s 366 me #linear :End");
        results ~= Ircv3Check("NAMES channel departure and next completed burst cannot resurrect the abandoned generation",
            client.snapshotSession().channelUsers["#linear"] == ["me!m@hm", "survivor!u@h"]
            && "abandoned" !in client.getIdents());
        feed(":s 005 me CASEMAPPING=ascii :supported");
        feed(":s 353 me = #linear :me @a[b +a{b");
        feed(":s 366 me #linear :End");
        results ~= Ircv3Check("NAMES ascii mapping keeps bracket-distinct members",
            client.snapshotSession().channelUsers["#linear"] == ["me!m@hm", "@a[b", "+a{b"]);
        feed(":s 353 me = #linear :me @a[b");
        feed(":s 005 me CASEMAPPING=rfc1459 :supported");
        feed(":s 353 me = #linear :+A{B");
        feed(":s 366 me #linear :End");
        results ~= Ircv3Check("NAMES mapping change rebuilds the pending index before merging equivalent nicks",
            client.snapshotSession().channelUsers["#linear"] == ["me!m@hm", "+a[b"]);
    }
    return results;
}


/// One named outbound-discovery check. Shared by the module unittest and
/// the `connection-registration-test` harness (built with the
/// `FiberMlsWireHarness` version), which prints and counts them.
struct FiberMlsCheck {
    string name;
    bool passed;
}

private string fiberCheckNonce(size_t i) {
    import std.format : format;
    return format("%064x", i);
}

private string fiberCheckQuery(size_t i, string channel) {
    import ircfiber.irc.mls_peer : buildFiberMlsQuery;
    return buildFiberMlsQuery(fiberCheckNonce(i), channel, 400);
}

/// Feeds the roster the checks use while unregistered (any WHO the JOINs
/// provoke waits in the outbound queue, nothing is written), then marks
/// the session registered at `connectedAt`. We are `me!~m@host.a` in #c
/// and #d; alice is in both, bob, erin and gina only in #c, carol is a
/// bare #c entry.
private void fiberCheckSession(PersistentIRCClient c, long connectedAt) {
    foreach (line; [":me!~m@host.a JOIN #c", ":alice!~a@ha JOIN #c", ":bob!~b@hb JOIN #c",
                    ":erin!~e@he JOIN #c", ":gina!~g@hg JOIN #c",
                    ":me!~m@host.a JOIN #d", ":alice!~a@ha JOIN #d"])
        c.processLine(line);
    c.channelUsers["#c"] ~= "carol";
    c.state = ConnectionState.connected;
    c.connectedAtMs = connectedAt;
}

/// Outbound discovery state transitions with an injected clock, no socket:
/// queue admission, per-recipient coalescing, write-time revalidation,
/// staleness, the msg/raw bypasses, cooldowns across a reconnect, the
/// responder refresh and the `mls_peer_deferred` lease a refused fresh
/// nonce for a proven responder is told.
FiberMlsCheck[] fiberMlsBackstopChecks() {
    import std.algorithm : endsWith;

    FiberMlsCheck[] results;
    void check(string name, bool passed) { results ~= FiberMlsCheck(name, passed); }
    NetworkConfig cfg;
    cfg.nick = "me";
    auto ch = EngineEventChannel.create();
    scope (exit) ch.close();
    auto c = new PersistentIRCClient(cfg, ch);
    const t0 = unixMsNow();
    fiberCheckSession(c, t0);
    FiberProbeDeferral deferral;
    bool queue(string target, size_t n, string channel, long at) {
        return c.queueFiberProbe("PRIVMSG " ~ target ~ " :" ~ fiberCheckQuery(n, channel), at, deferral);
    }
    /// The retryAfterMs a refused request is told (0: silent); -1 when it
    /// was queued, -2 when a deferral names some other nonce.
    long deferred(string target, size_t n, string channel, long at) {
        if (queue(target, n, channel, at)) return -1;
        if (deferral.retryAfterMs > 0 && deferral.nonce != fiberCheckNonce(n)) return -2;
        return deferral.retryAfterMs;
    }
    FiberProbe probe;
    bool needWho;
    string whoChan;
    bool take(long at) { return c.takeFiberProbe(at, probe, needWho, whoChan); }
    long blocked(string r) { auto g = r in c.fiberRecipients; return g ? g.blockedUntilMs : 0; }
    long chanGuard(string r, string chan) {
        auto g = r in c.fiberRecipients;
        return g ? g.channelNotBeforeMs.get(chan, 0) : 0;
    }
    bool proven(string r, long at) { auto g = r in c.fiberRecipients; return g && fiberResponsive(*g, at); }
    string idLine(string nick, string host, size_t n) {
        return ":" ~ nick ~ "!" ~ host ~ " NOTICE me :\x01FIBERMLS 1 ID " ~ fiberCheckNonce(n) ~ " "
            ~ fiberCheckNonce(999) ~ "\x01";
    }

    check("a QUERY to a member of a shared joined channel is queued", queue("alice", 1, "#c", t0));
    check("a fresh nonce for a recipient and channel already queued coalesces", !queue("alice", 2, "#c", t0));
    check("the same recipient and channel in another letter case coalesces", !queue("ALICE", 4, "#c", t0));
    check("the same recipient on another shared channel is held, not dropped", queue("alice", 3, "#d", t0));
    bool burst = false;
    foreach (n; 100 .. 164) burst |= queue("alice", n, n % 2 ? "#c" : "#d", t0);
    check("64 fresh nonces to one recipient add nothing", !burst && c.fiberProbeQueue.length == 2);
    check("a member not on the named channel is never probed", !queue("bob", 5, "#d", t0));
    check("a channel we are not in is never probed", !queue("bob", 6, "#zz", t0));
    check("a nick on no roster is never probed", !queue("dave", 7, "#c", t0));
    check("we never probe ourselves", !queue("me", 8, "#c", t0));
    check("a different recipient is still queued", queue("bob", 10, "#c", t0));
    check("a bare roster member may be queued", queue("carol", 11, "#c", t0));

    // Hold the pacer so nothing reaches writeRaw (there is no socket).
    c.fiberProbeNotBeforeMs = long.max;
    const queued = c.fiberProbeQueue.length;
    const paced = c.pacedQueue.length;
    const outbound = c.outboundQueue.length;
    c.sendLabeledMessage("erin", fiberCheckQuery(20, "#c"), "lbl-1");
    check("a msg-path QUERY joins the same validated queue, unlabeled, never as chat",
        c.fiberProbeQueue.length == queued + 1 && c.fiberProbeQueue[$ - 1].recipient == "erin"
        && ("lbl-1" in c.pendingLabels) is null && c.pacedQueue.length == paced);
    c.sendMessage("erin", fiberCheckQuery(21, "#c"));
    c.sendMessage("alice", fiberCheckQuery(22, "#d"));
    c.sendMessage("dave", fiberCheckQuery(23, "#c"));
    c.sendMessage("gina", fiberCheckQuery(24, "#c"), ["+reply": "m1"]);
    c.sendMessage("gina", "hi " ~ fiberCheckQuery(25, "#c"));
    c.sendMessage("gina", "line one\n" ~ fiberCheckQuery(26, "#c"));
    c.sendLabeledNotice("gina", "\x01FIBERMLS 1 ID " ~ fiberCheckNonce(27) ~ " "
        ~ fiberCheckNonce(28) ~ "\x01", "lbl-2");
    const q = fiberCheckQuery(29, "#c");
    foreach (line; ["NOTICE gina :\x01FIBERMLS 1 ID " ~ fiberCheckNonce(29) ~ " " ~ fiberCheckNonce(29) ~ "\x01",
                    "PRIVMSG #c :" ~ q, "PRIVMSG @gina :" ~ q, "PRIVMSG me :" ~ q,
                    "PRIVMSG gina,bob :" ~ q, "@+x=1 PRIVMSG gina :" ~ q,
                    "PRIVMSG gina :\x01FIBERMLS 1 QUERY nope\x01", "PRIVMSG gina :hello " ~ q])
        c.sendRaw(line, true);
    check("repeats, absent targets, tags, embedded or malformed control and ID replies are dropped"
        ~ " on both the msg and raw paths",
        c.fiberProbeQueue.length == queued + 1 && c.pacedQueue.length == paced
        && c.outboundQueue.length == outbound && ("lbl-2" in c.pendingLabels) is null);
    c.fiberProbeNotBeforeMs = 0;

    check("the first queued probe is written at once",
        take(t0) && probe.target == "alice" && probe.chanKey == "#c" && probe.nonce == fiberCheckNonce(1));
    check("writing it blocks that unproven recipient on every channel for 5 min",
        blocked("alice") == t0 + FIBERMLS_UNANSWERED_COOLDOWN_MS
        && chanGuard("alice", "#c") == t0 + FIBERMLS_UNANSWERED_COOLDOWN_MS
        && (fiberCheckNonce(1) in c.fiberProbesSent) !is null);
    check("the next probe waits for its pacing slot", !take(t0 + 500));
    check("a fresh nonce for the channel already on the wire is refused, silently while unproven",
        deferred("alice", 30, "#c", t0 + 600) == 0);
    // Behind the queue, bob's nick now names someone else and carol left.
    string[] moved;
    foreach (e; c.channelUsers["#c"]) {
        if (e.endsWith("bob!~b@hb")) moved ~= "bob!~x@elsewhere";
        else if (e != "carol") moved ~= e;
    }
    c.channelUsers["#c"] = moved;
    check("an unproven recipient's second channel waits while its first QUERY is unanswered;"
        ~ " probes whose target changed identity or left are dropped at write time",
        take(t0 + 1000) && probe.target == "erin" && c.fiberProbeQueue.length == 1
        && c.fiberProbeQueue[0].recipient == "alice" && c.fiberProbeQueue[0].chanKey == "#d"
        && ("bob" in c.fiberRecipients) is null && ("carol" in c.fiberRecipients) is null);
    c.processLine(idLine("alice", "~a@ha", 1));
    check("a matching ID reply proves the recipient and sets that channel's 20 s refresh",
        (fiberCheckNonce(1) in c.fiberProbesSent) is null && blocked("alice") == 0
        && proven("alice", t0 + 2000) && chanGuard("alice", "#c") == t0 + FIBERMLS_RESPONDER_REFRESH_MS);
    check("a proven responder's other shared channel then gets its own QUERY",
        take(t0 + 2000) && probe.target == "alice" && probe.chanKey == "#d" && c.fiberProbeQueue.length == 0);
    // A reloaded client asks again with fresh nonces: told exactly how long
    // the responder's own pacing holds them, never queued or written early.
    const sentBefore = c.fiberProbesSent.length;
    check("a fresh nonce inside a proven responder's 20 s channel refresh is deferred for the remainder",
        deferred("alice", 33, "#c", t0 + 5000) == FIBERMLS_RESPONDER_REFRESH_MS - 5000);
    check("a fresh nonce while that responder's QUERY for the channel is on the wire waits until 20 s"
        ~ " after that write",
        deferred("alice", 34, "#d", t0 + 5000) == 2000 + FIBERMLS_RESPONDER_REFRESH_MS - 5000);
    check("a deferred request is neither queued nor written",
        c.fiberProbeQueue.length == 0 && c.fiberProbesSent.length == sentBefore && !take(t0 + 5000));
    check("a proven responder is not refreshed on a channel sooner than 20 s: the last 1 ms is deferred",
        deferred("alice", 31, "#c", t0 + FIBERMLS_RESPONDER_REFRESH_MS - 1) == 1);
    check("a proven responder may be refreshed on that channel after 20 s",
        queue("alice", 32, "#c", t0 + FIBERMLS_RESPONDER_REFRESH_MS));
    check("another client's fresh nonce for that queued refresh waits one pacing slot plus the 20 s refresh",
        deferred("alice", 36, "#c", t0 + FIBERMLS_RESPONDER_REFRESH_MS)
            == FIBERMLS_RESPONDER_REFRESH_MS + FIBERMLS_PROBE_INTERVAL_MS && c.fiberProbeQueue.length == 1);
    check("only the first request's QUERY is written",
        take(t0 + FIBERMLS_RESPONDER_REFRESH_MS) && probe.nonce == fiberCheckNonce(32)
        && c.fiberProbeQueue.length == 0);
    check("on the wire past its 20 s refresh point, an awaited answer defers until that nonce lapses",
        deferred("alice", 37, "#d", t0 + 22_500) == 2000 + FIBERMLS_FRESH_MS - 22_500
        && deferred("alice", 38, "#c", t0 + 22_500) == 2 * FIBERMLS_RESPONDER_REFRESH_MS - 22_500);

    const tg = t0 + 21_000;
    check("a probe can be queued for gina", queue("gina", 40, "#c", tg));
    check("a probe still unwritten 20 s after the request is dropped, never sent late",
        !take(tg + FIBERMLS_PROBE_MAX_AGE_MS + 1) && c.fiberProbeQueue.length == 0
        && ("gina" in c.fiberRecipients) is null);
    check("a QUERY a proven responder left unanswered revokes the proof and blocks every channel",
        !proven("alice", tg + FIBERMLS_PROBE_MAX_AGE_MS + 1)
        && blocked("alice") == t0 + 2000 + FIBERMLS_UNANSWERED_COOLDOWN_MS
        && blocked("erin") == t0 + 1000 + FIBERMLS_UNANSWERED_COOLDOWN_MS);
    const ts = tg + FIBERMLS_PROBE_MAX_AGE_MS + 1;
    check("a revoked or never-proven recipient is never deferred: its refusal stays silent",
        deferred("alice", 39, "#c", ts) == 0 && deferred("alice", 43, "#d", ts) == 0
        && deferred("erin", 44, "#c", ts) == 0 && c.fiberProbeQueue.length == 0);
    c.state = ConnectionState.connecting;
    check("nothing is accepted while registering for later delivery", !queue("gina", 41, "#c", tg + 23_000));
    c.state = ConnectionState.disconnected;
    check("nothing is accepted while disconnected for later delivery", !queue("gina", 42, "#c", tg + 23_000));

    // Our reconnect: same client object, new socket generation. The #c
    // refresh written at t0 + 20 s is still in flight and goes unanswered.
    c.resetConnectionTelemetry();
    check("a reconnect forgets queued and sent probes but keeps per-recipient cooldowns",
        c.fiberProbeQueue.length == 0 && c.fiberProbesSent.length == 0
        && blocked("alice") == t0 + FIBERMLS_RESPONDER_REFRESH_MS + FIBERMLS_UNANSWERED_COOLDOWN_MS
        && blocked("erin") == t0 + 1000 + FIBERMLS_UNANSWERED_COOLDOWN_MS);
    const t1 = t0 + 50_000;
    c.state = ConnectionState.connected;
    c.connectedAtMs = t1;
    c.ownPrefix = "me!~m@host.a";
    check("the new socket cannot re-probe an unanswered recipient on any channel inside its cooldown",
        !queue("alice", 50, "#d", t1) && !queue("alice", 51, "#c", t1) && !queue("erin", 52, "#c", t1));
    check("a recipient that was dropped, never written, may still be probed",
        queue("bob", 53, "#c", t1) && take(t1) && probe.target == "bob");
    c.processLine(idLine("bob", "~x@elsewhere", 53));
    check("a responding recipient is not refreshed sooner than 20 s: the reloaded client is deferred",
        proven("bob", t1) && deferred("bob", 54, "#c", t1 + FIBERMLS_RESPONDER_REFRESH_MS - 1) == 1);
    check("a responding recipient may be refreshed after 20 s",
        queue("bob", 55, "#c", t1 + FIBERMLS_RESPONDER_REFRESH_MS));
    const aliceFree = t0 + FIBERMLS_RESPONDER_REFRESH_MS + FIBERMLS_UNANSWERED_COOLDOWN_MS;
    check("an unanswered recipient may be asked again once its 5 min cooldown ends",
        !queue("alice", 56, "#c", aliceFree - 1) && queue("alice", 57, "#c", aliceFree));
    FiberRecipientGuard responder, unproven;
    responder.answeredSentAtMs = t1;
    responder.channelNotBeforeMs["#c"] = t1 - 1000 + FIBERMLS_UNANSWERED_COOLDOWN_MS;
    responder.channelNotBeforeMs["#d"] = t1 + FIBERMLS_RESPONDER_REFRESH_MS;
    unproven.channelNotBeforeMs["#d"] = t1 + 1000;
    check("only a proven responder's own pacing is deferred, never past 20 s plus one pacing slot:"
        ~ " an unanswered QUERY's channel cooldown and an unproven recipient stay silent",
        fiberResponderDeferMs(responder, "#c", false, 0, t1) == 0
        && fiberResponderDeferMs(responder, "#d", false, 0, t1) == FIBERMLS_RESPONDER_REFRESH_MS
        && fiberResponderDeferMs(responder, "#e", false, 0, t1) == 0
        && fiberResponderDeferMs(responder, "#c", true, 0, t1)
            == FIBERMLS_RESPONDER_REFRESH_MS + FIBERMLS_PROBE_INTERVAL_MS
        && fiberResponderDeferMs(responder, "#e", false, t1 - FIBERMLS_FRESH_MS, t1) == 1
        && fiberResponderDeferMs(unproven, "#d", true, t1, t1) == 0
        && fiberResponderDeferMs(unproven, "#d", false, 0, t1) == 0);

    const sq = "PRIVMSG a :" ~ fiberCheckQuery(60, "#c");
    check("a queued client command carrying FIBERMLS is stale past 20 s or undated, chat never",
        staleFiberMlsCommand(sq, t0 - FIBERMLS_PROBE_MAX_AGE_MS - 1, t0)
        && staleFiberMlsCommand(sq, 0, t0)
        && !staleFiberMlsCommand(sq, t0 - 1_000, t0)
        && !staleFiberMlsCommand("PRIVMSG a :hello", 0, t0));
    return results;
}

/// The same paths over a real localhost socket: a fake ircd records every
/// line the client writes (returned in `wire`). Two tabs and a native
/// client asking for one person, an absent nick, control smuggled into
/// chat and an ID NOTICE put exactly one QUERY on the wire; a different
/// recipient gets its own one pacing slot later; the first recipient's
/// second shared channel goes only after its first QUERY is answered.
FiberMlsCheck[] fiberMlsWireChecks(out string[] wire) {
    import std.algorithm : canFind, filter, startsWith;
    import std.array : array;
    import core.time : msecs;
    import vibe.core.core : sleep;
    import vibe.core.net : listenTCP;
    import vibe.stream.operations : readLine;

    FiberMlsCheck[] results;
    void check(string name, bool passed) { results ~= FiberMlsCheck(name, passed); }
    string[] got;
    bool peerClosed = false;
    auto listener = listenTCP(0, (TCPConnection peer) {
        try {
            while (!peer.empty) got ~= (cast(const(char)[]) peer.readLine()).idup;
        } catch (Exception) {}
        try peer.close(); catch (Exception) {}
        peerClosed = true;
    }, "127.0.0.1");
    auto ch = EngineEventChannel.create();
    NetworkConfig cfg;
    cfg.nick = "me";
    auto c = new PersistentIRCClient(cfg, ch);
    c.connection = connectTCP("127.0.0.1", listener.bindAddress.port);
    // Close our end, let the fake ircd's handler see EOF and close the
    // accepted socket, then stop listening and run the loop once more so
    // eventcore releases every handle before the process exits.
    void cleanup() {
        try {
            c.connection.close();
            foreach (_; 0 .. 200) {
                if (peerClosed) break;
                sleep(10.msecs);
            }
            listener.stopListening();
            sleep(10.msecs);
        } catch (Exception) {}
        ch.close();
    }
    scope (exit) cleanup();
    fiberCheckSession(c, unixMsNow());
    static string[] messages(string[] lines) {
        return lines.filter!(l => l.startsWith("PRIVMSG") || l.startsWith("NOTICE")
            || l.startsWith("BATCH") || l.startsWith("@") || l.canFind("FIBERMLS")).array;
    }

    const qa = fiberCheckQuery(1, "#c");
    c.sendRaw("PRIVMSG alice :" ~ qa, true);                              // tab 1
    c.sendRaw("PRIVMSG alice :" ~ fiberCheckQuery(2, "#c"), true);       // tab 2, fresh nonce
    c.sendMessage("alice", fiberCheckQuery(3, "#d"));                    // shared channel, msg path
    c.sendLabeledMessage("Alice", fiberCheckQuery(4, "#c"), "bnc-1");    // native client
    c.sendRaw("PRIVMSG dave :" ~ fiberCheckQuery(5, "#c"), true);        // shares nothing
    c.sendMessage("bob", "hello " ~ fiberCheckQuery(6, "#c"));           // smuggled in chat
    c.sendLabeledNotice("bob", "\x01FIBERMLS 1 ID " ~ fiberCheckNonce(6) ~ " "
        ~ fiberCheckNonce(7) ~ "\x01", "bnc-2");
    const qb = fiberCheckQuery(8, "#c");
    c.sendMessage("bob", qb);                                            // different recipient
    sleep(300.msecs);
    const early = messages(got);
    check("one QUERY reaches the wire for alice however many tabs, nonces and paths ask",
        early == ["PRIVMSG alice :" ~ qa]);
    sleep((FIBERMLS_PROBE_INTERVAL_MS + 200).msecs);
    c.drainFiberProbes();
    sleep(300.msecs);
    check("a different recipient gets its own QUERY one pacing slot later; alice's #d waits unanswered",
        messages(got) == ["PRIVMSG alice :" ~ qa, "PRIVMSG bob :" ~ qb]
        && c.fiberProbeQueue.length == 1 && c.fiberProbeQueue[0].chanKey == "#d");
    // alice answers the #c QUERY: her #d proof may now be asked for.
    c.processLine(":alice!~a@ha NOTICE me :\x01FIBERMLS 1 ID " ~ fiberCheckNonce(1) ~ " "
        ~ fiberCheckNonce(999) ~ "\x01");
    sleep((FIBERMLS_PROBE_INTERVAL_MS + 200).msecs);
    c.drainFiberProbes();
    sleep(300.msecs);
    const qd = fiberCheckQuery(3, "#d");
    check("a proven responder's second channel gets exactly one QUERY after the answer",
        messages(got) == ["PRIVMSG alice :" ~ qa, "PRIVMSG bob :" ~ qb, "PRIVMSG alice :" ~ qd]);
    // A reloaded tab asks the proven responder again with fresh nonces: #c
    // is inside its 20 s refresh, #d still on the wire. Both are deferred
    // (published only with an owner), neither is queued or written.
    c.sendRaw("PRIVMSG alice :" ~ fiberCheckQuery(9, "#c"), true);
    c.sendMessage("alice", fiberCheckQuery(10, "#d"));
    sleep((FIBERMLS_PROBE_INTERVAL_MS + 200).msecs);
    c.drainFiberProbes();
    sleep(300.msecs);
    wire = got.dup;
    check("nothing further is written once the queue is spent, nor for a reloaded tab's deferred nonces",
        messages(got).length == 3 && c.fiberProbeQueue.length == 0);
    check("no client label is registered for a probe", ("bnc-1" in c.pendingLabels) is null
        && ("bnc-2" in c.pendingLabels) is null);
    return results;
}

} // version (FiberMlsChecks)

version (unittest) version = ServicesIdentityChecks;
version (FiberMlsWireHarness) version = ServicesIdentityChecks;

version (ServicesIdentityChecks) {

/// One named services-identity check, printed and counted by the
/// `connection-registration-test` harness.
struct ServicesIdentityCheck {
    string name;
    bool passed;
}

/// Engine-observed services identity over a real localhost socket: a fake
/// ircd runs two registrations (the first with a SASL 900, the second
/// without) and records every line the client writes (returned in `wire`).
/// Proves the account comes only from server statements, every registered
/// socket and every engine attach of a retained socket gets a fresh
/// canonical UUID epoch, logout/relogin and disconnect are announced, and
/// a detached engine exports and announces nothing.
ServicesIdentityCheck[] servicesIdentityWireChecks(out string[] wire) {
    import std.algorithm : canFind;
    import std.uuid : parseUUID, UUID;
    import core.time : msecs;
    import vibe.core.core : sleep;
    import vibe.core.net : listenTCP;
    import vibe.stream.operations : readLine;

    ServicesIdentityCheck[] results;
    void check(string name, bool passed) { results ~= ServicesIdentityCheck(name, passed); }
    static bool canonicalUuid(string s) {
        if (s.length != 36) return false;
        try {
            const u = UUID(s);
            return u != UUID.init && u.toString() == s;
        } catch (Exception) {
            return false;
        }
    }

    const loggedIn = ":s 900 me me!~m@host.a acct :You are now logged in as acct\r\n"
        ~ ":s 001 me :Welcome\r\n"
        ~ ":s 005 me WHOX CASEMAPPING=rfc1459 :are supported by this server\r\n"
        ~ ":s 376 me :End of MOTD\r\n";
    const anonymous = ":s 001 me :Welcome\r\n:s 376 me :End of MOTD\r\n";
    string[] got;
    int accepted;
    int closedPeers;
    auto listener = listenTCP(0, (TCPConnection peer) {
        const n = accepted++;
        try {
            peer.write(n == 0 ? loggedIn : anonymous);
            peer.flush();
            while (!peer.empty) got ~= (cast(const(char)[]) peer.readLine()).idup;
        } catch (Exception) {}
        try peer.close(); catch (Exception) {}
        ++closedPeers;
    }, "127.0.0.1");
    auto ch = EngineEventChannel.create();
    NetworkConfig cfg;
    cfg.nick = "me";
    // Configuration only: never evidence of who we are logged in as.
    cfg.saslUsername = "configured-sasl";
    auto c = new PersistentIRCClient(cfg, ch);
    string[][] announced;
    void drain() {
        IRCRawEvent ev;
        while (ch.tryConsumeOne(ev, 0.msecs))
            if (ev.command == "SERVICES_STATE") announced ~= ev.getParams();
    }
    void closeSocket(int peersBefore) {
        try c.connection.close(); catch (Exception) {}
        foreach (_; 0 .. 200) {
            if (closedPeers > peersBefore) break;
            try sleep(10.msecs); catch (Exception) {}
        }
    }
    void cleanup() {
        closeSocket(accepted - 1);
        try {
            listener.stopListening();
            sleep(10.msecs);
        } catch (Exception) {}
        ch.close();
    }
    scope (exit) cleanup();
    /// The real registration read loop, then attemptConnectionImpl's
    /// RPL_WELCOME tail for the services generation.
    void register() {
        c.connection = connectTCP("127.0.0.1", listener.bindAddress.port);
        c.performRegistration();
        c.connectedAtMs = unixMsNow();
        c.state = ConnectionState.connected;
        c.beginServicesGeneration();
        drain();
    }

    register();
    const epoch1 = c.getConnectionEpoch();
    check("a SASL 900 read off the wire during registration is the observed account",
        c.getServicesAccountState() == ServicesAccountState.account && c.getServicesAccount() == "acct");
    check("the configured SASL username is never the observed account",
        c.getServicesAccount() != cfg.saslUsername);
    check("registration mints a canonical random UUID epoch", canonicalUuid(epoch1));
    check("one SERVICES_STATE announces the new generation",
        announced == [["account", "acct", epoch1, "unknown"]]);

    c.requestSelfWho();
    sleep(300.msecs);
    check("a self WHO asks WHOX to restate our account", got.canFind("WHO me %tcuhnfar,152"));
    c.processLine(":s 354 me 152 * ~m host.a me H acct :Me");
    drain();
    check("a WHOX row restating the same account announces nothing", announced.length == 1);
    c.processLine(":s 901 me me!~m@host.a :You are now logged out");
    drain();
    check("901 is a logout on the same epoch",
        c.getServicesAccountState() == ServicesAccountState.none && c.getServicesAccount() == ""
        && c.getConnectionEpoch() == epoch1 && announced[$ - 1] == ["none", "", epoch1, "unknown"]);
    c.processLine("@batch=hist :me!~m@host.a ACCOUNT replayed");
    c.processLine(":bob!~b@hb ACCOUNT acct");
    check("replayed and other users' ACCOUNT lines are not our login",
        c.getServicesAccountState() == ServicesAccountState.none);
    c.processLine(":me!~m@host.a ACCOUNT acct2");
    drain();
    check("a live self ACCOUNT is a relogin",
        c.getServicesAccount() == "acct2" && announced[$ - 1] == ["account", "acct2", epoch1, "unknown"]);

    // Drop and redial: everything belonged to the old socket.
    closeSocket(0);
    c.state = ConnectionState.disconnected;
    c.resetConnectionTelemetry();
    drain();
    check("a dropped socket clears the epoch and login and says so",
        c.getConnectionEpoch() == "" && c.servicesAccount == ""
        && announced[$ - 1] == ["unknown", "", "", "unavailable"]);
    register();
    const epoch2 = c.getConnectionEpoch();
    check("the next registered socket gets a different epoch", canonicalUuid(epoch2) && epoch2 != epoch1);
    check("no 900 leaves identity unknown, whatever SASL config says",
        c.getServicesAccountState() == ServicesAccountState.unknown && c.getServicesAccount() == ""
        && announced[$ - 1] == ["unknown", "", epoch2, "unknown"]);
    c.processLine(":me!~m@host.a ACCOUNT acct2");
    drain();

    // Hot swap of the retained socket: META carries the login, never the
    // epoch; the detached engine goes quiet; the attaching one mints anew.
    auto meta = c.snapshotSession(true);
    c.detachedForHotSwap = true;
    const before = announced.length;
    c.processLine(":s 901 me me!~m@host.a :You are now logged out");
    drain();
    check("a detached engine exports and announces nothing",
        c.getConnectionEpoch() == "" && c.getServicesAccount() == "" && announced.length == before);
    auto next = new PersistentIRCClient(cfg, ch);
    next.connectedAtMs = meta.connectedAtMs;
    next.state = ConnectionState.connected;
    next.restoreServicesAccount(meta, true);
    next.mintConnectionEpoch();
    const epoch3 = next.getConnectionEpoch();
    check("an attached retained socket keeps its generation but gets a new epoch",
        canonicalUuid(epoch3) && epoch3 != epoch2 && next.getConnectedAtMs() == c.connectedAtMs);
    check("a graceful same-generation META restores the observed login",
        next.getServicesAccountState() == ServicesAccountState.account && next.getServicesAccount() == "acct2");
    auto crashed = new PersistentIRCClient(cfg, ch);
    crashed.connectedAtMs = meta.connectedAtMs;
    crashed.state = ConnectionState.connected;
    crashed.restoreServicesAccount(meta, false);
    crashed.mintConnectionEpoch();
    check("a crash attach cannot prove the login: unknown until the server restates it",
        crashed.getServicesAccountState() == ServicesAccountState.unknown && crashed.getServicesAccount() == ""
        && crashed.getConnectionEpoch() != epoch3);
    c.detachedForHotSwap = false;
    drain();
    wire = got.dup;
    return results;
}

} // version (ServicesIdentityChecks)

@("Services identity over a localhost socket: observed account, per-generation epochs, attach")
unittest {
    string[] wire;
    foreach (check; servicesIdentityWireChecks(wire)) assert(check.passed, check.name);
}

@("FIBERMLS outbound discovery: one validated probe per recipient, cooldowns, no msg/raw bypass")
unittest {
    foreach (check; fiberMlsBackstopChecks()) assert(check.passed, check.name);
    string[] wire;
    foreach (check; fiberMlsWireChecks(wire)) assert(check.passed, check.name);
}

@("IRCv3 registry: away, WHOX, CHGHOST, ACCOUNT *, batches, ACK, RENAME, FAIL CHATHISTORY, CAP")
unittest {
    import std.algorithm : count, filter;
    import std.array : array;
    import std.typecons : tuple;

    static auto make() {
        NetworkConfig cfg;
        cfg.nick = "me";
        auto ch = EngineEventChannel.create();
        auto c = new PersistentIRCClient(cfg, ch);
        c.queryBuffers = ["a", "bob", "carol", "dave", "eve"];
        c.queryHosts["a"] = "u@h";
        return tuple(c, ch);
    }
    static IRCRawEvent[] drain(typeof(make()) t) {
        t[1].close(); // an open, empty channel blocks tryConsumeOne
        IRCRawEvent[] got;
        IRCRawEvent e;
        while (t[1].tryConsumeOne(e)) got ~= e;
        return got;
    }
    static auto run(string[] lines) {
        auto t = make();
        foreach (l; lines) t[0].processLine(l);
        return tuple(t[0], drain(t));
    }

    // AWAY: text → stored; no text → present again.
    auto aw = run([":a!u@h AWAY :lunch"]);
    assert(aw[0].getAway()["a"] == "lunch");
    auto back = run([":a!u@h AWAY :lunch", ":a!u@h AWAY"]);
    assert(("a" in back[0].getAway()) is null);
    // QUIT and NICK keep the map in step.
    auto awNick = run([":a!u@h AWAY :lunch", ":a!u@h NICK b"]);
    assert(("a" in awNick[0].getAway()) is null && awNick[0].getAway()["b"] == "lunch");
    auto awQuit = run([":a!u@h AWAY :lunch", ":a!u@h QUIT :x"]);
    assert(("a" in awQuit[0].getAway()) is null);

    // Our own 306 keeps the message we set, not the server's text.
    {
        auto t = make();
        t[0].sendRaw("AWAY :brb");
        t[0].processLine(":s 306 me :You have been marked as being away");
        assert(t[0].isAway && t[0].awayMessage == "brb");
        drain(t);
    }

    // WHOX 152: away, bot, account, ident from one row.
    auto whox = run([":s 005 me WHOX BOT=b :are supported",
                     ":s 354 me 152 #c ident host bob Gb acct :Real Name"]);
    assert(("bob" in whox[0].getAway()) !is null);
    assert(("bob" in whox[0].getBots()) !is null);
    assert(whox[0].getAccounts()["bob"] == "acct");
    assert(whox[0].getIdents()["bob"] == "ident");
    assert(whox[0].getRealnames()["bob"] == "Real Name");
    assert(whox[1].count!(e => e.command == "354") == 0, "an unrequested 354 is never published");
    // A later row without the flags: present, not a bot, logged out.
    auto whox2 = run([":s 005 me WHOX BOT=b :are supported",
                      ":s 354 me 152 #c ident host bob Gb acct :Real Name",
                      ":s 354 me 152 #c ident host bob H 0 :Real Name"]);
    assert(("bob" in whox2[0].getAway()) is null);
    assert(("bob" in whox2[0].getBots()) is null);
    assert(("bob" in whox2[0].getAccounts()) is null);
    // whoLine asks for WHOX only when the server has it.
    assert(whox[0].whoLine("#c") == "WHO #c %tcuhnfar,152");
    assert(run([])[0].whoLine("#c") == "WHO #c");

    // A client's own WHOX (the E2EE roster probe) is answered to it, and
    // the engine's sweep queued behind it stays private.
    {
        auto t = make();
        t[0].processLine(":s 005 me WHOX :are supported");
        t[0].sendRaw("WHO #c %na", true);
        t[0].sendRaw(t[0].whoLine("#c"));
        foreach (l; [":s 354 me bob acct", ":s 354 me carol 0", ":s 315 me #c :End of /WHO list.",
                     ":s 354 me 152 #c u h dave H dacct :Dave", ":s 315 me #c :End of /WHO list."])
            t[0].processLine(l);
        auto got = drain(t);
        assert(got.count!(e => e.command == "354") == 2, "the client's rows only");
        assert(got.count!(e => e.command == "315") == 1, "the client's terminator only");
        assert(t[0].getAccounts()["bob"] == "acct");
        assert(("carol" in t[0].getAccounts()) is null);
        assert(t[0].getAccounts()["dave"] == "dacct");
        assert(t[0].pendingWhos.length == 0);
    }
    // Plain WHO: 352 rows follow the same ownership.
    {
        auto t = make();
        t[0].sendRaw("WHO #c");
        t[0].sendRaw("WHO #d", true);
        foreach (l; [":s 352 me #c u h s bob H :0 Bob", ":s 315 me #c :End",
                     ":s 352 me #d u h s eve H :0 Eve", ":s 315 me #D :End"])
            t[0].processLine(l);
        auto got = drain(t);
        assert(got.count!(e => e.command == "352") == 1 && got.count!(e => e.command == "315") == 1);
        assert(t[0].getRealnames()["bob"] == "Bob" && t[0].getRealnames()["eve"] == "Eve");
    }

    // CHGHOST rewrites every roster entry for the nick.
    auto chg = run([":me!u@h JOIN #c", ":me!u@h JOIN #d", ":a!u@h JOIN #c", ":a!u@h JOIN #d",
                    ":a!u@h CHGHOST nu nh"]);
    foreach (chan; ["#c", "#d"])
        assert(chg[0].getChannelUsers()[chan].canFind("a!nu@nh"), chan);
    assert(chg[0].getIdents()["a"] == "nu");

    // ACCOUNT * logs out.
    auto acct = run([":a!u@h ACCOUNT acct", ":a!u@h ACCOUNT *"]);
    assert(("a" in acct[0].getAccounts()) is null);

    // Unbatched live traffic stays live while a history batch is open.
    auto hist = run(["BATCH +x chathistory #c", ":s PRIVMSG #c :live",
                     "@batch=x :s PRIVMSG #c :old", "BATCH -x"]);
    auto msgs = hist[1].filter!(e => e.command == "PRIVMSG").array;
    assert(msgs.length == 2);
    assert(msgs[0].text == "live" && msgs[0].getTag("batch") != "chathistory");
    assert(msgs[1].text == "old" && msgs[1].getTag("batch") == "chathistory");

    // draft/multiline: one message per batch, concat honoured.
    auto ml = run(["BATCH +m draft/multiline #c", "@batch=m :a!u@h PRIVMSG #c :one",
                   "@batch=m;draft/multiline-concat :a!u@h PRIVMSG #c :two", "BATCH -m"]);
    auto mlMsgs = ml[1].filter!(e => e.command == "PRIVMSG").array;
    assert(mlMsgs.length == 1 && mlMsgs[0].text == "onetwo", mlMsgs.length ? mlMsgs[0].text : "none");
    auto ml2 = run(["BATCH +m draft/multiline #c", "@batch=m :a!u@h PRIVMSG #c :one",
                    "@batch=m :a!u@h PRIVMSG #c :two", "BATCH -m"]);
    auto ml2Msgs = ml2[1].filter!(e => e.command == "PRIVMSG").array;
    assert(ml2Msgs.length == 1 && ml2Msgs[0].text == "one\ntwo");
    assert(ml2Msgs[0].channel == "#c");

    // labeled-response: ACK clears the label and is never published; a
    // label on a labeled-response batch reaches the inner lines.
    {
        auto t = make();
        t[0].pendingLabels["L1"] = 1;
        t[0].processLine("@label=L1 :s ACK");
        assert(!t[0].isPendingLabel("L1"));
        assert(drain(t).length == 0);
    }
    {
        auto t = make();
        t[0].pendingLabels["L2"] = 1;
        t[0].processLine("@label=L2 BATCH +b labeled-response");
        t[0].processLine("@batch=b :s FAIL PRIVMSG CANNOT_SEND #c :nope");
        t[0].processLine("BATCH -b");
        auto got = drain(t);
        assert(!t[0].isPendingLabel("L2"));
        assert(got.length == 1 && got[0].getTag("label") == "L2");
    }

    // RENAME moves every per-channel fact and is published under the new name.
    {
        auto t = make();
        t[0].processLine(":me!u@h JOIN #old");
        t[0].processLine(":a!u@h JOIN #old");
        t[0].processLine(":s METADATA #old display-name * :Lobby");
        t[0].processLine(":me!u@h RENAME #old #new :r");
        auto c = t[0];
        assert(("#old" in c.channelState) is null && ("#new" in c.channelState) !is null);
        assert(("#old" in c.channelUsers) is null && c.channelUsers["#new"].length == 2);
        assert(!c.config.autoJoinChannels.canFind("#old") && c.config.autoJoinChannels.canFind("#new"));
        assert(c.getChannelMetadata()["#new"]["display-name"] == "Lobby");
        auto got = drain(t);
        auto ren = got.filter!(e => e.command == "RENAME").array;
        assert(ren.length == 1 && ren[0].channel == "#new");
    }

    // FAIL CHATHISTORY releases the in-flight slot.
    {
        auto t = make();
        t[0].ackedCaps["draft/chathistory"] = true;
        t[0].requestChathistory("#c", "LATEST", "", 50);
        assert(t[0].isChathistoryInFlight("#c"));
        t[0].processLine(":s FAIL CHATHISTORY INVALID_TARGET LATEST #c :x");
        assert(!t[0].isChathistoryInFlight("#c"));
        drain(t);
    }
    // CHATHISTORY= clamps the limit; MSGREFTYPES without msgid uses timestamps.
    {
        auto t = make();
        t[0].ackedCaps["draft/chathistory"] = true;
        t[0].processLine(":s 005 me CHATHISTORY=20 MSGREFTYPES=timestamp :are supported");
        t[0].recordChannelMsgid("#c", "abc", 1_788_750_000_000);
        t[0].requestChathistory("#c", "BEFORE", "abc", 100);
        assert(t[0].outboundQueue[$ - 1] == "CHATHISTORY BEFORE #c timestamp=2026-09-07T03:00:00.000Z 20",
               t[0].outboundQueue[$ - 1]);
        drain(t);
    }
    // Msgid cursors move by server-time, not by string order.
    {
        auto t = make();
        t[0].recordChannelMsgid("#c", "zzz", 100);
        t[0].recordChannelMsgid("#c", "aaa", 200);
        t[0].recordChannelMsgid("#c", "mmm", 50);
        assert(t[0].getLatestMsgid("#c") == "aaa" && t[0].getEarliestMsgid("#c") == "mmm");
        drain(t);
    }

    // CAP after registration: NEW requests, ACK/DEL track the cap set.
    {
        auto t = make();
        t[0].processLine(":s CAP me NEW :draft/read-marker");
        assert(t[0].outboundQueue.canFind("CAP REQ :draft/read-marker"));
        t[0].processLine(":s CAP me ACK :draft/read-marker");
        assert(t[0].hasCap("draft/read-marker"));
        t[0].processLine(":s CAP me DEL :draft/read-marker");
        assert(!t[0].hasCap("draft/read-marker"));
        auto got = drain(t);
        assert(got.count!(e => e.command == "CAP") == 3, "post-registration CAP lines are published");
    }
    // Services relinking after registration (`CAP NEW sasl`) logs a
    // credentialed, unidentified session in over SASL and takes back the
    // nick NickServ enforcement renamed it away from.
    static auto makeSasl() {
        NetworkConfig cfg;
        cfg.nick = "me";
        cfg.sasl = SASLMechanism.plain;
        cfg.saslUsername = "me";
        cfg.saslPassword = "secretpw";
        auto ch = EngineEventChannel.create();
        return tuple(new PersistentIRCClient(cfg, ch), ch);
    }
    {
        auto t = makeSasl();
        auto c = t[0];
        c.processLine(":me!u@h NICK Guest123");
        assert(c.sessionNick == "Guest123");
        c.processLine(":s CAP Guest123 NEW :sasl=EXTERNAL,PLAIN");
        assert(c.outboundQueue.canFind("CAP REQ :sasl"));
        c.processLine(":s CAP Guest123 ACK :sasl");
        assert(c.outboundQueue.canFind("AUTHENTICATE PLAIN"));
        c.processLine("AUTHENTICATE +");
        assert(c.outboundQueue.canFind("AUTHENTICATE " ~ buildSaslPlainPayload("me", "secretpw")));
        assert(!c.outboundQueue.canFind!(l => l.startsWith("PRIVMSG NickServ")), "never IDENTIFY over PRIVMSG");
        c.processLine(":s 900 Guest123 Guest123!u@h me :You are now logged in as me");
        c.processLine(":s 903 Guest123 :SASL authentication successful");
        assert(c.outboundQueue[$ - 1] == "NICK me", c.outboundQueue.join(" | "));
        assert(!c.lateSaslPending && c.forcedFromNick.length == 0);
        auto got = drain(t);
        assert(!got.canFind!(e => e.command == "AUTHENTICATE"), "the exchange is not published");
    }
    // Already identified, no credential, or a refusal: no login, no NICK.
    {
        auto t = makeSasl();
        auto c = t[0];
        c.processLine(":s 900 me me!u@h me :You are now logged in as me");
        c.processLine(":s CAP me NEW :sasl");
        assert(!c.outboundQueue.canFind("CAP REQ :sasl"));
        drain(t);
    }
    {
        auto t = make();
        t[0].processLine(":s CAP me NEW :sasl");
        assert(!t[0].outboundQueue.canFind("CAP REQ :sasl"));
        drain(t);
    }
    {
        auto t = makeSasl();
        auto c = t[0];
        c.processLine(":me!u@h NICK Guest123");
        c.processLine(":s CAP Guest123 NEW :sasl");
        c.processLine(":s CAP Guest123 ACK :sasl");
        c.processLine("AUTHENTICATE +");
        c.processLine(":s 904 Guest123 :SASL authentication failed");
        assert(!c.lateSaslPending);
        assert(!c.outboundQueue.canFind("NICK me"));
        drain(t);
    }

    // Registration-time split REQ: stable and draft caps go out separately
    // and CAP END waits for both answers.
    {
        auto t = make();
        auto c = t[0];
        c.saslDone = true;
        auto ls = c.parseIRCLine(":s CAP * LS :multi-prefix server-time draft/multiline chathistory draft/pre-away");
        c.handleCapLine(ls, false);
        assert(c.outboundQueue.canFind("CAP REQ :multi-prefix server-time"));
        assert(c.outboundQueue.canFind("CAP REQ :chathistory draft/multiline draft/pre-away"));
        assert(c.capReqOutstanding == 2);
        auto ack1 = c.parseIRCLine(":s CAP * ACK :multi-prefix server-time");
        c.handleCapLine(ack1, false);
        assert(!c.outboundQueue.canFind("CAP END"));
        c.isAway = true;
        c.awayMessage = "gone";
        auto nak2 = c.parseIRCLine(":s CAP * NAK :chathistory draft/multiline draft/pre-away");
        c.handleCapLine(nak2, false);
        assert(c.outboundQueue[$ - 1] == "CAP END");
        assert(!c.outboundQueue.canFind("AWAY :gone"), "no pre-away without the cap");
        drain(t);
    }
    {
        auto t = make();
        auto c = t[0];
        c.saslDone = true;
        c.isAway = true;
        c.awayMessage = "gone";
        auto ls = c.parseIRCLine(":s CAP * LS :draft/pre-away draft/extended-isupport");
        c.handleCapLine(ls, false);
        auto ack = c.parseIRCLine(":s CAP * ACK :draft/pre-away draft/extended-isupport");
        c.handleCapLine(ack, false);
        const n = c.outboundQueue.length;
        assert(c.outboundQueue[n - 3 .. n] == ["ISUPPORT", "AWAY :gone", "CAP END"], c.outboundQueue.join(" | "));
        drain(t);
    }

}

@("inbound framing sanitizes whole lines, so a UTF-8 char split across reads survives")
unittest {
    immutable wire = ":a!u@h PRIVMSG #c :caf\u00e9 \u2500\r\n";
    char[] partial;
    string line;
    // The cut lands inside the 3-byte U+2500: sanitizing that read on its
    // own would turn the dangling lead byte into CP437 mojibake.
    partial ~= wire[0 .. $ - 4];
    assert(!popInboundLine(partial, line));
    partial ~= wire[$ - 4 .. $];
    assert(popInboundLine(partial, line));
    assert(line == wire[0 .. $ - 2], line);
    assert(partial.length == 0);
    assert(!popInboundLine(partial, line));

    // CR and LF in separate reads still frame one line.
    partial ~= "PING :x\r";
    assert(!popInboundLine(partial, line));
    partial ~= "\n";
    assert(popInboundLine(partial, line) && line == "PING :x");

    // An empty line pops as "", and the next line is kept.
    partial ~= "\r\nA\r\n";
    assert(popInboundLine(partial, line) && line == "");
    assert(popInboundLine(partial, line) && line == "A");
    assert(partial.length == 0);
}

@("TOPIC keys are normalized, an empty TOPIC clears, PART drops the topic")
unittest {

    NetworkConfig cfg;
    cfg.nick = "me";
    auto ch = EngineEventChannel.create();
    auto c = new PersistentIRCClient(cfg, ch);
    c.channelState["#chan"] = "";

    c.processLine(":srv 332 me #Chan :old topic");
    assert(c.getChannelTopics() == ["#chan": "old topic"]);
    c.processLine(":op!o@h TOPIC #Chan :");
    assert(c.getChannelTopics() == ["#chan": ""]);
    c.processLine(":me!u@h PART #Chan");
    assert(("#chan" in c.getChannelTopics()) is null);

    ch.close();
    IRCRawEvent e;
    while (ch.tryConsumeOne(e)) {}
}

@("KICK of our own nick in another case still leaves the channel")
unittest {

    NetworkConfig cfg;
    cfg.nick = "me";
    auto ch = EngineEventChannel.create();
    auto c = new PersistentIRCClient(cfg, ch);
    c.channelState["#c"] = "";
    c.channelUsers["#c"] = ["me", "op"];

    c.processLine(":op!o@h KICK #c ME :bye");
    assert(!c.getJoinedChannels().canFind("#c"));
    assert(c.config.partedChannels.canFind("#c"));

    ch.close();
    IRCRawEvent e;
    while (ch.tryConsumeOne(e)) {}
}

version (ServicesWireHarness) {

import ircfiber.irc.services : ServicesOperation, ServicesTransaction, ServicesEndpoint, ServiceFrame,
    ServiceFrameSpec, ServiceFrameOutcome, registerServicesOperation, clearServicesOperations;

/// One named services-transport check over a localhost socket, printed by
/// the `services-test` runner.
struct ServicesWireCheck {
    string name;
    bool passed;
}

/// Test-only adapter: one INFO frame, "confirmed" only when the frame
/// completed AND carried a reply. It proves transport attribution, not any
/// real Anope grammar (unit 3 owns those).
private final class WireInfoOperation : ServicesOperation {
    ServiceFrame last;
    bool supports(const ref ServicesEndpoint ep) { return ep.version_.length > 0; }
    void run(ServicesTransaction txn) {
        import ircfiber.services.protocol : ServiceStatus;
        auto body_ = "INFO " ~ txn.request.params["account"].get!string;
        txn.frame(ServiceFrameSpec([body_]), (ServiceFrame f) {
            last = f;
            if (f.outcome != ServiceFrameOutcome.completed)
                return txn.complete(ServiceStatus.unconfirmed, f.reason);
            if (f.lines.length == 0) return txn.complete(ServiceStatus.unconfirmed, "no_reply");
            txn.complete(ServiceStatus.confirmed, "", Json.undefined, "", Json.undefined, txn.details(f.lines));
        });
    }
}

/// Real frame transport over a localhost fake ircd that answers like an
/// Anope pseudoclient on `services.test`: typed request → self-WHOIS
/// account → pin WHOIS + VERSION → start fence → command → end fence →
/// private result, with nothing service-private reaching the event channel.
ServicesWireCheck[] servicesTransportWireChecks(out string[] wire) {
    import std.algorithm : any, countUntil;
    import std.uuid : randomUUID;
    import core.time : msecs;
    import vibe.core.core : sleep;
    import vibe.core.net : listenTCP;
    import vibe.data.json : parseJsonString;
    import vibe.stream.operations : readLine;
    import ircfiber.services.config : ServicePin, ServiceId, ServicesProvider;
    import ircfiber.services.protocol : ServiceAction, ServiceStatus;
    import ircfiber.irc.services_channel : registerChannelServicesOperations;

    ServicesWireCheck[] results;
    void check(string name, bool passed) {
        results ~= ServicesWireCheck(name, passed);
    }

    enum svc = ":NickServ!services@services.test ";
    enum to = "PRIVMSG NickServ@services.test :";
    string[] got;
    int pings;
    bool candidateMode;
    bool compatibleTopic;
    enum netcraveVersion = "Anope-2.1.27-git (1947276) build #1, compiled Mon Sep 28 2026 08:19:33 UTC, flags DG -- InspIRCd 4+ -- enc_sha2";
    string respond(string line) {
        if (line.startsWith("WHOIS ")) {
            const nick = line[6 .. $];
            if (candidateMode && nick == "ChanServ")
                return ":s 311 me ChanServ services services.test * :Channel Services\r\n"
                    ~ ":s 312 me ChanServ services.test :Anope\r\n:s 318 me ChanServ :End of /WHOIS list.\r\n";
            if (nick == "NickServ")
                return ":s 311 me NickServ services services.test * :Nickname Services\r\n"
                    ~ ":s 312 me NickServ services.test :Anope\r\n:s 318 me NickServ :End of /WHOIS list.\r\n";
            if (nick == "me")
                return ":s 311 me me ~m host.a * :Me\r\n:s 330 me me acct :is logged in as\r\n"
                    ~ ":s 318 me me :End of /WHOIS list.\r\n";
            return ":s 401 me " ~ nick ~ " :No such nick\r\n:s 318 me " ~ nick ~ " :End of /WHOIS list.\r\n";
        }
        if (candidateMode && line.startsWith("PRIVMSG ChanServ@services.test :")) {
            enum prefix = ":ChanServ!services@services.test NOTICE me :";
            const body = line["PRIVMSG ChanServ@services.test :".length .. $];
            if (body == "\x01VERSION\x01") return prefix ~ "\x01VERSION " ~ netcraveVersion ~ "\x01\r\n";
            if (body.startsWith("\x01PING ")) return prefix ~ body ~ "\r\n";
            if (body == "INFO #c")
                return prefix ~ "Information about channel \x02#c\x02:\r\n"
                    ~ prefix ~ "Founder: acct\r\n" ~ prefix ~ "Description: Socket candidate fixture\r\n";
            if (body == "HELP ACCESS")
                return prefix ~ "Syntax: ACCESS channel LIST [mask | list] [ALL]\r\n";
            if (body == "ACCESS #c LIST * ALL") return prefix ~ "#c access list is empty.\r\n";
            if (body == "HELP TOPIC") return prefix ~ (compatibleTopic
                ? "Syntax: TOPIC channel [SET] [topic]" : "Syntax: TOPIC channel wrong-arguments") ~ "\r\n";
            if (body == "HELP SET KEEPTOPIC")
                return prefix ~ "Syntax: SET KEEPTOPIC channel {ON | OFF}\r\n";
            const command = body.startsWith("HELP ") ? body[5 .. $]
                : body.startsWith("STATUS ") ? "STATUS" : body.startsWith("LEVELS ") ? "LEVELS" : "FLAGS";
            return prefix ~ "Unknown command " ~ command ~ ". Type /msg ChanServ HELP for help.\r\n";
        }
        if (!line.startsWith(to)) return "";
        const body_ = line[to.length .. $];
        if (body_ == "\x01VERSION\x01")
            return svc ~ "NOTICE me :\x01VERSION Anope-2.1.test services.test -- inspircd4\x01\r\n";
        if (body_.startsWith("\x01PING ")) {
            // Every second fence closes a frame; services then say something
            // unsolicited, which must stay ordinary traffic.
            const closing = ++pings % 2 == 0;
            return svc ~ "NOTICE me :" ~ body_ ~ "\r\n"
                ~ (closing ? svc ~ "NOTICE me :Unsolicited reminder\r\n" : "");
        }
        if (body_ == "INFO acct")
            return svc ~ "NOTICE me :\x02acct\x02 is me\r\n" ~ svc ~ "PRIVMSG me :Registered: today\r\n";
        return ""; // "INFO quiet": fences answered, command silently dropped
    }

    int accepted;
    auto listener = listenTCP(0, (TCPConnection peer) {
        ++accepted;
        try {
            peer.write(":s 001 me :Welcome\r\n:s 005 me CASEMAPPING=rfc1459 :are supported\r\n"
                ~ ":s 376 me :End of MOTD\r\n");
            peer.flush();
            while (!peer.empty) {
                const line = (cast(const(char)[]) peer.readLine()).idup;
                got ~= line;
                const reply = respond(line);
                if (reply.length) {
                    peer.write(reply);
                    peer.flush();
                }
            }
        } catch (Exception) {}
        try peer.close(); catch (Exception) {}
    }, "127.0.0.1");

    auto ch = EngineEventChannel.create();
    NetworkConfig cfg;
    cfg.nick = "me";
    cfg.host = "127.0.0.1";
    cfg.saslUsername = "configured-sasl";
    cfg.services.provider = ServicesProvider.anope;
    cfg.services.server = "services.test";
    cfg.services.pins[ServiceId.nickServ] = ServicePin("NickServ", "services", "services.test");
    cfg.services.pins[ServiceId.chanServ] = ServicePin("ChanServ", "services", "services.test");
    cfg.services.pins[ServiceId.botServ] = ServicePin("BotServ", "services", "services.test");
    auto c = new PersistentIRCClient(cfg, ch);
    auto op = new WireInfoOperation;
    registerServicesOperation(ServiceAction.accountInfo, op);
    IRCRawEvent[] events;
    void cleanup() {
        try clearServicesOperations(); catch (Exception) {}
        try c.connection.close(); catch (Exception) {}
        try { listener.stopListening(); sleep(10.msecs); } catch (Exception) {}
        try ch.close(); catch (Exception) {}
    }
    scope (exit) cleanup();
    void drainEvents() {
        IRCRawEvent ev;
        // This harness is the only reader. Avoid the channel's zero-time
        // wait: its condition can wait indefinitely at the exact deadline.
        while (ch.bufferFill > 0 && ch.tryConsumeOne(ev)) {
            events ~= ev;
        }
    }
    void pump(long ms) {
        const until = unixMsNow() + ms;
        ubyte[4096] buf;
        while (unixMsNow() < until) {
            const n = c.readFromStream(buf[], 20.msecs);
            if (n) {
                c.inboundPartial ~= cast(const(char)[]) buf[0 .. n];
                string line;
                while (popInboundLine(c.inboundPartial, line))
                    if (line.length) c.processLine(line);
            }
            c.services.tick();
            c.drainServicesQueue();
        }
        drainEvents();
    }
    ServicesResult[] results_;
    void delegate(ServicesResult) collect() { return (ServicesResult r) { results_ ~= r; }; }
    ServicesRequest request(ServiceAction action, string params, string actor) {
        auto j = parseJsonString(`{"params":` ~ params ~ `}`);
        j["requestId"] = randomUUID().toString();
        j["action"] = action.to!string;
        // Offline: a well-formed review from a connection that is gone.
        j["expectedConnectionEpoch"] = c.getConnectionEpoch().length ? c.getConnectionEpoch()
            : randomUUID().toString();
        j["expectedActorAccount"] = actor;
        return ServicesRequest.fromJson(j);
    }

    c.connection = connectTCP("127.0.0.1", listener.bindAddress.port);
    c.state = ConnectionState.connecting;
    c.performRegistration();
    c.connectedAtMs = unixMsNow();
    c.state = ConnectionState.connected;
    c.beginServicesGeneration();
    pump(100);
    check("registration without 900 leaves the actor unknown",
        c.getServicesAccountState() == ServicesAccountState.unknown);

    // ── discover: self-WHOIS 330, then WHOIS + VERSION for the seven ───
    auto discover = request(ServiceAction.discover, `{}`, "");
    c.executeServices(discover, collect());
    pump(600);
    check("an unknown actor is resolved by a suppressed self-WHOIS 330, never by SASL config",
        c.getServicesAccount() == "acct" && c.getServicesAccount() != cfg.saslUsername);
    check("discover answers confirmed with observed WHOIS data",
        results_.length == 1 && results_[0].status == ServiceStatus.confirmed
        && results_[0].requestId == discover.requestId);
    Json data = results_.length ? results_[0].data : Json.undefined;
    check("the pinned NickServ is verified with its CTCP VERSION; absent services say so",
        data.type == Json.Type.object
        && data["services"]["nickserv"]["pin"].get!string == "verified"
        && data["services"]["nickserv"]["version"].get!string.startsWith("Anope-2.1.test")
        && data["services"]["chanserv"]["pin"].get!string == "absent"
        && data["approvedServer"].get!string == "services.test");
    check("discovery WHOIS/VERSION replies never reach the event channel",
        !events.any!(e => ["311", "312", "318", "330", "401"].canFind(e.command)
            || e.getTag("ctcp").length));

    // ── typed request through a real frame ────────────────────────────
    events = null;
    const before = got.length;
    auto info = request(ServiceAction.accountInfo, `{"account":"acct"}`, "acct");
    c.executeServices(info, collect());
    // A manual line to the busy service is refused, never interleaved.
    c.sendRaw("PRIVMSG NickServ :IDENTIFY hunter2", true);
    pump(600);
    auto frameWire = got[before .. $];
    const startAt = frameWire.countUntil!(l => l.startsWith(to ~ "\x01PING ifsvc"));
    const bodyAt = frameWire.countUntil(to ~ "INFO acct");
    ptrdiff_t endAt = -1;
    foreach (i, l; frameWire)
        if (cast(ptrdiff_t) i > bodyAt && l.startsWith(to ~ "\x01PING ifsvc")) { endAt = i; break; }
    check("start fence, command and end fence leave in order to Nick@server",
        startAt >= 0 && bodyAt > startAt && endAt > bodyAt);
    check("the typed request is answered confirmed only with an attributed reply",
        results_.length == 2 && results_[1].status == ServiceStatus.confirmed
        && op.last.startFenced && op.last.endFenced && op.last.lines.length == 2);
    check("NOTICE and PRIVMSG replies are both attributed, formatting kept raw",
        op.last.lines.length == 2 && op.last.lines[0].command == "NOTICE"
        && op.last.lines[1].command == "PRIVMSG" && op.last.lines[0].text == "\x02acct\x02 is me"
        && op.last.lines[0].plain == "acct is me");
    check("details are sanitized lines for the initiating session only",
        results_.length == 2 && results_[1].details == ["acct is me", "Registered: today"]);
    check("correlated private replies and fences never reach the event channel",
        !events.any!(e => (e.command == "NOTICE" || e.command == "PRIVMSG")
            && e.nick == "NickServ" && e.text != "Unsolicited reminder"));
    check("an unsolicited service notice after the frame stays ordinary traffic",
        events.any!(e => e.command == "NOTICE" && e.nick == "NickServ" && e.text == "Unsolicited reminder"));
    check("a manual line to the service during the transaction is refused, not queued",
        !got.any!(l => l.canFind("hunter2")) && !c.outboundQueue.any!(l => l.canFind("hunter2"))
        && !c.pacedQueue.any!(entry => entry.line.canFind("hunter2")));
    check("nothing services-related went through the reconnect or paced queues",
        c.outboundQueue.length == 0 && c.pacedQueue.length == 0);

    // ── fences answered, command silently dropped ─────────────────────
    auto quiet = request(ServiceAction.accountInfo, `{"account":"quiet"}`, "acct");
    c.executeServices(quiet, collect());
    pump(600);
    check("a fenced frame with no command reply is never success",
        results_.length == 3 && results_[2].status == ServiceStatus.unconfirmed
        && results_[2].reasonCode == "no_reply");

    // ── dedup, stale epoch ────────────────────────────────────────────
    const sentBefore = got.length;
    c.executeServices(info, collect());
    pump(200);
    check("a duplicate request id is answered from the dedup record without re-executing",
        results_.length == 4 && results_[3].reasonCode == "duplicate_request"
        && results_[3].status == ServiceStatus.confirmed && results_[3].details.length == 0
        && got.length == sentBefore);
    auto stale = request(ServiceAction.accountInfo, `{"account":"acct"}`, "acct");
    stale.expectedConnectionEpoch = randomUUID().toString();
    c.executeServices(stale, collect());
    check("a review from another connection epoch is stale",
        results_.length == 5 && results_[4].status == ServiceStatus.stale
        && results_[4].reasonCode == "epoch_stale");
    auto other = request(ServiceAction.accountInfo, `{"account":"acct"}`, "someoneelse");
    c.executeServices(other, collect());
    check("a review for another actor account is stale",
        results_.length == 6 && results_[5].reasonCode == "actor_changed");

    // ── pacing: the dedicated queue waits for the real pacer ──────────
    auto saved = c.pacer;
    c.pacer.tighten(unixMsNow());
    const pacedBefore = got.length;
    auto paced = request(ServiceAction.accountInfo, `{"account":"acct"}`, "acct");
    c.executeServices(paced, collect());
    sleep(100.msecs);
    check("service lines wait in their own queue while the pacer says wait",
        c.services.queued > 0 && got.length == pacedBefore);
    c.pacer = saved;
    pump(600);
    check("and leave through the same socket once it admits them",
        results_.length == 7 && results_[6].status == ServiceStatus.confirmed);

    // ── disconnect mid-transaction ────────────────────────────────────
    auto lost = request(ServiceAction.accountInfo, `{"account":"acct"}`, "acct");
    c.executeServices(lost, collect());
    c.resetConnectionTelemetry();
    c.state = ConnectionState.disconnected;
    check("a transaction lost to a disconnect is stale or unconfirmed, never confirmed",
        results_.length == 8 && results_[7].status != ServiceStatus.confirmed
        && results_[7].reasonCode == "cancelled_disconnect");
    c.sendRaw("PRIVMSG NickServ :IDENTIFY hunter2");
    check("a sensitive line while disconnected is dropped, never queued for replay",
        !c.outboundQueue.any!(l => l.canFind("hunter2"))
        && !c.snapshotSession(true).outboundQueue.any!(l => l.canFind("hunter2")));
    auto offline = request(ServiceAction.accountInfo, `{"account":"acct"}`, "acct");
    c.executeServices(offline, collect());
    check("an offline connection answers unavailable",
        results_.length == 9 && results_[8].reasonCode == "offline");

    // Use the same localhost peer and real client for grammar proof. The
    // WireInfoOperation cases above deliberately remain transport-only.
    candidateMode = true;
    compatibleTopic = true;
    registerChannelServicesOperations();
    c.state = ConnectionState.connected;
    c.connectedAtMs = unixMsNow();
    c.beginServicesGeneration();
    c.processLine(":s 900 me me!u@h acct :You are now logged in as acct");
    auto candidate = request(ServiceAction.channelInfo, `{"channel":"#c"}`, "acct");
    c.executeServices(candidate, collect());
    const candidateDeadline = unixMsNow() + 20_000;
    while (unixMsNow() < candidateDeadline
            && !results_.any!(r => r.requestId == candidate.requestId)) pump(50);
    const candidateReady = results_.length > 9 && results_[$ - 1].requestId == candidate.requestId
        && results_[$ - 1].status == ServiceStatus.confirmed;
    check("real candidate ChanServ socket replies yield a typed confirmed channel view",
        candidateReady && results_[$ - 1].data["channel"].get!string == "#c"
        && results_[$ - 1].data["registered"].get!bool
        && results_[$ - 1].data["founder"].get!string == "acct");
    check("real candidate HELP enables the corresponding authorized control",
        candidateReady && results_[$ - 1].capabilities["channelTopicSet"]["state"].get!string == "allowed");
    const candidateRevision = candidateReady ? results_[$ - 1].revision : "";
    compatibleTopic = false;
    auto incompatible = request(ServiceAction.channelTopicSet, `{"channel":"#c","topic":"candidate-forbidden"}`, "acct");
    incompatible.expectedRevision = candidateRevision;
    const incompatibleStart = got.length;
    c.executeServices(incompatible, collect());
    const incompatibleDeadline = unixMsNow() + 20_000;
    while (unixMsNow() < incompatibleDeadline
            && !results_.any!(r => r.requestId == incompatible.requestId)) pump(50);
    check("incompatible real HELP blocks a direct founder mutation on the socket",
        results_.length > 9 && results_[$ - 1].requestId == incompatible.requestId
        && results_[$ - 1].status != ServiceStatus.confirmed
        && got[incompatibleStart .. $].any!(l => l == "PRIVMSG ChanServ@services.test :HELP TOPIC")
        && !got[incompatibleStart .. $].any!(l => l == "PRIVMSG ChanServ@services.test :TOPIC #c SET candidate-forbidden"));

    wire = got.dup;
    return results;
}

/// Hand-off ordering over a localhost socket: a legacy NickServ auth line
/// and a typed transaction's first line leave only after the holder META
/// carrying the non-secret hand-off count/marker was written; a failed
/// META write sends nothing and queues nothing. (`servicesMetaSink` stands
/// in for the holder.)
ServicesWireCheck[] servicesLegacyMetaChecks() {
    import std.algorithm : any;
    import std.uuid : randomUUID;
    import core.time : msecs;
    import vibe.core.core : sleep;
    import vibe.core.net : listenTCP;
    import vibe.data.json : parseJsonString;
    import vibe.stream.operations : readLine;
    import ircfiber.services.config : ServicePin, ServiceId, ServicesProvider;
    import ircfiber.services.protocol : ServiceAction, ServiceStatus;

    ServicesWireCheck[] results;
    void check(string name, bool passed) { results ~= ServicesWireCheck(name, passed); }
    string[] got;
    auto listener = listenTCP(0, (TCPConnection peer) {
        try {
            while (!peer.empty) got ~= (cast(const(char)[]) peer.readLine()).idup;
        } catch (Exception) {}
        try peer.close(); catch (Exception) {}
    }, "127.0.0.1");
    auto ch = EngineEventChannel.create();
    NetworkConfig cfg;
    cfg.nick = "me";
    cfg.host = "127.0.0.1";
    cfg.services.provider = ServicesProvider.anope;
    cfg.services.server = "services.test";
    cfg.services.pins[ServiceId.nickServ] = ServicePin("NickServ", "services", "services.test");
    auto c = new PersistentIRCClient(cfg, ch);
    void cleanup() {
        try clearServicesOperations(); catch (Exception) {}
        try c.connection.close(); catch (Exception) {}
        try { listener.stopListening(); sleep(10.msecs); } catch (Exception) {}
        try ch.close(); catch (Exception) {}
    }
    scope (exit) cleanup();
    bool wired(string needle) { return got.any!(l => l.canFind(needle)); }
    bool queued(string needle) {
        return c.outboundQueue.any!(line => line.canFind(needle)) || c.pacedQueue.any!(entry => entry.line.canFind(needle));
    }

    c.connection = connectTCP("127.0.0.1", listener.bindAddress.port);
    c.connectedAtMs = unixMsNow();
    c.state = ConnectionState.connected;
    c.beginServicesGeneration();
    c.processLine(":s 900 me me!u@h acct :You are now logged in as acct");

    long[] counts;
    long linesAtMeta;
    bool metaOk = true;
    c.servicesMetaSink = (SessionSnapshot s) {
        counts ~= s.servicesLegacyAuthPending;
        linesAtMeta = c.linesOut;
        return metaOk;
    };

    c.sendRaw("PRIVMSG NickServ :IDENTIFY canary1", true);
    sleep(100.msecs);
    check("a manual IDENTIFY's hand-off count is in META before the line reaches the socket",
        counts == [1] && c.linesOut == linesAtMeta + 1 && wired("canary1"));
    c.sendRaw("PRIVMSG NickServ :INFO me", true);
    check("a non-auth service line needs no META write", counts.length == 1);

    metaOk = false;
    c.sendRaw("PRIVMSG NickServ :IDENTIFY canary2", true);
    c.sendMessage("NickServ", "IDENTIFY canary3");
    sleep(100.msecs);
    check("when the META write fails the auth line is neither sent nor queued",
        !wired("canary2") && !wired("canary3") && !queued("canary2") && !queued("canary3"));
    check("and the tentative ledger entry is undone",
        c.services.legacyAuthPending() == 1 && c.snapshotSession(false).servicesLegacyAuthPending == 1);

    registerServicesOperation(ServiceAction.accountInfo, new WireInfoOperation);
    auto j = parseJsonString(`{"params":{"account":"acct"}}`);
    j["requestId"] = randomUUID().toString();
    j["action"] = "accountInfo";
    j["expectedConnectionEpoch"] = c.getConnectionEpoch();
    j["expectedActorAccount"] = "acct";
    ServicesResult[] answered;
    const before = got.length;
    c.executeServices(ServicesRequest.fromJson(j), (ServicesResult r) { answered ~= r; });
    sleep(100.msecs);
    check("a typed transaction whose marker cannot be written sends nothing and ends stale",
        answered.length == 1 && answered[0].status == ServiceStatus.stale
        && answered[0].reasonCode == "meta_unavailable" && got.length == before);

    auto next = new PersistentIRCClient(cfg, ch);
    next.services.restoreLegacyAuth(cast(size_t) c.snapshotSession(false).servicesLegacyAuthPending);
    check("the next engine on the same socket keeps the count (no transient zero)",
        next.snapshotSession(false).servicesLegacyAuthPending == 1);
    return results;
}

} // version (ServicesWireHarness)

/// Real IPC/IRC wire regression; called by the isolated memory runner.
version (MemoryReliabilityHarness)
Ircv3Check[] holderRecoveryRegressionChecks() {
    import vibe.core.net : listenTCP;
    import vibe.stream.operations : readLine;
    import vibe.data.json : parseJsonString;
    import ircfiber.irc.manager : ConnectionManager, holderMaintenanceClassificationChecks;
    Ircv3Check[] checks;
    auto events = EngineEventChannel.create();
    NetworkConfig config;
    config.id = parseUUID("d72eb1d2-cb3a-4400-bf9e-000000000001");
    config.nick = "me";
    config.name = "holder recovery fixture";
    config.host = "holder-recovery.invalid";
    config.port = 6667;
    config.tls = TLSMode.disabled;
    auto client = new PersistentIRCClient(config, events);
    string incarnation = "00000000-0000-4000-8000-000000000001";
    string id = "held-one";
    long physicalTime = 100;
    long gap;
    bool failStatus;
    int busy;
    bool closed;
    bool missing;
    bool refuseRegistration;
    bool advanceGapOnAck;
    bool silentRegistration;
    bool motdWithoutWelcome;
    long welcomeBeforeRebind;
    bool timeoutPermitObserved, timeoutConfirmationObserved;
    bool timeoutCleanup;
    int registrationGapMode;
    bool blockTerminalObservation, loseCloseAck;
    Json[string] terminalEntries;
    string retainedRegistration;
    size_t attaches, closes, dials;
    long[] acknowledgments;
    string[] upstream;
    TCPConnection[] peers;
    TCPConnection[] relayPeers;
    Json status() {
        auto payload = Json.emptyObject;
        payload["proto"] = 1;
        payload["instance"] = incarnation;
        payload["pid"] = 42;
        payload["open"] = 1;
        return payload;
    }
    Json entry() {
        auto payload = Json.emptyObject;
        payload["instance"] = incarnation;
        payload["id"] = id;
        payload["state"] = closed ? "closed" : "open";
        payload["connectedAtMs"] = physicalTime;
        payload["bufferedBytes"] = cast(long) retainedRegistration.length;
        payload["gapGeneration"] = gap;
        payload["gapAckGeneration"] = 0;
        payload["droppedBytes"] = gap ? 64 : 0;
        payload["droppedLines"] = gap ? 1 : 0;
        return payload;
    }
    auto listener = listenTCP(0, (TCPConnection peer) {
        peers ~= peer;
        bool relay;
        try {
            while (!peer.empty) {
                const line = (cast(const(char)[]) peer.readLine(65536, "\n")).idup.strip;
                if (relay) {
                    upstream ~= line;
                    if (line == "CAP LS 302")
                        peer.write(":s CAP me LS :batch server-time message-tags draft/chathistory\r\n");
                    else if (line.startsWith("CAP REQ :"))
                        peer.write(":s CAP me ACK :" ~ line["CAP REQ :".length .. $] ~ "\r\n");
                    else if (line == "CAP END") {
                        if (refuseRegistration) peer.write(":s 465 me :Fixture external refusal\r\n");
                        else if (registrationGapMode) {
                            const welcomeFirst = registrationGapMode == 2;
                            registrationGapMode = 0;
                            if (welcomeFirst) {
                                peer.write(":s 001 me :Welcome\r\n");
                                peer.flush();
                                const deadline = unixMsNow() + 1000;
                                while (!client.observed001AtMs && unixMsNow() < deadline) sleep(1.msecs);
                                welcomeBeforeRebind = client.observed001AtMs;
                            }
                            gap++;
                            auto malformed = new char[128];
                            malformed[] = cast(char) 0xff;
                            retainedRegistration =
                                // Invalid UTF-8 grows on sanitization: only raw
                                // byte accounting keeps the later NAMES fenced.
                                ":s NOTICE me :" ~ cast(string) malformed ~ "\r\n"
                                ~ ":s 900 me me!u@h stale-account :Old login\r\n"
                                ~ ":s 903 me :Old SASL success\r\n"
                                ~ (welcomeFirst ? ":s 001 me :Old duplicate\r\n" : ":s 001 me :Welcome\r\n")
                                ~ ":me!u@h JOIN #stale\r\n"
                                ~ ":s 353 me = #stale :me stale\r\n"
                                ~ ":s 366 me #stale :Old names\r\n";
                            peer.close();
                            return;
                        } else if (motdWithoutWelcome) peer.write(":s 376 me :End of MOTD\r\n");
                        else if (!silentRegistration)
                            peer.write(":s 001 me :Welcome\r\n:s 376 me :End of MOTD\r\n");
                    }
                } else if (line.startsWith("HELLO ")) peer.write("OK " ~ status().toString() ~ "\n");
                else if (line == "STATUS") {
                    if (blockTerminalObservation) {
                        peer.write("ERR {\"code\":\"unavailable\"}\n");
                        peer.flush();
                        continue;
                    }
                    if (failStatus) { failStatus = false; peer.close(); return; }
                    if (timeoutCleanup && !closed)
                        timeoutPermitObserved = client.registrationPermit
                            && registrationAdmission.inFlight == 1 && client.holderConnId == id;
                    peer.write("OK " ~ status().toString() ~ "\n");
                } else if (line.startsWith("INFO ")) {
                    const requestedId = parseJsonString(line["INFO ".length .. $])["id"].get!string;
                    if (auto retainedEntry = requestedId in terminalEntries)
                        peer.write("OK " ~ (*retainedEntry).toString() ~ "\n");
                    else if (missing) peer.write("ERR {\"code\":\"not_found\"}\n");
                    else peer.write("OK " ~ entry().toString() ~ "\n");
                    if (timeoutCleanup && closed)
                        timeoutConfirmationObserved = client.registrationPermit
                            && registrationAdmission.inFlight == 1;
                }
                else if (line.startsWith("ATTACH ")) {
                    attaches++;
                    if (busy > 0) { busy--; peer.write("ERR {\"code\":\"busy\"}\n"); }
                    else {
                        peer.write("OK " ~ entry().toString() ~ "\n");
                        relay = true;
                        relayPeers ~= peer;
                        if (retainedRegistration.length) {
                            peer.write(retainedRegistration);
                            retainedRegistration = "";
                            peer.flush();
                            sleep(5.msecs);
                            peer.write(":s 376 me :End of MOTD\r\n");
                        }
                    }
                } else if (line.startsWith("GAP_ACK ")) {
                    const generation = parseJsonString(line["GAP_ACK ".length .. $])["generation"].get!long;
                    acknowledgments ~= generation;
                    if (advanceGapOnAck) { advanceGapOnAck = false; gap++; }
                    if (generation != gap) peer.write("ERR {\"code\":\"stale\"}\n");
                    else peer.write("OK {}\n");
                } else if (line.startsWith("CLOSE ")) {
                    closes++;
                    closed = true;
                    const requestedId = parseJsonString(line["CLOSE ".length .. $])["id"].get!string;
                    if (auto retainedEntry = requestedId in terminalEntries) {
                        auto ended = *retainedEntry;
                        ended["state"] = "closed";
                        terminalEntries[requestedId] = ended;
                    }
                    if (loseCloseAck) {
                        loseCloseAck = false;
                        peer.close();
                        return;
                    }
                    peer.write("OK {}\n");
                }
                else if (line.startsWith("DIAL ")) { dials++; peer.write("ERR {\"code\":\"bad_request\"}\n"); }
                else if (line.startsWith("META ")) peer.write("OK {}\n");
                else peer.write("ERR {\"code\":\"bad_request\"}\n");
                peer.flush();
            }
        } catch (Exception) {}
        try peer.close(); catch (Exception) {}
    }, "127.0.0.1");
    bool finished;
    runTask(() nothrow {
        try {
            const deadline = unixMsNow() + 30_000;
            while (!finished && unixMsNow() < deadline) sleep(25.msecs);
            if (!finished) client.isShutdownRequested = true;
        } catch (Exception) {
            client.isShutdownRequested = true;
        }
    });
    void cleanup() {
        finished = true;
        client.isShutdownRequested = true;
        try client.connection.close(); catch (Exception) {}
        foreach (peer; peers) try peer.close(); catch (Exception) {}
        try listener.stopListening(); catch (Exception) {}
        sleep(30.msecs);
        events.close();
    }
    scope(exit) cleanup();
    auto holder = new HolderClient("fixture",
        "tcp://127.0.0.1:" ~ listener.bindAddress.port.to!string);
    holder.connectControl();
    client.holder = holder;
    void claim() {
        auto relay = holder.attachIdentity(id);
        client.connection = relay.stream;
        client.holderConnId = id;
        client.holderInstance = incarnation;
        client.holderConnectedAtMs = physicalTime;
        client.observed001AtMs = 0;
        client.state = ConnectionState.connecting;
        client.activeRoute = "direct";
    }
    void drain() {
        IRCRawEvent event;
        while (events.tryConsumeOne(event, Duration.zero)) {}
    }
    size_t registrations() {
        size_t count;
        foreach (line; upstream)
            if (line.startsWith("NICK ") || line.startsWith("USER ")) count++;
        return count;
    }
    claim();
    client.performRegistration();
    client.state = ConnectionState.connected;
    client.connectedAtMs = client.observed001AtMs;
    const oldWelcome = client.observed001AtMs;
    const oldId = id;
    drain();
    const sentRegistration = registrations();
    failStatus = true;
    busy = 2;
    relayPeers[$ - 1].close();
    bool eofObserved;
    ubyte[32] eofBuffer;
    const eofDeadline = unixMsNow() + 1000;
    do {
        try client.readFromStream(eofBuffer[]);
        catch (Exception e) {
            eofObserved = e.msg == "Holder relay closed";
            break;
        }
        sleep(1.msecs);
    } while (unixMsNow() < eofDeadline);
    checks ~= Ircv3Check("remote relay EOF reaches actor recovery without waiting for keepalive",
        eofObserved && client.holderConnId == oldId && closes == 0 && dials == 0);
    const rebound = client.recoverHolderRelay();
    sleep(20.msecs);
    checks ~= Ircv3Check("holder outage and busy rebind preserve claim with no DIAL/CLOSE/NICK/USER",
        rebound && !client.isShutdownRequested && client.connection.connected && busy == 0 && attaches == 4
        && client.holderConnId == oldId && client.holderConnectedAtMs == 100
        && sentRegistration == 2 && registrations() == sentRegistration && closes == 0 && dials == 0);
    client.processLine(":me!u@h JOIN #room");
    client.processLine(":s 900 me me!u@h account :You are now logged in");
    client.channelUsers["#room"] = ["alice"];
    client.realnames["alice"] = "Alice";
    client.idents["alice"] = "old";
    client.saslSucceeded = true;
    gap = 1;
    advanceGapOnAck = true;
    auto firstGap = HolderEntry.fromJson(entry());
    client.recoverHolderGap(firstGap);
    checks ~= Ircv3Check("gap invalidates membership and authentication without claiming successful repair",
        client.channelState.length == 0 && client.channelUsers.length == 0
        && client.realnames.length == 0 && client.idents.length == 0
        && !client.saslSucceeded && client.servicesAccountState == ServicesAccountState.unknown
        && client.servicesAccount.length == 0 && client.openBatches.length == 0);
    checks ~= Ircv3Check("GAP_ACK cannot cover a loss arriving after the observed generation",
        acknowledgments == [1L] && client.lastGapAcknowledged == 0 && gap == 2);
    const staleAuth = ":s 900 me me!u@h stale-account :Old buffered login";
    client.attachBacklogBytes = staleAuth.length + 2;
    client.processLine(staleAuth);
    const staleNames = ":s 353 me = #room :me alice";
    client.attachBacklogBytes = staleNames.length + 2;
    client.processLine(staleNames);
    checks ~= Ircv3Check("pre-gap FIFO authentication and NAMES cannot restore uncertain live proof",
        client.servicesAccountState == ServicesAccountState.unknown && client.servicesAccount.length == 0
        && client.channelState.length == 0 && client.channelUsers.length == 0);
    const retainedChat = ":alice!u@h PRIVMSG #room :admitted-before-gap";
    client.attachBacklogBytes = retainedChat.length + 2;
    client.processLine(retainedChat);
    bool keptChat;
    IRCRawEvent retained;
    while (events.tryConsumeOne(retained, Duration.zero))
        if (retained.text == "admitted-before-gap" && retained.channel == "#room") keptChat = true;
    checks ~= Ircv3Check("gap quarantine preserves admitted complete chat as history", keptChat);
    client.processLine(":s 353 me = #room :me alice");
    checks ~= Ircv3Check("a partial fresh NAMES burst does not yet prove own membership",
        client.channelState.length == 0);
    client.processLine(":s 366 me #room :End of names");
    checks ~= Ircv3Check("fresh authoritative NAMES containing self restores membership",
        ("#room" in client.channelState) !is null);
    client.nextGapAckAtMs = 0;
    auto secondGap = HolderEntry.fromJson(entry());
    client.recoverHolderGap(secondGap);
    bool names, history;
    const commandDeadline = unixMsNow() + 1000;
    do {
        foreach (line; upstream) {
            if (line == "NAMES #room") names = true;
            if (line.startsWith("CHATHISTORY ")) history = true;
        }
        if (names && history) break;
        sleep(1.msecs);
    } while (unixMsNow() < commandDeadline);
    checks ~= Ircv3Check("gap initiates NAMES and negotiated history before acknowledging exactly the new generation",
        names && history && acknowledgments == [1L, 2L] && client.lastGapAcknowledged == 2);
    client.processLine(":s 353 me = #room :alice");
    client.processLine(":s 366 me #room :End of names");
    checks ~= Ircv3Check("fresh NAMES without self never invents own channel membership",
        "#room" !in client.channelState && "#room" !in client.channelUsers);
    const beforeReplacementAttach = attaches;
    incarnation = "00000000-0000-4000-8000-000000000002";
    physicalTime = 200;
    client.connection.close();
    checks ~= Ircv3Check("new incarnation loses only the old claim and never ATTACHes/CLOSEs a colliding ID",
        !client.recoverHolderRelay() && !client.holderConnId.length
        && client.holderGenerationLost && attaches == beforeReplacementAttach && closes == 0 && dials == 0);
    checks ~= Ircv3Check("guarded legacy-ID mutation refuses another incarnation",
        !holder.closeClaim(id, "00000000-0000-4000-8000-000000000001", 100) && closes == 0);
    client.holderConnId = oldId;
    client.holderInstance = ""; // genuine pre-upgrade claims have no UUID
    client.holderConnectedAtMs = 100;
    client.holderGenerationLost = false;
    checks ~= Ircv3Check("first UUID-bearing incarnation proves legacy holder loss without touching colliding IDs",
        !client.recoverHolderRelay() && !client.holderConnId.length && client.holderGenerationLost
        && attaches == beforeReplacementAttach && closes == 0 && dials == 0);
    id = "held-two";
    gap = 0;
    claim();
    drain();
    client.inboundPartial = null;
    client.performRegistration();
    client.state = ConnectionState.connected;
    client.connectedAtMs = client.observed001AtMs;
    client.holderGenerationLost = false; // fresh-engine observer must independently see holder loss
    checks ~= holderMaintenanceClassificationChecks(client, oldId, oldWelcome);
    drain();
    closed = true;
    client.connection.close();
    checks ~= Ircv3Check("authoritative same-incarnation closed permits retirement without upstream CLOSE",
        !client.recoverHolderRelay() && !client.holderConnId.length && closes == 0 && dials == 0);
    closed = false;
    client.holderConnId = id;
    client.holderInstance = incarnation;
    client.holderConnectedAtMs = physicalTime;
    missing = true;
    const beforeMissing = attaches;
    checks ~= Ircv3Check("authoritative same-incarnation not-found never reattaches or duplicates registration",
        !client.recoverHolderRelay() && !client.holderConnId.length && attaches == beforeMissing
        && closes == 0 && dials == 0);
    missing = false;
    refuseRegistration = true;
    client.connection.close();
    id = "held-refused";
    physicalTime = 300;
    claim();
    client.maintenanceDeadlineMs = unixMsNow() + 600_000;
    client.inboundPartial = null;
    try client.performRegistration(); catch (Exception) {}
    checks ~= Ircv3Check("only an observed external refusal supplies classification reason and time",
        client.externalRefusalReason == "Fixture external refusal" && client.externalRefusalAtMs > oldWelcome);
    checks ~= holderMaintenanceClassificationChecks(client, oldId, oldWelcome, true);
    auto admission = new RegistrationAdmission;
    bool[8] owned;
    foreach (i; 0 .. 8) { owned[i] = admission.tryStart("route-" ~ i.to!string, 10000); }
    checks ~= Ircv3Check("global full-registration permits cap at eight",
        admission.inFlight == 8 && !admission.tryStart("ninth", 10000));
    admission.release(owned[0]);
    admission.release(owned[0]);
    checks ~= Ircv3Check("route spacing waits without consuming a global permit and release is exactly once",
        admission.inFlight == 7 && !admission.tryStart("route-0", 10999)
        && admission.inFlight == 7 && admission.tryStart("route-0", 11000));
    auto delayedAdmission = new RegistrationAdmission;
    delayedAdmission.observeIncarnation("write-old");
    bool delayedPermit = delayedAdmission.tryStart("delayed-route", 10000);
    delayedAdmission.reserveStart("delayed-route");
    const startEpoch = delayedAdmission.epoch;
    const awaitingResponse = !delayedAdmission.tryStart("delayed-route", 14000);
    delayedAdmission.completeStart("delayed-route", startEpoch, 15000);
    delayedAdmission.release(delayedPermit);
    checks ~= Ircv3Check("route pacing waits for remote DIAL response after delayed policy checks and IPC write",
        awaitingResponse && !delayedAdmission.tryStart("delayed-route", 15999)
        && delayedAdmission.inFlight == 0 && delayedAdmission.tryStart("delayed-route", 16000));
    delayedAdmission.reserveStart("delayed-route");
    delayedAdmission.observeIncarnation("write-new");
    bool nextStartPermit = delayedAdmission.tryStart("delayed-route", 17000);
    delayedAdmission.reserveStart("delayed-route");
    delayedAdmission.completeStart("delayed-route", startEpoch, 18000);
    const staleCompletionBlocked = !delayedAdmission.tryStart("delayed-route", 19000);
    delayedAdmission.completeStart("delayed-route", delayedAdmission.epoch, 20000);
    delayedAdmission.release(nextStartPermit);
    checks ~= Ircv3Check("stale incarnation completion cannot release a newer pending route start",
        staleCompletionBlocked && !delayedAdmission.tryStart("delayed-route", 20999)
        && delayedAdmission.tryStart("delayed-route", 21000));
    auto uncertainAdmission = new RegistrationAdmission;
    uncertainAdmission.observeIncarnation("old-process");
    bool uncertainPermit = uncertainAdmission.tryStart("one-route", 10000);
    const oldPermitEpoch = uncertainAdmission.epoch;
    uncertainAdmission.retainUnproven(oldPermitEpoch);
    uncertainAdmission.observeIncarnation("old-process");
    checks ~= Ircv3Check("ambiguous DIAL remains within the global limit until generation loss",
        uncertainAdmission.inFlight == 1 && uncertainAdmission.unprovenCount == 1);
    uncertainAdmission.observeIncarnation("new-process");
    bool currentPermit = uncertainAdmission.tryStart("one-route", 11000);
    uncertainAdmission.release(uncertainPermit, oldPermitEpoch);
    checks ~= Ircv3Check("generation loss releases uncertain permits without stale-owner double release",
        !uncertainPermit && currentPermit && uncertainAdmission.inFlight == 1
        && uncertainAdmission.unprovenCount == 0);
    auto savedAdmission = registrationAdmission;
    scope(exit) registrationAdmission = savedAdmission;
    registrationAdmission = new RegistrationAdmission;
    client.registrationPermit = false;
    DialRequest cancelled;
    cancelled.host = config.host;
    cancelled.port = config.port;
    bool cancellation;
    try client.admitRegistration(cancelled, RouteKind.direct, () => false);
    catch (HolderUnavailableException) cancellation = true;
    checks ~= Ircv3Check("cancelled route wait owns no permit and emits no DIAL",
        cancellation && !client.registrationPermit && registrationAdmission.inFlight == 0 && dials == 0);
    // Run the actual registration read loop across EOF/rebind, both before
    // 001 and in the post-welcome MOTD tail. Neither test supplies a second
    // live welcome to rescue a buffered first 001.
    refuseRegistration = false;
    client.lastErrorText = "";
    client.maintenanceDeadlineMs = 0;
    foreach (mode; [1, 2]) {
        client.connection.close();
        closed = false;
        id = "held-gap-" ~ mode.to!string;
        physicalTime++;
        gap = 0;
        client.lastGapHandled = client.lastGapAcknowledged = 0;
        client.gapReplayUncertain = false;
        client.attachBacklogBytes = 0;
        client.saslSucceeded = false;
        client.servicesAccountState = ServicesAccountState.unknown;
        client.servicesAccount = "";
        client.channelState = null;
        client.channelUsers = null;
        client.inboundPartial = null;
        claim();
        registrationGapMode = mode;
        const beforeRegistrations = registrations();
        const beforeCloses = closes;
        client.registrationPermit = registrationAdmission.tryStart("gap-route-" ~ mode.to!string, unixMsNow());
        client.registrationPermitEpoch = registrationAdmission.epoch;
        client.performRegistration();
        checks ~= Ircv3Check(mode == 1
            ? "registration gap retains its first buffered actual 001 but quarantines raw-byte auth and NAMES"
            : "post-001 registration rebind quarantines retained auth membership and duplicate welcome",
            client.observed001AtMs > 0 && !client.registrationPermit && registrationAdmission.inFlight == 0
            && (mode == 1 || client.observed001AtMs == welcomeBeforeRebind)
            && !client.saslSucceeded && client.servicesAccountState == ServicesAccountState.unknown
            && client.servicesAccount.length == 0 && client.channelUsers.length == 0
            && client.channelState.length == 0 && client.attachBacklogBytes <= 0
            && client.holderConnId == id && registrations() == beforeRegistrations + 2
            && closes == beforeCloses && dials == 0);
        drain();
    }
    client.connection.close();
    id = "held-timeout";
    physicalTime++;
    gap = 0;
    closed = false;
    claim();
    silentRegistration = true;
    timeoutCleanup = true;
    failStatus = true; // first cleanup observation is unavailable, not closed
    client.inboundPartial = null;
    client.registrationPermit = registrationAdmission.tryStart("timeout-route", unixMsNow());
    client.registrationPermitEpoch = registrationAdmission.epoch;
    const beforeTimeoutCloses = closes;
    bool timedOut;
    try client.performRegistration(1);
    catch (Exception e) timedOut = e.msg.startsWith("Registration timeout:");
    client.releaseRegistrationPermit(); // normal attempt scope-exit
    client.releaseRegistrationPermit();
    checks ~= Ircv3Check("terminal registration timeout retains admission through outage and confirmed closure without unread parking",
        timedOut && timeoutPermitObserved && timeoutConfirmationObserved
        && !client.holderConnId.length && !client.registrationPermit
        && registrationAdmission.inFlight == 0 && closes == beforeTimeoutCloses + 1 && dials == 0);
    timeoutCleanup = false;
    silentRegistration = false;
    drain();
    client.connection.close();
    id = "held-motd-only";
    physicalTime++;
    closed = false;
    claim();
    motdWithoutWelcome = true;
    client.inboundPartial = null;
    client.registrationPermit = registrationAdmission.tryStart("motd-only-route", unixMsNow());
    client.registrationPermitEpoch = registrationAdmission.epoch;
    bool noWelcome;
    try client.performRegistration(1);
    catch (Exception e) noWelcome = e.msg.startsWith("Registration timeout:");
    client.releaseRegistrationPermit();
    checks ~= Ircv3Check("MOTD completion without actual 001 cannot claim registration or release a live attempt",
        noWelcome && client.observed001AtMs == 0 && !client.holderConnId.length
        && !client.registrationPermit && registrationAdmission.inFlight == 0 && dials == 0);
    motdWithoutWelcome = false;
    drain();
    closed = false;
    id = "held-uncertain-terminal";
    physicalTime++;
    claim();
    client.registrationPermit = registrationAdmission.tryStart("uncertain-terminal-route", unixMsNow());
    client.registrationPermitEpoch = registrationAdmission.epoch;
    client.registrationPermitUnproven = true;
    registrationAdmission.retainUnproven(client.registrationPermitEpoch);
    client.releaseRegistrationPermit();
    const retainedAttempt = client.registrationPermit && registrationAdmission.inFlight == 1
        && registrationAdmission.unprovenCount == 1;
    closed = true; // later authoritative same-incarnation termination evidence
    client.recoverHolderRelay(false, true);
    client.releaseRegistrationPermit();
    checks ~= Ircv3Check("unproven registration remains accounted until later terminal proof and releases exactly once",
        retainedAttempt && !client.holderConnId.length && !client.registrationPermit
        && registrationAdmission.inFlight == 0 && registrationAdmission.unprovenCount == 0);
    {
        auto fixture = EgressPlanHarness.open(EgressPlanHarness.standardPool()[0 .. 1]);
        scope(exit) fixture.close();
        client.config.routing = testRouting([RouteKind.mullvad]);
        DialRequest queued;
        queued.host = config.host;
        queued.port = config.port;
        queued.hasProxy = true;
        queued.tag.egressLabel = mullvadPool[0].label;
        queued.proxy = DialProxy(mullvadPool[0].host, mullvadPool[0].port, "", "");
        foreach (trial; [false, true]) {
            registrationAdmission = new RegistrationAdmission;
            bool[8] held;
            foreach (i; 0 .. 8)
                held[i] = registrationAdmission.tryStart("occupied-" ~ i.to!string, unixMsNow());
            const token = trial ? "queued-recovery-trial" : "";
            fixture.admission.set(queued.tag.egressLabel, trial ? "recovering" : "healthy");
            fixture.admission.admitReplies[queued.tag.egressLabel] = EgressDialAdmit(true, token, "");
            fixture.admission.trialSettlements = 0;
            bool invalidated, invalidationFailed;
            runTask(() nothrow {
                scope(exit) registrationAdmission.release(held[0]);
                try {
                    sleep(50.msecs);
                    fixture.admission.set(queued.tag.egressLabel, "draining");
                    fixture.admission.trialsCancelled = trial;
                    invalidated = true;
                } catch (Throwable) { invalidationFailed = true; }
            });
            bool blocked;
            TCPConnection dialQueued(RouteCandidate candidate, out DialResult result) {
                client.admitRegistration(queued, candidate.kind, () => true, candidate.trialToken);
                dials++; // transport seam: must never be reached
                return TCPConnection.init;
            }
            EgressUsed unused;
            DialResult unusedResult;
            try connectThroughEgressPlan(&dialQueued, config.id.toString(), config.host, config.port,
                "none", client.config.routing, true, "", null, "", unused, unusedResult);
            catch (RoutingPolicyBlockedException) blocked = true;
            checks ~= Ircv3Check(trial
                ? "post-wait drained recovery trial cannot reach DIAL or mark its claim registered"
                : "post-wait durable exit drain refuses actual DIAL without consuming admission",
                invalidated && !invalidationFailed && blocked && !client.registrationPermit
                && registrationAdmission.inFlight == 7 && dials == 0
                && fixture.admission.registeredTrials.length == 0
                && fixture.admission.trialSettlements == (trial ? 1 : 0));
            fixture.admission.trialsCancelled = false;
        }
        registrationAdmission = new RegistrationAdmission;
        registrationAdmission.observeIncarnation(incarnation);
        auto manager = new ConnectionManager(events);
        blockTerminalObservation = true;
        bool allReaped = true;
        foreach (index; 0 .. RegistrationAdmission.MAX_IN_FLIGHT) {
            holder.connectControl();
            manager.addNetwork(config, UUID.init);
            auto stopped = manager.getClient(config.id);
            const claimId = "stopped-terminal-" ~ index.to!string;
            auto retainedEntry = entry();
            retainedEntry["id"] = claimId;
            retainedEntry["state"] = "open";
            terminalEntries[claimId] = retainedEntry;
            stopped.holder = holder;
            stopped.holderConnId = claimId;
            stopped.holderInstance = incarnation;
            stopped.holderConnectedAtMs = physicalTime;
            stopped.state = ConnectionState.connecting;
            stopped.registrationPermit = registrationAdmission.tryStart(
                "stopped-route-" ~ index.to!string, unixMsNow());
            stopped.registrationPermitEpoch = registrationAdmission.epoch;
            loseCloseAck = true;
            manager.removeNetwork(config.id); // stop + actual manager root reclamation
            manager.reapRetiredClients(unixMsNow());
            const roots = manager.memoryCounters();
            allReaped = allReaped && stopped.getMoveQuiescent()
                && !stopped.registrationPermit && !stopped.registrationPermitUnproven
                && roots.activeGenerations == 0 && roots.retiredGenerations == 0;
            stopped = null;
            drain();
        }
        checks ~= Ircv3Check("stopped and reaped preregistration clients transfer at most eight proof-only terminal claims",
            allReaped && registrationAdmission.inFlight == 8
            && registrationAdmission.unprovenCount == 8 && registrationAdmission.terminalClaimCount == 8);
        auto waiter = new PersistentIRCClient(config, events);
        waiter.config.routing = testRouting([RouteKind.direct]);
        DialRequest pending;
        pending.host = config.host;
        pending.port = config.port;
        bool waiterAdmitted, waiterFinished;
        runTask({
            scope(exit) waiterFinished = true;
            try {
                waiter.admitRegistration(pending, RouteKind.direct, () => !waiter.isShutdownRequested);
                waiterAdmitted = true;
            } catch (Exception) {}
        });
        sleep(50.msecs);
        const waitedWithoutPermit = !waiterFinished && !waiter.registrationPermit
            && registrationAdmission.inFlight == 8;
        const beforeProofCloses = closes;
        const detachedProof = registrationAdmission.terminalClaimAt(0);
        blockTerminalObservation = false;
        holder.connectControl();
        const proofDeadline = unixMsNow() + 4000;
        while ((!waiterFinished || registrationAdmission.terminalClaimCount > 0)
                && unixMsNow() < proofDeadline) sleep(5.msecs);
        checks ~= Ircv3Check("independent INFO proof releases reaped generations and admits a waiting attempt without holder replacement or CLOSE",
            waitedWithoutPermit && waiterFinished && waiterAdmitted && waiter.registrationPermit
            && registrationAdmission.terminalClaimCount == 0 && registrationAdmission.unprovenCount == 0
            && !registrationAdmission.resolveTerminalClaim(0, detachedProof.token, detachedProof.epoch)
            && registrationAdmission.inFlight == 1 && closes == beforeProofCloses
            && incarnation == holder.status().instance);
        waiter.isShutdownRequested = true;
        waiter.releaseRegistrationPermit();
        if (!waiterFinished) {
            const cancelDeadline = unixMsNow() + 1000;
            while (!waiterFinished && unixMsNow() < cancelDeadline) sleep(5.msecs);
        }
    }
    return checks;
}

@("maintenance freezes exact slot affinity and blocks force/drain/quarantine instead of rotating")
unittest {
    auto fixture = EgressPlanHarness.open(EgressPlanHarness.standardPool());
    scope(exit) fixture.close();
    auto channel = EngineEventChannel.create();
    scope(exit) channel.close();
    NetworkConfig config;
    config.host = "maintenance.invalid";
    config.nick = "me";
    config.port = 6667;
    config.tls = TLSMode.disabled;
    config.routing = testRouting([RouteKind.nordvpn, RouteKind.direct]);
    auto client = new PersistentIRCClient(config, channel);
    client.state = ConnectionState.connected;
    client.holderConnId = "frozen";
    client.holderConnectedAtMs = 100;
    client.activeRoute = "nordvpn";
    client.activeEgressLabel = "nord-se";
    client.activeEgressLocationId = slotBanKey(&mullvadPool[2]);
    const preferences = config.routing.toJson();
    client.freezeMaintenanceRoute(unixMsNow() + 600000);
    scope(exit) client.releaseMaintenanceRoute();
    assert(retargetSlotByLabel("nord-se", "fixture", true) == "maintenance-frozen");
    auto holder = new HolderClient("fixture", "tcp://127.0.0.1:1");
    size_t actualDials;
    DialResult owned(DialRequest request, DialProgress progress, RouteKind kind, string trialToken) {
        client.validateFrozenDial(request, kind);
        actualDials++;
        return DialResult.init;
    }
    fixture.admission.set("nord-se", "healthy");
    {
        EgressUsed permitted;
        DialResult accepted;
        client.dialFrozenRoute(holder, DialTag.init, "none", null, permitted, accepted, &owned);
        assert(actualDials == 1 && permitted.label == "nord-se"
            && permitted.kind == RouteKind.nordvpn && config.routing.toJson() == preferences);
        releaseSlot("nord-se"); // the successful transport's ordinary hold
        actualDials = 0;
    }
    foreach (state; ["draining", "open", "unavailable"]) {
        fixture.admission.set("nord-se", state);
        EgressUsed used;
        DialResult result;
        bool blocked;
        try client.dialFrozenRoute(holder, DialTag.init, "none", null, used, result, &owned);
        catch (RoutingPolicyBlockedException) blocked = true;
        assert(blocked && actualDials == 0);
    }
    fixture.admission.set("nord-se", "healthy");
    mullvadPool[2].exitHostname = "different-exit";
    EgressUsed used;
    DialResult result;
    bool changed;
    try client.dialFrozenRoute(holder, DialTag.init, "none", null, used, result, &owned);
    catch (RoutingPolicyBlockedException) changed = true;
    assert(changed && actualDials == 0 && config.routing.toJson() == preferences);
}

version (MemoryReliabilityHarness)
Ircv3Check[] maintenanceAdmissionRegressionChecks() {
    import ircfiber.irc.manager : holderMaintenanceRestorationRegressionChecks;
    auto fixture = EgressPlanHarness.open(EgressPlanHarness.standardPool());
    scope(exit) fixture.close();
    auto savedOwners = maintenanceSlotOwners;
    auto savedUntil = maintenanceSlotUntilMs;
    maintenanceSlotOwners = null;
    maintenanceSlotUntilMs = null;
    scope(exit) {
        maintenanceSlotOwners = savedOwners;
        maintenanceSlotUntilMs = savedUntil;
    }
    auto channel = EngineEventChannel.create();
    scope(exit) channel.close();
    Ircv3Check[] checks;
    auto proxy = fixture.proxy("nord-se");
    proxy.activeConns = 3; // existing ordinary socket owners, not maintenance
    const identity = routeIdentityLocked(proxy, "");
    const deadline = unixMsNow() + 599000;
    const mismatched = reserveMaintenanceSlot("nord-se", identity ~ "-changed", deadline);
    releaseMaintenanceSlot("nord-se");
    releaseMaintenanceSlot("nord-se");
    checks ~= Ircv3Check("identity mismatch reserves nothing and unmatched release preserves existing socket owners",
        !mismatched && proxy.activeConns == 3 && maintenanceSlotOwners.length == 0);
    const first = reserveMaintenanceSlot("nord-se", identity, deadline);
    const second = reserveMaintenanceSlot("nord-se", identity, deadline - 1000);
    releaseMaintenanceSlot("nord-se");
    checks ~= Ircv3Check("releasing one maintenance hold preserves the other owner's later deadline",
        first && second && proxy.activeConns == 4
        && maintenanceSlotOwners.get("nord-se", 0) == 1
        && maintenanceSlotUntilMs.get("nord-se", 0) == deadline);
    releaseMaintenanceSlot("nord-se");
    checks ~= Ircv3Check("last maintenance release restores ordinary owner count and clears retarget fence",
        proxy.activeConns == 3 && maintenanceSlotOwners.length == 0 && maintenanceSlotUntilMs.length == 0);
    auto route = Json.emptyObject;
    route["provider"] = "nordvpn";
    route["slot"] = "nord-se";
    route["exitId"] = slotBanKey(proxy);
    route["nativeIpv6"] = "";
    checks ~= holderMaintenanceRestorationRegressionChecks(route, identity);
    checks ~= Ircv3Check("failed later slot acquisition rolls back every earlier successful hold",
        proxy.activeConns == 3 && maintenanceSlotOwners.length == 0 && maintenanceSlotUntilMs.length == 0);
    NetworkConfig config;
    config.host = "maintenance.invalid";
    config.nick = "me";
    config.port = 6667;
    config.tls = TLSMode.disabled;
    config.routing = testRouting([RouteKind.nordvpn, RouteKind.direct]);
    auto row = Json.emptyObject;
    row["host"] = config.host;
    row["port"] = cast(int) config.port;
    row["tls"] = "none";
    row["routingPreferences"] = config.routing.toJson();
    row["route"] = route;
    row["routeIdentity"] = identity;
    foreach (admission; ["draining", "open", "unavailable"]) {
        fixture.admission.set("nord-se", admission);
        auto client = new PersistentIRCClient(config, channel);
        bool rejected;
        try client.restoreMaintenanceRoute(row, deadline);
        catch (RoutingPolicyBlockedException) rejected = true;
        checks ~= Ircv3Check("restoration refuses " ~ admission ~ " concrete exits without acquiring a client hold",
            rejected && proxy.activeConns == 3);
    }
    fixture.admission.set("nord-se", "healthy");
    auto changed = config;
    changed.routing.preferredExit = "nord-se";
    bool rejectedPreferences;
    try (new PersistentIRCClient(changed, channel)).restoreMaintenanceRoute(row, deadline);
    catch (Exception) rejectedPreferences = true;
    checks ~= Ircv3Check("a changed routing preference cannot silently reuse the frozen provider",
        rejectedPreferences);
    auto client = new PersistentIRCClient(config, channel);
    client.restoreMaintenanceRoute(row, deadline);
    bool allowRegistration;
    client.setMaintenanceRegistrationGate(() => allowRegistration);
    auto holder = new HolderClient("fixture", "tcp://127.0.0.1:1");
    client.holder = holder;
    bool blockedFresh;
    try client.dialViaHolder("none");
    catch (RoutingPolicyBlockedException) blockedFresh = true;
    checks ~= Ircv3Check("unvalidated bootstrap maintenance blocks fresh registration before holder I/O or a permit",
        blockedFresh && !client.registrationPermit && !client.holderConnId.length);
    allowRegistration = true;
    bool admittedGate = true;
    try client.requireMaintenanceRegistration();
    catch (Exception) admittedGate = false;
    checks ~= Ircv3Check("validated restoration releases only the fresh-registration gate",
        admittedGate && proxy.activeConns == 3);
    {
        auto starting = new PersistentIRCClient(config, channel);
        size_t preparations;
        bool releasePreparation, preparationFinished;
        scope(exit) releasePreparation = true;
        runTask({
            scope(exit) preparationFinished = true;
            starting.start(() {
                preparations++;
                while (!releasePreparation) sleep(1.msecs);
                return true;
            });
        });
        const admissionDeadline = unixMsNow() + 1000;
        while (!preparations && unixMsNow() < admissionDeadline) sleep(1.msecs);
        starting.start(() { preparations++; return true; });
        starting.requestMoveStop();
        const pendingRetained = !starting.getMoveQuiescent();
        releasePreparation = true;
        const completionDeadline = unixMsNow() + 1000;
        while (!preparationFinished && unixMsNow() < completionDeadline) sleep(1.msecs);
        checks ~= Ircv3Check("fresh producer preparation is single-flight and shutdown reclaims it without starting a stale loop",
            preparations == 1 && pendingRetained && preparationFinished
            && starting.getMoveQuiescent() && !starting.loopRunning && !starting.holderConnId.length);
        auto held = new PersistentIRCClient(config, channel);
        held.state = ConnectionState.connected;
        held.start(() { preparations++; return true; });
        checks ~= Ircv3Check("already attached readers never wait on fresh producer scope preparation",
            preparations == 1 && !held.startPreparationPending);
    }
    return checks;
}
