    }
    /// Non-sensitive services availability: `unavailable` without a live
    /// epoch, else `unknown` — nothing here has discovered services yet.
    @property string getServicesAvailability() const nothrow {
        return getConnectionEpoch().length ? "unknown" : "unavailable";
    }
    /// Seconds since the last inbound byte; 0 when never. Surfaced via the
    /// state snapshot so the UI can hint staleness before the PONG watchdog fires.
    @property long getDataAgeSecs() const { return lastDataReceivedSecs > 0 ? Clock.currTime.toUnixTime!long - lastDataReceivedSecs : 0; }
    /// Seconds since the last PONG; 0 when never.
    @property long getPongAgeSecs() const { return lastPongReceivedSecs > 0 ? Clock.currTime.toUnixTime!long - lastPongReceivedSecs : 0; }
    /// Whether `getTlsInfo()` describes the live TLS session.
    @property bool hasTlsInfo() const nothrow { return tlsInfoValid; }
    /// Negotiated TLS session details (valid only when `hasTlsInfo`).
    @property TlsInfo getTlsInfo() const nothrow { return tlsInfo; }

    /// Clears per-connection telemetry. Called on every disconnect and
    /// before each reconnect attempt so a stale lag/uptime/TLS tuple
    /// from the previous socket never leaks into the next snapshot.
    private void resetConnectionTelemetry() nothrow {
        // Every connect attempt and every disconnect passes through here, so
        // this is the one place that guarantees a slot hold cannot outlive
        // the socket that took it.
        releaseEgressSlot();
        lagMs = -1;
        lagProbeSentMs = 0;
        connectedAtMs = 0;
        // Identity proof and discovery are per socket: a reconnect starts
        // unverified and forgets every probe the old socket carried.
        ownPrefix = "";
        // So are the epoch and the observed services login.
        connectionEpoch = "";
        servicesAccount = "";
        servicesAccountState = ServicesAccountState.unknown;
        announceServicesState();
        // Transactions, fences, probes and the service write queue belonged
        // to that socket.
        try services.onDisconnect();
        catch (Exception) {}
        fiberReplyTatMs = 0;
        fiberRequesterNotBeforeMs = null;
        fiberProbeQueue = null;
        // The per-recipient backstop outlives the socket; a QUERY this
        // socket left unanswered counts as unanswered.
        foreach (ref p; fiberProbesSent.byValue) noteFiberUnanswered(p);
        fiberProbesSent = null;
        fiberProbeNotBeforeMs = 0;
        fiberRosterWhoMs = null;
        fiberSelfWhoMs = 0;
        attachBacklogBytes = 0;
        tlsInfoValid = false;
        tlsInfo = TlsInfo.init;
        // Per-connection: a fresh socket may legitimately re-ask once.
        // Member identity lifetime follows the live-owner reconciliation
        // when registration replaces the old socket's rosters.
        whoEnrichAttempts = null;
        linesIn = 0;
        linesOut = 0;
        whoOut = 0;
        // A new socket gets a fresh throttle budget; pending JOINs from the
        // old one are meaningless (the reconnect re-sends the auto-joins).
        joinsAwaitingConfirm = [];
        joinThrottleRounds = 0;
        joinThrottleRetryInFlight = false;
        joinRetryEpoch++;
        // A fresh socket gets a fresh NAMES; nothing held is owed any more.
        memberFlaps = null;
        memberFlapEpoch++;
        memberFlapSweepArmed = false;
        inboundPartial = null;
    }

    /// Members tracked by the flap guard at once. Past it the guard fails
    /// open (relays live) rather than growing without bound in a channel
    /// with heavy churn; idle members are forgotten after one window.
    private enum MEMBER_FLAP_MAX_TRACKED = 8_192;
    /// How often the sweep settles held members.
    private enum MEMBER_FLAP_SWEEP_MS = 500;

    /// Flap-guard key for one member of one channel. Channel "" holds a
    /// QUIT from a nick in none of our tracked channels.
    private string memberKey(string chan, string nick) {
        return chan ~ "\0" ~ foldNick(nick);
    }

    private bool rosterHas(string chan, string nick) {
        foreach (u; channelUsers.get(chan, null))
            if (sameNick(u, nick)) return true;
        return false;
    }

    /// Runs one membership line of another user's (applied to the roster
    /// already) through the flap guard. Null: publish it now. Otherwise it
    /// is held, and the caller stores in `pending` the line the sweep
    /// relays if the member settles in this state.
    ///
    /// An echo — a line that changes nothing, about a member whose state we
    /// already published — is held without spending budget: a client
    /// re-sending JOIN gets one row, not one per echo. A member we have not
    /// published yet is relayed even when the roster already lists them,
    /// since that entry may be a ghost a missed QUIT left behind.
    private MemberFlap* holdMembership(string chan, string nick, bool wasIn, bool isIn) {
        const key = memberKey(chan, nick);
        const nowMs = unixMsNow();
        auto f = key in memberFlaps;
        if (f is null) {
            if (memberFlaps.length >= MEMBER_FLAP_MAX_TRACKED) return null;
            MemberFlap fresh;
            fresh.chan = chan;
            fresh.nick = nick;
            fresh.published = wasIn;
            memberFlaps[key] = fresh;
            f = key in memberFlaps;
        } else if (wasIn == isIn && f.published == isIn) {
            f.lastLineMs = nowMs; // keeps the record (and so this rule) alive
            return f;
        }
        armMemberFlapSweep();
        return admitMemberFlap(*f, isIn, nowMs) ? null : f;
    }

    /// Relays `f`'s held line iff the roster now differs from what
    /// downstream last saw and the line says what the roster says (a NAMES
    /// rebase may have moved the roster since the line was held).
    private void releaseHeld(ref MemberFlap f) {
        if (f.pending.command.length > 0) {
            const isIn = f.chan.length > 0 && rosterHas(f.chan, f.nick);
            if (isIn != f.published && (f.pending.command == "JOIN") == isIn) {
                eventChannel.put(f.pending);
                f.published = isIn;
            }
        }
        f.pending = IRCRawEvent.init;
    }

    /// The sweep: settles members whose storm is over (or has been held
    /// MAX_HOLD) and forgets idle ones. See `memberFlapDue`.
    private void settleMemberFlaps(long nowMs) {
        string[] idle;
        foreach (key, ref f; memberFlaps) {
            final switch (memberFlapDue(f, nowMs)) {
                case MemberFlapDue.wait:
                    break;
                case MemberFlapDue.forget:
                    idle ~= key;
                    break;
                case MemberFlapDue.settle:
                    releaseHeld(f);
                    // Still storming (MAX_HOLD, not quiet): keep holding.
                    f.holdSinceMs = nowMs - f.lastLineMs >= MEMBER_FLAP_QUIET_MS ? 0 : nowMs;
                    break;
            }
        }
        foreach (k; idle) memberFlaps.remove(k);
    }

    /// A rename moves the member to a new key: release what is held for the
    /// old nick now, so it lands before the NICK line that renames it.
    private void flushMemberFlaps(string nick) {
        const suffix = "\0" ~ foldNick(nick);
        string[] gone;
        foreach (key, ref f; memberFlaps) {
            if (key.endsWith(suffix)) {
                releaseHeld(f);
                gone ~= key;
            }
        }
        foreach (k; gone) memberFlaps.remove(k);
    }

    /// We left `chan`: nothing about its members is owed downstream.
    private void forgetMemberFlaps(string chan) {
        const prefix = chan ~ "\0";
        string[] gone;
        foreach (key, _; memberFlaps)
            if (key.startsWith(prefix)) gone ~= key;
        foreach (k; gone) memberFlaps.remove(k);
    }

    private void armMemberFlapSweep() nothrow {
        if (memberFlapSweepArmed) return;
        memberFlapSweepArmed = true;
        const epoch = memberFlapEpoch;
        try {
            runTask({
                try {
                    while (memberFlapEpoch == epoch && memberFlaps.length > 0) {
                        sleep(MEMBER_FLAP_SWEEP_MS.msecs);
                        if (memberFlapEpoch == epoch) settleMemberFlaps(unixMsNow());
                    }
                } catch (Exception e) {
                    logWarn("Membership flap sweep failed for %s: %s", config.name, e.msg);
                }
                // A newer socket's sweep owns the flag now.
                if (memberFlapEpoch == epoch) memberFlapSweepArmed = false;
            });
        } catch (Exception) {
            memberFlapSweepArmed = false;
        }
    }

    /// Max channels tracked for the throttle retry. The auto-join burst is
    /// the realistic upper bound; the cap only stops an unbounded list when
    /// a server never answers a JOIN at all.
    private enum MAX_PENDING_JOINS = 64;

    /// Records the targets of an outgoing `JOIN <chans>[ <keys>]`.
    private void recordPendingJoins(string argstr) nothrow {
        try {
            auto targets = argstr.strip();
            auto sp = targets.indexOf(' ');
            if (sp >= 0) targets = targets[0 .. sp]; // drop channel keys
            foreach (raw; targets.split(",")) {
                auto chan = normalizeChannelName(raw.strip());
                if (chan.length == 0) continue;
                if (joinsAwaitingConfirm.canFind(chan)) continue;
                if (joinsAwaitingConfirm.length >= MAX_PENDING_JOINS) return;
                joinsAwaitingConfirm ~= chan;
            }
        } catch (Exception) {}
    }

    /// Drops a channel from the pending set — it either joined or the server
    /// refused it for a reason waiting will not fix.
    private void clearPendingJoin(string chan) nothrow {
        try {
            auto norm = normalizeChannelName(chan);
            auto i = joinsAwaitingConfirm.countUntil(norm);
            if (i >= 0) joinsAwaitingConfirm = joinsAwaitingConfirm.remove(i);
        } catch (Exception) {}
    }

    /// Max throttle retry rounds per connection. A server that keeps saying
    /// "wait" must never turn into a JOIN loop, but one round is not always
    /// enough: observed on prod, SuperNETs rate-limits *per command*, so the
    /// first round can itself be partially throttled.
    private enum MAX_JOIN_THROTTLE_ROUNDS = 3;

    /// SuperNETs/DangerousIRCd (and UnrealIRCd anti-flood) answer a JOIN sent
    /// inside the first N seconds after connect with `421 <nick> JOIN :You
    /// must be connected for at least N seconds…` and drop the channel, so an
    /// auto-join burst that raced the window leaves the user in no channels.
    ///
    /// The retry re-sends the unconfirmed channels as ONE comma-separated
    /// JOIN rather than a burst of them. Prod evidence (2026-09-05, five
    /// auto-joins on Supernets): a burst of five separate JOINs sent right
    /// after the window landed only the first — the rest were dropped
    /// silently by the per-command rate limit. One command is one rate-limit
    /// hit, and `TARGMAX=…JOIN:` there is unlimited (`CHANLIMIT=#:10`).
    private void scheduleJoinThrottleRetry(uint windowSecs) nothrow {
        if (joinThrottleRetryInFlight) return;
        if (joinThrottleRounds >= MAX_JOIN_THROTTLE_ROUNDS) return;
        if (joinsAwaitingConfirm.length == 0) return;
        joinThrottleRounds++;
        joinThrottleRetryInFlight = true;
        // +1s cushion: the window is measured server-side from its own view
        // of the connect, which is never earlier than ours. Later rounds are
        // answering a fresh 421, so wait the whole window again.
        auto waitMs = joinThrottleRounds == 1
            ? remainingJoinDelayMs(windowSecs + 1, nowMsSafe(), registrationStartedAtMs)
            : (windowSecs + 1) * 1000L;
        if (waitMs <= 0) waitMs = 500;
        try {
            logJsonMap("warn", "connection",
                "JOIN throttled — retrying after the server's grace period",
                ["network": config.name,
                 "channels": joinsAwaitingConfirm.join(","),
                 "round": joinThrottleRounds.to!string,
                 "windowSecs": windowSecs.to!string,
                 "waitMs": waitMs.to!string,
                 "event": "join_throttled"]);
            const epoch = joinRetryEpoch;
            runTask({
                try {
                    sleep(waitMs.msecs);
                    // A newer socket owns the retry state now.
                    if (joinRetryEpoch != epoch) return;
                    scope(exit) joinThrottleRetryInFlight = false;
                    if (state != ConnectionState.connected) return;
                    // Anything confirmed or refused while we waited is gone
                    // from the pending set — never re-ask for it. A further
                    // round picks up whatever does not fit in one line.
                    auto batches = joinBatches(joinsAwaitingConfirm);
                    if (batches.length == 0) return;
                    logInfo("Re-sending throttled JOIN(s) for %s as one command: %s",
                        config.name, batches[0]);
                    sendRaw("JOIN " ~ batches[0]);
                } catch (Exception e) {
                    if (joinRetryEpoch == epoch) joinThrottleRetryInFlight = false;
                    logWarn("JOIN throttle retry failed for %s: %s", config.name, e.msg);
                }
            });
        } catch (Exception) {
            joinThrottleRetryInFlight = false;
        }
    }

    /// SuperNets' and similar servers' channel-targeted flood complaint
    /// rides numeric 405 (isFloodNotice(event.text) matched, not a genuine
    /// ERR_TOOMANYCHANNELS — see the case "405" handler). Unlike the 421
    /// throttle window (an explicit "wait N seconds from connect" the
    /// server states), a flood complaint gives no explicit window, so the
    /// wait is computed from the pacer's own documented fake-lag/recvq
    /// model (pacer.d) via its real `waitMs()` — not guessed — using the
    /// exact bytes the re-sent JOIN batch will cost. `onFloodComplaint`
    /// (called just before this) already ran `tighten()`, which primes
    /// `minIntervalMs` (doubled per complaint, capped at 4s) and
    /// `lastSendMs`, so `waitMs()` here returns that modelled floor
    /// immediately — the same quantity the paced PRIVMSG/NOTICE queue
    /// already waits on in `drainPacedQueue`, applied to JOIN for once.
    /// Reuses the same bounded-rounds safety net as
    /// scheduleJoinThrottleRetry (shared joinThrottleRounds counter: a
    /// server that will not stop complaining must never turn into a JOIN
    /// loop either way) and the same one-batched-JOIN re-send.
    ///
    /// Prod incident 2026-11-02: 9 SuperNets auto-join channels batched
    /// into one JOIN; the server's flood complaint named #superbowl in a
    /// 405 and the old handler dropped it from joinsAwaitingConfirm with
    /// no retry — 8 of 9 channels landed, #superbowl never did.
    private void scheduleFloodJoinRetry() nothrow {
        if (joinThrottleRetryInFlight) return;
        if (joinThrottleRounds >= MAX_JOIN_THROTTLE_ROUNDS) return;
        if (joinsAwaitingConfirm.length == 0) return;
        joinThrottleRounds++;
        joinThrottleRetryInFlight = true;
        long waitMs = 2000;
        try {
            auto batches = joinBatches(joinsAwaitingConfirm);
            if (batches.length > 0) {
                // "JOIN " + batch + CRLF — the exact bytes writeRaw charges.
                const cmdBytes = ("JOIN " ~ batches[0]).length + 2;
                const modeled = pacer.waitMs(cmdBytes, nowMsSafe());
                waitMs = modeled > 0 ? modeled : pacer.limits().penaltyMs;
            }
        } catch (Exception) {}
        if (waitMs < 500) waitMs = 500;
        try {
            logJsonMap("warn", "connection",
                "JOIN flood-complained — retrying after the pacer's backoff",
                ["network": config.name,
                 "channels": joinsAwaitingConfirm.join(","),
                 "round": joinThrottleRounds.to!string,
                 "waitMs": waitMs.to!string,
                 "event": "join_flood_retry"]);
            const epoch = joinRetryEpoch;
            runTask({
                try {
                    sleep(waitMs.msecs);
                    // A newer socket owns the retry state now.
                    if (joinRetryEpoch != epoch) return;
                    scope(exit) joinThrottleRetryInFlight = false;
                    if (state != ConnectionState.connected) return;
                    // Anything confirmed or refused while we waited is gone
                    // from the pending set — never re-ask for it.
                    auto batches = joinBatches(joinsAwaitingConfirm);
                    if (batches.length == 0) return;
                    logInfo("Re-sending flood-complained JOIN(s) for %s as one command: %s",
                        config.name, batches[0]);
                    sendRaw("JOIN " ~ batches[0]);
                } catch (Exception e) {
                    if (joinRetryEpoch == epoch) joinThrottleRetryInFlight = false;
                    logWarn("Flood JOIN retry failed for %s: %s", config.name, e.msg);
                }
            });
        } catch (Exception) {
            joinThrottleRetryInFlight = false;
        }
    }

    /// Seconds after the auto-join burst to check whether every channel
    /// confirmed (JOIN echo) or was refused (a numeric). Longer than
    /// SuperNETs' observed 5s throttle window and any normal round trip.
    private enum JOIN_CONFIRM_SWEEP_MS = 8_000;

    /// Safety net for a channel whose JOIN the server neither echoed nor
    /// answered with any numeric at all — not a 421 throttle, not a 405
    /// flood complaint, nothing. `scheduleJoinThrottleRetry` and
    /// `scheduleFloodJoinRetry` only fire in response to one of those
    /// numerics, so a server that just swallows one channel's JOIN out of
    /// a batch (observed on SuperNETs/#superbowl, 2026-11-03: 8 of 9
    /// auto-join channels confirmed within milliseconds, #superbowl got no
    /// reply of any kind on two separate reconnects) left that channel
    /// stuck in `joinsAwaitingConfirm` forever — `isJoined` stayed true
    /// from the pre-disconnect snapshot, the roster never refreshed, and
    /// nothing short of a manual /part + /join noticed. Armed once per
    /// auto-join burst; shares `joinThrottleRounds`/`MAX_JOIN_THROTTLE_ROUNDS`
    /// with the other two retries so this can't itself become a JOIN loop.
    private void scheduleJoinConfirmSweep() nothrow {
        if (joinConfirmSweepArmed) return;
        joinConfirmSweepArmed = true;
        const epoch = joinRetryEpoch;
        try {
            runTask({
                try {
                    sleep(JOIN_CONFIRM_SWEEP_MS.msecs);
                    // A newer socket owns the retry state now.
                    if (joinRetryEpoch != epoch) return;
                    joinConfirmSweepArmed = false;
                    if (joinsAwaitingConfirm.length == 0) return;
                    // A throttle/flood retry already in flight covers these
                    // same channels — don't send a second JOIN for them.
                    if (joinThrottleRetryInFlight) return;
                    if (joinThrottleRounds >= MAX_JOIN_THROTTLE_ROUNDS) {
                        logJsonMap("warn", "connection",
                            "JOIN never confirmed or refused — giving up (round cap)",
                            ["network": config.name,
                             "channels": joinsAwaitingConfirm.join(","),
                             "event": "join_confirm_timeout_exhausted"]);
                        return;
                    }
                    if (state != ConnectionState.connected) return;
                    joinThrottleRounds++;
                    auto batches = joinBatches(joinsAwaitingConfirm);
                    if (batches.length == 0) return;
                    logJsonMap("warn", "connection",
                        "JOIN never confirmed or refused — retrying once",
                        ["network": config.name,
                         "channels": joinsAwaitingConfirm.join(","),
                         "round": joinThrottleRounds.to!string,
                         "event": "join_confirm_timeout"]);
                    sendRaw("JOIN " ~ batches[0]);
                } catch (Exception e) {
                    if (joinRetryEpoch == epoch) joinConfirmSweepArmed = false;
                    logWarn("JOIN confirm sweep failed for %s: %s", config.name, e.msg);
                }
            });
        } catch (Exception) {
            joinConfirmSweepArmed = false;
        }
    }

    /// Drops this client's slot refcount if it holds one. Idempotent by
    /// construction — `egressSlotHeld` is cleared before the release.
    private void releaseEgressSlot() nothrow {
        if (!egressSlotHeld) return;
        egressSlotHeld = false;
        releaseSlot(egressSlotLabel);
        egressSlotLabel = "";
    }

    private void clearEgressTrial() nothrow {
        egressTrialToken = "";
        egressTrialExit = EgressEndpointRef.init;
        egressTrialProbeSentMs = 0;
    }

    /// The trial session registered: start the store's sustain clock (first
    /// call only) and extend the claim past it. A stale token means the
    /// trial was cancelled (drain) or expired; the session itself carries on
    /// untouched but no longer speaks for the exit.
    private void renewEgressTrialOnRegistered() nothrow {
        if (egressTrialToken.length == 0) return;
        const r = renewTrial(egressTrialExit, egressTrialToken);
        if (r == "ok") {
            emitLog("info", "Registered via VPN exit " ~ egressTrialExit.label ~ " during its recovery trial; "
                ~ "the exit takes new connections again only if this session stays registered for "
                ~ (EGRESS_TRIAL_SUSTAIN_MS / 1000).to!string ~ "s and then answers a keepalive PING.");
        } else if (r == "stale") {
            emitLog("info", "The recovery trial of VPN exit " ~ egressTrialExit.label
                ~ " was cancelled or expired; this session continues but does not count as a trial.");
            clearEgressTrial();
        }
        // "error": keep the token; the claim lock still bounds the trial.
    }

    /// Keepalive tick, right after a lag PING left: once the trial session
    /// has been registered for the sustain window, that PING becomes the
    /// trial's liveness probe. Nothing is settled here.
    private void noteEgressTrialProbe(long pingSentMs) nothrow {
        if (egressTrialToken.length == 0 || connectedAtMs <= 0 || pingSentMs <= 0) return;
        if (pingSentMs - connectedAtMs < EGRESS_TRIAL_SUSTAIN_MS) return;
        egressTrialProbeSentMs = pingSentMs;
    }

    /// A PONG answered lag PING `sentMs`. When that PING is the trial's
    /// post-window probe, the session has proven a live end-to-end round
    /// trip after staying registered: ask the store to close the circuit
    /// (it re-checks the window against its own registration mark).
    private void completeEgressTrialOnPong(long sentMs) nothrow {
        if (egressTrialToken.length == 0 || egressTrialProbeSentMs == 0 || sentMs != egressTrialProbeSentMs) return;
        egressTrialProbeSentMs = 0;
        const label = egressTrialExit.label;
        const r = settleTrial(egressTrialExit, egressTrialToken, EgressTrialOutcome.success, "");
        if (r == "ok") {
            emitLog("info", "VPN exit " ~ label ~ " passed its recovery trial (registered "
                ~ (EGRESS_TRIAL_SUSTAIN_MS / 1000).to!string ~ "s, keepalive answered) and takes new connections again.");
            announceEgressRecovery(label, nowMsSafe());
            clearEgressTrial();
        } else if (r == "stale") {
            clearEgressTrial();
        } else if (r == "early") {
            // The store never saw this session register (renew failed):
            // mark it now; a later post-window probe must be answered.
            renewEgressTrialOnRegistered();
        }
        // "error": the next post-window probe retries; the lock bounds it.
    }

    /// Settles a trial that did not complete while its session lived: the
    /// session ended (or was superseded) without an answered post-window
    /// probe, so the exit is not proven — uptime alone never heals it. An
    /// engine stop releases the claim without penalty; anything else is a
    /// failed trial (next cooldown). Never called for a hot-swap detach.
    private void settleEgressTrialOnEnd(long uptimeMs, bool stopping) nothrow {
        if (egressTrialToken.length == 0) return;
        const token = egressTrialToken;
        const exit = egressTrialExit;
        clearEgressTrial();
        if (stopping) {
            settleTrial(exit, token, EgressTrialOutcome.abort, "");
            return;
        }
        settleTrial(exit, token, EgressTrialOutcome.failure, "recovery trial session ended after "
            ~ (uptimeMs / 1000).to!string ~ "s without an answered keepalive after the "
            ~ (EGRESS_TRIAL_SUSTAIN_MS / 1000).to!string ~ "s window");
    }

    /// Whether a given IRCv3 capability was negotiated.
    bool hasCap(string cap) const { return (cap in ackedCaps) !is null && ackedCaps[cap]; }

    /// Whether server-side history is available. IRCv3 names it
    /// `draft/chathistory`; accept a bare `chathistory` too for servers
    /// that ship the un-prefixed spelling.
    bool hasChathistoryCap() const {
        return hasCap("draft/chathistory") || hasCap("chathistory");
    }

    /// CASEMAPPING-aware nick equality for membership lookups. Strips
    /// channel prefixes and userhost-in-names suffixes from both sides,
    /// then folds per the server's ISUPPORT CASEMAPPING (default
    /// rfc1459). Replaces bare `==` at every site that matches an event
    /// nick against the channel roster or the session nick.
    bool sameNick(string a, string b) {
        return nicksEqualMapped(stripNickPrefix(a), stripNickPrefix(b), casemapping());
    }

    /// `nick` without status prefixes, folded per CASEMAPPING: the key of
    /// the DM identity maps (`queryAccounts`, `queryHosts`).
    string foldNick(string nick) {
        return foldNickMapped(stripNickPrefix(nick), casemapping());
    }

    /// Only live session state owns the general member caches. Private
    /// probes/history requests retain their own response state.
    private bool identityStillOwned(string nick) {
        if (nick.length == 0) return false;
        if (sameNick(nick, sessionNick)) return true;
        foreach (users; channelUsers.byValue)
            foreach (user; users)
                if (sameNick(user, nick)) return true;
        foreach (users; namesBurst.byValue)
            foreach (user; users)
                if (sameNick(user, nick)) return true;
        foreach (query; queryBuffers)
            if (sameNick(query, nick)) return true;
        return false;
    }

    private string identityCacheKey(V)(ref V[string] cache, string nick) {
        if ((nick in cache) !is null) return nick;
        foreach (key; cache.byKey)
            if (sameNick(key, nick)) return key;
        return nick;
    }

    private void upsertNamesMember(string chan, string entry) {
        if (chan !in namesBurstIndex) namesBurstIndex[chan] = NamesBurstIndex.init;
        const member = upsertNamesBurstEntry(namesBurst[chan], namesBurstIndex[chan], entry, casemapping());
        auto index = &namesBurstIndex[chan];
        if (!index.whoChecked) {
            index.needsWho = channelNeedsRealnameWho(namesBurst[chan], realnames, realnameProbed, 0);
            index.whoChecked = true;
        } else if (memberNeedsRealname(member, realnames, realnameProbed)) {
            index.needsWho = true;
        }
    }

    private void resetNamesIdentIndex() {
        namesIdentKeys = null;
        namesIdentMapping = null;
        namesIdentKeysReady = false;
    }

    /// A parsed 353 member is already owned by namesBurst. Avoid both a
    /// repeated ownership scan and the linear legacy-spelling search for
    /// every new ident. Preserve cache spellings exposed in snapshots.
    private void recordNamesIdent(string nick, string ident) {
        const mapping = casemapping();
        if (!namesIdentKeysReady || namesIdentMapping != mapping) {
            namesIdentKeys = null;
            foreach (key; idents.byKey) {
                const folded = foldNickMapped(stripNickPrefix(key), mapping);
                if (folded !in namesIdentKeys) namesIdentKeys[folded] = key;
            }
            namesIdentMapping = mapping;
            namesIdentKeysReady = true;
        }
        const folded = foldNickMapped(stripNickPrefix(nick), mapping);
        // Exact spelling wins, as in identityCacheKey, including a legacy
        // snapshot with duplicate case-folded keys before reconciliation.
        if (nick in idents) idents[nick] = ident;
        else if (auto key = folded in namesIdentKeys) idents[*key] = ident;
        else {
            idents[nick] = ident;
            namesIdentKeys[folded] = nick;
        }
    }

    private void recordIdentity(V)(ref V[string] cache, string nick, V value) {
        if (identityStillOwned(nick)) recordOwnedIdentity(cache, nick, value);
    }

    private void recordOwnedIdentity(V)(ref V[string] cache, string nick, V value) {
        resetNamesIdentIndex();
        cache[identityCacheKey(cache, nick)] = value;
    }

    private void removeIdentityKey(V)(ref V[string] cache, string nick) {
        resetNamesIdentIndex();
        if (cache.remove(nick)) return;
        // Writers and full reconciliations keep one key per folded nick.
        // Stop after removal rather than advancing an invalidated iterator.
        foreach (key; cache.byKey) {
            if (!sameNick(key, nick)) continue;
            cache.remove(key);
            return;
        }
    }

    private void clearIdentity(string nick) {
        removeIdentityKey(realnames, nick);
        removeIdentityKey(realnameProbed, nick);
        removeIdentityKey(idents, nick);
        removeIdentityKey(accounts, nick);
        removeIdentityKey(away, nick);
        removeIdentityKey(bots, nick);
        removeIdentityKey(userMetadata, nick);
        markMetaDirty();
    }

    private void clearUnownedIdentity(string nick) {
        if (!identityStillOwned(nick)) clearIdentity(nick);
    }

    private void moveIdentityKey(V)(ref V[string] cache, string from, string to) {
        V value;
        bool found;
        foreach (key, entry; cache) {
            if (!sameNick(key, from)) continue;
            value = entry;
            found = true;
            break;
        }
        removeIdentityKey(cache, from);
        removeIdentityKey(cache, to);
        if (found) cache[to] = value;
    }

    /// Channel removal, authoritative NAMES and adoption reconcile once
    /// against one folded owner set, not once per cached identity.
    private void pruneUnownedIdentities() {
        resetNamesIdentIndex();
        bool[string] owners;
        void own(string nick) {
            if (nick.length) owners[foldNick(nick)] = true;
        }
        own(sessionNick);
        foreach (users; channelUsers.byValue)
            foreach (user; users) own(user);
        foreach (users; namesBurst.byValue)
            foreach (user; users) own(user);
        foreach (query; queryBuffers) own(query);
        pruneIdentityCache(realnames, owners);
        pruneIdentityCache(realnameProbed, owners);
        pruneIdentityCache(idents, owners);
        pruneIdentityCache(accounts, owners);
        pruneIdentityCache(away, owners);
        pruneIdentityCache(bots, owners);
        pruneIdentityCache(userMetadata, owners);
    }

    private void pruneIdentityCache(V)(ref V[string] cache, const bool[string] owners) {
        bool[string] seen;
        // AA removal can change its live traversal; capture the keys once
        // so removing one unowned occupant cannot skip the next one.
        foreach (key; cache.keys) {
            const folded = foldNick(key);
            if ((folded in owners) !is null && (folded in seen) is null) {
                seen[folded] = true;
                continue;
            }
            cache.remove(key);
            markMetaDirty();
        }
    }

    private string historyFold(string target) {
        return normalizeFiberChannel(target, casemapping());
    }

    /// The server's ISUPPORT CASEMAPPING, defaulting to rfc1459 (the
    /// common one). Shared by `sameNick` and every roster fold, so the two
    /// can never disagree about whether two spellings are one member.
    string casemapping() {
        if (auto m = "CASEMAPPING" in isupportMap)
            if (m.length) return *m;
        return "rfc1459";
    }

    /// Returns all negotiated capabilities.
    string[] getAckedCaps() const {
        string[] result;
        foreach (cap, acked; ackedCaps) {
            if (acked) result ~= cap;
        }
        return result;
    }

    string[string] getCapValues() const {
        string[string] values;
        foreach (name, value; capValues) values[name] = value;
        return values;
    }

    /// Updates the network configuration. Our own metadata keys and the
    /// MONITOR list are diffed and pushed live; while disconnected nothing
    /// goes out, the next registration publishes whatever is current then.
    void updateConfig(NetworkConfig cfg) {
        const oldAvatar = config.effectiveAvatarUrl();
        auto oldProfile = config.profileMetadata.dup;
        const oldServices = effectiveServices();
        config = cfg;
        if (effectiveServices() != oldServices) {
            services.onConfigChanged();
            announceServicesInvalidated();
        }
        const newAvatar = config.effectiveAvatarUrl();
        const live = state == ConnectionState.connected;
        if (live && hasCap("draft/metadata-2")) {
            foreach (l; metadataCommands("avatar", oldAvatar, newAvatar)) sendRaw(l);
            foreach (k; PROFILE_KEYS)
                foreach (l; metadataCommands(k, oldProfile.get(k, ""), config.profileMetadata.get(k, "")))
                    sendRaw(l);
        }
        if (live) reconcileMonitorUnion();
        if (oldAvatar != newAvatar) syncPublicAvatar();
    }

    /// Owner UUID exposed for the manager / session snapshot, not allocation.
    @property UUID getOwnerId() const { return ownerId; }
    void setOwnerId(UUID uid) { ownerId = uid; }

    /// Reserved address for this saved connection on this engine's pool.
    /// Missing/malformed IID or prefix means no native candidate, never a
    /// transient allocation. Observed active addresses come only from holder
    /// localIp/peerIp; resolving a reservation does not change those fields.
    string resolveIpv6Bind() {
        return resolveIpv6BindForConfig(config);
    }

    private static string resolveIpv6BindForConfig(const ref NetworkConfig config) {
        if (config.id == UUID.init) return "";
        loadIpv6Config();
        string prefix;
        if (gIpv6Lock !is null) synchronized (gIpv6Lock) { prefix = gIpv6Prefix; }
        else prefix = gIpv6Prefix;
        return ipv6ForConnection(prefix, config.ipv6Iid);
    }

    private bool hasAllowedAlternative(string banKey, bool unauthenticated = false) {
        const source = nativeIpv6Prefix(holder).length ? resolveIpv6Bind() : "";
        return hasAlternativeEgressForHost(config.host.toLower(), banKey, unauthenticated, config.routing, source);
    }

    /// Avoid a selected but silently filtered transport only for the existing
    /// inferred-ban window and only when another permitted route can serve it.
    private void avoidFailedRegistrationRoute(string failure, bool hadServerError) {
        if (isShutdownRequested || detachedForHotSwap || hadServerError || holderConnId.length == 0) return;
        const lower = failure.toLower();
        if (!(lower.canFind("registration timeout") || lower.canFind("closed")
                || lower.canFind("connection reset") || lower.canFind("broken pipe")
                || lower.canFind("transport dead") || lower.canFind("transport not alive"))) return;
        const key = activeEgressKey();
        if (!hasAllowedAlternative(key, config.sasl == SASLMechanism.none)) return;
        banEgressForHost(config.host, key, TLS_CLOSED_ROTATE_BAN_MS);
        routingFallbackReason = key ~ " [pre-registration transport]: " ~ failure;
        throttledUntil = 0;
    }

    // ── Connection loop ───────────────────────────────────────────────────────

    /// Runs the full connect / IRC-protocol / disconnect loop until
    /// `isShutdownRequested` becomes true. Package-visible so the
    /// `start()` worker task and any test harness can invoke it;
    /// callers must still set initial state via `start()`.
    package void runConnectionLoop() {
        // An attached session (hot swap) enters the loop already connected;
        // its first drop must not read "Failed to connect".
        bool wasEverConnected    = state == ConnectionState.connected;
        // Last reason we surfaced to the UI. We re-emit a DISCONNECT event
        // whenever the reason changes so persistently-failing connections
        // (e.g. TLS handshake reset) don't loop silently — but identical,
        // repeating errors are deduped via failureReasons + buildFailureSummary
        // on the next successful connect.
        string lastEmittedReason;

        // Bug 3 fix (Jul 8 2026): the engine previously ignored
        // `config.disabled` once the network was already loaded. An admin
        // disconnect call would set the flag in MongoDB and send a
        // `disconnectNetwork` control message, but on the next reconnect
        // window the engine would start a new connect attempt — SuperNets
        // sat in this loop for hours. The flag is now consulted at the
        // top of every iteration: if the network is administratively
        // disabled, the loop idles (with a 5s poll so we re-check the
        // flag without burning CPU) until either the admin re-enables it
        // (next reconnectNetwork control message removes the network and
        // re-adds it) or shutdown is requested.
        if (config.disabled) {
            logInfo("runConnectionLoop[%s]: network is administratively disabled — idling until re-enabled or shutdown",
                config.name);
            emitLog("disabled",
                "Network disabled by admin — connection loop idling. " ~
                "Re-enable via the admin panel or `reconnectNetwork` control message.");
            try eventChannel.put(IRCRawEvent.makeDisconnected(config.name, config.id.toString,
                "Network disabled by admin"));
            catch (Exception) {}
            while (!isShutdownRequested && config.disabled) {
                sleep(5.seconds);
            }
            if (isShutdownRequested) return;
            logInfo("runConnectionLoop[%s]: network re-enabled — resuming connection loop", config.name);
        }

        while (!isShutdownRequested) {
            lastHolderCloseReason = "";
            lastHolderClosedAtMs = 0;
            // How long the session that just ended stayed registered; -1
            // until measured. Only a stable session resets the backoff.
            long sessionUptimeMs = -1;
            try {
                if (!getConnected) {
                    attemptConnection();

                    // If stop() was called while we were connecting, close the
                    // fresh socket right away and exit the loop — otherwise the
                    // IRC server ends up with a zombie connection from us.
                    if (isShutdownRequested) {
                        transportClose();
                        break;
                    }

                    wasEverConnected = true;
                    lastEmittedReason = "";
                    lastDisconnectReason = "";

                    if (failureReasons.length > 0) {
                        auto summaryEvt          = IRCRawEvent(config.name, "CONNECT");
                        summaryEvt.networkId     = config.id.toString();
                        summaryEvt.text          = buildFailureSummary(failureReasons);
                        eventChannel.put(summaryEvt);
                        failureReasons = [];
                    }
                }
                processEvents();
                if (holderConnId.length && lastErrorText.length == 0
                        && !isShutdownRequested && recoverHolderRelay()) continue;
                // A hot-swap detach ends this loop: the holder keeps the
                // session and the process is exiting.
                if (detachedForHotSwap) return;
            } catch (Throwable e) {
                const wasRegistered = state == ConnectionState.connected;
                const hadServerError = lastErrorText.length > 0;
                const hadSelectedTransport = holderConnId.length > 0;
                sessionUptimeMs = connectedAtMs > 0 ? unixMsNow() - connectedAtMs : 0;
                // Enterprise: catch Throwable (not just Exception) — SyncError@(0) from
                // unsynchronized __gshared access previously killed the TaskFiber
                // (observed 2026-08-17 cnTb-fin FATAL) and the TLS wedge left the
                // loop stuck forever. SyncError must be treated as a recoverable
                // disconnect, not a fiber terminator.
                if (detachedForHotSwap) return;
                string errMsg;
                try { errMsg = e.msg; } catch (Throwable) { errMsg = "unknown throwable"; }
                if (holderConnId.length && !hadServerError && !isShutdownRequested
                        && recoverHolderRelay()) continue;
                if (holderGenerationLost && maintenanceActive()) {
                    // Planned process loss is not an egress health signal.
                    lastDisconnectReason = hadServerError ? lastErrorText : errMsg;
                    handleDisconnection();
                    releaseRegistrationPermit();
                    lastErrorText = "";
                    state = ConnectionState.waiting_to_retry;
                    foreach (_; 0 .. 10) {
                        if (isShutdownRequested) break;
                        sleep(100.msecs);
                    }
                    continue;
                }
                // Holder outage: not a network failure and not this network's
                // fault — no backoff growth, no ban policy, no failure report.
                // Retry on a short fixed cadence until the holder is back.
                if (cast(HolderUnavailableException) e) {
                    logJsonMap("warn", "connection", "Connection holder unavailable — retrying in 5s",
                        ["network": config.name, "host": config.host, "err": errMsg,
                         "event": "holder_unavailable_retry"]);
                    emitLog("error", "Connection holder unavailable — retrying in 5s");
                    // No socket claim remains here: claimed relays were
                    // resolved above, before any generic transport cleanup.
                    state = ConnectionState.waiting_to_retry;
                    backoff.reset();
                    emitZeroRetryStatus();
                    foreach (_; 0 .. 50) {
                        if (isShutdownRequested) break;
                        sleep(100.msecs);
                    }
                    continue;
                }
                if (auto policy = cast(RoutingPolicyBlockedException) e) {
                    // No upstream dial is permitted. Park on a fixed cadence
                    // so restoring durable policy resumes without a restart.
                    // Do not call handleDisconnection or count a host failure.
                    lastEmittedReason = policy.msg;
                    lastDisconnectReason = policy.msg;
                    state = ConnectionState.waiting_to_retry;
                    emitLog("error", policy.msg);
                    try eventChannel.put(IRCRawEvent.makeDisconnected(
                        config.name, config.id.toString(), policy.msg));
                    catch (Exception) {}
                    emitZeroRetryStatus();
                    foreach (_; 0 .. 50) {
                        if (isShutdownRequested) break;
                        sleep(100.msecs);
                    }
                    continue;
                }
                // SASL park (parkNetwork already persisted `disabled`,
                // mirrored it in-memory, tore the socket down and emitted the
                // user-visible error): skip the disconnect/backoff machinery
                // and idle exactly like the admin-disabled path. A Reconnect
                // or SASL edit replaces this client via `reconnectNetwork`.
                if (auto se = cast(SaslParkedException) e) {
                    string seMsg;
                    try { seMsg = se.msg; } catch (Throwable) { seMsg = "SASL rejected"; }
                    lastEmittedReason = seMsg;
                    lastDisconnectReason = seMsg;
                    while (!isShutdownRequested && config.disabled) {
                        sleep(5.seconds);
                    }
                    if (isShutdownRequested) return;
                    logInfo("runConnectionLoop[%s]: network re-enabled after SASL park — resuming", config.name);
                    continue;
                }
                // Downgraded from logException(error) with hex stack spam.
                // `transport not alive` and `Registration timed out` are expected
                // during normal reconnect — not `error`.
                logJsonMap("warn", "connection",
                    "Connection error",
                    ["network": config.name, "host": config.host,
                     "err": errMsg,
                     "event": "connection_error"]);
                // Record SyncError distinctly for observability.
                if (errMsg.canFind("SyncError") || typeid(e).toString().canFind("SyncError")) {
                    recordCounter("ircfiber.connection.sync_error", 1, ["host": config.host]);
                    logWarn("SyncError recovered for %s: %s — treating as disconnect, will reconnect", config.name, errMsg);
                }
                // Save the disconnect reason BEFORE handleDisconnection so
                // it emits the DISCONNECTED event with the right text.
                string reason = errMsg.length > 0 ? errMsg : "Connection closed unexpectedly";
                if (reason == "Peer closed connection" || reason == "Connection lost"
                    || reason == "Server closed during registration") {
                    reason = "Connection closed unexpectedly";
                }
                if (!wasEverConnected) reason = "Failed to connect: " ~ reason;

                string displayReason = reason;
                if (lastErrorText.length > 0) {
                    const extracted = extractServerReason(lastErrorText);
                    if (extracted.length > 0) displayReason = extracted;
                }
                if (displayReason != lastEmittedReason) {
                    lastEmittedReason = displayReason;
                    lastDisconnectReason = displayReason;
                }
                if (!wasRegistered) avoidFailedRegistrationRoute(errMsg, hadServerError);

                // handleDisconnection now emits the DISCONNECTED lifecycle
                // event so the frontend sees the state transition for ALL
                // disconnect paths. Wrapped in Throwable catch so a secondary
                // SyncError there doesn't kill the loop.
                try {
                    handleDisconnection();
                } catch (Throwable he) {
                    try logWarn("handleDisconnection threw for %s: %s", config.name, he.msg);
                    catch (Throwable) {}
                    try { transportClose(); } catch (Throwable) {}
                    state = ConnectionState.disconnected;
                }
                const lossAtMs = unixMsNow();
                if (isStaticProxy(activeEgressLabel)
                    && isEstablishedEgressLoss(wasRegistered, sessionUptimeMs,
                        isShutdownRequested || detachedForHotSwap, hadServerError,
                        lastHolderCloseReason, errMsg)) {
                    const closedAtMs = lastHolderCloseReason.length > 0
                        ? lastHolderClosedAtMs : lossAtMs;
                    if (closedAtMs > 0 && closedAtMs <= lossAtMs
                        && lossAtMs - closedAtMs <= EGRESS_LOSS_MAX_AGE_MS) {
                        recordEstablishedEgressLoss(activeEgressLabel,
                            config.host.toLower(), closedAtMs, lossAtMs);
                        avoidEgressLabel = activeEgressLabel;
                        avoidUntilMs = lossAtMs + EGRESS_QUARANTINE_MS;
                    }
                }

                if (isShutdownRequested) break;

                failureReasons ~= reason;
                lastErrorText = "";

                // Report the failure to Redis for smart routing (per-network failover).
                // The gateway's health monitor checks this and may reassign the network
                // to a different engine if failures exceed the threshold.
                if (redis !is null && serverId.length > 0 && !wasEverConnected) {
                    try {
                        auto rdb = redis.getDb();
                        auto failKey = RedisKeys.networkFail(config.id.toString());
                        auto now = Clock.currTime.toUnixTime!long * 1000;
                        rdb.hincr(failKey, "count", 1);
                        rdb.hset(failKey, "serverId", serverId);
                        rdb.hset(failKey, "error", reason);
                        rdb.hset(failKey, "lastFailure", now.to!string);
                        logInfo("Reported connection failure for %s to smart routing", config.name);
                    } catch (Throwable) {}
                }
                // Track TLS timeout vs generic disconnect for egress rotation.
                if (reason.canFind("TLS handshake timed out") || errMsg.canFind("TLS handshake timed out")) {
                    recordCounter("ircfiber.tls_handshake.timeout_disconnect", 1, ["host": config.host]);
                    // Ban the egress this network used for this host so the next attempt tries a different exit.
                    if (hadSelectedTransport && activeEgressLocationId.length > 0)
                        banEgressForHost(config.host, activeEgressLocationId);
                    recordHostFailure(config.host, config.port);
                }
                // Keep Mullvad's existing accounting for silent drops. Static
                // exits instead use qualified, cross-host observations above.
                if (hadSelectedTransport && (reason.canFind("PONG timeout")
                    || reason.canFind("transport not alive") || reason.canFind("transport dead"))) {
                    recordCounter("ircfiber.keepalive.timeout_disconnect", 1, ["host": config.host, "egress": activeEgressLabel]);
                    recordSilentEgressLoss(config.host, activeEgressLabel, activeEgressLocationId);
                }
                // An IP ban on a TLS port never reaches us as text: InspIRCd
                // answers a Z-lined address with a plaintext ERROR and closes,
                // which the TLS client reports as "SSL/TLS tunnel closed"
                // right after tcp_open. Two of those in a row on the same
                // egress, with another route available, means rotate — the
                // same failover a spelled-out Z-line gets in applyBanPolicy,
                // but with a shorter host-ban since we are inferring.
                const tlsClosed = hadSelectedTransport
                    && (reason.canFind("tunnel closed") || errMsg.canFind("tunnel closed"));
                consecutiveTlsClosed = tlsClosed ? consecutiveTlsClosed + 1 : 0;
                if (tlsClosed && consecutiveTlsClosed >= TLS_CLOSED_ROTATE_AFTER) {
                    import std.string : toLower;
                    const banKey = activeEgressLocationId.length > 0
                        ? activeEgressLocationId : DIRECT_EGRESS_LABEL;
                    if (hasAllowedAlternative(banKey)) {
                        banEgressForHost(config.host, banKey, TLS_CLOSED_ROTATE_BAN_MS);
                        consecutiveTlsClosed = 0;
                        emitLog("info", "TLS handshake keeps being closed via "
                            ~ (activeEgressLabel.length ? egressProviderName(activeEgressLabel) ~ " exit " ~ egressDisplay() : "the direct host IP")
                            ~ " — likely an IP ban on that address; switching to a different exit.");
                        logJsonMap("warn", "connection", "Repeated TLS close — rotating egress",
                            ["network": config.name, "host": config.host, "egress": banKey, "event": "egress_tls_close_rotate"]);
                    }
                }
            }
            if (sessionUptimeMs < 0) sessionUptimeMs = connectedAtMs > 0 ? unixMsNow() - connectedAtMs : 0;
            // A session that held for a while proves the route works: start
            // the next reconnect from the shortest delay. One that dropped
            // right after registering keeps growing the backoff.
            if (sessionUptimeMs >= STABLE_SESSION_RESET_MS) backoff.reset();
            if (isShutdownRequested) break;
            if (!shouldReconnect) break;

            // Smart routing: check if this network was reassigned to another engine.
            // If so, stop retrying and let the new engine handle it.
            if (redis !is null && serverId.length > 0) {
                try {
                    auto assignedSid = redis.getDb().hget(RedisKeys.networkAssignments(), config.id.toString());
                    if (assignedSid.length > 0 && assignedSid != serverId) {
                        logInfo("Network %s reassigned to server %s — stopping retry loop",
                            config.name, assignedSid);
                        break;
                    }
                } catch (Exception) {}
            }

            // If the server throttled or banned us, wait out the window
            // BEFORE computing the exponential backoff. Previously this
            // sleep happened with state==disconnected and no retryStatus,
            // so the UI showed a frozen "Disconnected:" banner for up to
            // 5 min (throttle) or 30 min (ZLINE ban) with no countdown.
            // Now we surface the same waiting_to_retry + queued line that
            // the normal backoff path uses, so the banner shows
            // "Reconnecting in 300s (Nth attempt)" and the user can
            // still hit "Reconnect" to bypass via /reconnect.
            if (throttledUntil > 0) {
                const now = Clock.currTime.toUnixTime!long * 1000;
                if (now < throttledUntil) {
                    auto remaining = throttledUntil - now;
                    logWarn("Server throttled/banned, waiting %s before retrying %s", remaining.msecs, config.host);
                    // Surface as retry so the frontend doesn't freeze.
                    state = ConnectionState.waiting_to_retry;
                    // Use the next attempt number for the countdown label.
                    // backoff.currentAttempt() is 0 before the first
                    // nextDelay(), so bump to 1 for the first visible try.
                    int displayAttempt = backoff.currentAttempt();
                    if (displayAttempt == 0) displayAttempt = 1;
                    attemptCount = displayAttempt;
                    nextRetryAtMs = throttledUntil;
                    activeRetryDelayMs = remaining;
                    emitLog("queued",
                        "Server " ~ (isBanError(lastEmittedReason) ? "ban" : "throttle")
                        ~ " window active — retry in "
                        ~ (remaining / 1000).to!string ~ "s.");
                    try eventChannel.put(IRCRawEvent.makeConnectionRetryStatus(
                        config.name, config.id.toString(),
                        attemptCount, nextRetryAtMs, activeRetryDelayMs));
                    catch (Exception e) logWarn("Failed to publish throttled retry status: %s", e.msg);
                    // Chunked sleep so stop() / isShutdownRequested is
                    // honoured within 1s and the countdown stays live.
                    const deadline = Clock.currTime + remaining.msecs;
                    while (Clock.currTime < deadline) {
                        if (isShutdownRequested) break;
                        sleep(1.seconds);
                    }
                    if (isShutdownRequested) {
                        throttledUntil = 0;
                        break;
                    }
                }
                throttledUntil = 0;
            }

            // Ghost / Overridden floor: when the server closes the connection
            // because a previous session for our nick is still active
            // (UnrealIRCd's "Overridden" ghost protection, ~30-60s), a retry
            // sooner than 10s hits the same wall. Floor the delay without
            // resetting the backoff, so repeated ghosts still grow it.
            auto delay = backoff.nextDelay();
            if (lastEmittedReason.canFind("Overridden") && delay != Duration.max
                && delay < GHOST_RETRY_FLOOR) {
                logWarn("Ghost failure detected for %s — retrying in %s (previous session still active)",
                    config.name, GHOST_RETRY_FLOOR);
                emitLog("warn", "Previous session still active (ghost) — retrying in 10s.");
                delay = GHOST_RETRY_FLOOR;
            }

            // Give up after a week of uninterrupted failure (see
            // ExponentialBackoff): the host is not coming back on its own.
            // Park the loop (like the admin-disabled path) until the user
            // hits Reconnect — that control message replaces this client
            // with a fresh one — or the engine restarts.
            if (delay == Duration.max) {
                const streak = backoff.failingFor();
                const summary = "Gave up reconnecting to " ~ config.host ~ ":" ~ config.port.to!string
                    ~ " after " ~ backoff.currentAttempt().to!string ~ " attempts over "
                    ~ (streak.total!"hours").to!string ~ " h ("
                    ~ (lastEmittedReason.length > 0 ? lastEmittedReason : "connection_lost")
                    ~ "). Use Reconnect to try again.";
                logWarn("%s: %s", config.name, summary);
                logJsonMap("warn", "connection", "Reconnect budget exhausted — parking network",
                    ["network": config.name, "host": config.host, "port": config.port.to!string,
                     "attempts": backoff.currentAttempt().to!string,
                     "streakHours": (streak.total!"hours").to!string,
                     "reason": lastEmittedReason.length > 0 ? lastEmittedReason : "connection_lost",
                     "event": "reconnect_gave_up"]);
                recordCounter("ircfiber.reconnect.gave_up", 1,
                    ["network": config.name, "host": config.host]);
                state = ConnectionState.disconnected;
                emitZeroRetryStatus();
                lastDisconnectReason = summary;
                emitLog("error", summary);
                try eventChannel.put(IRCRawEvent.makeDisconnected(config.name, config.id.toString(), summary));
                catch (Exception) {}
                while (!isShutdownRequested) sleep(5.seconds);
                break;
            }

            // Per-host circuit breaker: after N consecutive failures to the
            // same host, extend the delay to the remaining cooldown so we
            // don't keep hammering a server that's clearly rejecting us.
            // The cooldown doubles every time the breaker re-opens
            // (5 → 10 → 20 → 40 → 60 min) — see hostCooldownMs().
            auto hostKey = config.host ~ ":" ~ config.port.to!string;
            if (auto breaker = hostKey in _hostBreakers) {
                if (breaker.openedAt > 0) {
                    const now = Clock.currTime.toUnixTime!long * 1000;
                    const elapsed = now - breaker.openedAt;
                    const cooldown = hostCooldownMs(breaker.openCount);
                    if (elapsed < cooldown) {
                        auto remaining = cooldown - elapsed;
                        const remainingDur = dur!"msecs"(remaining);
                        if (remainingDur > delay) {
                            delay = remainingDur;
                            logWarn("Host circuit breaker active for %s — extending delay to %s",
                                hostKey, delay);
                        }
                    } else {
                        // Cooldown expired — half-open: allow attempts again but
                        // remember how often this host has tripped so the next
                        // opening cools down for longer.
                        breaker.openedAt = 0;
                        breaker.failCount = 0;
                        logInfo("Host circuit breaker reset for %s (cooldown expired, opened %d× so far)",
                            hostKey, breaker.openCount);
                    }
                }
            }

            // 2026-07-08: per-host minimum delay to prevent pile-up.
            // When 5 networks on the same host reconnect simultaneously
            // (e.g. after a shared upstream reset), all 5 hit the
            // same host at the same instant. Backoff already has ±25%
            // jitter, but a fresh 5s minimum gives the host time to
            // recover between attempts when multiple networks are
            // reconnecting.
            enum MIN_RECONNECT_DELAY_MS = 5_000;
            if (delay.total!"msecs" < MIN_RECONNECT_DELAY_MS) {
                delay = dur!"msecs"(MIN_RECONNECT_DELAY_MS);
            }

            logInfo("Reconnecting to %s in %s", config.host, delay);
            logJsonMap("info", "connection",
                "Reconnect scheduled",
                ["network": config.name,
                 "host": config.host, "port": config.port.to!string,
                 "delayMs": delay.total!"msecs".to!string,
                 "attempt": backoff.currentAttempt().to!string,
                 "reason": lastEmittedReason.length > 0 ? lastEmittedReason : "connection_lost",
                 "event": "reconnect_scheduled"]);
            recordCounter("ircfiber.reconnect.scheduled", 1,
                ["network": config.name, "host": config.host,
                 "port": config.port.to!string,
                 "reason": lastEmittedReason.length > 0 ? lastEmittedReason : "connection_lost"]);
            // W1-T01 (plan B1): set state to `waiting_to_retry` for the
            // duration of the backoff sleep so the frontend's
            // "Reconnecting in {N}s ({Nth} attempt)" banner branch
            // (already wired in types.ts:19) is reachable. The state
            // flips back to `connecting` in `attemptConnectionImpl`
            // when the sleep exits and `attemptConnection()` runs.
            state = ConnectionState.waiting_to_retry;
            // W1-T01: compute the structured retry-state up front so the
            // both the legacy "queued" server-log line and the
            // CONNECTION_RETRY_STATUS event see the same numbers.
            attemptCount         = backoff.currentAttempt();
            const delayMs        = cast(long) delay.total!"msecs";
            nextRetryAtMs        = Clock.currTime.toUnixTime!long * 1000 + delayMs;
            // W1-T01-rev1: persist the real schedule delay so the
            // snapshot writer's getRetryStatus() surfaces `delayMs > 0`
            // during the active backoff window. Cleared by
            // emitZeroRetryStatus() on every backoff.reset() site.
            activeRetryDelayMs   = delayMs;
            resetConnectionTelemetry();
            // W1-T01-rev1: ordering — emit the user-visible queued log
            // line FIRST so it lands in the chat timestamped before the
            // structured retry event (per plan W1-T01 ordering
            // requirement; the previous order had CONNECTION_RETRY_STATUS
            // first, which logged the structured event before the user
            // saw the matching "Reconnect scheduled in Ns" line in the
            // `_server` buffer).
            emitLog("queued",
                "Reconnect attempt scheduled in "
                ~ (delay.total!"seconds" < 1 ? "<1s"
                    : (delay.total!"seconds").to!string ~ "s")
                ~ " (exponential backoff).");
            try eventChannel.put(IRCRawEvent.makeConnectionRetryStatus(
                config.name, config.id.toString(),
                attemptCount, nextRetryAtMs, delayMs));
            catch (Exception e) logWarn("Failed to publish CONNECTION_RETRY_STATUS for %s: %s",
                config.name, e.msg);
            // Sleep in 1s chunks so a concurrent stop() (isShutdownRequested)
            // is honoured within ~1s instead of waiting for the full delay.
            // This lets the user cancel a pending reconnect almost instantly.
            const deadline = Clock.currTime + delay;
            while (Clock.currTime < deadline) {
                if (isShutdownRequested) break;
                sleep(1.seconds);
            }
        }

        // DISCONNECT lifecycle event is now emitted by
        // handleDisconnection() (called via cleanup() below), which
        // covers ALL disconnect paths.  The per-path emitLog("error") +
        // DISCONNECT that was previously duplicated in the catch block
        // and the exit block have been centralized there. A hot-swap
        // detach returns early inside handleDisconnection().
        cleanup();
    }

    // ── Connection attempt ────────────────────────────────────────────────────

    /// Emit a tagged server-log entry into the event channel so the
    /// frontend's `_server` buffer mirrors every phase of the connect.
    /// Failures are swallowed (eventChannel.put can throw if the channel
    /// is closed during shutdown) so the connection attempt itself is
    /// never blocked by a logging error.
    package(ircfiber) void emitLog(string phase, string text) nothrow {
        try {
            auto evt = IRCRawEvent.makeServerLog(config.name, config.id.toString(), phase, text);
            eventChannel.put(evt);
        } catch (Exception e) {
            try logWarn("Failed to emit server-log phase=%s for %s: %s", phase, config.name, e.msg);
            catch (Exception) {}
        }
    }

    /// W1-T01 (plan B3): emit a zero-valued CONNECTION_RETRY_STATUS
    /// event AND clear the in-memory retry state. Called at every
    /// `backoff.reset()` site (holder attach, holder outage) and after a
    /// successful registration, which clears the banner without touching the
    /// backoff. The frontend's
    /// `applyRetryStatus(networkId, null)` on receipt of this event
    /// clears BOTH `net.retryStatus` AND `net.failInfo` so the banner
    /// doesn't keep showing "Reconnecting..." / "Disconnected: ...".
    private void emitZeroRetryStatus() nothrow {
        attemptCount         = 0;
        nextRetryAtMs        = 0;
        // W1-T01-rev1: also clear the persisted active delay so the
        // nullable getRetryStatus() collapses to null and the snapshot
        // / WS sync payload stops emitting retryStatus until the next
        // backoff fires. Without this, a freshly-reset client's
        // Nullable still surfaces the previous attempt's delay.
        activeRetryDelayMs   = 0;
        // B3: clear the snapshot-side failInfo too, otherwise the WS
        // sync payload keeps shipping the previous disconnect's
        // failInfo to fresh clients even after a successful reconnect.
        lastFailInfo         = FailInfo.init;
        try {
            auto evt = IRCRawEvent.makeConnectionRetryStatus(
                config.name, config.id.toString(), 0, 0L, 0L);
            eventChannel.put(evt);
        } catch (Exception e) {
            try logWarn("Failed to publish zero CONNECTION_RETRY_STATUS for %s: %s",
                config.name, e.msg);
            catch (Exception) {}
        }
    }

    /// W1-T01: build a structured FailInfo from a disconnect reason
    /// string + the engine's `lastErrorText` and publish a
    /// `CONNECTION_FAIL` event. Called from `handleDisconnection()`
    /// (centralised site — covers the catch block,
    /// data-loss detection, and server-error paths). Failures during
    /// the put are swallowed so they don't mask the existing
    /// DISCONNECTED lifecycle event. Also stashes the FailInfo on
    /// the client so the snapshot writer (`engine/state.d`) can ship
    /// it to fresh WS clients via the sync payload.
    private void emitConnectionFail(string reason, string errText) nothrow {
        try {
            auto info = parseReasonToFailInfo(reason, errText);
            // Stash on the client so a fresh WS sync arriving in the
            // next 10s heartbeat (or sooner if the snapshot writer
            // runs from processor.d) picks up the structured reason
            // without depending on the event stream. Cleared by
            // emitZeroRetryStatus() at every backoff.reset() site.
            lastFailInfo = info;
            auto evt = IRCRawEvent.makeConnectionFail(
                config.name, config.id.toString(),
                info.type_, info.reason, info.killedReason, info.sslVerifyError);
            eventChannel.put(evt);
        } catch (Exception e) {
            try logWarn("Failed to publish CONNECTION_FAIL for %s: %s",
                config.name, e.msg);
            catch (Exception) {}
        }
    }

    /// Apply exactly the token parameters, independent of trailer wording.
    /// Value replacements and withdrawals are changes even at equal map size.
    private bool applyIsupportReply(ref IRCRawEvent event) {
        const params = event.getParams();
        const end = params.length - (event.hasTrailingParam && params.length ? 1 : 0);
        const oldMonitor = isupportMap.get("MONITOR", "\x00");
        const oldMapping = casemapping();
        bool changed;
        if (end > 1)
            foreach (token; params[1 .. end])
                changed = applyIsupport(serverFeatures, isupportMap, token) || changed;
        if (changed) {
            markMetaDirty();
            if (oldMapping != casemapping()) pruneUnownedIdentities();
            publishIsupportEvent();
            if (state == ConnectionState.connected && redis !is null
                && (oldMonitor != isupportMap.get("MONITOR", "\x00") || oldMapping != casemapping()))
                reconcileMonitorUnion();
        }
        return changed;
    }

    /// Publish a synthetic `ISUPPORT` event carrying the engine's
    /// parsed feature map so the frontend can render the categorised
    /// "Server features" panel without re-parsing raw 005 lines.
    /// Called from the 005 handler after every successful token that
    /// crossed the threshold (welcomed=true) — the panel keeps up
    /// incrementally as tokens stream in, and then settles once the
    /// server's 005 reply stream ends.
    private void publishIsupportEvent() nothrow {
        try {
            auto evt = IRCRawEvent.makeIsupport(
                config.name, config.id.toString(), isupportMap);
            eventChannel.put(evt);
        } catch (Exception e) {
            try logWarn("Failed to publish ISUPPORT for %s: %s", config.name, e.msg);
            catch (Exception) {}
        }
    }

    /// Starts a new /LIST accumulation. Called from `sendRaw` when we see
    /// an outgoing LIST, or lazily from the 321/322 handlers when the
    /// request originated elsewhere (e.g. before a hot swap).
    private void beginChannelList(string pattern) {
        channelListInFlight = true;
        channelListEmittedFirst = false;
        channelListPending.length = 0;
        channelListPattern = pattern;
    }

    /// Emits the buffered /LIST rows as one CHANNEL_LIST chunk. `done`
    /// marks the final chunk (may carry 0 rows); `error` is attached when
    /// the server aborted the list; `code` is the aborting numeric
    /// ("416" too many matches, "263" try again) so the frontend can pick
    /// IRCCloud's `list_response_toomany` vs `try_again` copy.
    private void flushChannelList(bool done, string error = "", string code = "") nothrow {
        try {
            auto j = Json.emptyObject;
            j["pattern"] = channelListPattern;
            j["first"] = !channelListEmittedFirst;
            j["done"] = done;
            auto rows = Json.emptyArray;
            foreach (ref r; channelListPending) {
                auto o = Json.emptyObject;
                o["name"] = r.name;
                o["users"] = r.users;
                o["topic"] = r.topic;
                o["modes"] = r.modes;
                rows ~= o;
            }
            j["rows"] = rows;
            if (error.length) {
                j["error"] = error;
                if (code.length) j["code"] = code;
            }
            eventChannel.put(IRCRawEvent.makeChannelList(
                config.name, config.id.toString(), j.toString()));
            channelListEmittedFirst = true;
            channelListPending.length = 0;
            if (done) channelListInFlight = false;
        } catch (Exception e) {
            try logWarn("flushChannelList[%s]: %s", config.name, e.msg);
            catch (Exception) {}
        }
    }

    private void attemptConnection() {
        // Jul 8 2026 UX fix: emit a "Connecting" event to the chat IMMEDIATELY
        // so the user sees feedback the moment the engine starts attempting
        // the connect. Without this, the first user-visible event is
        // "Connected" (or "Disconnected" on failure) — and depending on
        // server response time, that gap can feel like "nothing is
        // happening" for 1-2 seconds. The existing code only emitted
        // "queued" on RETRY attempts (where there's a backoff delay);
        // fresh connects went straight to "Connecting → Connected"
        // without a "queued" marker. The frontend already groups all
        // events between two CONNECTED events as "Connection steps";
        // an early "Connecting" event makes the timeline show "queued →
        // tcp_open → tls → registered → connected" instead of an empty
        // gap. We dedup on consecutive identical events so this can't
        // spam the chat.
        emitLog("connecting",
            "Connecting to " ~ config.host ~ ":" ~ config.port.to!string
            ~ (config.tls == TLSMode.disabled ? "" : " (TLS)") ~ "...");
        // Trace span: covers TCP + TLS + REGISTER. The full IRC connect
        // attempt is captured in a single root span, with child spans
        // added by performRegistration() for finer granularity.
        withSpan("irc.connect",
            ["network": config.name, "host": config.host, "port": config.port.to!string],
            (ref Span s) {
            try {
                attemptConnectionImpl(true);
                s.setStatusOk();
            } catch (Exception e) {
                s.setStatusError(e.msg);
                throw e;
            }
        });
    }

    /// TLS mode string for the holder `DIAL` request.
    private static string holderTlsMode(TLSMode tls) @safe pure nothrow {
        if (tls == TLSMode.disabled) return "none";
        if (tls == TLSMode.starttls) return "starttls";
        return "implicit";
    }

    /// Timeline adapter for holder dial events: the holder reports *when*
    /// each phase happens (real timestamps), the engine owns the wording.
    /// `attempt`/`attempt_fail`/`dns`/`info` texts arrive holder-composed
    /// (or wrapper-composed for proxied dials) and are emitted verbatim.
    private void onDialEvent(ref DialEvent ev) nothrow {
        switch (ev.phase) {
            case "tcp_open":
                activeEgressLabel = ev.egressLabel;
                activeEgressHost = ev.egressHost;
                activeEgressIp = ev.egressIp;
                activeEgressLocation = ev.egressLocationText;
                activePeerIp = ev.peerIp;
                activeLocalIp = ev.localIp;
                if (dialPlainFallback) {
                    emitLog("tcp_open", "Re-established plain-text TCP connection to " ~ config.host ~ " via "
                        ~ (activeEgressLabel.length ? egressDisplay() ~ " (" ~ activeEgressHost
                            ~ (activeEgressIp.length ? "/" ~ activeEgressIp : "") ~ ")" : "direct") ~ ".");
                    return;
                }
                emitLog("tcp_open",
                    "TCP connection established to " ~ config.host ~ ":" ~ config.port.to!string
                    ~ (activePeerIp.length ? " [" ~ activePeerIp ~ "]" : "")
                    ~ (activeEgressLabel.length ? " via " ~ egressDisplay() ~ " (" ~ activeEgressHost ~ (activeEgressIp.length ? "/" ~ activeEgressIp : "") ~ ")" : " (direct)")
                    ~ (activeLocalIp.length ? " from " ~ activeLocalIp : "") ~ ".");
                try logJsonMap("info", "connection",
                    "TCP open",
                    ["network": config.name, "host": config.host,
                     "port": config.port.to!string,
                     "egress": activeEgressLabel.length ? activeEgressLabel : "direct",
                     "egressHost": activeEgressHost,
                     "egressIp": activeEgressIp,
                     "peerIp": activePeerIp,
                     "localIp": activeLocalIp,
                     "tls": dialTlsMode != "none" ? "true" : "false",
                     "event": "tcp_open"]);
                catch (Exception) {}
                return;
            case "starttls":
                emitLog("tls", "Requesting STARTTLS upgrade with " ~ config.host ~ "...");
                return;
            case "tls":
                emitLog("tls", dialTlsMode == "starttls"
                    ? "Server accepted STARTTLS — starting TLS handshake..."
                    : "Starting TLS handshake with " ~ config.host ~ "...");
                return;
            default:
                emitLog(ev.phase, ev.text);
                return;
        }
    }

    /// One holder-backed connect through the egress policy loop. Sets the
    /// transport, the holder connection id, the active egress/socket
    /// bookkeeping and the TLS details; emits the post-connect timeline.
    private void dialViaHolder(string tlsMode) {
        if (holder is null) throw new HolderUnavailableException("no connection holder configured");
        requireMaintenanceRegistration();
        import ircfiber.irc.dial_guard : ownsNetworkForDial, dialWithOwnership;
        bool mayDial() {
            return !getStopping && !detachedForHotSwap
                && ownsNetworkForDial(redis, serverId, config.id.toString());
        }
        DialResult ownedDial(DialRequest req, DialProgress progress, RouteKind kind, string trialToken) {
            releaseRegistrationPermit();
            if (registrationPermit)
                throw new HolderUnavailableException("earlier DIAL has unproven completion");
            scope(failure) releaseRegistrationPermit();
            bool sent;
            string registrationStartKey;
            ulong registrationStartEpoch;
            void completeRegistrationStart() {
                if (!registrationStartKey.length) return;
                registrationAdmission.completeStart(registrationStartKey, registrationStartEpoch, unixMsNow());
                registrationStartKey = null;
            }
            scope(exit) completeRegistrationStart();
            const dialIdentity = concreteDialIdentity(req);
            try {
                return dialWithOwnership(holder, req, progress, redis, serverId,
                    () => getStopping || detachedForHotSwap,
                    () {
                        requireMaintenanceRegistration();
                        requirePermittedRoute(config.host, config.routing, kind);
                        validateConcreteDial(req, trialToken, dialIdentity);
                    },
                    (string identity) {
                        if (registrationAdmission is null) registrationAdmission = new RegistrationAdmission;
                        registrationAdmission.observeIncarnation(identity);
                        registrationStartKey = admitRegistration(req, kind, &mayDial, trialToken);
                        registrationStartEpoch = registrationPermitEpoch;
                    }, &completeRegistrationStart, sent);
            } catch (Throwable error) {
                bool ambiguous = sent;
                if (cast(HolderErrorException) error) ambiguous = false;
                if (auto failed = cast(DialFailedException) error) ambiguous = sent && failed.phase == "holder";
                if (ambiguous && registrationPermit && !registrationPermitUnproven) {
                    registrationPermitUnproven = true;
                    registrationAdmission.retainUnproven(registrationPermitEpoch);
                    observeUnprovenRegistrations(holder);
                    logJsonMap("error", "connection", "Unproven DIAL retains full-registration admission",
                        ["event": "registration_unproven", "networkId": config.id.toString(),
                         "inFlight": registrationAdmission.inFlight.to!string]);
                }
                throw error;
            }
        }
        dialTlsMode = tlsMode;
        DialResult dr;
        withSpan("irc.tcp_connect",
            ["network": config.name, "host": config.host, "port": config.port.to!string,
             "routing": config.routing.toJson().toString(), "tls": tlsMode],
            (ref Span ts) {
            EgressUsed used;
            // Release before the new connect: happyEyeballsConnect takes the
            // hold on the slot it wins, and releasing afterwards would cancel
            // it out when the same slot is reused.
            releaseEgressSlot();
            // A trial still owned here belonged to a connection that is
            // gone without being settled: it did not prove the exit.
            settleEgressTrialOnEnd(0, isShutdownRequested);
            auto tag = DialTag(config.id.toString(), ownerId.toString(), config.name, "");
            const now = unixMsNow();
            if (now >= avoidUntilMs) { avoidEgressLabel = ""; avoidUntilMs = 0; }
            if (maintenanceActive()) {
                connection = dialFrozenRoute(holder, tag, tlsMode, &onDialEvent, used, dr, &ownedDial);
            } else {
                connection = happyEyeballsConnect(holder, tag, config.host, config.port, tlsMode,
                    config.routing, config.sasl == SASLMechanism.none,
                    resolveIpv6Bind(), &onDialEvent, avoidEgressLabel, used, dr,
                    &mayDial, &ownedDial);
            }
            holderConnId = dr.id;
            holderInstance = dr.instance;
            holderConnectedAtMs = dr.connectedAtMs;
            observed001AtMs = 0;
            lastGapHandled = lastGapAcknowledged = 0;
            nextGapAckAtMs = 0;
            pendingHolderGap = HolderEntry.init;
            gapNamesPending = null;
            gapRefreshPending = false;
            gapReplayUncertain = false;
            activeEgressLabel = used.label;
            activeEgressHost = used.host;
            activeEgressIp = used.ip;
            activeEgressLocationId = used.locationId;
            activeEgressLocation = used.locationText;
            egressSlotLabel = used.label;
            egressSlotHeld = used.label.length > 0;
            egressTrialToken = used.trialToken;
            egressTrialExit = used.trialExit;
            egressTrialProbeSentMs = 0;
            activePeerIp = dr.peerIp;
            activeLocalIp = dr.localIp;
            activeRoute = routeToken(used.kind);
            if (used.fallbackReason.length || used.kind == RouteKind.ipv6)
                routingFallbackReason = used.fallbackReason;
            tlsInfoValid = dr.tlsOk;
            tlsInfo = dr.tls;
            ts.setStatusOk();
        });
        // No OS TCP keepalive here: the upstream socket lives in the holder — the 30 s app-level LAG probes in processEvents() hold NAT mappings and meet the ~2 min detection goal.
        logInfo("TCP via egress '%s' (%s/%s) to %s:%d peer=%s local=%s holder=%s", activeEgressLabel.length ? activeEgressLabel : "direct", activeEgressHost.length ? activeEgressHost : "direct", activeEgressIp.length ? activeEgressIp : "-", config.host, config.port, activePeerIp.length ? activePeerIp : "-", activeLocalIp.length ? activeLocalIp : "-", holderConnId);
        if (tlsMode == "starttls") {
            logInfo("Connected to %s:%s with STARTTLS", config.host, config.port);
            logJsonMap("info", "connection",
                "Connected with STARTTLS",
                ["network": config.name, "host": config.host,
                 "port": config.port.to!string,
                 "event": "tls_handshake"]);
            emitLog("tls_done", formatTlsDoneText(tlsInfoValid, tlsInfo,
                "STARTTLS handshake complete — connection is now encrypted."));
        } else if (tlsMode != "none") {
            logInfo("Connected to %s:%s with TLS", config.host, config.port);
            logJsonMap("info", "connection",
                "Connected with TLS",
                ["network": config.name, "host": config.host,
                 "port": config.port.to!string,
                 "sni": config.host,
                 "event": "tls_handshake"]);
            emitLog("tls_done", formatTlsDoneText(tlsInfoValid, tlsInfo,
                "TLS handshake complete — connection is now encrypted."));
        } else {
            emitLog("info",
                "Plain-text mode — no TLS handshake will be performed.");
            logInfo("Connected to %s:%s (plain)", config.host, config.port);
        }
    }

    private void attemptConnectionImpl(bool) {
        // If the user clicked Disconnect (or the manager removed this client)
        // while we were waiting on the backoff timer, abort the connection
        // attempt instead of starting a new Happy Eyeballs / TLS / registration
        // cycle. Without this guard, the outer while (!isShutdownRequested)
        // check can race with stop() and let one connect slip through after
        // a disconnect, which is what the user saw as "Reconnect attempt
        // scheduled in 34s" still firing after they clicked Disconnect.
        if (isShutdownRequested) {
            logInfo("attemptConnection[%s]: skipped — shutdown requested", config.name);
            throw new Exception("Shutdown requested");
        }
        scope(exit) releaseRegistrationPermit();
        state = ConnectionState.connecting;
        nativeSocketId = randomUUID().toString();
        disconnectedEmitted = false;
        ackedCaps.clear();
        capValues.clear();
        // Fake lag is per TCP session, and so is our own hostmask, the
        // channel `+f` inventory and the sliding windows. The pacer's
        // *tightening* deliberately survives: it is what we learned about
        // this server, and an Excess Flood kill must not be forgotten by
        // the reconnect it caused. Queued user lines survive too — they
        // were never delivered.
        saslSucceeded = false;
        // A login and an epoch belong to the socket that observed them.
        servicesAccount = "";
        servicesAccountState = ServicesAccountState.unknown;
        connectionEpoch = "";
        announceServicesState();
        try services.onDisconnect();
        catch (Exception) {}
        saslMechsReply = "";
        pacer.resetAccrual();
        pacer.adopt(assumedFloodLimits());
        chargeSuppressed = false;
        ownHostmask = "";
        chanFloodLimit.clear();
        // Oper status and every channel exemption are per TCP session; a
        // reconnect starts as a plain user until the server says otherwise.
        isOper = false;
        pacer.setImmune(false);
        chanFloodExempt.clear();
        chanFloodProbed.clear();
        lastFloodNoticeChannel = "";
        chanFloodWindow.clear();
        lastPacedWriteMs = 0;
        // The command-penalty counter is per TCP session too. The trust
        // itself is per host, so re-derive it here: a network can be edited
        // between attempts.
        cmdBucket.clear();
        lastPacedNoticeMs = 0;
        applyFloodTrust();
        // A dropped connection can strand us inside a `BATCH +chathistory`
        // (the closing `BATCH -` never arrives — verified live: every row
        // for #superbowl stored with `batch=chathistory`, so the bouncer's
        // missed-message replay skipped the whole backlog). Batch state is
        // per TCP connection, so it dies with the old socket; the same goes
        // for in-flight CHATHISTORY flags the dead connection can never
        // answer (they would suppress fresh backfills forever).
        resetHistorySocket();
        capReqOutstanding = 0;
        serverFeatures = ServerFeatures.init;
        // Drop any tokens leftover from the previous connection attempt;
        // the new server's 005 stream will repopulate this map. Without
        // the clear, a reconnect to a less-featureful server would leave
        // stale tokens in the synchronised state.
        isupportMap.clear();
        channelListPending.length = 0;
        channelListInFlight = false;
        channelListEmittedFirst = false;
        channelListPattern = "";

        logInfo("Connecting to %s:%s (Happy Eyeballs)", config.host, config.port);
        logJsonMap("info", "connection",
            "Reconnect attempt starting",
            ["network": config.name, "host": config.host,
             "port": config.port.to!string,
             "attempt": backoff.currentAttempt().to!string,
             "event": "reconnect_attempt"]);

        logInfo("Connecting to %s:%s (Happy Eyeballs) routing=%s owner=%s",
            config.host, config.port, config.routing.toJson().toString(), ownerId.toString());
        dialPlainFallback = false;
        try {
            dialViaHolder(holderTlsMode(config.tls));
        } catch (DialFailedException e) {
            if (e.phase != "tls" && e.phase != "starttls") throw e;
            logJsonMap("warn", "connection",
                "TLS handshake failed",
                ["network": config.name, "host": config.host,
                 "err": e.msg,
                 "event": "tls_fail"]);
            // TLS-only ports must not fall back to plain even when config says "enabled".
            // 6697/6698/7000 are de-facto TLS ports — plain on them gets 0 bytes
            // and leads to "Registration timed out → transport not alive" loop.
            // Treat enabled+TLS-port as required by default. STARTTLS fails
            // closed as well.
            bool isTlsOnlyPort = config.port == 6697 || config.port == 6698
                || config.port == 7000 || config.port == 6699;
            bool mustRequireTls = config.tls == TLSMode.required || config.tls == TLSMode.starttls
                || (config.tls == TLSMode.enabled && isTlsOnlyPort);
            if (mustRequireTls) {
                emitLog("error", "TLS handshake failed");
                throw e;
            }
            logWarn("TLS handshake failed for %s, falling back to plain text", config.host);
            emitLog("warn", "TLS handshake failed — falling back to plain text as configured.");
            dialPlainFallback = true;
            dialViaHolder("none");
            logInfo("Plain fallback TCP via egress '%s' (%s/%s) to %s:%d", activeEgressLabel.length ? activeEgressLabel : "direct", activeEgressHost.length ? activeEgressHost : "direct", activeEgressIp.length ? activeEgressIp : "-", config.host, config.port);
            logJsonMap("info", "connection", "TLS handshake failed; fell back to plain text", ["network": config.name, "host": config.host, "egress": activeEgressLabel.length ? activeEgressLabel : "direct", "egressHost": activeEgressHost, "egressIp": activeEgressIp, "event": "tls_plain_fallback"]);
            logInfo("Connected to %s:%s without TLS via %s", config.host, config.port, activeEgressLabel.length ? activeEgressLabel : "direct");
        }

        emitLog("registering",
            "Sending registration: CAP LS 302, NICK " ~ sessionNick
            ~ ", USER " ~ sessionNick ~ "...");
        logJsonMap("info", "connection",
            "Sending registration",
            ["network": config.name, "nick": sessionNick,
             "event": "register_sending"]);
        withSpan("irc.register", ["network": config.name],
                    (ref Span s) {
            performRegistration();
            s.setStatusOk();
        });

        // Surface a "welcome" notice when the registration completed and
        // the engine is about to flip state to `connected`. The actual
        // state flip happens below; we emit the notice first so the
        // server log timeline ends on a clear success line before any
        // MOTD text begins to stream in.
        connectedAtMs = observed001AtMs;
        renewEgressTrialOnRegistered();
        emitLog("welcome",
            "Connection registered as " ~ sessionNick
            ~ ". Server handshake complete.");
        logJsonMap("info", "connection",
            "Registration complete",
            ["network": config.name, "nick": sessionNick,
             "event": "register_complete"]);

        state = ConnectionState.connected;
        // Registration is fresh inbound evidence. Backoff may have lasted
        // longer than the keepalive deadline; never carry its old clock into
        // the first event-loop iteration of this newly registered socket.
        lastPongReceivedSecs = Clock.currTime.toUnixTime!long;
        lastDataReceivedSecs = lastPongReceivedSecs;
        idleEmitted = false;
        beginServicesGeneration();
        bncState().newSocket(unixMsNow());
        BncPendingWrite[] ordinaryWrites;
        foreach (entry; pacedQueue)
            if (!entry.owner.request.length) ordinaryWrites ~= entry;
        pacedQueue = ordinaryWrites;
        startHistoryRecovery();
        // The backoff is not reset here: runConnectionLoop resets it only
        // after the session stays up STABLE_SESSION_RESET_MS, so a server
        // that accepts then drops us keeps backing off.
        consecutiveTlsClosed = 0;
        throttledUntil = 0;
        droppedNoConnWarned = false;
        // The handshake (CAP LS / NICK / USER / CAP REQ / CAP END / SASL) is
        // accounted separately by the server — UnrealIRCd meters it with
        // handshake-data-flood, not fake lag — so charging it to the bucket
        // would make the first message after every connect wait for nothing.
        // Start the fake-lag model at zero from the moment we are a
        // registered user.
        pacer.resetAccrual();
        recordHostSuccess(config.host, config.port);
        // Welcome received — clear any prior registration-timeout marker so
        // the admin SPA doesn't keep showing this network as stuck.
        registrationTimeoutSince = 0;
        // W1-T01 (plan B3): zero-valued CONNECTION_RETRY_STATUS emit at
        // every backoff.reset() site. Without this the frontend keeps
        // showing stale retryStatus / failInfo after a successful
        // reconnect cycle — see the smoke scenario 3 in plan W1-T01
        // section G.
        emitZeroRetryStatus();
        // First META for this session: from here a hot swap (or a crash)
        // can re-attach the held socket with the registered state.
        requestMetaPublication();
    }

    /// True for the first-party network (irc.ircfiber.com), whose SASL
    /// account IRC Fiber provisions itself.
    private bool isFiberNetwork() const {
        import std.uni : toLower;
        import ircfiber.default_network : DEFAULT_FIBER_HOST;
        return config.host.toLower == DEFAULT_FIBER_HOST;
    }

    /// Parks the network until the user acts: persists `disabled` (survives
    /// restarts, skips bootstrap), mirrors it in-memory so the run loop
    /// idles, tears the half-registered socket down and says why — the
    /// `_server` log, DISCONNECTED (the bouncer relays it to `*status`) and,
    /// when `failType` is set, a CONNECTION_FAIL whose banner opens the
    /// network's SASL settings. The caller throws
    /// `SaslParkedException(msg)` right after. Recovery: Reconnect, a SASL
    /// edit in the network form, or for the Fiber network a
    /// NickServ-password site login — each re-enables and pushes
    /// `reconnectNetwork`. The account name is logged; the credential never is.
    private void parkNetwork(string msg, string failType, string event, string reason = "") {
        import ircfiber.db.network : NetworkRepository;
        try {
            (new NetworkRepository()).setDisabled(config.id, true);
        } catch (Exception e) {
            logWarn("park[%s]: persisting disabled failed: %s", config.name, e.msg);
        }
        config.disabled = true;
        try transportClose(); catch (Exception e) logWarn("park[%s]: transport close failed: %s", config.name, e.msg);
        state = ConnectionState.disconnected;
        lastDisconnectReason = msg;
        emitLog("error", msg);
        logWarn("park[%s]: %s", config.name, msg);
        logJsonMap("warn", "auth", "Parking network until the user acts",
            ["network": config.name, "host": config.host,
             "account": config.saslUsername, "event": event]);
        recordCounter("ircfiber.sasl.parked", 1, ["network": config.name, "host": config.host, "event": event]);
        // Before the CONNECTION_FAIL: the frontend clears failInfo on a zero
        // retry status, so the reverse order would erase the banner.
        emitZeroRetryStatus();
        if (failType.length) {
            FailInfo info;
            info.type_ = failType;
            info.reason = reason.length ? reason : msg;
            lastFailInfo = info;
            try eventChannel.put(IRCRawEvent.makeConnectionFail(config.name, config.id.toString(),
                info.type_, info.reason, info.killedReason, info.sslVerifyError));
            catch (Exception) {}
        }
        try eventChannel.put(IRCRawEvent.makeDisconnected(config.name, config.id.toString(), msg));
        catch (Exception) {}
    }

    /// Where the SASL settings live, named in every park message for a
    /// user-managed network. The banner shows the message on one line, so
    /// each message leads with this instruction; the server's own words are
    /// already in the `_server` log as its ERROR/465 line.
    private enum SASL_SETTINGS_HINT = "Edit network → Advanced options → SASL authentication";

    /// The park message when the server only admits SASL logins and the
    /// network has none.
    private string saslRequiredMessage() const {
        return config.host ~ " only accepts IRC Fiber connections that log in with SASL. Add your account under "
            ~ SASL_SETTINGS_HINT ~ ", then Save — not reconnecting until then.";
    }

    private void rejectAccountRequired(ref const IRCRawEvent event) {
        const params = event.getParams();
        const required = event.command == "draft/ACCOUNTREQUIRED"
            || (event.command == "FAIL" && params.length >= 2
                && params[0] == "*" && params[1] == "ACCOUNT_REQUIRED");
        if (!required || !isServerPrefix(event)) return;
        if (maintenanceActive()) {
            const detail = event.text.length ? event.text : event.command ~ " ACCOUNT_REQUIRED";
            applyRegistrationRefusal(detail);
            lastErrorText = detail;
            throw new Exception("Server refused account during holder maintenance: " ~ detail);
        }
        string message = "This network requires an existing account and SASL login. Configure SASL before reconnecting.";
        if (capValues.get("draft/account-registration", "").split(",").canFind("before-connect"))
            message ~= " Early registration is available only through an early-registration-capable client.";
        parkNetwork(message, "sasl_required", "account_required", "account_required");
        throw new SaslParkedException(message);
    }

    /// Definitive SASL rejection (904/905): services are reachable and refuse
    /// the stored credential or mechanism. On the Fiber network the password
    /// no longer matches the live NickServ account (rotated on IRC, dropped
    /// and re-registered, or lost in an Anope restart), and a NickServ-password
    /// site login is the fix. Elsewhere the user typed the account, so point
    /// them at the form — and when the server's 908 list lacks the mechanism,
    /// say so (Libera offers SCRAM-SHA-512 but not SCRAM-SHA-256). Returns
    /// the user-facing message for the caller's SaslParkedException.
    private string parkOnSaslRejection(string detail) {
        const mech = saslMechanismName(config.sasl);
        if (isFiberNetwork()) {
            const msg = "SASL " ~ mech ~ " rejected for account \"" ~
                config.saslUsername ~ "\" (" ~ detail ~ ") — stored credential does not match " ~
                "the live NickServ account. Parked (disabled); log into the site with " ~
                "the NickServ password to reconnect.";
            parkNetwork(msg, "", "sasl_parked");
            return msg;
        }
        if (saslMechsReply.length && !saslMechanismOffered(saslMechsReply, mech))
            return parkOnUnsupportedMechanism(saslMechsReply);
        const msg = config.host ~ " rejected the SASL " ~ mech ~ " login for \"" ~ config.saslUsername
            ~ "\" — check the account name and password under " ~ SASL_SETTINGS_HINT
            ~ ", then Save. Server said: \"" ~ detail ~ "\".";
        parkNetwork(msg, "sasl_failed", "sasl_parked");
        return msg;
    }

    /// The server does not offer the configured mechanism (`offered` is its
    /// comma-separated list). Every attempt would fail the same way, so park
    /// and name what it does offer. Returns the user-facing message.
    private string parkOnUnsupportedMechanism(string offered) {
        import std.array : replace;
        const mech = saslMechanismName(config.sasl);
        const pick = saslMechanismOffered(offered, "PLAIN") ? "PLAIN" : "a mechanism it offers";
        const msg = config.host ~ " does not support SASL " ~ mech ~ " — choose " ~ pick ~ " under "
            ~ SASL_SETTINGS_HINT ~ ", then Save. It offers " ~ offered.replace(",", ", ") ~ ".";
        parkNetwork(msg, isFiberNetwork() ? "" : "sasl_failed", "sasl_mechanism_parked");
        return msg;
    }

    // ── Registration (CAP + NICK + USER + SASL) ───────────────────────────────

    private void performRegistration(long timeoutOverrideMs = 0) {
        // Every terminal handshake failure closes and confirms its own claim
        // before unwinding admission. Relay EOF recovery stays on this stack.
        scope(failure) recoverHolderRelay(false, true);
        // WEBIRC before anything else, and only to irc.ircfiber.com: the ircd
        // swaps this session's address for the user's own (and re-matches
        // the connect class on the `webirc="ircfiber"` constraint) before
        // registration continues. Never to another host, never a
        // non-public address (see isPublicUnicast). Every branch logs so
        // prod can account for each fiber connection.
        {
            import std.uni : toLower;
            import ircfiber.default_network : DEFAULT_FIBER_HOST;
            const bool fiber = config.host.toLower == DEFAULT_FIBER_HOST;
            const webSecret = fiber ? webircPassword() : "";
            if (fiber) clientIp = loadClientIp();
            if (fiber && webSecret.length && isPublicUnicast(clientIp)) {
                // A swap into an address the server just banned gets this
                // session killed with it: stay on the engine IP until the
                // suppression recorded by applyBanPolicy lapses (geo display
                // goes slightly stale, session stays alive).
                if (webircSwapSuppressed(config.host.toLower(), clientIp)) {
                    logJsonMap("info", "connection", "WEBIRC skipped",
                        ["network": config.name, "event": "webirc_skipped",
                         "reason": "zline-suppressed", "ip": clientIp]);
                } else {
                    sendRaw("WEBIRC " ~ webSecret ~ " ircfiber " ~ clientIp ~ " " ~ clientIp);
                    logJsonMap("info", "connection", "WEBIRC sent",
                        ["network": config.name, "ip": clientIp, "event": "webirc_sent"]);
                }
            } else if (fiber) {
                logJsonMap("info", "connection", "WEBIRC skipped",
                    ["network": config.name, "event": "webirc_skipped",
                     "reason": webSecret.length == 0 ? "no-password"
                             : clientIp.length == 0 ? "no-client-ip" : "non-public-ip"]);
            }
        }

        // CAP LS 302 first — lets us inspect what the server offers
        sendRaw("CAP LS 302");
        // Use last-negotiated nick from Redis if available, falling back
        // to the configured nick. This avoids the 433 collision → rename
        // → reconnect race on every reconnect. loadPersistedNick is safe
        // to call here (inside a fiber); the constructor deliberately does
        // NOT call it to avoid Redis calls outside a fiber context.
        auto persisted = loadPersistedNick();
        if (persisted.length > 0 && persisted != sessionNick) {
            logInfo("Switching to persisted nick '%s' for %s (was '%s')", persisted, config.name, sessionNick);
            sessionNick = persisted;
        }
        // requestedNick = what the USER wants, i.e. their configured nick
        // in `cfg.nick`. The actual NICK we send may differ (persisted
        // override above, or a 433 fallback below), but cfg.nick stays
        // anchored to user intent — so on 001 we can tell whether we
        // landed on the requested nick or a fallback. (Fallbacks must NOT
        // be persisted — see clearPersistedNick.)
        requestedNick = config.nick.length > 0 ? config.nick : sessionNick;
        // Fresh attempt: a previous attempt's random-suffix escape hatch
        // must not shield this attempt's plain `_` fallback from the
        // 001 handler's clearPersistedNick below.
        randomNickPersisted = false;
        ghostReclaimAttempted = false;
        lateSaslPending = false;
        forcedFromNick = "";
        // PASS must be sent before NICK/USER per RFC 1459 §4.1
        if (config.serverPass.length > 0) sendRaw("PASS " ~ config.serverPass);
        sendRaw("NICK " ~ sessionNick);
        // `config.ident` is the user-chosen IRC username ("ident"); empty —
        // the default — keeps the historical `USER <nick>` line byte-for-byte.
        sendRaw("USER " ~ (config.ident.length ? config.ident : sessionNick) ~ " 0 * :" ~ config.realName);

        ubyte[STREAM_BUFFER_SIZE] buf;
        inboundPartial = null;
        bool welcomed    = false; // 001 received (for timeout warning)
        bool motdDone    = false; // 376/422 received (end of MOTD)
        // CAP handshake state lives on the client so `handleCapLine` (also
        // used after registration) can drive it.
        saslDone    = (config.sasl == SASLMechanism.none);
        capEndSent  = false;
        serverCaps  = null;
        capReqOutstanding = 0;

        // SCRAM state (may be null)
        ScramSha256Client* scram = null;
        int scramStep = 0; // 0=not started, 1=sent client-first, 2=sent client-final

        // RFC 2812 §2.3 — "client should expect a reply as specified but it
        // is not advised to wait forever for the reply." Bound the
        // CAP+NICK+USER+SASL handshake: REGISTRATION_SILENT_TIMEOUT_SECS
        // while the server has sent nothing (black-holed peer),
        // REGISTRATION_OVERALL_TIMEOUT_SECS once it has spoken (alive but
        // slow — typically waiting out its own ident timer). The read-loop
        // bound below only protects against a tight loop on partial data.
        immutable registrationStartMs = Clock.currTime.toUnixTime!long * 1000;
        // Mirrored onto the client so the JOIN-throttle retry can measure
        // the server's grace window after this function has returned.
        registrationStartedAtMs = registrationStartMs;
        immutable registrationOverallTimeoutMs
            = REGISTRATION_OVERALL_TIMEOUT_SECS * 1000;
        long registrationLastWarnMs = 0;
        immutable registrationWarnThresholdMs1
            = (registrationOverallTimeoutMs * REGISTRATION_WARN_AT_FRACTION_1) / 100;
        immutable registrationWarnThresholdMs2
            = (registrationOverallTimeoutMs * REGISTRATION_WARN_AT_FRACTION_2) / 100;

        foreach (_; 0 .. REGISTRATION_MAX_READS) {
            // Hard upper bound: give up and let the connection loop's
            // exponential backoff schedule a retry. This is what RFC 2812
            // calls out as required behavior.
            immutable nowMs = Clock.currTime.toUnixTime!long * 1000;
            immutable serverSilent = linesIn == 0;
            immutable timeoutSecs = serverSilent
                ? REGISTRATION_SILENT_TIMEOUT_SECS : REGISTRATION_OVERALL_TIMEOUT_SECS;
            if (nowMs - registrationStartMs > (timeoutOverrideMs > 0 ? timeoutOverrideMs : timeoutSecs * 1000)) {
                if (!welcomed) {
                    registrationTimeoutSince = nowMs;
                    immutable why = serverSilent
                        ? "server sent nothing — black-holed"
                        : "server replied but never completed registration";
                    logWarn("PersistentIRCClient[%s] registration TIMEOUT after %ds"
                        ~ " (CAP+SASL+001 not received; %s); will retry with backoff",
                        config.name, timeoutSecs, why);
                    logJsonMap("warn", "connection",
                        "Registration timeout",
                        ["network":  config.name,
                         "networkId": config.id.toString(),
                         "host":     config.host ~ ":" ~ config.port.to!string,
                         "elapsed":  (nowMs - registrationStartMs).to!string,
                         "linesIn":  linesIn.to!string,
                         "event":    "registration_timeout"]);
                    recordCounter("ircfiber.registration.timeout", 1,
                        ["network":  config.name,
                         "networkId": config.id.toString(),
                         "host":     config.host ~ ":" ~ config.port.to!string]);
                    throw new Exception(
                        "Registration timeout: 001 not received within "
                        ~ timeoutSecs.to!string ~ "s (" ~ why ~ ")");
                }
                // welcomed == true means registration completed; remaining
                // reads are post-001 MOTD/376 traffic. Let the existing
                // 400-read cap bound that loop naturally.
            }
            // Soft warnings at 50% / 75% of the timeout so operators can
            // see "this network is taking unusually long to welcome us"
            // before the hard timeout fires. Cheaper than a per-second log
            // line; just one event per threshold per registration attempt.
            immutable elapsedMs = nowMs - registrationStartMs;
            if (registrationLastWarnMs < registrationWarnThresholdMs1
                && elapsedMs >= registrationWarnThresholdMs1) {
                registrationLastWarnMs = elapsedMs;
                emitLog("registering", "Still waiting for the server to accept the registration ("
                    ~ (elapsedMs / 1000).to!string ~ "s) — servers often stall here on ident/hostname lookups; giving up at "
                    ~ REGISTRATION_OVERALL_TIMEOUT_SECS.to!string ~ "s.");
                logWarn("PersistentIRCClient[%s] registration slow — %dms elapsed, still waiting for 001",
                    config.name, cast(int) elapsedMs);
                logJsonMap("warn", "connection",
                    "Registration slow",
                    ["network":  config.name,
                     "networkId": config.id.toString(),
                     "host":     config.host ~ ":" ~ config.port.to!string,
                     "elapsed":  elapsedMs.to!string,
                     "event":    "registration_slow"]);
                recordCounter("ircfiber.registration.slow", 1,
                    ["network":  config.name,
                     "networkId": config.id.toString(),
                     "host":     config.host ~ ":" ~ config.port.to!string]);
            } else if (registrationLastWarnMs < registrationWarnThresholdMs2
                && elapsedMs >= registrationWarnThresholdMs2) {
                registrationLastWarnMs = elapsedMs;
                emitLog("registering", "No welcome after " ~ (elapsedMs / 1000).to!string
                    ~ "s — the server accepted the TCP/TLS connection but has not completed registration.");
                logWarn("PersistentIRCClient[%s] registration very slow — %dms elapsed",
                    config.name, cast(int) elapsedMs);
                logJsonMap("warn", "connection",
                    "Registration very slow",
                    ["network":  config.name,
                     "networkId": config.id.toString(),
                     "host":     config.host ~ ":" ~ config.port.to!string,
                     "elapsed":  elapsedMs.to!string,
                     "event":    "registration_very_slow"]);
                recordCounter("ircfiber.registration.very_slow", 1,
                    ["network":  config.name,
                     "networkId": config.id.toString(),
                     "host":     config.host ~ ":" ~ config.port.to!string]);
            }

            // Use a non-zero timeout so the fiber blocks until data actually
            // arrives.  With waitForData(0) on macOS/kqueue, the poll can miss
            // server responses (CAP LS, 001) entirely, causing a 40s timeout.
            auto received = readFromStream(buf[], REGISTRATION_READ_TIMEOUT_MS.msecs);
            if (received == 0) {
                // waitForData returns at once on a closed stream. Without
                // this check a server that hangs up before replying (a
                // TLS-only port dialled in plain text, e.g. Libera's 7000)
                // raced this loop to its end, "timed out" in the same second
                // and went on to write auto-joins into a dead socket, which
                // surfaced as "Connection closed while writing data".
                if (!transportAlive || relayClosed()) throw new Exception(registrationClosedReason());
                // waitForData already blocked for the full timeout above;
                // a minimal yield prevents tight-looping the event loop.
                yield();
            } else {
                inboundPartial ~= cast(const(char)[]) buf[0 .. received];
                string line;
                while (true) {
                    const before = inboundPartial.length;
                    if (!popInboundLine(inboundPartial, line)) break;
                    const rawBytes = before - inboundPartial.length;
                    lineFromBacklog = attachBacklogBytes > 0;
                    if (lineFromBacklog) attachBacklogBytes -= cast(long) rawBytes;
                    if (line.length == 0) continue;
                    linesIn++;

                    auto evt = parseIRCLine(line);
                    evt.network = config.name;
                    evt.timestampMs = resolveTimestamp(evt);
                    // Gap-retained state predates the loss boundary. Fence it
                    // before services/CAP/SASL or membership dispatch, including
                    // the post-001 MOTD tail. A first 001 for this fresh attempt
                    // remains valid evidence even if buffered during rebind.
                    if (gapReplayUncertain && lineFromBacklog && evt.command != "001") {
                        processEvent(evt);
                        continue;
                    }
                    if (gapReplayUncertain && !lineFromBacklog) gapReplayUncertain = false;
                    auto replay = replayContext(evt);
                    if (services.interceptNative(evt, replay.historical, lineFromBacklog)) continue;
                    if (handleReplayBatch(evt, replay) || replayQuarantined(evt)) continue;
                    if (accumulateReplayMultiline(evt)) continue;
                    if (replay.historical) { processHistoricalEvent(evt, replay); continue; }
                    rejectAccountRequired(evt);
                    if (evt.command == "464" || evt.command == "463") {
                        lastErrorText = evt.text;
                        applyRegistrationRefusal(evt.text.length ? evt.text : evt.command);
                        throw new Exception("Server refused registration: " ~ evt.command ~ " " ~ evt.text);
                    }
                    // Set by a case below to keep this line out of the
                    // generic publish at the bottom of the loop.

                    switch (evt.command) {
                        // 375/372 pass through verbatim like every other
                        // registration numeric: the ircd's motdpool module
                        // renders the per-connect, per-user MOTD.

                        case "PING":
                            auto params = evt.getParams();
                            sendRaw("PONG :" ~ (params.length > 0 ? params[$ - 1] : ""));
                            break;

                        // ── 001 welcomed ─────────────────────────────────────
                        case "001":
                            if (welcomed) break; // never mint new evidence from duplicate 001
                            welcomed = true;
                            observed001AtMs = unixMsNow();
                            externalRefusalAtMs = 0;
                            externalRefusalReason = "";
                            releaseRegistrationPermit();
                            // Registration NICK has no separate echo: 001 is
                            // its confirmation, not an outstanding /nick.
                            const welcomeParams = evt.getParams();
                            if (welcomeParams.length) sessionNick = welcomeParams[0];
                            optimisticNickOld = "";
                            // A new registration is a new IRC session:
                            // every membership fact we hold belongs to the
                            // socket that just died, and each rejoin's
                            // NAMES burst rebuilds it from the server.
                            // Keeping it is how our own pre-fallback nick
                            // survived a 433 chain — a fallback sent
                            // before registration gets no NICK echo, so
                            // nothing renamed the old entry and `Zodiac`
                            // sat in #tclmafia beside `Zodiac_` for hours.
                            channelUsers = null;
                            userMetadata = null;
                            channelMetadata = null;
                            away = null;
                            bots = null;
                            namesBurst = null;
                            namesBurstAt = null;
                            namesBurstIndex = null;
                            resetNamesIdentIndex();
                            realnames = null;
                            realnameProbed = null;
                            idents = null;
                            accounts = null;
                            // Registration completed. Reset the fallback
                            // counter so the next reconnect attempts the
                            // user's configured nick from scratch — if
                            // the random-suffix nick is what landed us
                            // here, the user's intended nick may now be
                            // free and we should re-derive requestedNick
                            // from cfg.nick on the next attempt.
                            registrationFallbackAttempts = 0;
                            // Only persist the nick if it matches the one
                            // we asked for — otherwise we're on a 433
                            // fallback (e.g. `Zodiac_`) and we clear any
                            // persisted nick so the next reconnect retries
                            // the configured nick instead of locking the
                            // fallback in. (The random-suffix escape hatch
                            // below keeps its persisted nick, gated by
                            // randomNickPersisted.)
                            if (sessionNick == requestedNick)
                                persistNick(sessionNick);
                            else if (!randomNickPersisted)
                                clearPersistedNick();
                            logJsonMap("info", "connection",
                                "RPL_WELCOME received",
                                ["network": config.name,
                                 "nick": sessionNick,
                                 "hostmask": evt.prefix.length > 0 ? evt.prefix : "",
                                 "event": "welcome"]);
                            break;

                        // ── End of MOTD ───────────────────────────────────────
                        // Keep reading until MOTD is complete so all 372 lines
                        // are published BEFORE emitLog("welcome") below rather
                        // than being split by it into separate event batches.
                        case "376":
                        case "422":
                            motdDone = true;
                            // End-of-MOTD is not registration evidence; only 001 is.
                            break;

                        // ── Nick in use ───────────────────────────────────────
                        case "433":
                        case "432":
                            registrationFallbackAttempts++;
                            // A 433 on the exact nick we asked for, when we
                            // hold a services credential for it, almost
                            // always means a stale session of OUR OWN is
                            // still holding it: our previous connection
                            // died in a way that skipped a clean QUIT
                            // (transport loss, egress rotation — see the
                            // ghost retry floor in runConnectionLoop), and
                            // ghost protection keeps the server-side socket
                            // alive for up to ~30-60s. Minting a `_`-suffix
                            // sibling nick here used to register a brand
                            // new session instead — a flappy connection
                            // left a trail of `Zodiac_`, `Zodiac__`, … ghost
                            // entries sitting in every auto-join channel
                            // until the network eventually timed each one
                            // out. Reclaim the nick outright via NickServ
                            // GHOST instead so a self-collision self-heals
                            // in ~2s with no ghost entry left behind.
                            // Guarded to at most one attempt per
                            // registration attempt, only against the
                            // primary requested nick (never an
                            // already-fallen-back nick — ghosting `Zodiac_`
                            // because `Zodiac__` is taken could kill a
                            // different, unrelated collision's session),
                            // and only when a credential proves we own the
                            // nick's services account, so this never
                            // touches a stranger's session.
                            if (!ghostReclaimAttempted && sessionNick == requestedNick) {
                                ghostReclaimAttempted = true;
                                const ghostPass = config.nspass.length > 0 ? config.nspass
                                    : (config.sasl != SASLMechanism.none ? config.saslPassword : "");
                                if (ghostPass.length > 0) {
                                    registrationFallbackAttempts--; // doesn't consume the `_`-chain budget
                                    logJsonMap("info", "connection",
                                        "Nick in use, likely by our own stale session — reclaiming via NickServ GHOST",
                                        ["network": config.name, "nick": requestedNick,
                                         "event": "nickserv_ghost_attempt"]);
                                    recordCounter("ircfiber.nick.ghost_attempt", 1, ["network": config.name]);
                                    sendRaw("PRIVMSG NickServ :GHOST " ~ requestedNick ~ " " ~ ghostPass);
                                    sleep(GHOST_RECLAIM_WAIT_MS.msecs);
                                    sendRaw("NICK " ~ requestedNick);
                                    break;
                                }
                            }
                            if (registrationFallbackAttempts <= REGISTRATION_MAX_FALLBACK_ATTEMPTS) {
                                // The classic `Zod` → `Zod_` → `Zod__` chain.
                                // Each fallback _is_ a NICK change on the
                                // IRC server, so each one is a unique
                                // member entry in any channels the user
                                // auto-joins after registration completes.
                                // Across many reconnect cycles those
                                // accumulate as ghost entries (one per
                                // cycle), so we cap the chain at
                                // REGISTRATION_MAX_FALLBACK_ATTEMPTS and
                                // fall through to a unique random nick.
                                sessionNick ~= "_";
                                sendRaw("NICK " ~ sessionNick);
                            } else {
                                // Configure nick + every short-underscore
                                // variant is taken (or the server is
                                // rejecting us). Generate a unique random
                                // suffix and persist it so the next
                                // reconnect uses the same nick — no more
                                // ghost nick accumulation in shared
                                // channels. The suffix is generated with
                                // std.random.uniform!rndGen which gives a
                                // thread-local PRNG; for a one-shot
                                // uniqueness probe that's enough — the
                                // suffix only needs to not collide with
                                // anything currently in the channel.
                                import std.random : uniform, Mt19937, unpredictableSeed, Random;
                                auto rng = Random(unpredictableSeed);
                                ubyte[] nibbles = new ubyte[REGISTRATION_RANDOM_SUFFIX_HEX_LEN];
                                foreach (ref n; nibbles) n = cast(ubyte) uniform(0, 16, rng);
                                char[] hex = new char[](nibbles.length);
                                foreach (i, b; nibbles) hex[i] = "0123456789abcdef"[b];
                                auto suffix = cast(string) hex;
                                sessionNick = requestedNick ~ "_" ~ suffix;
                                persistNick(sessionNick);
                                // Escape-hatch nick: keep it persisted so
                                // the 001 handler below doesn't clear it.
                                randomNickPersisted = true;
                                logWarn("Nick '%s' persistently unavailable for %s after %d fallbacks; "
                                    ~ "switching to random nick '%s' and persisting",
                                    requestedNick, config.name, REGISTRATION_MAX_FALLBACK_ATTEMPTS, sessionNick);
                                sendRaw("NICK " ~ sessionNick);
                            }
                            break;

                        // ── RPL_MYINFO ────────────────────────────────────────
                        // `004 <nick> <server> <version> <umodes> <cmodes>…` —
                        // the only place a server names its own software, and
                        // what gates the ircd-specific probes (probeChannelFlood).
                        case "004": {
                            auto myinfo = evt.getParams();
                            if (myinfo.length >= 3) serverSoftware = myinfo[2];
                            break;
                        }

                        // ── ISUPPORT ──────────────────────────────────────────
                        case "005":
                            applyIsupportReply(evt);
                            break;

                        // ── RPL_WHOISUSER (311): nick user host * :realname ──
                        // Stores the realname so the frontend can render
                        // <span class="author-realname"> next to the nick
                        // (IRCCloud parity).
                        case "311": {
                            auto params = evt.getParams();
                            // params[0] = our nick, params[1] = target nick,
                            // params[2] = ident, params[3] = host,
                            // params[4] = "*", params[5] = realname
                            if (params.length >= 6) {
                              auto nick = params[1];
                              const rn   = params[5];
                              if (nick.length > 0) {
                                // The server answered — record that even when
                                // the answer is the nick itself and therefore
                                // not stored below.
                                recordIdentity(realnameProbed, nick, true);
                                if (rn.length > 0 && rn != nick)
                                  recordIdentity(realnames, nick, rn);
                              }
                            }
                            break;
                        }

                        // ── CAP LS / ACK / NAK / NEW / DEL ────────────────────
                        case "CAP":
                            handleCapLine(evt, false);
                            break;

                        // ── AUTHENTICATE ──────────────────────────────────────
                        case "AUTHENTICATE":
                            logJsonMap("debug", "auth",
                                "SASL authenticate",
                                ["network": config.name,
                                 "mechanism": saslMechanismName(config.sasl),
                                 "event": "sasl_authenticate"]);
                            auto params = evt.getParams();
                            auto challenge = params.length > 0 ? params[0] : "";

                            if (config.sasl == SASLMechanism.plain) {
                                if (challenge == "+") {
                                    sendSaslAuthenticate(buildSaslPlainPayload(config.saslUsername,
                                        config.saslPassword));
                                } else {
                                    // Unexpected challenge — abort SASL per RFC 4422 §3.5
                                    logWarn("SASL PLAIN: unexpected challenge from %s, aborting", config.host);
                                    sendRaw("AUTHENTICATE *");
                                    saslDone = true;
                                }
                            } else if (config.sasl == SASLMechanism.external) {
                                if (challenge == "+") {
                                    sendRaw("AUTHENTICATE +"); // empty authzid
                                } else {
                                    // Unexpected challenge — abort
                                    logWarn("SASL EXTERNAL: unexpected challenge from %s, aborting", config.host);
                                    sendRaw("AUTHENTICATE *");
                                    saslDone = true;
                                }
                            } else if (config.sasl == SASLMechanism.scramSha256) {
                                if (scramStep == 0 && challenge == "+") {
                                    // Server indicates readiness — send client-first-message
                                    auto s = new ScramSha256Client(config.saslUsername, config.saslPassword);
                                    scram  = s;
                                    sendSaslAuthenticate(scram.clientFirstMessage());
                                    scramStep = 1;
                                } else if (scramStep == 1 && challenge != "+" && challenge.length > 0) {
                                    // Server-first-message — send client-final-message
                                    sendSaslAuthenticate(scram.clientFinalMessage(challenge));
                                    scramStep = 2;
                                } else if (scramStep == 2 && challenge != "+" && challenge.length > 0) {
                                    // Server-final-message (mutual auth verification)
                                    if (!scram.verifyServerFinal(challenge)) {
                                        logWarn("SCRAM: server signature verification FAILED for %s", config.host);
                                    }
                                } else {
                                    // Unexpected state — abort SASL
                                    logWarn("SASL SCRAM: unexpected challenge (step=%s) from %s, aborting",
                                        scramStep, config.host);
                                    sendRaw("AUTHENTICATE *");
                                    saslDone = true;
                                }
                            } else {
                                // SASL mechanism not configured but server sent AUTHENTICATE — abort
                                logWarn("SASL: unexpected AUTHENTICATE from %s (no mechanism selected), aborting",
                                    config.host);
                                sendRaw("AUTHENTICATE *");
                                saslDone = true;
                            }
                            break;

                        // ── SASL success / failure ────────────────────────────
                        case "903": // RPL_SASLSUCCESS
                            saslDone = true;
                            // UnrealIRCd's `known-users` security group is
                            // "identified to services OR connected > 2h", and
                            // it carries looser flood limits. Being identified
                            // is the half we can actually observe.
                            saslSucceeded = true;
                            pacer.adopt(KNOWN_USER_LIMITS);
                            emitLog("sasl_done",
                                "SASL " ~ saslMechanismName(config.sasl) ~ " authentication succeeded");
                            maybeEndCap("sasl-success");
                            logJsonMap("info", "auth",
                                "SASL success",
                                ["network": config.name,
                                 "host": config.host, "port": config.port.to!string,
                                 "mechanism": saslMechanismName(config.sasl),
                                 "event": "sasl_success"]);
                            recordCounter("ircfiber.sasl.success", 1,
                                ["network": config.name, "host": config.host,
                                 "port": config.port.to!string,
                                 "mechanism": saslMechanismName(config.sasl)]);
                            break;
                        case "902": // ERR_NICKLOCKED — the account is locked/suspended
                        case "904": // ERR_SASLFAIL
                        case "905": // ERR_SASLTOOLONG
                            externalRefusalAtMs = unixMsNow();
                            externalRefusalReason = !evt.text.length ? evt.command
                                : evt.text.length > 2048 ? evt.text[0 .. 2048].idup : evt.text;
                            if (maintenanceActive()) {
                                lastErrorText = externalRefusalReason;
                                throw new Exception("Server refused SASL during holder maintenance: " ~ evt.text);
                            }
                            // Definitive: services are reachable and refuse the
                            // stored credential (or, after a 908, the
                            // mechanism). Retrying would re-enter the same nick
                            // war forever — park instead. 906 (aborted, usually
                            // our own timeout) stays on the retry path below.
                            throw new SaslParkedException(parkOnSaslRejection(evt.text));
                        case "908": { // RPL_SASLMECHS — what the server offers; precedes 904 for an unsupported mechanism
                            auto mechParams = evt.getParams();
                            if (mechParams.length >= 2) saslMechsReply = mechParams[1];
                            break;
                        }
                        case "906": // ERR_SASLABORTED
                            emitLog("sasl_fail", "SASL authentication aborted");
                            logJsonMap("warn", "auth",
                                "SASL aborted",
                                ["network": config.name,
                                 "host": config.host, "port": config.port.to!string,
                                 "mechanism": saslMechanismName(config.sasl),
                                 "event": "sasl_fail"]);
                            recordCounter("ircfiber.sasl.failure", 1,
                                ["network": config.name, "host": config.host,
                                 "port": config.port.to!string,
                                 "mechanism": saslMechanismName(config.sasl)]);
                            throw new Exception("SASL aborted");
                        case "907": // ERR_SASLALREADY
                            saslDone = true;
                            emitLog("sasl_done", "SASL already authenticated (907)");
                            break;

                        case "465": // ERR_YOUREBANNEDCREEP — server ban during registration
                            lastErrorText = evt.text;
                            evt.network = config.name; evt.timestampMs = resolveTimestamp(evt); eventChannel.put(evt);
                            applyRegistrationRefusal(evt.text.length ? evt.text : evt.command);
                            throw new Exception("Server banned connection during registration: " ~ evt.text);
                        case "ERROR":
                            lastErrorText = evt.text;
                            evt.network     = config.name;
                            evt.timestampMs = resolveTimestamp(evt);
                            eventChannel.put(evt);
                            applyRegistrationRefusal(evt.text.length ? evt.text : evt.command);
                            throw new Exception("Server closed connection during registration: " ~ evt.text);

                        // draft/metadata-2 replies and RPL_LOGGEDIN/OUT:
                        // same bookkeeping as after registration.
                        case "METADATA":
                        case "FAIL":
                        case "761": case "766": case "770": case "771":
                        case "772": case "774":
                        case "900": case "901":
                            if (handleMetadataLine(evt)) continue;
                            break;

                        case "JOIN": case "PART": case "KICK": case "QUIT":
                        case "NICK": case "MODE": case "TOPIC":
                        case "353": case "366": case "332": case "333":
                        case "352": case "354":
                            // Server-side autojoins can arrive before MOTD
                            // ends or share its final read. Publishing alone
                            // loses JOIN/NAMES state; our later JOIN is then a
                            // no-op because the server already joined us.
                            evt.network = config.name;
                            evt.timestampMs = resolveTimestamp(evt);
                            processEvent(evt);
                            continue; // normal dispatch already publishes

                        default:
                            break;
                    }

                    // Skip WHOIS / WHOX / NAMES / WHO replies during
                    // registration too — engine consumes what it needs
                    // (311 → realnames, 352 → channelUsers) above, the
                    // rest is metadata noise the frontend has no UI for.
                    // Without this, the WS frame stream fills with 2000+
                    // WHOX 354 lines on a SuperNets-scale channel and
                    // the scrollback Redis key bloats with one entry per
                    // user. The frontend's `isSkippedCommand` already
                    // filters most of these at display time; this is the
                    // symmetric engine-side guard so we don't burn
                    // bandwidth / storage shipping what we'll discard.
                    const noPublishDuringRegistration = [
                        "311", "312", "313", "315", "317", "318", "319",
                        "330", "332", "333", "354", "366", "376", "401",
                        "422", "761", "766", "770", "771", "772", "774",
                        "902",
                        // `BATCH ±ref draft/isupport` around the ISUPPORT
                        // reply (draft/extended-isupport) — framing only.
                        "BATCH",
                    ];
                    if (evt.command != "PING" && evt.command != "ERROR"
                        && !noPublishDuringRegistration.canFind(evt.command)) {
                        evt.network     = config.name;
                        evt.timestampMs = resolveTimestamp(evt);
                        eventChannel.put(evt);
                    }
                }
                enforceLineBound(inboundPartial);
            }
            if (welcomed && motdDone && saslDone) break;
            yield();
        }

        if (!welcomed) throw new Exception("Registration timeout: 001 not received before read limit");
        // Auto-OPER (if configured) — sent before the auto-join block below so
        // oper-only (+O) channels in the auto-join list are joinable. The IRCd
        // processes OPER then JOIN in receive order on this one connection, so +o
        // is set before each JOIN is evaluated; no need to await the 381 reply.
        // performRegistration() runs on every (re)connect, so this re-opers too.
        if (config.operUsername.length > 0 && config.operPassword.length > 0) {
            sendRaw("OPER " ~ config.operUsername ~ " " ~ config.operPassword);
        }
        // Our away state outlives the socket; the server forgot it. With
        // draft/pre-away it already went out before CAP END.
        if (isAway && awayMessage.length && !hasCap("draft/pre-away"))
            sendRaw("AWAY :" ~ awayMessage);
        // draft/metadata-2: subscribe before the JOINs below so the
        // server's join-sync batches already carry members' keys, then
        // publish our own (avatar default/override plus profile keys).
        if (hasCap("draft/metadata-2")) publishOwnMetadata();

        // SuperNETs/DangerousIRCd throttles JOIN until the client has been
        // connected for ≥5s (421 "You must be connected for at least 5
        // seconds before you can use this command"). Per-network
        // autoJoinDelaySeconds (default 0 = join immediately) waits out the
        // remaining window measured from registration start (≈ connect) so
        // the auto-joins below land after the throttle instead of being
        // bounced.
        if (config.autoJoinDelaySeconds > 0) {
            immutable nowMs = Clock.currTime.toUnixTime!long * 1000;
            immutable delayMs = remainingJoinDelayMs(
                config.autoJoinDelaySeconds, nowMs, registrationStartMs);
            if (delayMs > 0) {
                logInfo("Auto-join delay: waiting %d ms for %s (configured %d s, connected %d ms ago)",
                    delayMs, config.name, config.autoJoinDelaySeconds, nowMs - registrationStartMs);
                sleep(delayMs.msecs);
            }
        }

        // One comma-joined JOIN (per 400-byte batch) instead of one command
        // per channel. Servers that rate-limit per command answered every
        // single JOIN of the burst with its own refusal — nine identical
        // "You must be connected for at least 5 seconds" rows in the user's
        // server log for a nine-channel network. Same batching the throttle
        // retry already uses.
        string[] autoJoin;
        foreach (chan; config.autoJoinChannels) {
            string ch = chan.strip();
            if (ch.length == 0) continue;
            if (ch[0] != '#' && ch[0] != '&' && ch[0] != '+' && ch[0] != '!')
                ch = "#" ~ ch;
            autoJoin ~= ch[0 .. 1] ~ ch[1 .. $].toLower();
        }
        // channelState is never wiped on a real reconnect (only PART/KICK
        // remove a key, ~6227/6254) but channelUsers just was, at 001
        // above, and the IRC server has genuinely forgotten every
        // membership the dead TCP session held — NAMES alone (the
        // attachHeld resync at line 3352) can't refill a roster for a
        // channel we are no longer actually in. A channel the user
        // manually /joined but never added to the persisted
        // autoJoinChannels list used to sit out of this JOIN burst, so
        // channelState kept reporting isJoined:true forever with an
        // empty roster: the buffer looked joined with zero members and
        // no way to self-heal short of an explicit /part + /join.
        // (Reproduced on #superbowl / Super Nets, whose ircd throttles
        // JOIN — see autoJoinDelaySeconds above — and so reconnects often.)
        foreach (chan; channelState.byKey) {
            auto ch = normalizeChannelName(chan);
            if (!autoJoin.canFind(ch)) autoJoin ~= ch;
        }
        foreach (batch; joinBatches(autoJoin))
            sendRaw("JOIN " ~ batch);
        if (autoJoin.length > 0) scheduleJoinConfirmSweep();


        // ── Post-registration commands ─────────────────────────────────────
        // NickServ IDENTIFY (if configured) — sent BEFORE user-supplied
        // commands so the user's commands can rely on being identified.
        if (config.nspass.length > 0) {
            sendRaw("PRIVMSG NickServ :IDENTIFY " ~ config.nspass);
        }

        // User-supplied commands to run on connect (one per line).
        // Supports WAIT N for delays (e.g. "WAIT 15" pauses 15 seconds).
        if (config.commands.length > 0) {
            import std.ascii : isDigit;
            foreach (line; config.commands.split("\n")) {
                auto trimmed = line.strip();
                if (trimmed.length == 0) continue;
                if (trimmed.length > 5 && trimmed[0 .. 5] == "WAIT ") {
                    int seconds = 0;
                    foreach (ch; trimmed[5 .. $]) {
                        if (isDigit(ch)) seconds = seconds * 10 + (ch - '0');
                        else break;
                    }
                    if (seconds > 0) {
                        logInfo("Waiting %d seconds before next command…", seconds);
                        sleep(seconds.seconds);
                        continue;
                    }
                }
                sendRaw(trimmed);
            }
        }
    }

    /// Disconnect reason when the server hangs up during registration
    /// without an ERROR line. Silence from the first byte on a plain-text
    /// connection is what a TLS-only port answers, so say so.
    private string registrationClosedReason() const {
        if (linesIn > 0) return "Server closed the connection during registration";
        return "Server closed the connection without replying"
            ~ (config.tls == TLSMode.disabled
                ? " — if this port expects TLS (6697 and 7000 usually do), turn TLS on" : "");
    }

    /// The holder hung up the relay: the IRC server closed its socket.
    /// `transportAlive` cannot tell — vibe-core counts a half-closed (peer
    /// EOF) socket as connected. Non-blocking: data still to read is kept in
    /// the stream's buffer for the next read.
    private bool relayClosed() {
        import vibe.core.net : WaitForDataStatus;
        try return connection.waitForDataEx(0.seconds) == WaitForDataStatus.noMoreData;
        catch (Exception) return true;
    }

    // ── SASL AUTHENTICATE message fragmentation ──────────────────────────────
    //
    // IRC lines are limited to ~512 bytes. SASL base64 payloads exceeding
    // 400 bytes must be split into multiple AUTHENTICATE messages per the
    // IRCv3 SASL spec. Each fragment is exactly 400 bytes (or less for the
    // final piece). If the final fragment is exactly 400 bytes, an empty
    // AUTHENTICATE + is sent as a terminator.

    private string saslMechanismName(SASLMechanism m) const {
        final switch (m) {
            case SASLMechanism.none:        return "none";
            case SASLMechanism.plain:       return "PLAIN";
            case SASLMechanism.external:    return "EXTERNAL";
            case SASLMechanism.scramSha256: return "SCRAM-SHA-256";
        }
    }

    private void sendSaslAuthenticate(string base64Payload) {
        immutable maxFragment = 400;
        if (base64Payload.length <= maxFragment) {
            sendRaw("AUTHENTICATE " ~ base64Payload);
            return;
        }
        size_t offset = 0;
        while (offset < base64Payload.length) {
            auto end = offset + maxFragment < base64Payload.length ? offset + maxFragment : base64Payload.length;
            auto chunk = base64Payload[offset .. end];
            sendRaw("AUTHENTICATE " ~ chunk);
            offset += maxFragment;
        }
        // If the last chunk was exactly maxFragment bytes, the server
        // expects an empty AUTHENTICATE + to signal end of data.
        if (base64Payload.length % maxFragment == 0) {
            sendRaw("AUTHENTICATE +");
        }
    }

    // ── Event processing loop ─────────────────────────────────────────────────

private void processEvents() {
        // Detached for a hot swap: the holder owns the session now and the
        // process is exiting. Never read, write or reconnect from here.
        if (detachedForHotSwap) return;
        import core.atomic : atomicLoad;

        ubyte[] buffer = new ubyte[4096];
        auto lastKeepalive = Clock.currTime.toUnixTime!long;
        auto lastLabelSweep = lastKeepalive;
        auto lastWhoEnrichCheck = lastKeepalive;
        // engine forces a `transportAlive` probe instead of waiting for
        // either the 120 s idle heuristic or the next I/O attempt — this
        // closes the window where a TCP RST has already been received
        // but we haven't tried to read or write yet, leaving the UI
        // showing "connected" for up to 120 s after the server cut us.
        int consecutiveZeroReads = 0;
        enum MAX_ZERO_READS_BEFORE_PROBE = 10;

        while (state == ConnectionState.connected) {
            if (pendingHolderGap.id == holderConnId) recoverHolderGap(pendingHolderGap);
            auto now = Clock.currTime.toUnixTime!long;
            if (!transportAlive) throw new Exception("Connection lost: transport not alive");

            // Proactive disconnect probe: every N consecutive zero-reads
            // (after a successful read earlier), touch the transport to
            // see if the underlying socket is still alive. This used to
            // take up to 120 s idle before the engine noticed a dead
            // connection — now it's bounded by N * PROCESS_READ_TIMEOUT_MS.
            if (consecutiveZeroReads >= MAX_ZERO_READS_BEFORE_PROBE
                && lastDataReceivedSecs > 0) {
                logJsonMap("debug", "connection",
                    "Proactive disconnect probe (no data for %s ms)",
                    [
                        "network": config.name,
                        "idleMs": (now * 1000 - lastDataReceivedSecs * 1000).to!string,
                        "event": "disconnect_probe"
                    ]);
                if (!transportAlive) throw new Exception("Proactive probe: transport not alive");
                consecutiveZeroReads = 0; // reset so we don't spam every iter
            }

            // Non-blocking read (0 s waitForData gate); the outer sleep paces
            // the loop.
            auto received = readFromStream(buffer[]);
            if (received == 0) {
                consecutiveZeroReads++;
                sleep(PROCESS_READ_TIMEOUT_MS.msecs);
            } else {
                consecutiveZeroReads = 0;
                lastDataReceivedSecs = now;
                // Any data receipt proves the connection is alive — reset
                // the PONG timeout too (not just PONG responses). This
                // prevents false disconnects before the first keepalive
                // PING/PONG exchange completes.
                lastPongReceivedSecs = now;
                idleEmitted = false;
                inboundPartial ~= cast(const(char)[]) buffer[0 .. received];
                string line;
                while (true) {
                    const before = inboundPartial.length;
                    if (!popInboundLine(inboundPartial, line)) break;
                    const rawBytes = before - inboundPartial.length;
                    if (line.length > 0) processLine(line, rawBytes);
                    else if (attachBacklogBytes > 0) attachBacklogBytes -= cast(long) rawBytes;
                }
                enforceLineBound(inboundPartial);
                // Own NICK/JOIN/PART/KICK/AWAY/005 changed the session state:
                // refresh the holder META once per read batch (an auto-join
                // burst is one write, not ten).
                if (metaDirty && !ordinaryMetaPublisherRunning && state == ConnectionState.connected)
                    requestMetaPublication();
            }

            // FIBERMLS probes leave on their own 1 s pacing.
            drainFiberProbes();
            // Services: deadlines, then the dedicated paced write queue.
            services.tick();
            drainServicesQueue();
            tickHistoryRecovery();
            if (bncOwnership !is null) bncOwnership.tick(unixMsNow());

            yield();
            // Detach pause: while a hot-swap detach is being prepared, spin
            // here so the snapshot the engine publishes is exact. We check
            // *after* yield() so any pending wake-ups get processed; the
            // count is shared/atomic so reads from the engine thread are
            // well-defined.
            while (atomicLoad(detachPauseCount) > 0) {
                sleep(10.msecs);
            }
            // The detach closed our relay stream and the process is exiting:
            // leave without reconnecting or emitting a disconnect.
            if (detachedForHotSwap) return;
            processOutboundQueue();

            if (now - lastKeepalive >= 30) {
                lagProbeSentMs = unixMsNow();
                sendRaw("PING :" ~ lagPingToken(lagProbeSentMs));
                lastKeepalive = now;
                logJsonMap("debug", "connection",
                    "PING sent",
                    ["network": config.name,
                     "event": "ping_sent"]);
                // Catch-up META write (member-list drift from other users'
                // JOIN/PART/NICK, which do not trigger a write of their own).
                requestMetaPublication();
                noteEgressTrialProbe(lagProbeSentMs);
            }
            // Silent-drop early warning: a LAG probe is outstanding and no
            // PONG (or any data, which also resets the PONG clock) has
            // arrived for 60 s. Info level so prod sees it without a debug
            // restart; throttled to one line per minute per network.
            // Per-probe ping_sent/pong_received traffic stays at debug.
            if (lagProbeSentMs != 0
                && now - lastPongReceivedSecs >= 60
                && now - lastKeepaliveMissedLogSecs >= 60) {
                lastKeepaliveMissedLogSecs = now;
                logJsonMap("info", "connection",
                    "LAG probe unanswered for 60s — peer may be silently dead",
                    ["network": config.name,
                     "host": config.host,
                     "lagMs": lagMs.to!string,
                     "dataAgeSecs": (lastDataReceivedSecs > 0 ? now - lastDataReceivedSecs : -1).to!string,
                     "pongAgeSecs": (now - lastPongReceivedSecs).to!string,
                     "egress": activeEgressLabel.length ? activeEgressLabel : "direct",
                     "event": "keepalive_missed"]);
            }
            // PONG timeout: if no PONG has been received in 120s (2 min),
            // the connection is half-open (server silently died but local
            // socket stays ESTABLISHED). Throw to trigger the auto-reconnect
            // with exponential backoff — same as TCP read failure.
            if (now - lastPongReceivedSecs >= 120) {
                throw new Exception(
                    "PONG timeout — no response for 120s (network: " ~
                    config.name ~ ")");
            }
            // Periodically (every ~30s) drop labels we never got an echo for
            // so a chatty client with a flaky echo path doesn't leak memory.
            if (now - lastLabelSweep >= 30) {
                expireStalePendingLabels(30_000);
                lastLabelSweep = now;
            }

            // Periodic realname enrichment: if we have channels with users
            // but no realnames (e.g. snapshot-loaded state after a restart),
            // trigger WHO to populate them. Rate-limited to 60s per check
            // and 2s per channel via lastWhoTime.
            if (now - lastWhoEnrichCheck >= 60 && !pacer.isArmed()) {
                lastWhoEnrichCheck = now;
                foreach (chan, users; channelUsers) {
                    if (users.length == 0) continue;
                    auto ap = chan in whoEnrichAttempts;
                    const attempts = ap ? *ap : 0;
                    if (!channelNeedsRealnameWho(users, realnames, realnameProbed, attempts))
                        continue;
                    if (chan in lastWhoTime && now - lastWhoTime[chan] < 2) continue;
                    sendRaw(whoLine(chan));
                    lastWhoTime[chan] = now;
                    whoEnrichAttempts[chan] = attempts + 1;
                    // info, not debug: bounded now (at most
                    // MAX_WHO_ENRICH_ATTEMPTS per channel per connection), and
                    // this counter is the production proof the sweep
                    // terminates instead of running once a minute forever.
                    logJsonMap("info", "protocol",
                        "WHO periodic enrichment",
                        ["network": config.name, "channel": chan,
                            "users": users.length.to!string,
                            "attempt": whoEnrichAttempts[chan].to!string,
                            "event": "who_periodic"]);
                }
            }

            // W1-T08: Connection idle detection — after 120s without any
            // incoming data, emit a synthetic "idle" event so the frontend
            // can show a stale-connection indicator.
            if (!idleEmitted && now - lastDataReceivedSecs >= 120) {
                auto idleEvt = IRCRawEvent(config.name, "idle");
                idleEvt.networkId = config.id.toString();
                idleEvt.addTag("since_ms", ((now - lastDataReceivedSecs) * 1000).to!string);
                eventChannel.put(idleEvt);
                idleEmitted = true;
            }
        }
    }

    /// Returns `true` if `text` (the trailing parameter of an IRC event)
    /// looks like a squashed `ERROR :Closing Link: ...` shoved onto a
    /// numeric reply by an IRCd that violated the per-line protocol. We
    /// match two canonical signals: the literal "ERROR" command-name
    /// appearing as a sub-token OR the templated `Closing Link:` prefix
    /// that IRCds use when closing the link.
    ///
    /// The match is intentionally conservative — a stray user saying
    /// "I got an ERROR this morning" is not a server shutdown.
    private static bool looksLikeSquashedError(string text) {
        if (text.length == 0) return false;
        // "Closing Link:" — case-sensitive prefix per RFC 2812 §3.7.2.
        if (text.startsWith("Closing Link:") || text.indexOf(" ERROR ") >= 0) {
            return true;
        }
        return false;
    }

    /// "Mullvad exit Zürich (ip)" / "NordVPN exit Stockholm, Sweden (ip)" /
    /// "the direct host IP (ip)" for the egress of the current connection,
    /// as the ban and SASL-gate copy names it.
    private string egressVia() {
        if (activeRoute == "ipv6") return "native IPv6" ~ (activeLocalIp.length ? " (" ~ activeLocalIp ~ ")" : "");
        return activeEgressLabel.length > 0
            ? egressProviderName(activeEgressLabel) ~ " exit " ~ egressDisplay() ~ (activeEgressIp.length ? " (" ~ activeEgressIp ~ ")" : "")
            : "the direct host IP" ~ (activeLocalIp.length ? " (" ~ activeLocalIp ~ ")" : "");
    }

    /// The egress key of the current connection in the per-host ban and
    /// SASL-gate tables.
    private string activeEgressKey() const {
        return activeEgressLocationId.length > 0 ? activeEgressLocationId : DIRECT_EGRESS_LABEL;
    }

    /// A refusal while registering (465, or ERROR before 001). SASL demands
    /// go first — Libera's account-exempt K-line also says "banned", but only
    /// bans connections that do not log in — then bans, then throttles. May
    /// throw SaslParkedException (applySaslGatePolicy, applyBanPolicy).
    private void applyRegistrationRefusal(string text) {
        lastErrorText = text;
        externalRefusalAtMs = unixMsNow();
        externalRefusalReason = text.length > 2048 ? text[0 .. 2048].idup : text;
        if (maintenanceActive()) return; // record refusal, never rotate frozen affinity
        if (isSaslRequiredRefusal(text)) applySaslGatePolicy(text);
        else if (isBanError(text)) applyBanPolicy(text, true);
        else if (isThrottleError(text)) throttledUntil = Clock.currTime.toUnixTime!long * 1000 + 300_000;
    }

    /// The server refused this connection until it logs in with SASL
    /// (`isSaslRequiredRefusal`).
    ///
    /// Without SASL configured that is a fact about the route: remember it
    /// for the host (hostSaslGateUntil — other networks without SASL then
    /// order the route last) and fail over to a route the host has not gated.
    /// With none left, park and ask for the account: every further attempt
    /// is refused the same way. On 2026-10-26 this loop ran 11 h against
    /// irc.libera.chat, alternating two gated Mullvad exits every 1–60 min
    /// and never reaching a route that could work.
    ///
    /// With SASL configured, a refusal after 903 means the account itself
    /// does not qualify (Libera: no verified email) — park too. One where the
    /// login never completed (services down, `sasl` withdrawn) waits out the
    /// ban window instead, since it can clear on its own.
    private void applySaslGatePolicy(string text) {
        import std.string : toLower;
        const key = activeEgressKey();
        if (config.sasl == SASLMechanism.none) {
            gateEgressForHost(config.host, key);
            logJsonMap("warn", "connection", "Server requires SASL via this egress",
                ["network": config.name, "host": config.host, "egress": key, "message": text,
                 "event": "egress_sasl_gate"]);
            // preferredExit is not a hard pin: try another route only when
            // the complete saved provider order permits that alternative.
            if (hasAllowedAlternative(key, true)) {
                throttledUntil = 0;
                emitLog("info", config.host ~ " only admits SASL logins via " ~ egressVia()
                    ~ " — trying a different route.");
                logJsonMap("warn", "connection", "SASL gate — failing over to another egress",
                    ["network": config.name, "host": config.host, "egress": key, "event": "sasl_gate_failover"]);
                return;
            }
            const msg = saslRequiredMessage();
            parkNetwork(msg, "sasl_required", "sasl_required_parked");
            throw new SaslParkedException(msg);
        }
        if (saslSucceeded) {
            const msg = config.host ~ " accepted the SASL login for \"" ~ config.saslUsername
                ~ "\" but still refused the connection — the account probably needs a verified email "
                ~ "address. Confirm it with the network's NickServ, then Reconnect.";
            parkNetwork(msg, "sasl_required", "sasl_unverified_parked");
            throw new SaslParkedException(msg);
        }
        throttledUntil = Clock.currTime.toUnixTime!long * 1000 + 30 * 60 * 1000;
        emitLog("info", config.host ~ " requires SASL, but the SASL " ~ saslMechanismName(config.sasl)
            ~ " login did not complete on this connection — retrying in 30 minutes.");
        logJsonMap("warn", "connection", "SASL required but login incomplete — 30m backoff",
            ["network": config.name, "host": config.host, "egress": key, "event": "sasl_gate_incomplete"]);
    }

    /// Server banned us (Z/G/K-line, "banned from", ...). Ban the egress
    /// that was in use for this host — the bare host IP counts as an
    /// egress too (DIRECT_EGRESS_LABEL) — then either fail over right
    /// away or wait out the ban window:
    ///   - another route remains (an exit that is healthy and not banned
    ///     for this host, or the direct path) → `throttledUntil = 0` so
    ///     the reconnect loop retries on the normal short backoff and the
    ///     picker, which now skips the banned egress, lands on a
    ///     different IP. This is the whole point of the Mullvad pool: a
    ///     ban on one address must not cost the user 30 minutes. For a
    ///     network without SASL, routes the host SASL-gates do not count.
    ///   - only SASL-gated routes remain, the network has no SASL and
    ///     `mayPark` (registration-time refusals) → park and ask for the
    ///     account (Libera: K-lined direct IP, gated Mullvad exits).
    ///   - nothing else to try (empty pool, everything banned, or the user
    ///     pinned the banned route) → keep the 30-minute window as before.
    /// Every branch tells the user what happened in the _server buffer.
    private void applyBanPolicy(string text, bool mayPark = false) {
        import std.string : toLower;
        // The swap that painted us with a banned address must not be
        // repeated: a fiber session dying while asserting clientIp means
        // that address is unsafe to assert until the ban is long gone
        // (see webircSwapSuppressed). Unconditional: whether the ban hit
        // the asserted address or the socket, re-asserting it next
        // redial walks back into the kill zone either way.
        if (clientIp.length) suppressWebircSwapFor(config.host, clientIp);

        const banKey = activeEgressKey();
        const via = egressVia();
        const hostLower = config.host.toLower();
        const unauthenticated = config.sasl == SASLMechanism.none;
        banEgressForHost(config.host, banKey);
        routingFallbackReason = banKey ~ " [registration ban]: " ~ text;
        logJsonMap("warn", "connection", "Egress host-banned after G/K/Z-line",
            ["network": config.name, "host": config.host, "egress": banKey, "event": "egress_host_ban"]);
        if (hasAllowedAlternative(banKey, unauthenticated)) {
            throttledUntil = 0;
            emitLog("info", "Banned via " ~ via ~ " — retrying through a different exit.");
            logJsonMap("warn", "connection", "Server BAN detected — failing over to another egress",
                ["network": config.name, "message": text, "egress": banKey, "event": "server_ban_failover"]);
        } else if (mayPark && unauthenticated && hostHasSaslGates(hostLower)) {
            emitLog("info", "Banned via " ~ via ~ ", and every other route only admits connections that log in with SASL.");
            const msg = saslRequiredMessage();
            logJsonMap("error", "connection", "Server BAN with only SASL-gated routes left — parking",
                ["network": config.name, "message": text, "egress": banKey, "event": "server_ban_sasl_only"]);
            parkNetwork(msg, "sasl_required", "sasl_required_parked");
            throw new SaslParkedException(msg);
        } else {
            throttledUntil = Clock.currTime.toUnixTime!long * 1000 + 30 * 60 * 1000;
            emitLog("info", "Banned via " ~ via ~ " and no other exit is available"
                ~ " — retrying in 30 minutes.");
            logJsonMap("error", "connection", "Server BAN detected (ZLINE/GLINE) — 30m backoff",
                ["network": config.name, "message": text, "egress": banKey, "event": "server_ban_detected"]);
        }
    }

    /// Common implementation of the `case "ERROR":` body — sets
    /// `lastErrorText`, applies the throttle-detection policy, transitions
    /// the FSM to `disconnecting`, and emits the structured
    /// `event=server_error_detected` log. Used by both the registration-
    /// loop ERROR branch and the post-registration squashed-numeric
    /// detector in `processLine`.
    private void handleServerError(string text) {
        lastErrorText = text;
        if (isBanError(text)) {
            lastDisconnectReason = text;
            emitConnectionFail(text, text);
            applyBanPolicy(text);
        } else if (isThrottleError(text)) {
            throttledUntil = Clock.currTime.toUnixTime!long * 1000 + 300_000; // 5 min
            lastDisconnectReason = text;
            emitConnectionFail(text, text);
            // "Excess Flood" means our send rate model was too optimistic.
            // The client object outlives the reconnect, so tightening here
            // carries over to the new TCP session.
            if (text.toLower().canFind("flood"))
                onFloodComplaint("excess_flood", text);
        } else {
            lastDisconnectReason = text;
            emitConnectionFail(text, text);
        }
        // Emit DISCONNECTED immediately so the frontend sees the
        // state transition even when the caller (processEvents'
        // data loop) exits without throwing (squashed ERROR path).
        // Without this, the old attempt card stays "Connected" while
        // a new reconnect cycle silently opens a second card.
        if (!detachedForHotSwap && !disconnectedEmitted) {
            disconnectedEmitted = true;
            try eventChannel.put(IRCRawEvent.makeDisconnected(
                config.name, config.id.toString(), text));
            catch (Exception) {}
        }
        logJsonMap("error", "connection",
            "Server ERROR detected",
            [
                "network": config.name,
                "message": text,
                "event":   "server_error_detected"
            ]);
        logWarn("Server ERROR for %s: %s", config.name, text);
    }

    /// draft/metadata-2 bookkeeping (user and channel keys) plus
    /// RPL_LOGGEDIN/OUT tracking. Returns true when the line is internal
    /// noise the caller must not publish (our own GET/SUB replies,
    /// rate-limit retries, KEY_NOT_SET).
    private bool handleMetadataLine(ref IRCRawEvent event) {
        auto p = event.getParams();
        static bool isChanTarget(string t) { return t.length && (t[0] == '#' || t[0] == '&'); }
        switch (event.command) {
            case "METADATA":
                // [target, key, visibility, value?]
                if (p.length < 3 || p[0].length == 0) return false;
                applyMetadata(p[0], p[1], p.length > 3 ? p[3] : "");
                // User keys go to the server log, not a channel (same
                // routing as ACCOUNT); channel keys stay in the channel.
                if (!isChanTarget(p[0])) event.channel = "";
                return false;
            case "761":
            case "766": {
                // RPL_KEYVALUE [me, target, key, visibility, value]
                // RPL_KEYNOTSET [me, target, key, text]
                if (p.length < 3) return true;
                const target = p[1] == "*" ? sessionNick : p[1];
                applyMetadata(target, p[2], event.command == "761" && p.length >= 5 ? p[4] : "");
                // A channel reply answers a channel SET (ours or a bouncer
                // client's), so it is published; user-target replies are
                // our own bookkeeping.
                return !isChanTarget(target);
            }
            case "770": // RPL_METADATASUBOK
            case "771": // RPL_METADATAUNSUBOK
            case "772": // RPL_METADATASUBS
                return true;
            case "774": {
                // RPL_METADATASYNCLATER [me, target, retryAfter?]
                if (p.length < 2) return true;
                const target = p[1];
                int secs = 5;
                if (p.length > 2) {
                    try secs = p[2].to!int; catch (Exception) {}
                }
                if (secs < 1) secs = 1;
                if (secs > 60) secs = 60;
                try {
                    runTask({
                        try {
                            sleep(secs.seconds);
                            if (state == ConnectionState.connected)
                                sendRaw("METADATA " ~ target ~ " SYNC");
                        } catch (Exception e) {
                            logWarn("METADATA SYNC retry failed for %s: %s", config.name, e.msg);
                        }
                    });
                } catch (Exception e) {
                    logWarn("METADATA SYNC retry not scheduled for %s: %s", config.name, e.msg);
                }
                return true;
            }
            case "FAIL":
                return p.length >= 2 && p[0] == "METADATA" && p[1] == "KEY_NOT_SET";
            case "900":
                // RPL_LOGGEDIN [me, mask, account, text]
                if (p.length >= 3 && p[2].length) {
                    servicesAccount = p[2];
                    syncPublicAvatar();
                    syncMlsAccountOwner();
                    noteServicesAccount(ServicesAccountState.account);
                }
                return false;
            case "901":
                // RPL_LOGGEDOUT
                forgetPublicAvatar();
                forgetMlsAccountOwner();
                servicesAccount = "";
                noteServicesAccount(ServicesAccountState.none);
                return false;
            default:
                return false;
        }
    }

    /// Stores `value` under `target`'s metadata `key` when the key is one
    /// we render for that target type (USER_ / CHANNEL_METADATA_KEYS) and
    /// the value passes `isValidMetadataValue`; otherwise (cleared,
    /// unknown key, unsafe value) forgets it. Channel targets key
    /// `channelMetadata` lowercase.
    private void applyMetadata(string target, string key, string value) {
        if (target.length == 0 || key.length == 0) return;
        const isChan = target[0] == '#' || target[0] == '&';
        if (!isChan && !identityStillOwned(target)) return;
        const owner = isChan ? target.toLower : identityCacheKey(userMetadata, target);
        auto m = isChan ? &channelMetadata : &userMetadata;
        const known = isChan ? CHANNEL_METADATA_KEYS.canFind(key) : USER_METADATA_KEYS.canFind(key);
        if (known && value.length && isValidMetadataValue(key, value)) {
            if (auto row = owner in *m) (*row)[key] = value;
            else (*m)[owner] = [key: value];
        } else if (auto row = owner in *m) {
            (*row).remove(key);
            if ((*row).length == 0) (*m).remove(owner);
        }
    }

    /// draft/read-marker → `irc:lastseen` bridge. `sel` is
    /// `timestamp=<iso>` or `*` (no marker on the server). A newer server
    /// marker advances the shared field (and every web tab / bouncer
    /// client through the heartbeat echo); a newer stored one is pushed
    /// back so the server converges too. No-op without Redis.
    private void applyMarkRead(string target, string sel) {
        import ircfiber.irc.chathistory : isoTimestampMs, parseIsoTimestampMs;
        if (redis is null || target.length == 0) return;
        try {
            const field = config.id.toString() ~ ":" ~ lastSeenBufferKey(target);
            auto repo = new LastSeenRepository(redis);
            long ms = 0;
            if (sel.startsWith("timestamp=")) ms = parseIsoTimestampMs(sel["timestamp=".length .. $]);
            if (ms > 0) {
                auto changed = repo.merge(ownerId, [field: ms]);
                if (changed.length)
                    redis.publish(RedisKeys.events(ownerId.toString()), heartbeatEchoJson(changed).toString());
            }
            if (ms <= 0 && sel != "*") return;
            const stored = repo.get(ownerId, field);
            if (stored > ms) sendRaw("MARKREAD " ~ target ~ " timestamp=" ~ isoTimestampMs(stored));
        } catch (Exception e) {
            logWarn("MARKREAD bridge failed for %s %s: %s", config.name, target, e.msg);
        }
    }

    /// draft/channel-rename: moves every per-channel fact from `oldChan`
    /// to `newChan`, honouring each map's key form (normalized, raw,
    /// lowercase, `chan\0nick`), and follows the rename in the persisted
    /// autojoin / parted lists.
    private void renameChannelState(string oldChan, string newChan) {
        import std.uni : toLower, sicmp;
        const oldN = normalizeChannelName(oldChan), newN = normalizeChannelName(newChan);
        const oldL = oldChan.toLower, newL = newChan.toLower;
        // normalized
        moveKey(channelState, oldN, newN);
        moveKey(channelTopics, oldN, newN);
        moveKey(channelUsers, oldN, newN);
        moveKey(namesBurst, oldN, newN);
        moveKey(namesBurstAt, oldN, newN);
        moveKey(namesBurstIndex, oldN, newN);
        foreach (ref c; joinsAwaitingConfirm) if (c == oldN) c = newN;
        // raw (366 params) and normalized (sweep) spellings both occur
        foreach (from; [oldChan, oldN]) {
            moveKey(lastWhoTime, from, newN);
            moveKey(whoEnrichAttempts, from, newN);
        }
        // lowercase
        moveKey(chanFloodLimit, oldL, newL);
        moveKey(chanFloodWindow, oldL, newL);
        moveKey(chanFloodExempt, oldL, newL);
        moveKey(chanFloodProbed, oldL, newL);
        moveKey(channelLatestMsgid, oldL, newL);
        moveKey(channelEarliestMsgid, oldL, newL);
        moveKey(channelLatestTs, oldL, newL);
        moveKey(channelEarliestTs, oldL, newL);
        moveKey(channelMetadata, oldL, newL);
        if (sicmp(lastFloodNoticeChannel, oldChan) == 0) lastFloodNoticeChannel = newChan;
        // chan\0nick
        const prefix = oldN ~ "\0";
        string[] flapKeys;
        foreach (key, _; memberFlaps) if (key.startsWith(prefix)) flapKeys ~= key;
        foreach (key; flapKeys) {
            auto f = memberFlaps[key];
            if (f.pending.channel.length && sicmp(f.pending.channel, oldChan) == 0)
                f.pending.channel = newChan;
            memberFlaps.remove(key);
            memberFlaps[newN ~ "\0" ~ key[prefix.length .. $]] = f;
        }
        // persisted lists
        foreach (ref c; config.autoJoinChannels) if (sicmp(c, oldN) == 0) c = newN;
        foreach (ref c; config.partedChannels) if (sicmp(c, oldN) == 0) c = newN;
        markMetaDirty();
    }

    /// Records our effective avatar in the public-avatar registry under our
    /// services account, so IRC Fiber users on networks without
    /// draft/metadata-2 still see it. Never throws.
    void syncPublicAvatar() nothrow {
        if (redis is null || servicesAccount.length == 0) return;
        try {
            const key = RedisKeys.publicAvatars(config.host);
            const field = servicesAccount.toLower;
            const url = config.effectiveAvatarUrl();
            if (url.length) redis.hset(key, field, url);
            else redis.getDb().hdel(key, field);
        } catch (Exception e) {
            try logWarn("Public avatar sync failed for %s: %s", config.name, e.msg);
            catch (Exception) {}
        }
    }

    /// Drops our entry from the public-avatar registry. Never throws.
    void forgetPublicAvatar() nothrow {
        if (redis is null || servicesAccount.length == 0) return;
        try {
            redis.getDb().hdel(RedisKeys.publicAvatars(config.host), servicesAccount.toLower);
        } catch (Exception e) {
            try logWarn("Public avatar removal failed for %s: %s", config.name, e.msg);
            catch (Exception) {}
        }
    }

    /// Mirrors `syncPublicAvatar`, but for E2EE identity resolution: lets
    /// the MLS backend bind a services account seen on ANY network (not
    /// just irc.ircfiber.com) to the ircfiber account that owns this
    /// connection, via `irc:mls:acct:<host>` → owner UUID. Never throws.
    void syncMlsAccountOwner() nothrow {
        if (redis is null || servicesAccount.length == 0 || ownerId == UUID.init) return;
        try {
            redis.hset(RedisKeys.mlsAccountOwners(config.host), servicesAccount.toLower, ownerId.toString());
        } catch (Exception e) {
            try logWarn("MLS account-owner sync failed for %s: %s", config.name, e.msg);
            catch (Exception) {}
        }
    }

    /// Drops our entry from the MLS account-owner registry. Never throws.
    void forgetMlsAccountOwner() nothrow {
        if (redis is null || servicesAccount.length == 0) return;
        try {
            redis.getDb().hdel(RedisKeys.mlsAccountOwners(config.host), servicesAccount.toLower);
        } catch (Exception e) {
            try logWarn("MLS account-owner removal failed for %s: %s", config.name, e.msg);
            catch (Exception) {}
        }
    }

    /// `WHO <chan>`, asking for the WHOX field set (`%tcuhnfar` with our
    /// query type 152 — channel, user, host, nick, flags, account,
    /// realname) when the server advertises WHOX.
    private string whoLine(string chan) {
        if (("WHOX" in isupportMap) !is null) return "WHO " ~ chan ~ " %tcuhnfar,152";
        return "WHO " ~ chan;
    }

    /// Records a WHO line on its way out (see `PendingWho`); any other
    /// line is ignored. `client` marks a WHO a client asked for.
    private void trackWho(string line, bool client) {
        string mask, fields;
        if (!parseWhoLine(line, mask, fields)) return;
        if (pendingWhos.length >= MAX_PENDING_WHOS) pendingWhos = pendingWhos[1 .. $];
        pendingWhos ~= PendingWho(mask, fields, client, Clock.currTime.toUnixTime!long);
    }

    /// The WHO the next 352/354 row answers — the oldest one pending, once
    /// those the server left unanswered past WHO_REPLY_TIMEOUT_SECS are
    /// dropped. False when nothing is pending.
    private bool whoReplyOwner(out PendingWho owner) {
        const now = Clock.currTime.toUnixTime!long;
        size_t i = 0;
        while (i < pendingWhos.length && now - pendingWhos[i].sentAt > WHO_REPLY_TIMEOUT_SECS) i++;
        pendingWhos = pendingWhos[i .. $];
        if (pendingWhos.length == 0) return false;
        owner = pendingWhos[0];
        return true;
    }

    /// Closes the WHO that a 315 for `mask` ends; true when a client sent
    /// it. Older entries were never answered (a server that refused the
    /// WHO with 263 sends no 315), so they are dropped with it.
    private bool closeWho(string mask) {
        const cm = casemapping();
        const key = foldNickMapped(mask, cm);
        foreach (i, w; pendingWhos) {
            if (foldNickMapped(w.mask, cm) != key) continue;
            pendingWhos = pendingWhos[i + 1 .. $];
            return w.client;
        }
        return false;
    }

    /// One WHO (352) or WHOX (354, query type 152) row. Records the
    /// realname, ident, away (`G`/`H`), bot flag and — WHOX only —
    /// services account (`"0"` = logged out, `""` = not reported), and
    /// promotes a BARE roster entry to the prefixed form. Explicit MODE
    /// changes like +v are never overwritten by a WHO answer that may
    /// arrive after the MODE.
    private void applyWhoReply(string chan, string user, string host, string nick,
                               string flags, string realname, string account, bool live) {
        if (!live || !identityStillOwned(nick)) return;
        recordOwnedIdentity(realnameProbed, nick, true);
        if (realname.length > 0 && realname != nick) {
            recordOwnedIdentity(realnames, nick, realname);
            logJsonMap("debug", "protocol",
                "WHO realname captured",
                ["network": config.name, "nick": nick, "realname": realname, "event": "who_realname"]);
        }
        if (user.length > 0) recordOwnedIdentity(idents, nick, user);
        if (flags.length > 0) {
            if (flags[0] == 'G') recordOwnedIdentity(away, nick, away.get(identityCacheKey(away, nick), ""));
            else if (flags[0] == 'H') removeIdentityKey(away, nick);
            const botFlag = isupportMap.get("BOT", "B");
            if (botFlag.length > 0 && flags[1 .. $].indexOf(botFlag) >= 0) recordOwnedIdentity(bots, nick, "1");
            else removeIdentityKey(bots, nick);
        }
        if (account == "0") removeIdentityKey(accounts, nick);
        else if (account.length > 0) recordOwnedIdentity(accounts, nick, account);
        // A WHO row is the server's statement of who `nick` is right now:
        // the roster keeps it so peer discovery has a full identity to
        // check a source against, and for our own confirmed nick (no /nick
        // awaiting its echo) it is the verified prefix.
        if (live && user.length > 0 && host.length > 0) {
            const full = nick ~ "!" ~ user ~ "@" ~ host;
            IrcPrefix row;
            if (parseFullPrefix(full, row)) {
                if (optimisticNickOld.length == 0 && sameNick(nick, sessionNick)) {
                    setOwnPrefix(full);
                    // A WHOX row states our account too ("0" = none).
                    if (account.length) observeOwnAccount(account == "0" ? "" : account);
                }
                if (auto members = normalizeChannelName(chan) in channelUsers)
                    if (rosterHas(normalizeChannelName(chan), nick))
                        *members = upsertRosterEntry(*members, full, casemapping());
            }
        }

        char[5] order = ['~', '&', '@', '%', '+'];
        char chosen = '\0';
        foreach (c; order) {
            if (flags.indexOf(c) >= 0) { chosen = c; break; }
        }
        if (chosen == '\0' || (chan in channelUsers) is null || !rosterHas(chan, nick)) return;
        bool foundBare = false;
        size_t j = 0;
        while (j < channelUsers[chan].length) {
            auto existing = channelUsers[chan][j];
            if (sameNick(existing, nick)) {
                // A run of prefix chars — including the
                // operprefix `*` a multi-prefix NAMES puts
                // first — means the entry already carries
                // the server's own, richer answer. Only a
                // genuinely bare entry gets the single char
                // WHO's flags field can express.
                if (nickPrefixRun(existing) == 0) {
                    // Bare entry — promote it to the
                    // prefixed form from the WHO response.
                    if (!foundBare) {
                        channelUsers[chan][j] = chosen ~ existing;
                        foundBare = true;
                        j++;
                    } else {
                        // Already promoted an entry for this
                        // nick; remove the stale duplicate.
                        channelUsers[chan] = channelUsers[chan][0 .. j]
                            ~ channelUsers[chan][j + 1 .. $];
                    }
                } else if (!foundBare) {
                    // Already has a prefix (set by 353 or
                    // MODE). Keep it, but mark as found so
                    // subsequent bare duplicates get removed.
                    foundBare = true;
                    j++;
                } else {
                    // Duplicate prefixed entry — remove.
                    channelUsers[chan] = channelUsers[chan][0 .. j]
                        ~ channelUsers[chan][j + 1 .. $];
                }
            } else {
                j++;
            }
        }
        // Existing membership is required above: WHO never creates a
        // departed member merely because its delayed reply has a prefix.
    }

    private void processLine(string line, size_t rawBytes = 0) {
        linesIn++;
        // Count original wire bytes, not sanitized UTF-8: replacements can
        // grow a line and must never release the replay fence early.
        lineFromBacklog = attachBacklogBytes > 0;
        if (lineFromBacklog)
            attachBacklogBytes -= cast(long)(rawBytes ? rawBytes : line.length + 2);
        auto event      = parseIRCLine(line);
        event.network   = config.name;
        event.timestampMs = resolveTimestamp(event);
        processEvent(event);
    }

    /// Resolve message destinations once, using this session's CASEMAPPING
    /// and tracked query spelling rather than parser guesses or client case.
    private bool resolveConversation(ref IRCRawEvent event) {
        if (event.command != "PRIVMSG" && event.command != "NOTICE"
            && event.command != "REDACT" && event.command != "TAGMSG")
            return false;
        event.channel = "";
        const params = event.getParams();
        if (params.length == 0 || params[0].length == 0) return true;
        const target = params[0];
        if (channelTypes().indexOf(target[0]) >= 0) {
            event.channel = target;
            return true;
        }
        if (event.nick.length == 0) return true;
        const outgoing = sessionNick.length > 0 && sameNick(event.nick, sessionNick);
        string other = outgoing ? target : event.nick;
        bool tracked;
        foreach (query; queryBuffers) {
            if (!sameNick(query, other)) continue;
            other = query;
            tracked = true;
            break;
        }
        event.channel = other;
        if (event.getTag("ctcp").length) return true;
        if (!tracked) queryBuffers ~= other;
        // Only ordinary messages update query-follow identity evidence.
        // TAGMSG without account-tag is not evidence of a logout.
        if (!outgoing && (event.command == "PRIVMSG" || event.command == "NOTICE")) {
            const key = foldNick(other);
            const account = event.getTag("account");
            if (account.length) queryAccounts[key] = account;
            else queryAccounts.remove(key);
            if (event.hostmask.length) queryHosts[key] = event.hostmask;
        }
        return true;
    }

    /// Everything `processLine` does after parsing. Also re-entered with
    /// the one message a closed `draft/multiline` batch reassembles.
    private void processEvent(IRCRawEvent event) {
        scope (exit) announceServicesInvalidated();
        if (gapReplayUncertain && !lineFromBacklog) gapReplayUncertain = false;
        auto replay = replayContext(event);

        // Reserved FIBERMLS control packets never reach multiline
        // accumulation, query tracking, buffers, history or logs.
        if (interceptFiberMls(event)) return;
        if (services.interceptNative(event, replay.historical, lineFromBacklog)) return;
        if (!replay.historical && !replayQuarantined(event)) rejectAccountRequired(event);

        // Services fences, correlated private replies, engine WHOIS/VERSION
        // probes and private own echoes never reach CTCP handling, buffers,
        // history, persistence or bouncers.
        if (services.intercept(event, fiberHistorical(event))) return;
        // The retained FIFO precedes the loss boundary. Keep complete chat
        // as real history, but never promote its stale state/auth/batch facts
        // into the uncertain current session or reconstruct a partial batch.
        if (gapReplayUncertain && lineFromBacklog) {
            if (event.getTag("batch").length == 0
                    && (event.command == "PRIVMSG" || event.command == "NOTICE"
                        || event.command == "TAGMSG" || event.command == "REDACT")) {
                if (resolveConversation(event)) {
                    replay.historical = true;
                    replay.target = event.channel;
                    processHistoricalEvent(event, replay);
                }
            }
            return;
        }
        const privateResponse = !inMultilineMerge && bncState().observeResponse(event, replay.historical);
        if (handleReplayBatch(event, replay)) return;
        if (privateResponse) return;
        if (replayQuarantined(event)) return;
        if (accumulateReplayMultiline(event)) return;
        if (replay.historical) {
            processHistoricalEvent(event, replay);
            return;
        }
        if (observeMonitorNumeric(event)) return;
        publishBncPresence(event);
        if (replay.label.length && !replay.label.startsWith("bnc-")
            && !replay.label.startsWith("hist-") && !event.getTag("label").length)
            event.addTag("label", replay.label);

        if (event.command == "PING") {
            auto params = event.getParams();
            sendRaw("PONG :" ~ (params.length > 0 ? params[$ - 1] : ""));
            return;
        }

        if (event.command == "PONG") {
            lastPongReceivedSecs = Clock.currTime.toUnixTime!long;
            {
                auto pongParams = event.getParams();
                const sentMs = pongParams.length > 0 ? parseLagPongParam(pongParams[$ - 1]) : -1;
                if (sentMs > 0 && sentMs == lagProbeSentMs) {
                    lagMs = unixMsNow() - sentMs;
                    lagProbeSentMs = 0;
                }
                if (sentMs > 0) completeEgressTrialOnPong(sentMs);
            }
            logJsonMap("debug", "connection",
                "PONG received",
                ["network": config.name,
                 "event": "pong_received"]);
            return; // keepalive reply — don't publish to UI
        }

        // ── Squashed numeric+ERROR detection ────────────────────────────
        // Some IRC servers (SuperNets observed in the wild, June 2026)
        // cram an `ERROR :Closing Link:` onto the same line as the MOTD-end
        // numeric reply: `:server 376 Luis ERROR :Closing Link:`. The
        // parser correctly handles the resulting 376 with that trailing,
        // but the dispatch switch below has no `case "376"` post-registration,
        // so the line silently falls through to `default:` and the
        // ERROR-with-closing-link signal is lost — the connection never
        // transitions to disconnecting and stays open with a dead socket.
        //
        // Detect this pattern by examining the trailing text for canonical
        // ERROR signals ("ERROR" command-name as a sub-token, or "Closing
        // Link:" templated prefix), and re-dispatch as case "ERROR" if so.
        if (looksLikeSquashedError(event.text)) {
            handleServerError(event.text);
            // Continue to also publish the original 376 event for the UI
            // so existing handlers (MIB/366) still get visibility into
            // the channel/topic state.
        }

        if (handleMetadataLine(event)) return;


        string[] quitChannels;
        string[] nickChannels;
        string[] chghostChannels;

        switch (event.command) {

            // ── Channel membership ────────────────────────────────────────────
            case "JOIN":
                auto params = event.getParams();
                if (params.length > 0) {
                    auto chan = normalizeChannelName(params[0]);
                    if (sameNick(event.nick, sessionNick)) {
                        channelState[chan] = "";
                        // Confirmed: the throttle retry must not re-ask.
                        clearPendingJoin(chan);
                        markMetaDirty();
                        // Our own JOIN echo is the one line that reliably
                        // carries the `nick!user@host` other clients see —
                        // 396 RPL_VISIBLEHOST only gives the host. The
                        // payload budget subtracts this prefix, so without
                        // it we have to assume the IRCv3 worst case.
                        if (event.prefix.length > 0
                            && event.prefix.indexOf("!") > 0
                            && event.prefix.indexOf("@") > 0)
                            ownHostmask = event.prefix;
                        // The same echo is server-observed proof of who
                        // this connection is — unless it is replayed
                        // history or a /nick of ours is still unconfirmed.
                        if (!fiberHistorical(event) && optimisticNickOld.length == 0) {
                            IrcPrefix self;
                            if (parseFullPrefix(event.prefix, self)) setOwnPrefix(event.prefix);
                        }
                        // Add our nick to channelUsers immediately so the
                        // current user always appears in the member list,
                        // even if the IRC server omits us from
                        // RPL_NAMREPLY (353). The fold keys on the bare
                        // nick, so this bare echo merges into the
                        // hostmask form 353 already stored instead of
                        // standing beside it as a second member.
                        channelUsers[chan] = upsertRosterEntry(
                            channelUsers.get(chan, null), rosterIdentityOf(event), casemapping());
                        if (chan in namesBurst)
                            upsertNamesMember(chan, rosterIdentityOf(event));
                        bool wasAutoJoin = config.autoJoinChannels.canFind(chan);
                        if (!wasAutoJoin)
                            config.autoJoinChannels ~= chan;
                        auto pi = config.partedChannels.countUntil(chan);
                        if (pi >= 0) config.partedChannels = config.partedChannels.remove(pi);
                        // Request server-side history if available. Goes
                        // through requestChathistory so it uses the spec
                        // wire format and takes the per-channel in-flight
                        // slot the BATCH close releases — the hand-rolled
                        // `sendRaw` here did neither.
                        beginTargetRecovery(chan);
                        drainHistoryQueue();
                        // no-implicit-names: the server sends no 353/366
                        // burst for our JOIN unless asked.
                        if (hasCap("no-implicit-names")) sendRaw("NAMES " ~ chan);
                        // Log our own JOINs at info so the web join at
                        // /irc/Supernets/channel/superbowl is visible in SigNoz.
                        // Fixed: was checking autoJoinChannels *after* appending, so the
                        // second canFind was always true and the log never emitted.
                        logJsonMap("info", "protocol",
                            "JOIN",
                            ["network": config.name,
                             "nick": event.nick,
                             "channel": chan,
                             "event": "join"]);
                    } else if (chan in channelState) {
                        // extended-join: params may be [channel, account, realname]
                        // Fold on the bare nick: a JOIN we see twice (a
                        // netsplit heal re-announcing the channel, or a
                        // JOIN for somebody 353 already named with their
                        // hostmask) must not add a second entry for one
                        // member. This raw append is how `kernelstub` and
                        // `kernelstub!~kernelstub@host` both ended up in
                        // the #tclmafia roster.
                        const wasIn = rosterHas(chan, event.nick);
                        channelUsers[chan] = upsertRosterEntry(
                            channelUsers.get(chan, null), rosterIdentityOf(event), casemapping());
                        if (chan in namesBurst)
                            upsertNamesMember(chan, rosterIdentityOf(event));
                        // IRCv3 extended-join: extract account name from params[1]
                        // ("*" means not logged in; empty string means not provided).
                        if (params.length >= 3) {
                          const acct = params[1];
                          if (acct == "*") removeIdentityKey(accounts, event.nick);
                          else if (acct.length > 0) recordOwnedIdentity(accounts, event.nick, acct);
                          const rn = params[2];
                          // The realname param was supplied, so the question
                          // is answered even when it equals the nick.
                          if (event.nick.length > 0)
                            recordOwnedIdentity(realnameProbed, event.nick, true);
                          if (rn.length > 0 && rn != event.nick)
                            recordOwnedIdentity(realnames, event.nick, rn);
                        }
                        // Extract ident from the event prefix (nick!user@host)
                        if (event.prefix.length > 0) {
                            auto bang = event.prefix.indexOf("!");
                            if (bang > 0) {
                                auto userAt = event.prefix[bang+1 .. $];
                                auto at = userAt.indexOf("@");
                                if (at > 0)
                                    recordOwnedIdentity(idents, event.nick, userAt[0 .. at]);
                            }
                        }
                        // Flap guard (see `MemberFlap`): the roster and the
                        // identity above are current either way; a held
                        // JOIN publishes nothing and skips the WHOIS.
                        if (auto f = holdMembership(chan, event.nick, wasIn, true)) {
                            f.pending = event;
                            return;
                        }
                        // Fallback: send WHOIS to discover the realname when
                        // extended-join didn't carry it (the older spec
                        // doesn't include realname in JOIN, or the cap is
                        // unavailable). 311/354 will populate realnames[].
                        // Rate-limit to 1/s so a 2000-user channel burst on
                        // SuperNets doesn't flood the server log with 354
                        // WHOX responses.
                        if (memberNeedsRealname(event.nick, realnames, realnameProbed)) {
                            import std.datetime : Clock;
                            const whoisNow = Clock.currTime.toUnixTime!long;
                            if (whoisNow - lastWhoisTime >= 1) {
                                sendRaw("WHOIS " ~ event.nick);
                                lastWhoisTime = whoisNow;
                            }
                        }
                        logJsonMap("debug", "protocol",
                            "JOIN",
                            ["network": config.name,
                             "nick": event.nick,
                             "channel": chan,
                             "event": "join"]);
                    }
                }
                break;

            case "PART":
                auto params = event.getParams();
                if (params.length > 0) {
                    auto chan = normalizeChannelName(params[0]);
                    if (sameNick(event.nick, sessionNick)) {
                        forgetMemberFlaps(chan);
                        channelState.remove(chan);
                        markMetaDirty();
                        channelUsers.remove(chan);
                        namesBurst.remove(chan);
                        namesBurstAt.remove(chan);
                        namesBurstIndex.remove(chan);
                        resetNamesIdentIndex();
                        pruneUnownedIdentities();
                        channelTopics.remove(chan);
                        channelMetadata.remove(chan.toLower);
                        auto i = config.autoJoinChannels.countUntil(chan);
                        if (i >= 0) config.autoJoinChannels = config.autoJoinChannels.remove(i);
                        if (!config.partedChannels.canFind(chan))
                            config.partedChannels ~= chan;
                    } else {
                        const wasIn = rosterHas(chan, event.nick);
                        removeFromUsers(chan, event.nick);
                        clearUnownedIdentity(event.nick);
                        if (auto f = holdMembership(chan, event.nick, wasIn, false)) {
                            f.pending = event; // flap guard, as for JOIN
                            return;
                        }
                    }
                    logJsonMap("debug", "protocol",
                        "PART",
                        ["network": config.name,
                         "nick": event.nick,
                         "channel": chan,
                         "reason": event.text,
                         "event": "part"]);
                }
                break;

            case "KICK":
                auto params = event.getParams();
                if (params.length >= 2) {
                    auto chan       = normalizeChannelName(params[0]);
                    auto targetNick = params[1];
                    if (sameNick(targetNick, sessionNick)) {
                        forgetMemberFlaps(chan);
                        channelState.remove(chan);
                        markMetaDirty();
                        channelUsers.remove(chan);
                        namesBurst.remove(chan);
                        namesBurstAt.remove(chan);
                        namesBurstIndex.remove(chan);
                        resetNamesIdentIndex();
                        pruneUnownedIdentities();
                        channelTopics.remove(chan);
                        channelMetadata.remove(chan.toLower);
                        auto i = config.autoJoinChannels.countUntil(chan);
                        if (i >= 0) config.autoJoinChannels = config.autoJoinChannels.remove(i);
                        if (!config.partedChannels.canFind(chan))
                            config.partedChannels ~= chan;
                    } else {
                        removeFromUsers(chan, targetNick);
                        clearUnownedIdentity(targetNick);
                        // A kick is an operator's act, never the member's
                        // flapping: always relayed, and it supersedes
                        // whatever the flap guard was holding for them.
                        if (auto f = memberKey(chan, targetNick) in memberFlaps) {
                            f.published = false;
                            f.holdSinceMs = 0;
                            f.pending = IRCRawEvent.init;
                        }
                    }
                    logJsonMap("info", "protocol",
                        "KICK",
                        ["network": config.name,
                         "channel": chan,
                         "kicker": event.nick,
                         "target": targetNick,
                         "reason": event.text,
                         "event": "kick"]);
                }
                break;

            case "QUIT":
                // The roster loses the nick everywhere; the flap guard (see
                // `MemberFlap`) decides per channel whether that row is
                // published now or held. Our own QUIT is never gated.
                const selfQuit = sameNick(event.nick, sessionNick);
                bool quitInAny;
                foreach (chan, ref users; channelUsers) {
                    foreach (i, u; users) {
                        if (sameNick(u, event.nick)) {
                            for (size_t j = users.length; j > 0; --j)
                                if (sameNick(users[j - 1], event.nick)) users = users.remove(j - 1);
                            quitInAny = true;
                            auto f = selfQuit ? null : holdMembership(chan, event.nick, true, false);
                            if (f is null) {
                                quitChannels ~= chan;
                            } else {
                                f.pending = event;
                                f.pending.channel = chan;
                                f.pending.id = randomUUID().toString();
                            }
                            break;
                        }
                    }
                }
                foreach (ref users; namesBurst.byValue)
                    for (size_t i = users.length; i > 0; --i)
                        if (sameNick(users[i - 1], event.nick)) users = users.remove(i - 1);
                namesBurstIndex = null;
                // QUIT ends this occupant even when its conversation stays open.
                // DM follow evidence belongs to the conversation, not these maps.
                clearIdentity(event.nick);
                // Skip logging our own QUITs when we're about to reconnect
                // (it just adds noise during reconnect storms).
                if (event.nick != sessionNick) {
                    logJsonMap("debug", "protocol",
                        "QUIT",
                        ["network": config.name,
                         "nick": event.nick,
                         "reason": event.text,
                         "event": "quit"]);
                }
                // The channel-less line goes out with the relayed channel
                // rows; when every one is held, so is it. A nick in no
                // tracked channel has nothing to hold, but its repeats still
                // count against the budget.
                if (!selfQuit && (quitInAny ? quitChannels.length == 0
                                            : holdMembership("", event.nick, false, false) !is null))
                    return;
                break;

                        case "ERROR":
                            handleServerError(event.text);
                            break;

                        case "465": // ERR_YOUREBANNEDCREEP — treat as host-ban like ERROR
                            handleServerError(event.text);
                            break;

            case "305": // RPL_UNAWAY — no longer away
                isAway = false;
                awayMessage = "";
                markMetaDirty();
                break;

            case "306": // RPL_NOWAWAY — marked as away
                // Keep our own text: the server's "You have been marked as
                // being away" is not the message, and the reconnect re-send
                // (pre-away / post-registration) needs the real one.
                isAway = true;
                markMetaDirty();
                break;

            case "335": { // RPL_WHOISBOT — `335 <me> <nick> :is a bot`
                auto bp = event.getParams();
                if (bp.length >= 2 && bp[1].length > 0) recordIdentity(bots, bp[1], "1");
                break; // still part of the WHOIS output
            }

            case "421": { // ERR_UNKNOWNCOMMAND — or a JOIN throttle wearing its clothes
                auto ps = event.getParams();
                // `421 <nick> JOIN :You must be connected for at least 5 seconds…`
                const rejected = ps.length > 1 ? ps[1] : "";
                import std.uni : icmp;
                if (rejected.length == 4 && icmp(rejected, "JOIN") == 0) {
                    const window = parseJoinThrottleSeconds(event.text);
                    if (window > 0) scheduleJoinThrottleRetry(window);
                }
                break;
            }

            case "403": // ERR_NOSUCHCHANNEL
            case "471": // ERR_CHANNELISFULL
            case "473": // ERR_INVITEONLYCHAN
            case "474": // ERR_BANNEDFROMCHAN
            case "475": // ERR_BADCHANNELKEY
            case "477": // ERR_NOCHANMODES / registration required
            case "489": { // ERR_SECUREONLYCHAN
                // Permanent refusal invalidates observed membership, not
                // configured autojoin/parted intent. No throttle retry may
                // keep asking for this channel after it was rejected.
                auto ps = event.getParams();
                bool validChannel = ps.length > 1 && ps[1].length > 0
                    && channelTypes().indexOf(ps[1][0]) >= 0;
                if (validChannel)
                    foreach (c; ps[1])
                        if (c <= ' ' || c == ',' || c == ':' || c == 0x7F) {
                            validChannel = false;
                            break;
                        }
                if (validChannel) {
                    auto chan = gapNamesChannelKey(normalizeChannelName(ps[1]));
                    clearPendingJoin(chan);
                    forgetMemberFlaps(chan);
                    channelState.remove(chan);
                    channelUsers.remove(chan);
                    namesBurst.remove(chan);
                    namesBurstAt.remove(chan);
                    namesBurstIndex.remove(chan);
                    resetNamesIdentIndex();
                    gapNamesPending.remove(chan);
                    channelTopics.remove(chan);
                    channelMetadata.remove(chan.toLower);
                    pruneUnownedIdentities();
                    markMetaDirty();
                }
                break;
            }

            // SuperNets' channel-targeted flood warning rides numeric 405
            // (ERR_TOOMANYCHANNELS is its RFC meaning, but this ircd reuses
            // it for ":<server> 405 <nick> <channel> :<flood text>", e.g.
            // the colourised "slow down nerd" — see the unittests below).
            // isFloodNotice(event.text) tells the two cases apart, narrow
            // enough that a real ERR_TOOMANYCHANNELS ("You have joined too
            // many channels") on another network is never mistaken for a
            // flood signal:
            //   - flood match: NOT a real refusal — the channel stays in
            //     joinsAwaitingConfirm and gets the same bounded
            //     throttle-retry as 421, instead of being abandoned.
            //     Prod incident 2026-11-02: the previous unconditional
            //     clearPendingJoin lost 1 of 9 SuperNets auto-join
            //     channels (#superbowl) to exactly this with no retry.
            //   - no match: a genuine refusal, cleared like 403/471/.../489
            //     above — waiting will not fix it.
            case "405": {
                auto ps = event.getParams();
                const channelName = ps.length > 1 ? ps[1] : "";
                if (isFloodNotice(event.text)) {
                    onFloodComplaint("405", event.text);
                    scheduleFloodJoinRetry();
                } else if (channelName.length > 0) {
                    clearPendingJoin(channelName);
                }
                break;
            }
            case "433": // ERR_NICKNAMEINUSE
            case "432": // ERR_ERRONEUSNICKNAME
                // Post-registration nick change rejected. The user sent /nick
                // via sendRaw which optimistically updated sessionNick. When the
                // server rejects it, revert sessionNick and notify the user.
                if (optimisticNickOld.length > 0) {
                    logInfo("Nick change rejected (cmd=%s): reverting '%s' → '%s' for %s",
                        event.command, sessionNick, optimisticNickOld, config.name);
                    const oldNick = optimisticNickOld;
                    sessionNick = oldNick;
                    optimisticNickOld = "";
                    persistNick(sessionNick);
                    auto notice = IRCRawEvent.makeServerLog(config.name, config.id.toString(),
                        "notice", "Nick change to '" ~ event.text ~ "' rejected — reverting to '" ~ sessionNick ~ "'");
                    eventChannel.put(notice);

                    // Mirror the 433/432 numeric to the frontend as a
                    // synthetic event so the client can revert its
                    // optimistic currentNick and clear pendingSelfNickChange.
                    // Without this signal, the UI keeps the rejected nick
                    // until the next page reload — when the sync
                    // populates currentNick from the engine snapshot, the
                    // user sees their pre-change nick "return" and
                    // concludes the change never happened.
                    auto revertEvt = IRCRawEvent(config.name, event.command);
                    revertEvt.networkId = config.id.toString();
                    revertEvt.text = oldNick;
                    revertEvt.paramsJson = `["` ~ oldNick ~ `"]`;
                    eventChannel.put(revertEvt);
                }
                break;

            case "NICK":
                auto params = event.getParams();
                if (params.length > 0) {
                    const newNick = params[$ - 1];
                    // Capture account/DM proof before moving any cache key.
                    string renamerAccount = event.getTag("account");
                    if (renamerAccount.length == 0)
                        if (auto p = identityCacheKey(accounts, event.nick) in accounts)
                            if (*p != "*") renamerAccount = *p;
                    const oldQueryKey = foldNick(event.nick);
                    const followsQuery = dmFollowsNick(queryAccounts.get(oldQueryKey, ""),
                        queryHosts.get(oldQueryKey, ""), renamerAccount, event.hostmask);
                    flushMemberFlaps(event.nick);
                    // The renamer's user@host as the server states it now;
                    // without a full prefix each entry keeps what it held.
                    IrcPrefix renamerId;
                    const renamerSuffix = parseFullPrefix(event.prefix, renamerId)
                        ? "!" ~ renamerId.user ~ "@" ~ renamerId.host : "";
                    foreach (chan, ref users; channelUsers) {
                        // Mutate EVERY entry that matches the old nick. The
                        // same user can appear twice in channelUsers — once
                        // as a bare entry (from JOIN), once with the host
                        // attached (from 353 with userhost-in-names, or
                        // WHO). Without this, a NICK change leaves the
                        // host-bearing entry stale and the channel roster
                        // ends up showing both the old and the new nick.
                        foreach (i, ref u; users) {
                            if (sameNick(u, event.nick)) {
                                if (!canFind(nickChannels, chan))
                                    nickChannels ~= chan;
                                u = nickPrefix(u) ~ newNick
                                  ~ (renamerSuffix.length ? renamerSuffix : rosterHostSuffix(u));
                                // Don't break — keep mutating duplicates.
                            }
                        }
                    }
                    foreach (ref users; namesBurst.byValue)
                        foreach (ref user; users)
                            if (sameNick(user, event.nick))
                                user = nickPrefix(user) ~ newNick
                                    ~ (renamerSuffix.length ? renamerSuffix : rosterHostSuffix(user));
                    namesBurstIndex = null;
                    moveIdentityKey(realnames, event.nick, newNick);
                    moveIdentityKey(realnameProbed, event.nick, newNick);
                    moveIdentityKey(idents, event.nick, newNick);
                    moveIdentityKey(accounts, event.nick, newNick);
                    moveIdentityKey(away, event.nick, newNick);
                    moveIdentityKey(bots, event.nick, newNick);
                    moveIdentityKey(userMetadata, event.nick, newNick);
                    // Two paths for detecting this is OUR nick change:
                    // 1. Server-initiated — event.nick (old nick) matches
                    //    current sessionNick and we never asked for it: a
                    //    services enforcement (`Guest12345` / UID when a
                    //    registered nick goes unidentified), an oper SANICK,
                    //    a collision. Track it, but do NOT persist it: the
                    //    persisted nick is "what the user last chose", and a
                    //    forced rename is exactly what the next reconnect
                    //    must undo. Persisting it made a Guest nick sticky —
                    //    the reconnect requested `Guest12345`, collided with
                    //    its own still-quitting session, and fell into the
                    //    random-suffix escape hatch (Sep 17 2026, 36 users).
                    // 2. Optimistic — user sent /nick via sendRaw which already
                    //    updated sessionNick. The old nick before the update is
                    //    tracked in optimisticNickOld. We match against that;
                    //    this is the only self-rename worth remembering.
                    bool isSelf = false;
                    if (sameNick(event.nick, sessionNick)) {
                        isSelf = true;
                        sessionNick = newNick;
                        markMetaDirty();
                        // Keep the first nick taken from us: a later forced
                        // rename (Guest → UID) must not overwrite it.
                        if (forcedFromNick.length == 0) forcedFromNick = event.nick;
                        logJsonMap("info", "connection",
                            "Server-initiated self nick change — not persisting",
                            ["network": config.name,
                             "oldNick": event.nick,
                             "newNick": newNick,
                             "event":   "forced_nick_change"]);
                    } else if (optimisticNickOld.length > 0 && sameNick(event.nick, optimisticNickOld)) {
                        isSelf = true;
                        sessionNick = newNick;
                        markMetaDirty();
                        optimisticNickOld = "";
                        forcedFromNick = "";
                        persistNick(sessionNick);
                    }
                    // Identity proof follows only a live rename the server
                    // states for the exact identity we hold; any other
                    // rename touching us drops the proof until a WHO
                    // restates it. `isSelf` alone is not proof: it keys on
                    // the possibly optimistic `sessionNick`.
                    {
                        IrcPrefix held;
                        const haveHeld = parseFullPrefix(ownPrefix, held);
                        if (haveHeld && renamerSuffix.length && !fiberHistorical(event)
                            && sameIdentity(renamerId, held, casemapping())) {
                            setOwnPrefix(newNick ~ "!" ~ held.user ~ "@" ~ held.host);
                        } else if (isSelf
                                   || (haveHeld && nicksEqualMapped(event.nick, held.nick, casemapping()))) {
                            clearOwnPrefix();
                            requestSelfWho();
                        }
                    }
                    // IRCCloud-style you_nickchange: emit a dedicated message
                    // type for self-nick changes so the frontend can update
                    // currentNick AND all channel member lists from a single
                    // authoritative event, without relying on per-channel NICK
                    // fan-out (which the per-channel broadcast below also does,
                    // but as redundant events that the frontend can ignore for
                    // self-update purposes).
                    // IRCCloud-style you_nickchange: emit a dedicated message
                    // type for self-nick changes so the frontend gets a single
                    // authoritative event that carries [oldNick, newNick] params.
                    // The frontend handler updates currentNick AND ALL channel
                    // member lists immediately, mimicking IRCCloud's realtime
                    // event-driven member list architecture.
                    if (isSelf) {
                        // The base (channel-less) NICK event is published for EVERY user's
                        // rename and lands in the frontend's `_server` buffer. Stamp our own so
                        // the server log can word it in the first person without guessing from
                        // the live nick (the roster has already moved to `newNick` by then).
                        event.addTag("self_echo", "true");
                        auto youChange = IRCRawEvent(config.name, "you_nickchange");
                        youChange.networkId = config.id.toString();
                        youChange.nick = event.nick;
                        youChange.text = newNick;
                        youChange.setParams([event.nick, newNick]);
                        eventChannel.put(youChange);
                    } else {
                        // Query-partner NICK following (IRCCloud rename
                        // model), for the same person only: a nick is no
                        // identity. A stranger who held a DM partner's old
                        // nick for seconds and renamed away used to drag
                        // the whole conversation onto their nick chain.
                        // On a match, keep the tracked counterparty on the
                        // new nick so sync + future echoes use it, and tag
                        // the event `query_follow`: the event processor
                        // then moves the stored history and the frontend
                        // renames its buffer. If the new nick is already
                        // tracked separately, drop the stale entry instead
                        // of merging — never destroy history.
                        const oldKey = foldNick(event.nick);
                        if (followsQuery) {
                            ptrdiff_t oldIdx = -1, newIdx = -1;
                            foreach (i, q; queryBuffers) {
                                if (oldIdx < 0 && sameNick(q, event.nick)) oldIdx = i;
                                if (newIdx < 0 && sameNick(q, newNick)) newIdx = i;
                            }
                            if (oldIdx >= 0 && newIdx < 0) {
                                queryBuffers[oldIdx] = newNick;
                                event.addTag("query_follow", "true");
                            } else if (oldIdx >= 0 && newIdx >= 0 && newIdx != oldIdx) {
                                queryBuffers[oldIdx] = queryBuffers[$ - 1];
                                queryBuffers.length--;
                            }
                            const newKey = foldNick(newNick);
                            if (newKey != oldKey) {
                                if (auto a = oldKey in queryAccounts) {
                                    queryAccounts[newKey] = *a;
                                    queryAccounts.remove(oldKey);
                                }
                                if (auto h = oldKey in queryHosts) {
                                    queryHosts[newKey] = *h;
                                    queryHosts.remove(oldKey);
                                }
                            }
                        }
                    }
                    clearUnownedIdentity(newNick);
                    logJsonMap("info", "protocol",
                        "NICK",
                        ["network": config.name,
                         "oldNick": event.nick,
                         "newNick": newNick,
                         "event": "nick_change"]);
                }
                break;

            case "CHGHOST":
                foreach (chan, ref users; channelUsers) {
                    foreach (u; users) {
                        if (sameNick(stripNickPrefix(u), event.nick)) {
                            chghostChannels ~= chan;
                            break;
                        }
                    }
                }
                // Every roster copy of the nick takes the new user@host, and
                // so does our own hostmask (it drives the payload budget).
                {
                    auto hp = event.getParams();
                    if (hp.length >= 2 && event.nick.length > 0) {
                        foreach (chan, ref users; channelUsers)
                            foreach (i, ref u; users)
                                if (sameNick(stripNickPrefix(u), event.nick))
                                    u = nickPrefix(u) ~ event.nick ~ "!" ~ hp[0] ~ "@" ~ hp[1];
                        recordIdentity(idents, event.nick, hp[0]);
                        if (sameNick(event.nick, sessionNick))
                            ownHostmask = event.nick ~ "!" ~ hp[0] ~ "@" ~ hp[1];
                        // Proof moves only when the server restates the
                        // exact identity we hold; a CHGHOST for our nick
                        // from any other identity drops it until a WHO.
                        IrcPrefix held, changer, moved;
                        const haveHeld = parseFullPrefix(ownPrefix, held);
                        if (haveHeld && !fiberHistorical(event)
                            && parseFullPrefix(event.prefix, changer)
                            && sameIdentity(changer, held, casemapping())
                            && parseFullPrefix(held.nick ~ "!" ~ hp[0] ~ "@" ~ hp[1], moved)) {
                            setOwnPrefix(held.nick ~ "!" ~ hp[0] ~ "@" ~ hp[1]);
                        } else if (sameNick(event.nick, sessionNick)
                                   || (haveHeld && nicksEqualMapped(event.nick, held.nick, casemapping()))) {
                            clearOwnPrefix();
                            requestSelfWho();
                        }
                    }
                    // A DM counterparty with a new user@host is still them.
                    const key = foldNick(event.nick);
                    if (hp.length >= 2 && (key in queryHosts) !is null)
                        queryHosts[key] = hp[0] ~ "@" ~ hp[1];
                }
                break;

            // ── Topics ────────────────────────────────────────────────────────
            case "TOPIC":
                auto params = event.getParams();
                if (params.length >= 1) {
                    // An empty trailing ("TOPIC #c :") clears the topic; the
                    // parser drops it, leaving only the channel param.
                    auto chan  = normalizeChannelName(params[0]);
                    auto topic = params.length >= 2 ? params[$ - 1] : "";
                    channelTopics[chan] = topic;
                    logJsonMap("info", "protocol",
                        "TOPIC",
                        ["network": config.name,
                         "channel": chan,
                         "topic": topic,
                         "by": event.nick,
                         "event": "topic_change"]);
                }
                break;

            case "332":
                // RPL_TOPIC: ":server 332 <nick> <channel> :<topic>" → params = [nick, channel, topic]
                auto params = event.getParams();
                if (params.length >= 3) {
                    channelTopics[normalizeChannelName(params[1])] = params[$ - 1];
                    logJsonMap("debug", "protocol",
                        "TOPIC (332)",
                        ["network": config.name,
                         "channel": params[1],
                         "topic": params[$ - 1],
                         "event": "topic_change"]);
                }
                break;

            // ── NAMES list ────────────────────────────────────────────────────
            case "353":
                auto params = event.getParams();
                if (params.length >= 3) {
                    auto chan = gapNamesChannelKey(normalizeChannelName(params[2]));
                    auto nicks = params[$ - 1].split(" ");
                    // Accumulate into the pending burst instead of the
                    // live roster: 353 used to append straight into
                    // channelUsers, which made NAMES additive-only — a
                    // rejoin, a reconnect or an explicit resync could add
                    // members but never drop one, so anybody who left
                    // unseen stayed in the list for the life of the
                    // connection. The 366 below installs the burst.
                    bool replacedNamesBurst;
                    {
                        import std.datetime : Clock;
                        const burstNow = Clock.currTime.toUnixTime!long;
                        auto lastLineAt = chan in namesBurstAt;
                        if (chan !in namesBurst || lastLineAt is null
                            || burstNow - *lastLineAt > NAMES_BURST_STALE_SECS) {
                            replacedNamesBurst = (chan in namesBurst) !is null;
                            namesBurst[chan] = null;
                            namesBurstIndex.remove(chan);
                            resetNamesIdentIndex();
                        }
                        // Stamped per LINE, not per burst: a channel big
                        // enough to have its NAMES paced over minutes must
                        // not have the burst reset out from under its own
                        // tail, which would install half a roster.
                        namesBurstAt[chan] = burstNow;
                    }
                    foreach (n; nicks) {
                        if (n.length == 0) continue;
                        // userhost-in-names format: [mode]nick!user@host
                        // Store the full string (as-is) for the frontend,
                        // but extract ident at the engine level too.
                        upsertNamesMember(chan, n);
                        auto bare = stripNickPrefix(n);
                        const suffix = rosterHostSuffix(n);
                        if (suffix.length) {
                            auto userAt = suffix[1 .. $];
                            auto at = userAt.indexOf("@");
                            if (at > 0 && bare.length > 0)
                                recordNamesIdent(bare, userAt[0 .. at]);
                        }
                    }
                    if (replacedNamesBurst) pruneUnownedIdentities();
                    logJsonMap("info", "protocol",
                        "NAMES (353)",
                        ["network": config.name,
                         "channel": chan,
                         "count": nicks.length.to!string,
                         "burstUsers": namesBurst[chan].length.to!string,
                         "totalUsers": channelUsers.get(chan, null).length.to!string,
                         "realnames": realnames.length.to!string,
                         "event": "numeric"]);
                    // If we have many users but no realnames, trigger WHO to populate them.
                    // This handles the initial NAMES burst where 366 may be delayed or missed.
                    // Reads the burst, which is the fresher view of the
                    // channel while one is open.
                    {
                        import std.datetime : Clock;
                        const whoNow = Clock.currTime.toUnixTime!long;
                        auto ap = chan in whoEnrichAttempts;
                        const attempts = ap ? *ap : 0;
                        // Cache negatives: already-enriched members must not
                        // cause a full growing-roster scan after every line.
                        // Recheck positives before sending because WHO may
                        // have filled the missing probes since the last line.
                        if (namesBurstIndex[chan].needsWho
                            && namesBurst[chan].length > 5
                            && (chan !in lastWhoTime || whoNow - lastWhoTime[chan] >= 2)
                            && !pacer.isArmed()) {
                            namesBurstIndex[chan].needsWho = channelNeedsRealnameWho(
                                namesBurst[chan], realnames, realnameProbed, attempts);
                            if (namesBurstIndex[chan].needsWho) {
                                sendRaw(whoLine(chan));
                                lastWhoTime[chan] = whoNow;
                                whoEnrichAttempts[chan] = attempts + 1;
                                logJsonMap("info", "protocol",
                                    "WHO after NAMES(353) to populate realnames",
                                    ["network": config.name, "channel": chan, "event": "who_after_names_353"]);
                            }
                        }
                    }
                }
                break;
            // ── End of NAMES (RPL_ENDOFNAMES, 366) — trigger WHO to enrich ──
            // After NAMES we have the full member list but no realnames yet
            // (realnames only arrive via extended-join JOIN or WHOIS 311).
            // Issue a WHO to populate both mode prefixes (for any bare
            // entries that still need promotion) and realnames (via our
            // enhanced 352 handler). Rate-limited to 2s per channel to avoid
            // flooding on netsplits or repeated NAMES bursts.
            case "366": {
                auto params = event.getParams();
                logJsonMap("info", "protocol",
                    "366 received",
                    ["network": config.name, "channel": params.length>=2?params[1]:"?", "event": "rpl_endofnames"]);
                if (params.length >= 2) {
                    auto chan = gapNamesChannelKey(normalizeChannelName(params[1]));
                    const recoveringGap = (chan in gapNamesPending) !is null;
                    const wasJoined = (chan in channelState) !is null;
                    // A holder gap may have hidden our NICK; use the
                    // server's current recipient before testing self.
                    if (recoveringGap && params[0].length && params[0] != "*")
                        sessionNick = params[0];
                    bool containsSelf;
                    if (auto burst = chan in namesBurst) {
                        // Public NAMES is available outside a channel.
                        // Only the completed burst, never the retained
                        // roster, can prove unknown/gap membership.
                        foreach (member; *burst)
                            if (sameNick(stripNickPrefix(member), sessionNick)) {
                                containsSelf = true;
                                break;
                            }
                        if ((wasJoined && !recoveringGap) || containsSelf) {
                            auto held = channelUsers.get(chan, null);
                            auto rebased = applyNamesBurst(held, *burst, casemapping());
                            if (rebased.length != held.length)
                                logJsonMap("info", "protocol",
                                    "NAMES re-baselined the channel roster",
                                    ["network": config.name, "channel": chan,
                                     "was": held.length.to!string,
                                     "now": rebased.length.to!string,
                                     "event": "roster_rebased"]);
                            channelUsers[chan] = rebased;
                            if (!wasJoined || recoveringGap) {
                                channelState[chan] = "";
                                clearPendingJoin(chan);
                                if (!recoveringGap) {
                                    // Recover a dropped self-JOIN only once
                                    // a complete NAMES proves we are there.
                                    auto pi = config.partedChannels.countUntil(chan);
                                    if (!config.autoJoinChannels.canFind(chan) && pi >= 0) {
                                        config.partedChannels = config.partedChannels.remove(pi);
                                        config.autoJoinChannels ~= chan;
                                    }
                                    logJsonMap("warn", "connection",
                                        "channelState drift: adopted channel from completed NAMES",
                                        ["network": config.name,
                                         "channel": chan,
                                         "reason": "join-echo-dropped-but-names-arrived",
                                         "event": "channelstate_self_heal"]);
                                }
                            }
                        }
                    }
                    // A confirmed self-JOIN is stronger than an omission
                    // from NAMES, except while holder-gap proof is pending.
                    if ((!wasJoined || recoveringGap) && !containsSelf) {
                        channelState.remove(chan);
                        channelUsers.remove(chan);
                    }
                    namesBurst.remove(chan);
                    namesBurstAt.remove(chan);
                    namesBurstIndex.remove(chan);
                    if (!namesBurst.length) resetNamesIdentIndex();
                    gapNamesPending.remove(chan);
                    pruneUnownedIdentities();
                    markMetaDirty();
                    // Our own prefix is now known for this channel, so we
                    // can tell whether `+f` even applies to us, and ask the
                    // server what its effective limit actually is.
                    refreshFloodExemption(chan);
                    probeChannelFlood(chan);
                    import std.datetime : Clock;
                    const whoNow = Clock.currTime.toUnixTime!long;
                    if (chan in channelUsers) {
                        auto ap = chan in whoEnrichAttempts;
                        const attempts = ap ? *ap : 0;
                        const needsWho = channelNeedsRealnameWho(
                            channelUsers[chan], realnames, realnameProbed, attempts);
                        logJsonMap("info", "protocol",
                            "366 needsWho check",
                            ["network": config.name, "channel": chan,
                                "needsWho": needsWho?"true":"false",
                                "users": channelUsers[chan].length.to!string,
                                "realnames": realnames.length.to!string,
                                "event": "rpl_endofnames_check"]);
                        if (needsWho && (chan !in lastWhoTime || whoNow - lastWhoTime[chan] >= 2)
                            && !pacer.isArmed()) {
                            sendRaw(whoLine(chan));
                            lastWhoTime[chan] = whoNow;
                            whoEnrichAttempts[chan] = attempts + 1;
                            logJsonMap("info", "protocol",
                                "WHO after NAMES to populate realnames",
                                ["network": config.name, "channel": chan, "event": "who_after_names"]);
                        }
                    } else {
                        logJsonMap("info", "protocol",
                            "366 no channelUsers entry",
                            ["network": config.name, "channel": chan, "event": "rpl_endofnames_no_users"]);
                    }
                }
                break;
            }

            // ── RPL_VISIBLEHOST (396) ────────────────────────────────────────
            // Our displayed host changed, but the numeric carries no user, so
            // it cannot restate the full identity: drop the proof and ask the
            // server who we are now. The payload budget takes the new host at
            // once. Still published to the server log as before.
            case "396": {
                auto p = event.getParams();
                const at = ownHostmask.indexOf('@');
                if (p.length >= 2 && p[1].length > 0 && at > 0)
                    ownHostmask = ownHostmask[0 .. at + 1] ~ p[1];
                clearOwnPrefix();
                requestSelfWho();
                break;
            }

            // ── WHO reply (RPL_WHOREPLY, 352) ────────────────────────────────
            // Only promotes BARE entries (no existing prefix) so explicit
            // MODE changes like +v are not overwritten by a WHO response
            // that may arrive after the MODE. Published only when a
            // client's own WHO owns the row (see `PendingWho`).
            case "352": {
                auto mp = event.getParams();
                logJsonMap("debug", "protocol",
                    "352 received",
                    ["network": config.name,
                        "params": event.getParams().join(" "), "text": event.text,
                        "event": "rpl_whoreply"]);
                if (mp.length >= 7) {
                    // Realname from the trailing ":<hopcount> <realname>".
                    // Hopcount is digits; the real name follows the first space.
                    string rn;
                    auto txt = event.text;
                    if (txt.length > 0) {
                        auto sp = txt.indexOf(' ');
                        if (sp >= 0) rn = txt[sp+1 .. $].strip();
                        else {
                            size_t i = 0;
                            while (i < txt.length && txt[i] >= '0' && txt[i] <= '9') i++;
                            if (i < txt.length && txt[i] == ' ') rn = txt[i+1 .. $].strip();
                            else if (i == 0) rn = txt.strip();
                        }
                    }
                    // [me, chan, user, host, server, nick, flags, trailing]
                    applyWhoReply(mp[1], mp[2], mp[3], mp[5], mp[6], rn, "", !fiberHistorical(event));
                }
                PendingWho owner;
                if (whoReplyOwner(owner) && owner.client) break;
                return;
            }

            // ── RPL_WHOISUSER (311) in the main loop ──────────────────────
            // The handshake switch has its own 311 case, so a WHOIS answer
            // arriving after registration used to update nothing: the
            // JOIN-time `WHOIS <nick>` could never satisfy the check that
            // triggered it and fired again on every JOIN. `break` (not
            // `return`) keeps WHOIS output flowing to the server buffer.
            case "311": {
                auto p = event.getParams();
                if (p.length >= 6) {
                    auto nick = p[1];
                    const rn = p[5];
                    if (nick.length > 0) {
                        recordIdentity(realnameProbed, nick, true);
                        if (rn.length > 0 && rn != nick) recordIdentity(realnames, nick, rn);
                    }
                }
                break;
            }

            // ── End of WHO (RPL_ENDOFWHO, 315) ─────────────────────────────
            // WHO reply (352) rows themselves are consumed above (realname
            // cache + channelUsers prefix promotion) and are only
            // published for a client's own WHO. The terminator of the
            // engine's sweep has no state and no UI consumer — returning
            // here keeps it off the eventChannel
            // and out of Redis scrollback. Without this, SuperNets
            // (which re-WHOs every few seconds to refresh realnames)
            // floods each channel's scrollback with one 315 row per
            // WHO, pushing the user's actual PRIVMSGs out of the
            // displayed window on every page load and making recent
            // messages appear to "disappear" behind a wall of
            // "End of WHO list" noise.
            // After End-of-WHO the roster is resolved: a member the server
            // did not name in any 352 will never be named, so marking the
            // whole channel probed is what stops the 60 s sweep from asking
            // again forever.
            case "315": {
                auto p = event.getParams();
                bool forClient = false;
                if (p.length >= 2) {
                    forClient = closeWho(p[1]);
                    if (auto members = p[1] in channelUsers)
                        foreach (u; *members) {
                            const bare = stripNickPrefix(u);
                            if (bare.length) recordOwnedIdentity(realnameProbed, bare, true);
                        }
                }
                if (forClient) break;
                return;
            }

            // ── WHOX reply (RPL_WHOX, 354) ─────────────────────────────────
            // Our own `%tcuhnfar,152` query (see `whoLine`) is read —
            // [me, 152, chan, user, host, nick, flags, account, realname] —
            // and fed through the same path as 352; it stays off the
            // eventChannel: on SuperNets / UnrealIRCd a channel's WHOX is a
            // 2000+ line flood the frontend has no consumer for. A row
            // owned by a client's WHOX (the E2EE roster probe
            // `WHO #chan %na`) is published to it instead, and its nick →
            // account pair, when asked for, lands in `accounts` too so the
            // synced roster carries it.
            case "354": {
                auto p = event.getParams();
                if (p.length >= 8 && p[1] == "152")
                    applyWhoReply(p[2], p[3], p[4], p[5], p[6], event.text, p[7], !fiberHistorical(event));
                PendingWho owner;
                if (!whoReplyOwner(owner) || !owner.client) return;
                const nick = whoxField(p, owner.fields, 'n');
                const acct = whoxField(p, owner.fields, 'a');
                if (nick.length > 0 && acct == "0") removeIdentityKey(accounts, nick);
                else if (nick.length > 0 && acct.length > 0) recordIdentity(accounts, nick, acct);
                break;
            }

            // ── Away notify (away-notify cap) ─────────────────────────────────
            // ONE event per shared channel, not one per matching roster
            // entry: the same nick legitimately appears twice in
            // channelUsers — bare from the JOIN handler, host-bearing from
            // 353 with userhost-in-names or from WHO (see the NICK handler
            // below, which mutates every copy for exactly that reason).
            // sameNick strips both the mode prefix and the !user@host
            // suffix, so a per-entry loop matched twice and published two
            // events with distinct ids — two identical rows in the client.
            case "AWAY":
                // event.text is the away message (empty = returned from away).
                if (event.nick.length > 0) {
                    if (event.text.length > 0) recordIdentity(away, event.nick, event.text);
                    else removeIdentityKey(away, event.nick);
                }
                foreach (chan, users; channelUsers) {
                    foreach (u; users) {
                        if (sameNick(u, event.nick)) {
                            auto dup        = event;
                            dup.channel     = chan;
                            dup.id          = randomUUID().toString();
                            eventChannel.put(dup);
                            break; // one per channel
                        }
                    }
                }
                return; // don't double-publish below

            // ── Account notify (account-notify cap) ──────────────────────────
            case "ACCOUNT":
                // params[0] = account name or "*" (logged out).
                // Server-log only: per-channel fan-out spammed every shared
                // channel with "nick logged in as account" rows. A single
                // _server event (empty channel falls through to the publish
                // below) keeps the login visible without the channel noise —
                // QUIT/NICK/CHGHOST dual-publish, ACCOUNT does not.
                {
                    auto ap = event.getParams();
                    if (ap.length >= 1 && ap[0].length > 0 && event.nick.length > 0) {
                        if (ap[0] == "*") removeIdentityKey(accounts, event.nick);
                        else recordIdentity(accounts, event.nick, ap[0]);
                        // A DM counterparty logging in or out ("*") stays
                        // comparable for `dmFollowsNick`.
                        const key = foldNick(event.nick);
                        if ((key in queryHosts) !is null || (key in queryAccounts) !is null) {
                            if (ap[0] == "*") queryAccounts.remove(key);
                            else queryAccounts[key] = ap[0];
                        }
                        // Colon-less `ACCOUNT acct` parses with empty text;
                        // the timeline renders msg.text, so normalize it.
                        if (event.text.length == 0)
                            event.text = ap[0];
                        // A self ACCOUNT on the live socket restates our own
                        // login; a chathistory/multiline replay does not.
                        if (optimisticNickOld.length == 0 && sameNick(event.nick, sessionNick)
                                && event.getTag("batch").length == 0 && !inMultilineMerge)
                            observeOwnAccount(ap[0] == "*" ? "" : ap[0]);
                    }
                }
                event.channel = "";
                break;

            // ── Realname change (setname cap) ──────────────────────────────
            // `:nick!user@host SETNAME :new real name` — one trailing
            // param (https://ircv3.net/specs/extensions/setname).
            // Updates the realname cache and fans out to shared channels
            // like AWAY so the UI can refresh member details.
            case "SETNAME":
                if (event.text.length > 0 && event.nick.length > 0) {
                    recordIdentity(realnameProbed, event.nick, true);
                    recordIdentity(realnames, event.nick, event.text);
                }
                foreach (chan, users; channelUsers) {
                    foreach (u; users) {
                        if (sameNick(u, event.nick)) {
                            auto dup    = event;
                            dup.channel = chan;
                            dup.id      = randomUUID().toString();
                            eventChannel.put(dup);
                            break; // one per channel
                        }
                    }
                }
                return;

            // ── Standard replies (standard-replies cap) ────────────────────
            // FAIL/WARN/NOTE carry a command name plus code and human text,
            // e.g. `:server FAIL PRIVMSG CANNOT_SEND_TO_CHANNEL #chan :...`.
            // They fall through to the normal publish path below so they
            // land in the target buffer (or _server when no channel is
            // named). A `label` tag on a FAIL is correlated with our
            // pending sends in the labeled-response block below.
            case "FAIL":
            case "WARN":
            case "NOTE":
                // `FAIL BATCH MULTILINE_MAX_LINES 15 :Too many lines` and
                // MULTILINE_MAX_BYTES carry the server's real limit, which
                // beats whatever the CAP said (a channel's +f can lower it).
                // Record it so the next paste chunks correctly instead of
                // failing again.
                applyMultilineFail(event);
                auto fp = event.getParams();
                if (fp.length >= 3 && fp[0] == "REDACT" && event.channel.length == 0)
                    event.channel = fp[2]; // FAIL REDACT <code> <target> … → the target buffer
                if (handleHistoryFailure(event)) return;
                break;

            // ── Message redaction (draft/message-redaction cap) ────────────
            // `REDACT <target> <msgid> [<reason>]` — channel targets resolve
            // via the generic first channel-like param walk below; DM
            // redactions resolve via the DM fallback below.
            case "REDACT":
                break;

            // ── Monitor replies (IRCv3 monitor, ISUPPORT MONITOR) ──────────
            // 730 RPL_MONONLINE / 731 RPL_MONOFFLINE / 732 RPL_MONLIST /
            // 733 RPL_ENDOFMONLIST. Published as-is into the server buffer
            // so watch-status changes are visible. 734 ERR_MONLISTFULL is
            // deliberately left to the default numeric path (warn-logged).
            case "730":
            case "731":
            case "732":
            case "733":
                break;

            // ── RPL_MYINFO (see the handshake handler) ───────────────────────
            case "004": {
                auto myinfo = event.getParams();
                if (myinfo.length >= 3) serverSoftware = myinfo[2];
                break;
            }

            // ── ISUPPORT ─────────────────────────────────────────────────────
            case "005":
                applyIsupportReply(event);
                break;

            // ── CTCP ──────────────────────────────────────────────────────────
            case "PRIVMSG":
                if (handlePrivmsg(event)) return; // consumed; don't publish
                // Non-CTCP channel-target PRIVMSGs only — query PRIVMSGs are
                // skipped to avoid logging the content of every DM.
                {
                    auto mp = event.getParams();
                    auto to = mp.length > 0 ? mp[0] : "";
                    if (to.length > 0 && (to[0] == '#' || to[0] == '&')) {
                        logJsonMap("debug", "protocol",
                            "PRIVMSG",
                            ["network": config.name,
                             "from": event.nick,
                             "to": to,
                             "isQuery": "false",
                             "event": "privmsg"]);
                    }
                }
                break;

            // ── NOTICE ─────────────────────────────────────────────────────────
            case "NOTICE":
                if (event.text.length > 0 && event.text[0] == CTCP_DELIM) {
                    if (sameNick(event.nick, sessionNick)) return;
                    event.addTag("ctcp", isCtcp(event.text) ? parseCtcp(event.text)[0] : "MALFORMED");
                    break;
                }
                {
                    auto mp = event.getParams();
                    auto to = mp.length > 0 ? mp[0] : "";
                    logJsonMap("debug", "protocol",
                        "NOTICE",
                        ["network": config.name,
                         "from": event.nick,
                         "to": to,
                         "event": "notice"]);
                    // Server-sourced flood warnings ("Message to #chan
                    // throttled due to flooding", "You must wait…") are the
                    // only notice we act on; a user saying "flood" is not a
                    // signal, so this requires a server prefix. The parser
                    // has no "no prefix" case for a bare hostname — with no
                    // `!user@host` to split off, `event.nick` ends up
                    // holding the whole prefix (e.g. a real server sent
                    // `:openwater.supernets.org NOTICE Zodiac :slow down
                    // nerd`, and `event.nick` reads
                    // "openwater.supernets.org") — so `nick.length == 0`
                    // alone misses every real-world server notice and the
                    // pacer never arms.
                    if (isServerPrefix(event) && isFloodNotice(event.text))
                        onFloodComplaint("notice", event.text);
                    // Reply to our `MODE <chan> f` probe. This is the only
                    // way to read the numbers behind `+F <profile>`, whose
                    // limits are otherwise server-side config.
                    if (isServerPrefix(event)) applyEffectiveFloodNotice(event.text);
                }
                break;

            // ── INVITE ─────────────────────────────────────────────────────────
            case "INVITE":
                {
                    auto mp = event.getParams();
                    auto to      = mp.length > 0 ? mp[0] : "";
                    auto channel = mp.length > 1 ? mp[1] : "";
                    logJsonMap("info", "protocol",
                        "INVITE",
                        ["network": config.name,
                         "from": event.nick,
                         "to": to,
                         "channel": channel,
                         "event": "invite"]);
                }
                break;


            // ── labeled-response ACK: a labeled command with no other reply.
            case "ACK":
                clearPendingLabel(event.getTag("label"));
                return;

            // ── Late SASL login (startLateSasl) ─────────────────────────────
            // Outside a late login these keep their old path (published).
            case "AUTHENTICATE": {
                if (!lateSaslPending) break;
                auto ap = event.getParams();
                if (ap.length > 0 && ap[0] == "+") {
                    sendSaslAuthenticate(buildSaslPlainPayload(config.saslUsername, config.saslPassword));
                } else {
                    sendRaw("AUTHENTICATE *");
                    finishLateSasl(false, "unexpected challenge");
                }
                return; // the exchange itself is not a row
            }
            case "903": // RPL_SASLSUCCESS
            case "907": // ERR_SASLALREADY: logged in either way
                if (lateSaslPending) finishLateSasl(true, event.text);
                break;
            case "902": case "904": case "905": case "906":
                if (lateSaslPending) finishLateSasl(false, event.text);
                break;

            // ── CAP after registration (cap-notify NEW/DEL, late ACKs) ─────
            // State follows the server; the line is still published so the
            // frontend's capability set updates live.
            case "CAP":
                handleCapLine(event, true);
                event.channel = "";
                break;

            // ── draft/channel-rename: `RENAME <old> <new> [:reason]` ────────
            case "RENAME": {
                auto rp = event.getParams();
                if (rp.length >= 2 && rp[0].length > 0 && rp[1].length > 0) {
                    renameChannelState(rp[0], rp[1]);
                    event.channel = rp[1];
                }
                break;
            }

            // ── draft/read-marker: `MARKREAD <target> timestamp=<iso>|*` ────
            // Bridged into `irc:lastseen`; never published as a row.
            case "MARKREAD": {
                auto rp = event.getParams();
                if (rp.length >= 2) applyMarkRead(rp[0], rp[1]);
                return;
            }

            // ── Channel mode (ban/quiet/op/voice/etc.) ───────────────────────
            case "MODE":
                auto mp = event.getParams();
                if (mp.length > 0 && (mp[0].startsWith("#") || mp[0].startsWith("&") || mp[0].startsWith("!") || mp[0].startsWith("+"))) {
                    event.channel = mp[0];
                    // Sync channelUsers with MODE changes so periodic
                    // snapshots preserve the correct prefixes. Without this,
                    // ops/voice set via MODE are lost on the next sync
                    // because the frontend gets the stale snapshot and
                    // overwrites its live MODE-driven update.
                    if (mp.length >= 2) {
                        logJsonMap("info", "protocol",
                            "MODE",
                            ["network": config.name,
                             "channel": mp[0],
                             "mode": mp.length >= 2 ? mp[1] : "",
                             "by": event.nick,
                             "event": "mode_change"]);
                    }
                    // Channel flood mode: `MODE #chan +f [5t]:15` is the one
                    // per-channel flood limit clients can actually read, and
                    // it caps both our line rate and a multiline batch.
                    if (mp.length >= 3) applyChannelFloodMode(mp[0], mp[1], mp[2 .. $]);
                    if (mp.length >= 3) {
                        const chan = mp[0];
                        auto modeStr = mp[1];
                        // Modifying the array through `ref` inside a foreach
                        // over `*members` (AA value pointer) can leave stale
                        // references for subsequent outer-loop iterations.
                        // Re-read the AA value on each mode character so
                        // multi-target MODE commands like `+vv alice bob`
                        // correctly find and update both targets.
                        bool adding = true;
                        size_t targetIdx = 2;
                        foreach (ch; modeStr) {
                            if (ch == '+') { adding = true; continue; }
                            if (ch == '-') { adding = false; continue; }
                            const modePrefix = prefixForModeChar(ch);
                            if (modePrefix != '\0') {
                                if (targetIdx >= mp.length) break;
                                const targetNick = mp[targetIdx++];
                                bool found = false;
                                if (auto members = chan in channelUsers) {
                                    foreach (i, ref u; *members) {
                                        if (sameNick(u, targetNick)) {
                                            found = true;
                                            // Merge into / remove from the run
                                            // rather than rewriting its first
                                            // char: a `+v` on `~alice` used to
                                            // overwrite the owner prefix and
                                            // demote her to voiced.
                                            u = adding
                                                ? addNickPrefix(u, modePrefix)
                                                : removeNickPrefix(u, modePrefix);
                                            break;
                                        }
                                    }
                                    if (!found && adding)
                                        *members ~= modePrefix ~ targetNick;
                                } else if (adding) {
                                    channelUsers[chan] = [modePrefix ~ targetNick];
                                }
                            }
                        }
                    }
                    // Our own status may have just changed, which decides
                    // whether floodprot's "hoaq" exemption covers us.
                    refreshFloodExemption(mp[0]);
                } else if (mp.length >= 2 && sameNick(mp[0], sessionNick)) {
                    // User-mode change on ourselves: `MODE <us> +o` is the
                    // live signal that we just gained (or lost) the
                    // `immune:lag` privilege every IRCOp holds by default.
                    if (userModesGrantOper(mp[1])) setOperState(true, "mode_self");
                    else if (mp[1].canFind("-o") || mp[1].canFind("-O"))
                        setOperState(false, "mode_self");
                }
                break;

            case "671": // RPL_WHOISSECURE — suppress "is using a Secure Connection" noise
                return;

            // ── /LIST: 321/322/323 are folded into CHANNEL_LIST chunks ──
            // and never published raw (raw 322 rows carry channel=#chan
            // and would otherwise be persisted into per-channel scrollback).
            case "321": // RPL_LISTSTART — header
                if (!channelListInFlight) beginChannelList("");
                return;
            case "322": { // RPL_LIST — one row
                ChannelListRow row;
                if (parseChannelListRow(event, row)) {
                    if (!channelListInFlight) beginChannelList("");
                    channelListPending ~= row;
                    if (channelListPending.length >= CHANNEL_LIST_CHUNK) flushChannelList(false);
                }
                return;
            }
            case "323": // RPL_LISTEND
                flushChannelList(true);
                return;
            case "416": // ERR_TOOMANYMATCHES — server truncated/refused the list
                if (channelListInFlight) {
                    flushChannelList(true, event.text.length ? event.text : "Output too large, truncated", "416");
                    return;
                }
                break;

            // 324 RPL_CHANNELMODEIS: `<nick> <channel> <modes> [params…]`.
            // Sent on join/`MODE #chan`, so this is how we learn an
            // already-set +f rather than waiting for someone to change it.
            case "324": {
                auto cp = event.getParams();
                if (cp.length >= 3)
                    applyChannelFloodMode(cp[1], cp[2], cp[3 .. $]);
                break;
            }

            // 381 RPL_YOUREOPER / 221 RPL_UMODEIS: the two authoritative
            // statements of our own oper status. An IRCOp holds
            // `immune:lag` by default, which switches fake lag off
            // entirely (UnrealIRCd src/parse.c).
            case "381":
                setOperState(true, "381");
                break;
            case "221": {
                auto up = event.getParams();
                const modes = up.length >= 2 ? up[1] : event.text;
                setOperState(userModesGrantOper(modes), "221");
                break;
            }

            // ── Rate-limit signals the server sends instead of killing us ──
            // 439 ERR_TARGETTOOFAST ("target change too fast"), 707
            // ERR_TARGETTOOFAST / ERR_TARGCHANGE on some ircds. Both mean
            // the server is already dropping or deferring our traffic,
            // which is the last warning before an Excess Flood kill.
            case "439":
            case "707":
                onFloodComplaint(event.command, event.text);
                break;

            // ── W1-T08: RPL_TRYAGAIN (263) — Server busy ─────────────────
            case "263": {
                if (channelListInFlight) {
                    // A LIST-triggered RPL_TRYAGAIN fails the list rather
                    // than raising the buffer-level "Server busy" chip.
                    flushChannelList(true, event.text.length ? event.text : "Server busy, try again later", "263");
                    return;
                }
                // Deliberately NOT a flood complaint. 263 RPL_TRYAGAIN is a
                // COMMAND rate limit, not a message one — Libera's text is
                // literally "This command could not be completed because it
                // has been used recently, and is rate-limited", and it is
                // answering our own periodic WHO/WHOIS probes. Treating it
                // as a chat-flood signal ratcheted a live Libera connection
                // to the 8 s penalty cap within 15 minutes of deploy,
                // throttling the user's messages for traffic they never
                // sent. Only message-related signals (439/707, a flood
                // NOTICE, FAIL, Excess Flood) tighten the pacer.
                import ircfiber.irc.parser : extractTempUnavailableCountdown;
                auto countdownMs = extractTempUnavailableCountdown(event);
                auto tue = IRCRawEvent(config.name, "temp_unavailable");
                tue.networkId = config.id.toString();
                tue.addTag("countdown_ms", countdownMs.to!string);
                tue.addTag("serverTs", event.timestampMs.to!string);
                eventChannel.put(tue);
                return; // don't publish as regular numeric event
            }

            default:
                // Numeric replies (3 digits): surface warn-level ones
                // (433/464/etc.) and skip already-handled numerics (001,
                // 311, 353, 354, 376, 422, …). The `354` entry was added
                // because the SuperNets WHOX flood now returns early at
                // the main switch above — this guard is the symmetric
                // protection in case a future code path bypasses that.
                if (event.command.length == 3) {
                    const bool isHandled = (event.command == "001" || event.command == "305"
                        || event.command == "306" || event.command == "311"
                        || event.command == "354" || event.command == "376"
                        || event.command == "422" || event.command == "432"
                        || event.command == "433" || event.command == "671"
                        || event.command == "321" || event.command == "322"
                        || event.command == "323"
                        || event.command == "903" || event.command == "904"
                        || event.command == "905" || event.command == "906"
                        || event.command == "907");
                    if (!isHandled && isWarnNumeric(event.command)) {
                        logJsonMap("warn", "protocol",
                            "Numeric reply",
                            ["network": config.name,
                             "numeric": event.command,
                             "message": event.text,
                             "event": "numeric"]);
                    }
                }
                break;
        }

        // Conversation routing is authoritative for all message commands,
        // including TAGMSG's non-row typing and reaction events.

        // Set channel for channel-scoped events that didn't set it explicitly.
        // For PRIVMSG the channel is params[0] (e.g. "#scroll").  For numeric
        // replies like 404 the target nick is params[0] and the channel is
        // params[1] (e.g. ":server 404 nick #channel :reason").  Walk all
        // params to find the first channel-like value.
        if (!resolveConversation(event) && event.channel.length == 0) {
            auto p = event.getParams();
            foreach (param; p) {
                if (param.length > 0 && (param[0] == '#' || param[0] == '&')) {
                    event.channel = param;
                    break;
                }
            }
        }


        // Diagnostics retain the original IRC wire fields, but never touch a
        // query's identity, history cursor, or author metadata.
        if (event.getTag("ctcp").length > 0) {
            event.channel = "_server";
            eventChannel.put(event);
            return;
        }

        // Correlate labeled echoes (labeled-response cap) and record msgids
        // so CHATHISTORY pagination has stable cursors. This runs for both
        // live messages and those arriving inside a chathistory batch.
        if (event.command == "PRIVMSG" || event.command == "NOTICE"
            || event.command == "TAGMSG" || event.command == "FAIL"
            || event.command == "WARN" || event.command == "NOTE") {
            auto msgLabel = event.getTag("label");
            if (msgLabel.length > 0 && clearPendingLabel(msgLabel))
                event.addTag("labeled_echo", "true");
            // draft/edit-message: a PRIVMSG tagged `+draft/edit=<msgid>`
            // replaces that message. Applies to remote edits and to the
            // echo of our own (both carry the tag); the frontend folds it
            // onto the row with that msgid instead of appending a row.
            auto editTag = event.getTag("+draft/edit");
            if (editTag.length > 0 && (event.command == "PRIVMSG" || event.command == "NOTICE"))
                event.addTag("edit_of", editTag);
            // IRCv3 account-tag: track the author's account name for
            // identity display without a WHOIS round trip.
            auto acctTag = event.getTag("account");
            if (acctTag.length > 0 && acctTag != "*" && event.nick.length > 0)
                recordIdentity(accounts, event.nick, acctTag);
            // Self-echo detection: tag PRIVMSG/NOTICE events from the
            // session's own nick. This runs regardless of msgid presence
            // so the suppression below catches all echo paths, including
            // servers that don't assign msgid tags.
            if (sameNick(event.nick, sessionNick)
                && (event.command == "PRIVMSG" || event.command == "NOTICE")) {
                event.addTag("self_echo", "true");
                // IRCCloud-style duplicate suppression: when the IRC server
                // echoes our own PRIVMSG back but echo-message was NOT
                // negotiated, the engine already emitted a synthetic
                // self-message event (emitSyntheticSelfMessage). Publishing
                // the server echo too creates a duplicate in the UI because
                // the synthetic (with label) replaces the optimistic, while
                // the server echo (no label if labeled-response is also
                // absent) gets a different eid and appends as a second copy.
                //
                // The labeled-response path is safe: the label was correlated
                // above, so labeled_echo is set and the frontend can do
                // in-place replacement. Without it, there's no correlation \xe2\x80\x94
                // skip the echo entirely.
                if (!hasCap("echo-message") && event.getTag("labeled_echo") != "true") {
                    return;
                }
            }
            auto msgid = event.getTag("msgid");
            if (msgid.length > 0) {
                if (event.command == "PRIVMSG" || event.command == "NOTICE") {
                    // Update per-channel msgid cursors for CHATHISTORY
                    // pagination. We use the buffer's "own" channel \xe2\x80\x94 for
                    // PRIVMSGs the params[0] is the recipient, so the
                    // channel is whichever buffer this event ends up in.
                    // The frontend will fetch the buffer's actual name; on
                    // the engine we record against the channel the
                    // event is being routed to.
                    string bufName = event.channel.length > 0 ? event.channel
                        : (event.nick.length > 0 ? event.nick : "");
                    if (bufName.length > 0) recordChannelMsgid(bufName, msgid, event.timestampMs);
                } else if (event.command == "TAGMSG" && event.channel.length > 0) {
                    // +react, +typing, etc. carry msgid referring to the
                    // target message. We don't update cursors for these.
                }
            }
        }

        // IRCCloud `from_mode`: the author's channel status AT SEND TIME.
        //
        // The frontend used to derive the `@`/`&` glyph from the live
        // roster, so a message lost its prefix the moment its author quit
        // or was de-opped — and every history row rendered bare, because
        // scrollback is read before NAMES completes. Stamping it here makes
        // the mode a property of the message, which is what it actually is.
        if (event.command == "PRIVMSG" || event.command == "NOTICE")
            stampAuthorMode(event);

        eventChannel.put(event);

        // Broadcast QUIT / NICK / CHGHOST events to each affected channel
        foreach (chan; quitChannels) {
            auto dup     = event;
            dup.channel  = chan;
            dup.id       = randomUUID().toString();
            eventChannel.put(dup);
        }
        foreach (chan; nickChannels) {
            auto dup    = event;
            dup.channel = chan;
            dup.id      = randomUUID().toString();
            eventChannel.put(dup);
        }
        foreach (chan; chghostChannels) {
            auto dup    = event;
            dup.channel = chan;
            dup.id      = randomUUID().toString();
            eventChannel.put(dup);
        }
    }

    // ── FIBERMLS peer discovery ───────────────────────────────────────────────
    // Wire protocol and pure checks live in ircfiber.irc.mls_peer. Nothing
    // here logs a control line, nonce or ticket: they are bearer material.

    /// Status symbols of ISUPPORT PREFIX; RFC `@+` when none was sent.
    private string prefixSymbols() {
        if (auto p = "PREFIX" in isupportMap) return prefixSymbolsFromIsupport(*p);
        return DEFAULT_PREFIX_SYMBOLS;
    }

    /// ISUPPORT CHANTYPES; RFC `#&` when none was sent.
    private string channelTypes() {
        if (auto p = "CHANTYPES" in isupportMap) return *p;
        return "#&";
    }

    /// The source as a roster entry may record it: `nick!user@host` when
    /// the server stated it whole, else the bare nick.
    private static string rosterIdentityOf(ref IRCRawEvent event) {
        IrcPrefix p;
        return parseFullPrefix(event.prefix, p) ? event.prefix : event.nick;
    }

    /// Sets the verified own prefix (and the payload-budget hostmask);
    /// a change refreshes the holder META and the state snapshot.
    private void setOwnPrefix(string prefix) {
        if (prefix == ownPrefix) return;
        ownPrefix = prefix;
        ownHostmask = prefix;
        markMetaDirty();
        announceOwnPrefix();
    }

    /// Drops the proof until the server restates it.
    private void clearOwnPrefix() {
        if (ownPrefix.length == 0) return;
        ownPrefix = "";
        markMetaDirty();
        announceOwnPrefix();
    }

    /// Engine-private `own_prefix` event: the processor writes the state
    /// snapshot at once and never publishes or stores it. A WHO-only
    /// refresh has no other published event to ride on (the engine's own
    /// 315 stays off the event channel).
    private void announceOwnPrefix() {
        auto ev = IRCRawEvent(config.name, "own_prefix");
        ev.networkId = config.id.toString();
        eventChannel.put(ev);
    }

    // ── Observed services identity (no transport here) ───────────────────

    /// A fresh opaque epoch for the transport this engine now interprets.
    /// Random, not derived from anything, never reused across generations.
    private void mintConnectionEpoch() {
        connectionEpoch = randomUUID().toString();
        if (services !is null) services.onEpoch();
    }

    /// RPL_WELCOME preserves any login already stated during registration.
    /// Silence is not an authoritative logout; WHOX/WHOIS or 901 may resolve
    /// an unknown account after the transport gets its own epoch.
    private void beginServicesGeneration() {
        mintConnectionEpoch();
        announceServicesState();
    }

    /// Attach: the inherited login is kept only from a planned swap's META
    /// written for this very generation (the `ownPrefix` rule); otherwise
    /// it stays unknown until the server restates it.
    private void restoreServicesAccount(ref const SessionSnapshot s, bool graceful) {
        servicesAccount = "";
        servicesAccountState = ServicesAccountState.unknown;
        if (!(graceful && s.graceful && s.wasConnected && s.connectedAtMs > 0
                && s.connectedAtMs == connectedAtMs))
            return;
        const st = parseServicesAccountState(s.servicesAccountState);
        if (st == ServicesAccountState.account && s.servicesAccount.length) {
            servicesAccount = s.servicesAccount;
            servicesAccountState = st;
        } else if (st == ServicesAccountState.none) {
            servicesAccountState = st;
        }
    }

    /// Records the state after `servicesAccount` was set from a server
    /// statement; an `account` state without a name is not proof.
    private void noteServicesAccount(ServicesAccountState st) nothrow {
        if (st == ServicesAccountState.account && servicesAccount.length == 0)
            st = ServicesAccountState.unknown;
        servicesAccountState = st;
        markMetaDirty();
        announceServicesState();
        try services.onOwnAccount(servicesActor());
        catch (Exception) {}
        announceServicesInvalidated();
    }

    /// Server-observed self ACCOUNT/WHOX/WHOIS or authentic native SUCCESS.
    /// Registry upkeep matches 900/901 only when the observed login changes.
    private void observeOwnAccount(string account) {
        if (gapReplayUncertain && lineFromBacklog) return;
        const next = account.length ? ServicesAccountState.account : ServicesAccountState.none;
        if (next == servicesAccountState && account == servicesAccount) return;
        if (account.length) {
            servicesAccount = account;
            syncPublicAvatar();
            syncMlsAccountOwner();
        } else {
            forgetPublicAvatar();
            forgetMlsAccountOwner();
            servicesAccount = "";
        }
        noteServicesAccount(next);
    }

    /// Publishes `SERVICES_STATE` [accountState, account, epoch,
    /// availability] when the exported tuple changed. Carries no service
    /// reply text or credentials; the processor publishes it live only
    /// (never scrollback, Mongo or the user stream) and refreshes the
    /// state snapshot. A detached engine stays silent: the attaching one
    /// announces its own epoch.
    private void announceServicesState() nothrow {
        if (detachedForHotSwap) return;
        string[4] now = [servicesAccountStateName(getServicesAccountState()),
            getServicesAccount(), getConnectionEpoch(), getServicesAvailability()];
        if (now == announcedServicesState) return;
        announcedServicesState = now;
        try {
            auto ev = IRCRawEvent(config.name, "SERVICES_STATE");
            ev.networkId = config.id.toString();
            ev.setParams(now[].dup);
            eventChannel.put(ev);
        } catch (Exception e) {
            try logWarn("SERVICES_STATE publish failed for %s: %s", config.name, e.msg);
            catch (Exception) {}
        }
    }

    /// Live, non-sensitive invalidation only. No permission cache survives
    /// an account, mode, target-identity, channel-state or pin change.
    private void announceServicesInvalidated() nothrow {
        if (detachedForHotSwap || services is null || !getConnectionEpoch().length) return;
        const generation = services.invalidationGeneration;
        if (generation == announcedServicesGeneration) return;
        announcedServicesGeneration = generation;
        try {
            auto ev = IRCRawEvent(config.name, "SERVICES_INVALIDATED");
            ev.networkId = config.id.toString();
            ev.setParams([getConnectionEpoch(), generation.to!string,
                services.lastInvalidationChannel, services.lastInvalidationTarget]);
            eventChannel.put(ev);
        } catch (Exception) {
            // Invalidations contain no private text; disconnect/sync is the
            // authoritative fallback when the event channel is closing.
        }
    }

    // ── Actual-user services transport (ircfiber.irc.services) ───────────

    /// Trust configuration this connection enforces: the managed network's
    /// is derived from the deployment, never from stored/browser data.
    private ServicesConfig effectiveServices() const {
        return effectiveServicesConfig(config.services, isFiberNetwork());
    }

    /// The shared classifier, against this network's services.
    private bool isSensitiveServiceLine(string line) const {
        return sensitiveServiceLine(line, effectiveServices());
    }

    /// Observed login in the transport's terms.
    private ServicesActor servicesActor() const nothrow {
        final switch (getServicesAccountState()) {
            case ServicesAccountState.unknown: return ServicesActor(ServicesActorState.unknown, "");
            case ServicesAccountState.none:    return ServicesActor(ServicesActorState.none, "");
            case ServicesAccountState.account:
                return ServicesActor(ServicesActorState.account, getServicesAccount());
        }
    }

    /// Gate for every manual, alias, bouncer and automatic line: a line to a
    /// service whose transaction is in flight is refused (never queued or
    /// interleaved), and a sensitive service line is never parked in the
    /// reconnect queue — it would be replayed later and written into META.
    private bool admitServiceLine(string line) {
        return admitService(services.lockedServiceFor(line), () => isSensitiveServiceLine(line));
    }

    /// `admitServiceLine` for a chat message: only its targets decide the
    /// lock, and the body is judged as messages to them (a multi-line body
    /// to a person is ordinary chat).
    private bool admitServiceMessage(string target, string text) {
        return admitService(services.lockedServiceForTargets(target),
            () => sensitiveServiceMessage(target, text, effectiveServices()));
    }

    private bool admitService(string busy, scope bool delegate() sensitive) {
        if (busy.length) {
            emitLog("warn", busy ~ " is busy with a request from IRC Fiber; your line to it was not sent."
                ~ " Try again in a moment.");
            return false;
        }
        const live = state == ConnectionState.connected
            || (state == ConnectionState.connecting && transportAlive);
        if (!live && sensitive()) {
            emitLog("warn", "A services login or private command was not sent: the network is not connected."
                ~ " It is never queued for later.");
            return false;
        }
        return true;
    }

    /// Writes queued service lines (fences, bodies, probes) as fast as the
    /// real pacer allows. Never through `outboundQueue`/`pacedQueue`, so
    /// none of it can be replayed or snapshotted.
    private void drainServicesQueue() {
        if (state != ConnectionState.connected || detachedForHotSwap || servicesDraining) return;
        servicesDraining = true;
        scope (exit) servicesDraining = false;
        while (true) {
            const line = services.nextWrite();
            if (!line.length) return;
            // The non-secret marker (in-flight pseudoclients, the auth
            // hand-off count) is durable in the holder META before any
            // services line can reach the socket — or nothing leaves.
            if (servicesMarkerDirty) {
                servicesMarkerDirty = false;
                if (!publishMetaStrict()) {
                    servicesMarkerDirty = true;
                    services.failClosedMeta();
                    return;
                }
                // The META write may have yielded.
                if (state != ConnectionState.connected || detachedForHotSwap) return;
                continue;
            }
            const now = unixMsNow();
            if (floodTrusted && cmdBucket.waitMs(now, trustedRate, pacer.isImmune()) > 0) return;
            if (pacer.waitMs(line.length + 2, now) > 0) return;
            services.popWrite();
            try writeRaw(line);
            catch (Exception e) {
                // The transport is gone; the loop's liveness check reconnects
                // and the disconnect cancels the transaction (unconfirmed).
                logInfo("Services write failed for %s: %s", config.name, e.msg);
                return;
            }
        }
    }

    /// Writes the holder META now. True when it was written, or when there
    /// is no held registered socket to protect (no holder, not registered:
    /// a META-less entry is never adopted). False: the caller must not send.
    private bool publishMetaStrict(bool graceful = false) {
        ++metaBarrierGeneration;
        version (ServicesWireHarness) {
            if (servicesMetaSink !is null) return servicesMetaSink(snapshotSession(graceful));
        }
        if (holder is null || holderConnId.length == 0 || state != ConnectionState.connected) return true;
        ++strictMetaPublications;
        scope (exit) --strictMetaPublications;
        markMetaDirty();
        try {
            const acknowledged = writeMetaAcknowledged(graceful, false, metaBarrierGeneration);
            if (!acknowledged) return false;
            metaWarned = false;
            return true;
        } catch (Exception e) {
            markMetaDirty();
            logJsonMap("warn", "connection", "Holder META write failed — services line not sent",
                ["network": config.name, "holderId": holderConnId, "err": e.msg, "event": "services_meta_fail"]);
            return false;
        }
    }

    /// Records the NickServ auth commands `note` finds in an outgoing manual
    /// line and makes the new hand-off count durable in the holder META
    /// BEFORE the line can reach the socket. False: the META write failed;
    /// the note is undone and the line must not be sent (never queued).
    private bool gateLegacyAuth(scope void delegate() note) {
        const before = services.legacyAuthState();
        note();
        if (services.legacyAuthPending() == before.pending) return true;
        servicesMarkerDirty = false;
        if (publishMetaStrict()) return true;
        services.restoreLegacyAuthState(before);
        emitLog("warn", "A services login was not sent: its hand-off record could not be saved."
            ~ " Try again in a moment.");
        return false;
    }

    /// Runs one validated services request as this connection's live user.
    /// `complete` is called exactly once with the request's result (the
    /// caller adds `network`). The holder marker is published before the
    /// transaction's first line leaves.
    void executeServices(ServicesRequest request, void delegate(ServicesResult) complete, long issuedMs = 0) {
        servicesWakeDeferred = true;
        try services.execute(request, complete, issuedMs);
        finally servicesWakeDeferred = false;
        // The marker is published by the drain, strictly, before the
        // transaction's first line leaves.
        drainServicesQueue();
    }

    /// A sensitive manual `msg`/`raw` the gateway kept out of the ordinary
    /// command list. Legacy manual behaviour on the epoch it was typed for;
    /// another (or no) live epoch drops it — it is never replayed.
    bool sendManualService(ServicesManualPayload p) {
        if (!p.expectedConnectionEpoch.length || p.expectedConnectionEpoch != getConnectionEpoch()) {
            emitLog("warn", "A services login or private command was not sent: the connection changed"
                ~ " before it could be delivered.");
            return false;
        }
        if (p.command == "msg") {
            if (p.label.length) sendLabeledMessage(p.target, p.text, p.label);
            else sendMessage(p.target, p.text);
        } else {
            if (services.submitManualNative(p.text, p.expectedConnectionEpoch)) return true;
            sendRaw(p.text, true);
        }
        return true;
    }

    /// Our live status prefixes on `channel` from the roster.
    private bool ownChannelStatus(string channel, out string prefixes) {
        string[]* members = channel in channelUsers;
        if (members is null) members = normalizeChannelName(channel).toLower() in channelUsers;
        if (members is null) return false;
        bool found;
        foreach (entry; *members) {
            auto bare = stripNickPrefix(entry);
            const bang = bare.indexOf("!");
            if (bang > 0) bare = bare[0 .. bang];
            if (!sameNick(bare, sessionNick)) continue;
            found = true;
            foreach (c; nickPrefix(entry))
                if (!prefixes.canFind(c)) prefixes ~= c;
        }
        return found;
    }

    /// WHO on our own nick so the server restates who we are; at most every
    /// FIBERMLS_SELF_WHO_MS, and never while a /nick awaits its echo (the
    /// row would name a nick we may not hold).
    private void requestSelfWho() {
        if (state != ConnectionState.connected || optimisticNickOld.length || sessionNick.length == 0)
            return;
        const now = unixMsNow();
        if (fiberSelfWhoMs > 0 && now - fiberSelfWhoMs < FIBERMLS_SELF_WHO_MS) return;
        fiberSelfWhoMs = now;
        // WHOX (when offered) also restates our services account.
        sendRaw(whoLine(sessionNick));
    }

    /// WHO on a channel whose roster cannot prove an identity yet (a bare or
    /// contradicting entry), at most every FIBERMLS_ROSTER_WHO_MS per channel.
    private void requestRosterWho(string chanKey) {
        if (state != ConnectionState.connected) return;
        const now = unixMsNow();
        if (auto last = chanKey in fiberRosterWhoMs)
            if (now - *last < FIBERMLS_ROSTER_WHO_MS) return;
        fiberRosterWhoMs[chanKey] = now;
        sendRaw(whoLine(chanKey));
    }

    /// `nick` is this connection: the session nick, a /nick still awaiting
    /// its echo, or the verified prefix's nick.
    private bool isOwnNick(string nick) {
        if (nick.length == 0) return false;
        if (sameNick(nick, sessionNick)) return true;
        if (optimisticNickOld.length && sameNick(nick, optimisticNickOld)) return true;
        IrcPrefix held;
        return parseFullPrefix(ownPrefix, held) && nicksEqualMapped(nick, held.nick, casemapping());
    }

    /// The line is history, never a live request: any batch (chathistory,
    /// netjoin, labeled), a reassembled multiline message, the holder's
    /// attach backlog, or a server-time more than FIBERMLS_FRESH_MS off.
    private bool fiberHistorical(ref IRCRawEvent event) {
        if (lineFromBacklog || inMultilineMerge || event.getTag("batch").length) return true;
        if (event.getTag("time").length) {
            const age = unixMsNow() - event.timestampMs;
            if (age > FIBERMLS_FRESH_MS || age < -FIBERMLS_FRESH_MS) return true;
        }
        return false;
    }

    /// GCRA bucket for ID replies, separate from `takeCtcpReplySlot`.
    private bool takeFiberReplySlot(string requester) {
        const now = unixMsNow();
        auto peer = requester in fiberRequesterNotBeforeMs;
        if (peer !is null && *peer > now) return false;
        if (peer is null) {
            string[] expired;
            foreach (key, until; fiberRequesterNotBeforeMs)
                if (until <= now) expired ~= key;
            foreach (key; expired) fiberRequesterNotBeforeMs.remove(key);
            if (fiberRequesterNotBeforeMs.length >= FIBERMLS_MAX_REQUESTERS) return false;
        }
        const tat = fiberReplyTatMs > now ? fiberReplyTatMs : now;
        if (tat - now > (FIBERMLS_REPLY_BURST - 1) * FIBERMLS_REPLY_INTERVAL_MS) return false;
        fiberReplyTatMs = tat + FIBERMLS_REPLY_INTERVAL_MS;
        fiberRequesterNotBeforeMs[requester] = now + FIBERMLS_REQUESTER_INTERVAL_MS;
        return true;
    }

    /// This engine may issue for this socket right now: registered with a
    /// generation and a verified prefix, still owning the session (not
    /// detached for a swap, not shutting down, on its holder connection),
    /// with Redis, an owner and a server id to fence the assignment on.
    private bool fiberIssuerLive() {
        return state == ConnectionState.connected && !detachedForHotSwap && !isShutdownRequested
            && connectedAtMs > 0 && ownPrefix.length > 0
            && (holder is null || holderConnId.length > 0)
            && ownerId != UUID.init && redis !is null && serverId.length > 0;
    }

    /// Consumes every reserved FIBERMLS PRIVMSG/NOTICE before chat, query,
    /// multiline or history handling. Answers only a live private QUERY to
    /// our verified nick and relays only the ID reply to a probe this
    /// connection sent; everything else (malformed, other versions,
    /// oversized, channel/STATUSMSG targets, own echoes, history) is
    /// dropped silently. NOTICE never elicits a reply.
    private bool interceptFiberMls(ref IRCRawEvent event) {
        if (event.command != "PRIVMSG" && event.command != "NOTICE") return false;
        if (!isReservedFiberMls(event.text)) return false;
        auto params = event.getParams();
        const target = params.length > 0 ? params[0] : "";
        int linelen = 512;
        if (auto v = "LINELEN" in isupportMap) {
            try linelen = (*v).to!int; catch (Exception) linelen = 512;
        }
        auto pkt = parseFiberMls(event.text,
            payloadBudget(linelen, event.prefix, event.command, target, 0), channelTypes());
        if (isOwnNick(event.nick) || fiberHistorical(event)) return true;
        IrcPrefix source;
        if (!parseFullPrefix(event.prefix, source)) return true;
        IrcPrefix self;
        if (!parseFullPrefix(ownPrefix, self)) {
            // Cannot prove the line was addressed to us; get verified so
            // the peer's retry can be answered.
            if (target.length && sameNick(target, sessionNick)) requestSelfWho();
            return true;
        }
        if (target.length == 0 || !nicksEqualMapped(target, self.nick, casemapping())) return true;
        if (event.command == "PRIVMSG" && pkt.kind == FiberMlsKind.query)
            answerFiberQuery(source, event.prefix, pkt);
        else if (event.command == "NOTICE" && pkt.kind == FiberMlsKind.id)
            relayFiberId(source, event.prefix, target, pkt);
        return true;
    }

    /// Issues a ticket for a QUERY whose source and our own identity are
    /// both stated in full on the named channel's roster, stores it
    /// (SET NX EX 30, fenced on the assignment before and after) and only
    /// then answers with the ID NOTICE.
    private void answerFiberQuery(IrcPrefix source, string sourcePrefix, FiberMlsPacket pkt) {
        if (!fiberIssuerLive()) return;
        const mapping = casemapping();
        if (!fiberMappingSupported(mapping)) return;
        const chanKey = fiberChannelKey(pkt.channel, mapping);
        auto roster = chanKey.length ? chanKey in channelUsers : null;
        if (roster is null) return;
        IrcPrefix self;
        if (!parseFullPrefix(ownPrefix, self)) return;
        const symbols = prefixSymbols();
        const peer = matchRosterIdentity(*roster, source, symbols, mapping);
        const mine = matchRosterIdentity(*roster, self, symbols, mapping);
        if (peer != RosterMatch.match || mine != RosterMatch.match) {
            // A bare or stale entry is no proof; refresh it so the peer's
            // retry can be answered. A peer simply not on the channel is not.
            if (peer != RosterMatch.absent || mine != RosterMatch.match) requestRosterWho(chanKey);
            return;
        }
        const foldedNick = normalizeFiberChannel(source.nick, mapping);
        const requesterKey = foldedNick == source.nick ? sourcePrefix
            : foldedNick ~ sourcePrefix[source.nick.length .. $];
        if (!takeFiberReplySlot(requesterKey)) return;
        string ticket;
        bool minted;
        try minted = generateTicketHex(ticket); catch (Exception) minted = false;
        if (!minted) return;
        const body = buildFiberMlsId(pkt.nonce, ticket, linePayloadBudget(source.nick, "NOTICE"));
        if (body is null) return;
        PeerTicket t;
        t.networkId = config.id.toString();
        t.ownerId = ownerId.toString();
        t.serverId = serverId;
        t.connectedAtMs = connectedAtMs;
        t.issuerPrefix = ownPrefix;
        t.requesterPrefix = sourcePrefix;
        t.networkKey = canonicalNetworkKey(config.host, config.port);
        t.channel = normalizeFiberChannel(pkt.channel, mapping);
        t.nonce = pkt.nonce;
        t.issuedAt = unixMsNow();
        const generation = connectedAtMs;
        const issuer = ownPrefix;
        const holderId = holderConnId;
        if (!storeFiberTicket(ticket, t.toJson())) return;
        // Redis yielded this fiber: re-fence the session before answering.
        if (!fiberIssuerLive() || connectedAtMs != generation || ownPrefix != issuer
            || holderConnId != holderId) {
            dropFiberTicket(ticket);
            return;
        }
        writeRaw("NOTICE " ~ source.nick ~ " :" ~ body);
    }

    /// SET NX EX 30 of the ticket, only while `irc:assignments` names this
    /// engine before and after the write. False (and no ID reply) on any
    /// failure.
    private bool storeFiberTicket(string ticket, string value) {
        const nid = config.id.toString();
        const key = RedisKeys.mlsPeerTicket(ticket);
        try {
            auto db = redis.getDb();
            if (db.hget(RedisKeys.networkAssignments(), nid) != serverId) return false;
            if (!db.setNX(key, value, FIBERMLS_TICKET_TTL_SECS.seconds)) return false;
            if (db.hget(RedisKeys.networkAssignments(), nid) == serverId) return true;
            db.del(key);
            return false;
        } catch (Exception) {
            logJsonMap("warn", "connection", "FIBERMLS ticket not stored; no reply sent",
                ["network": config.name, "event": "fibermls_ticket_store_failed"]);
            return false;
        }
    }

    private void dropFiberTicket(string ticket) {
        try redis.getDb().del(RedisKeys.mlsPeerTicket(ticket));
        catch (Exception) {}
    }

    /// Publishes a matching ID reply to the owner's live event channel only
    /// (no scrollback, history, query tab or notification). The nonce must
    /// belong to a probe this connection wrote to that same nick within
    /// FIBERMLS_FRESH_MS; it is single-use. A reply from anyone else leaves
    /// the genuine probe redeemable. The answer proves the recipient runs
    /// discovery: it may be asked on that channel again
    /// FIBERMLS_RESPONDER_REFRESH_MS after that probe was written, and on
    /// its other shared channels independently.
    private void relayFiberId(IrcPrefix source, string sourcePrefix, string destination,
                              FiberMlsPacket pkt) {
        pruneFiberProbes(unixMsNow());
        auto sent = pkt.nonce in fiberProbesSent;
        if (sent is null || !nicksEqualMapped(sent.target, source.nick, casemapping())) return;
        const answered = *sent;
        fiberProbesSent.remove(pkt.nonce);
        noteFiberAnswered(answered);
        if (redis is null || ownerId == UUID.init) return;
        auto msg = Json.emptyObject;
        msg["type"] = "mls_peer_response";
        msg["networkId"] = config.id.toString();
        msg["prefix"] = sourcePrefix;
        msg["destination"] = destination;
        msg["nonce"] = pkt.nonce;
        msg["ticket"] = pkt.ticket;
        redis.publish(RedisKeys.events(ownerId.toString()), msg.toString());
    }

    /// Forgets sent probes past FIBERMLS_FRESH_MS: each was left unanswered.
    private void pruneFiberProbes(long now) {
        string[] stale;
        foreach (nonce, ref p; fiberProbesSent)
            if (now - p.sentAtMs > FIBERMLS_FRESH_MS) stale ~= nonce;
        foreach (nonce; stale) {
            noteFiberUnanswered(fiberProbesSent[nonce]);
            fiberProbesSent.remove(nonce);
        }
    }

    /// A written QUERY was answered: the recipient is proven, its global
    /// cooldown lifts, and that channel may be refreshed 20 s after it.
    private void noteFiberAnswered(ref const SentFiberProbe p) {
        auto g = p.recipient in fiberRecipients;
        if (g is null) {
            fiberRecipients[p.recipient] = FiberRecipientGuard.init;
            g = p.recipient in fiberRecipients;
        }
        if (p.sentAtMs > g.answeredSentAtMs) g.answeredSentAtMs = p.sentAtMs;
        g.blockedUntilMs = 0;
        g.channelNotBeforeMs[p.chanKey] = p.sentAtMs + FIBERMLS_RESPONDER_REFRESH_MS;
    }

    /// A written QUERY got no answer (expired, or its socket closed). Its
    /// channel keeps the cooldown set at write time; unless the recipient
    /// answered a later QUERY, its proof is revoked and every channel waits
    /// out FIBERMLS_UNANSWERED_COOLDOWN_MS from this write.
    private void noteFiberUnanswered(ref const SentFiberProbe p) nothrow {
        auto g = p.recipient in fiberRecipients;
        if (g is null || g.answeredSentAtMs > p.sentAtMs) return;
        g.answeredSentAtMs = 0;
        const until = p.sentAtMs + FIBERMLS_UNANSWERED_COOLDOWN_MS;
        if (g.blockedUntilMs < until) g.blockedUntilMs = until;
    }

    /// A QUERY was written at `now`: that channel waits the full cooldown
    /// (shortened by an answer), and an unproven recipient gets nothing on
    /// any channel until it answers or the cooldown ends.
    private void noteFiberWritten(ref const FiberProbe p, long now) {
        auto g = p.recipient in fiberRecipients;
        if (g is null) {
            fiberRecipients[p.recipient] = FiberRecipientGuard.init;
            g = p.recipient in fiberRecipients;
        }
        if (!fiberResponsive(*g, now)) g.blockedUntilMs = now + FIBERMLS_UNANSWERED_COOLDOWN_MS;
        string[] lapsed;
        foreach (key, until; g.channelNotBeforeMs) if (until <= now) lapsed ~= key;
        foreach (key; lapsed) g.channelNotBeforeMs.remove(key);
        g.channelNotBeforeMs[p.chanKey] = now + FIBERMLS_UNANSWERED_COOLDOWN_MS;
    }

    /// The `channelState` key naming `channel` under `mapping`; "" when
    /// this connection is not in it.
    private string fiberChannelKey(string channel, string mapping) {
        foreach (k; channelState.byKey)
            if (nicksEqualMapped(k, channel, mapping)) return k;
        return "";
    }

    /// Registered (a generation is set) and still owned by this engine (not
    /// detached for a swap or shutting down): the only time a probe is
    /// accepted or written. It does not probe the transport itself; a dead
    /// relay surfaces in writeRaw like any other write, and the reconnect's
    /// resetConnectionTelemetry drops everything queued for this socket.
    private bool fiberDiscoveryLive() const {
        return state == ConnectionState.connected && connectedAtMs > 0
            && !detachedForHotSwap && !isShutdownRequested;
    }

    /// Room for one more recipient record, pruning expired ones when full.
    private bool fiberRecipientRoom(long now) {
        if (fiberRecipients.length < FIBERMLS_MAX_RECIPIENTS) return true;
        string[] expired;
        foreach (key, ref g; fiberRecipients)
            if (fiberGuardExpired(g, now)) expired ~= key;
        foreach (key; expired) fiberRecipients.remove(key);
        return fiberRecipients.length < FIBERMLS_MAX_RECIPIENTS;
    }

    /// The per-recipient backstop for a QUERY to `recipient` naming
    /// `chanKey` at `now` (call after pruneFiberProbes). Drop: that channel
    /// already has one on the wire or is inside its refresh/cooldown, or an
    /// unproven recipient is in its unanswered cooldown, or no record fits.
    /// Wait: an unproven recipient's one QUERY on another channel is still
    /// awaiting its answer, which would prove it for this channel too.
    private FiberProbeVerdict fiberRecipientVerdict(string recipient, string chanKey, long now) {
        bool inFlight = false;
        foreach (ref p; fiberProbesSent) {
            if (p.recipient != recipient) continue;
            if (p.chanKey == chanKey) return FiberProbeVerdict.drop;
            inFlight = true;
        }
        auto g = recipient in fiberRecipients;
        if (g is null)
            return inFlight ? FiberProbeVerdict.wait
                : fiberRecipientRoom(now) ? FiberProbeVerdict.send : FiberProbeVerdict.drop;
        if (auto until = chanKey in g.channelNotBeforeMs)
            if (*until > now) return FiberProbeVerdict.drop;
        if (fiberResponsive(*g, now)) return FiberProbeVerdict.send;
        if (inFlight) return FiberProbeVerdict.wait;
        return g.blockedUntilMs > now ? FiberProbeVerdict.drop : FiberProbeVerdict.send;
    }

    /// Queues a client's exact `PRIVMSG <nick> :<FIBERMLS 1 QUERY …>` for
    /// paced sending, only while registered, only when the channel it names
    /// is one we are in with both the target and us on its roster, and
    /// only when the per-recipient backstop allows it (fiberRecipientVerdict)
    /// and that recipient has nothing for that channel queued already —
    /// whatever the nonce, tab or client. A second channel for an unproven
    /// recipient is held until the first is answered, never sent beside it.
    /// Everything else carrying the reserved command — an ID reply (only
    /// this engine answers), tags, a channel/STATUSMSG/self/multi target, a
    /// malformed or oversized packet (never split), a repeat, a 65th
    /// pending probe — is dropped. False when dropped; `deferral` is then
    /// set (retryAfterMs > 0) only for a fully validated fresh nonce that
    /// a proven responder's own pacing refused (fiberResponderDeferMs).
    private bool queueFiberProbe(string line, long now, out FiberProbeDeferral deferral) {
        import std.uni : icmp;
        if (!fiberDiscoveryLive()) return false;
        if (line.length < 8 || icmp(line[0 .. 8], "PRIVMSG ") != 0) return false;
        const rest = line[8 .. $];
        const sep = rest.indexOf(" :");
        if (sep <= 0) return false;
        const target = rest[0 .. sep];
        const text = rest[sep + 2 .. $];
        foreach (char c; target) if (c <= ' ' || c == ',' || c == 0x7F) return false;
        const types = channelTypes();
        if (types.indexOf(target[0]) >= 0 || stripNickPrefix(target) != target || isOwnNick(target))
            return false;
        auto pkt = parseFiberMls(text, linePayloadBudget(target, "PRIVMSG"), types);
        if (pkt.kind != FiberMlsKind.query) return false;
        const mapping = casemapping();
        if (!fiberMappingSupported(mapping)) return false;
        const chanKey = fiberChannelKey(pkt.channel, mapping);
        auto roster = chanKey.length ? chanKey in channelUsers : null;
        if (roster is null) return false;
        const symbols = prefixSymbols();
        IrcPrefix peer;
        const peerState = rosterNickIdentity(*roster, target, symbols, mapping, peer);
        if (peerState == RosterMatch.absent || peerState == RosterMatch.conflict) return false;
        IrcPrefix self;
        if (parseFullPrefix(ownPrefix, self)) {
            const mine = matchRosterIdentity(*roster, self, symbols, mapping);
            if (mine == RosterMatch.absent || mine == RosterMatch.conflict) return false;
        } else if (!rosterHas(chanKey, sessionNick)) {
            return false;
        }
        const recipient = normalizeFiberChannel(target, mapping);
        if ((pkt.nonce in fiberProbesSent) !is null) return false;
        bool queued = false;
        foreach (ref q; fiberProbeQueue) {
            if (q.nonce == pkt.nonce) return false;
            if (q.recipient == recipient && q.chanKey == chanKey) queued = true;
        }
        pruneFiberProbes(now);
        if (queued || fiberRecipientVerdict(recipient, chanKey, now) == FiberProbeVerdict.drop) {
            const wait = fiberDeferMs(recipient, chanKey, queued, now);
            if (wait > 0) deferral = FiberProbeDeferral(pkt.nonce, wait);
            return false;
        }
        if (fiberProbeQueue.length + fiberProbesSent.length >= FIBERMLS_MAX_PENDING) return false;
        FiberProbe p;
        p.target = target;
        p.recipient = recipient;
        p.chanKey = chanKey;
        if (peerState == RosterMatch.match) {
            p.targetUser = peer.user;
            p.targetHost = peer.host;
        }
        p.nonce = pkt.nonce;
        p.line = "PRIVMSG " ~ target ~ " :" ~ text;
        p.queuedAtMs = now;
        p.generation = connectedAtMs;
        fiberProbeQueue ~= p;
        return true;
    }

    /// fiberResponderDeferMs for `recipient` on `chanKey` at `now`, with
    /// that channel's QUERY on the wire, if any (call after pruneFiberProbes).
    private long fiberDeferMs(string recipient, string chanKey, bool queued, long now) {
        auto g = recipient in fiberRecipients;
        if (g is null) return 0;
        long sentAtMs = 0;
        foreach (ref p; fiberProbesSent)
            if (p.recipient == recipient && p.chanKey == chanKey) sentAtMs = p.sentAtMs;
        return fiberResponderDeferMs(*g, chanKey, queued, sentAtMs, now);
    }

    private enum FiberProbeVerdict : ubyte { send, wait, drop }

    /// Re-checks a queued probe against the live session at write time:
    /// same socket, under FIBERMLS_PROBE_MAX_AGE_MS old, still in the
    /// channel, the target still there as the identity it was queued for,
    /// our verified prefix stated on that roster, and the per-recipient
    /// backstop. `whoChan` names a channel whose roster cannot prove us yet.
    private FiberProbeVerdict fiberProbeVerdict(ref const FiberProbe q, long now, ref const IrcPrefix self,
                                                string mapping, string symbols, ref string whoChan) {
        if (q.generation != connectedAtMs || now - q.queuedAtMs > FIBERMLS_PROBE_MAX_AGE_MS
            || now < q.queuedAtMs)
            return FiberProbeVerdict.drop;
        if ((q.chanKey in channelState) is null) return FiberProbeVerdict.drop;
        auto roster = q.chanKey in channelUsers;
        if (roster is null) return FiberProbeVerdict.drop;
        IrcPrefix peer;
        const peerState = rosterNickIdentity(*roster, q.target, symbols, mapping, peer);
        if (peerState == RosterMatch.absent || peerState == RosterMatch.conflict)
            return FiberProbeVerdict.drop;
        if (q.targetUser.length && (peerState != RosterMatch.match
            || peer.user != q.targetUser || peer.host != q.targetHost))
            return FiberProbeVerdict.drop;
        const mine = matchRosterIdentity(*roster, self, symbols, mapping);
        if (mine == RosterMatch.unverified) {
            if (whoChan.length == 0) whoChan = q.chanKey;
            return FiberProbeVerdict.wait;
        }
        if (mine != RosterMatch.match) return FiberProbeVerdict.drop;
        return fiberRecipientVerdict(q.recipient, q.chanKey, now);
    }

    /// Takes the oldest queued probe that may be written at `now`, dropping
    /// every one that no longer validates, and records it as sent: the
    /// pacing slot, the redeemable nonce and the recipient's cooldown. False
    /// when nothing may go out yet; `needSelfWho`/`whoChan` then name the
    /// WHO that would let a waiting probe prove our identity.
    private bool takeFiberProbe(long now, out FiberProbe probe, out bool needSelfWho, out string whoChan) {
        if (fiberProbeQueue.length == 0 || !fiberDiscoveryLive()) return false;
        IrcPrefix self;
        if (!parseFullPrefix(ownPrefix, self)) { needSelfWho = true; return false; }
        if (now < fiberProbeNotBeforeMs) return false;
        pruneFiberProbes(now);
        if (fiberProbesSent.length >= FIBERMLS_MAX_PENDING) return false;
        const mapping = casemapping();
        const symbols = prefixSymbols();
        bool taken = false;
        size_t kept = 0;
        foreach (i; 0 .. fiberProbeQueue.length) {
            FiberProbe q = fiberProbeQueue[i];
            if (!taken) {
                const verdict = fiberMappingSupported(mapping)
                    ? fiberProbeVerdict(q, now, self, mapping, symbols, whoChan)
                    : FiberProbeVerdict.drop;
                if (verdict == FiberProbeVerdict.drop) continue;
                if (verdict == FiberProbeVerdict.send) {
                    probe = q;
                    taken = true;
                    continue;
                }
            }
            fiberProbeQueue[kept++] = q;
        }
        fiberProbeQueue = fiberProbeQueue[0 .. kept];
        if (!taken) return false;
        whoChan = "";
        fiberProbeNotBeforeMs = now + FIBERMLS_PROBE_INTERVAL_MS;
        fiberProbesSent[probe.nonce] = SentFiberProbe(probe.target, probe.recipient, probe.chanKey, now);
        noteFiberWritten(probe, now);
        return true;
    }

    /// A client's reserved-command line: queued then drained, or — when a
    /// proven responder's own pacing refused a fully validated fresh nonce —
    /// answered with owner-scoped `mls_peer_deferred {networkId, nonce,
    /// retryAfterMs}` so that client retries once the backstop allows it
    /// instead of waiting out silence. Nothing reaches the wire either way.
    private void submitFiberProbe(string line) {
        FiberProbeDeferral deferral;
        if (queueFiberProbe(line, unixMsNow(), deferral)) {
            drainFiberProbes();
            return;
        }
        if (deferral.retryAfterMs <= 0 || redis is null || ownerId == UUID.init) return;
        auto msg = Json.emptyObject;
        msg["type"] = "mls_peer_deferred";
        msg["networkId"] = config.id.toString();
        msg["nonce"] = deferral.nonce;
        msg["retryAfterMs"] = deferral.retryAfterMs;
        redis.publish(RedisKeys.events(ownerId.toString()), msg.toString());
    }

    /// Writes the next valid queued probe once its 1 s slot opens, then
    /// publishes `mls_peer_sent` so the browser's deadline starts at the
    /// real write rather than while queued.
    private void drainFiberProbes() {
        if (fiberProbeQueue.length == 0) return;
        FiberProbe probe;
        bool needSelfWho;
        string whoChan;
        if (!takeFiberProbe(unixMsNow(), probe, needSelfWho, whoChan)) {
            if (needSelfWho) requestSelfWho();
            else if (whoChan.length) requestRosterWho(whoChan);
            return;
        }
        writeRaw(probe.line);
        if (redis is null || ownerId == UUID.init) return;
        auto msg = Json.emptyObject;
        msg["type"] = "mls_peer_sent";
        msg["networkId"] = config.id.toString();
        msg["nonce"] = probe.nonce;
        redis.publish(RedisKeys.events(ownerId.toString()), msg.toString());
    }

    // ── CTCP dispatch ─────────────────────────────────────────────────────────

    /// Claims the global CTCP auto-reply slot: at most one reply per
    /// CTCP_REPLY_MIN_INTERVAL_MS, so a CTCP flood cannot turn us into a
    /// NOTICE flood (and an Excess Flood kill).
    private bool takeCtcpReplySlot() {
        const now = unixMsNow();
        if (now < ctcpReplyNotBeforeMs) return false;
        ctcpReplyNotBeforeMs = now + CTCP_REPLY_MIN_INTERVAL_MS;
        return true;
    }

    /// Consume only our non-ACTION echoes; publish every other diagnostic.
    private bool handlePrivmsg(ref IRCRawEvent event) {
        if (event.text.length == 0 || event.text[0] != CTCP_DELIM) return false;
        const framed = isCtcp(event.text);
        auto ctcp = framed ? parseCtcp(event.text) : ["MALFORMED", ""];
        auto cmd = ctcp[0];
        auto param = ctcp[1];
        if (framed && cmd == "ACTION") return false;
        if (sameNick(event.nick, sessionNick)) return true;
        event.addTag("ctcp", cmd);
        if (!framed) return false;

        // Auto-reply only to a live request from someone else: never to a
        // replayed (chathistory) one, nor to our own echo or another of our
        // clients, and rate-limited.
        const batchRef = event.getTag("batch");
        const replayed = batchRef == "chathistory"
            || (batchRef.length > 0 && openBatches.get(batchRef, OpenBatch.init).type == "chathistory");
        const requester = event.nick;
        auto params = event.getParams();
        const mayReply = requester.length > 0 && !replayed && !sameNick(requester, sessionNick)
            && params.length > 0 && params[0] == stripNickPrefix(params[0])
            && sameNick(params[0], sessionNick);
        void reply(string type, string value) {
            if (!mayReply || !takeCtcpReplySlot()) return;
            sendRaw("NOTICE " ~ requester ~ " :" ~ ctcpReply(type, value));
        }
        switch (cmd) {
            case "VERSION":    reply("VERSION", "IRC Fiber"); break;
            case "PING":       reply("PING", param); break;
            case "TIME":       reply("TIME", Clock.currTime.toString()); break;
            case "CLIENTINFO": reply("CLIENTINFO", "ACTION VERSION PING TIME CLIENTINFO"); break;
            default:           break;
        }
        return false;
    }

    // ── IRC line parser ───────────────────────────────────────────────────────

    private IRCRawEvent parseIRCLine(string line) {
        import ircfiber.irc.parser : parseIRCLinePublic;
        return parseIRCLinePublic(line, config);
    }

    // ── Timestamp resolution ──────────────────────────────────────────────────

    /// Use `server-time` tag if present, otherwise fall back to local wall clock.
    private long resolveTimestamp(const ref IRCRawEvent event) {
        // server-time tag value: 2023-01-01T12:00:00.000Z
        auto ts = event.getTag("time");
        if (ts.length > 0) {
            try {
                import std.datetime : SysTime, DateTime, UTC;
                // vibe.d's SysTime.fromISOExtString handles RFC3339/ISO8601
                auto st = SysTime.fromISOExtString(ts);
                return st.toUnixTime!long * 1000 + st.fracSecs.total!"msecs";
            } catch (Exception) {}
        }
        // Use ms-precision wall clock, not second-precision (toUnixTime*1000
        // truncates ms and makes two PRIVMSGs in the same second hash-collide
        // in BufferManager's dedup fallback). See buffer.d hasDedupKey fix.
        return (Clock.currTime - SysTime.fromUnixTime(0)).total!"msecs";
    }

    // ── CAP values + flood pacing ─────────────────────────────────────────────

    /// Cap list we ask for on this connection.
    private string[] desiredCapList() {
        string[] caps = DESIRED_CAPS_BASE.dup;
        if (config.sasl != SASLMechanism.none) caps ~= DESIRED_CAPS_SASL;
        if (("draft/chathistory" in capValues) !is null
            && ("batch" in capValues) !is null
            && ("server-time" in capValues) !is null
            && ("message-tags" in capValues) !is null)
            caps ~= "draft/event-playback";
        return caps;
    }

    /// `draft/multiline=max-bytes=5250` → `draft/multiline`.
    private static string capNameOf(string token) {
        auto t = token.strip();
        const eq = t.indexOf("=");
        return eq >= 0 ? t[0 .. eq] : t;
    }

    /// Stores the `=value` part of every cap token in a CAP LS / CAP NEW
    /// line. Bare caps get an empty string so presence is still recorded.
    private void recordCapValues(string capLine) {
        foreach (token; capLine.split(" ")) {
            auto t = token.strip();
            if (t.length == 0) continue;
            const eq = t.indexOf("=");
            if (eq >= 0) capValues[t[0 .. eq]] = t[eq + 1 .. $];
            else if ((t in capValues) is null) capValues[t] = "";
        }
    }

    /// Every `CAP` line, during registration (`registered == false`, where
    /// it drives REQ / SASL / `CAP END`) and after it (cap-notify NEW/DEL
    /// and the ACKs that answer our own late REQs). The caller still
    /// publishes the line so the frontend's cap set follows it live.
    private void handleCapLine(ref IRCRawEvent event, bool registered) {
        const nativeWasAcked = hasCap("draft/account-registration");
        const nativeValue = capValues.get("draft/account-registration", "");
        scope (exit) {
            Json values = Json.emptyObject;
            foreach (name, value; capValues) values[name] = Json(value);
            event.capValuesPayload = values.toString();
            if (nativeWasAcked != hasCap("draft/account-registration")
                || nativeValue != capValues.get("draft/account-registration", ""))
                services.onRegistrationCapabilityChanged();
        }
        auto params = event.getParams();
        if (params.length < 2) return;
        // params[0] = our nick (or *), params[1] = subcommand
        const sub = toUpper(params[1]);
        auto capLine = params.length >= 3 ? params[$ - 1] : "";

        if (sub == "LS") {
            // Accumulate caps (multi-line uses trailing '*')
            const bool isMultiline = (params.length >= 3 && params[2] == "*");
            recordCapValues(capLine);
            foreach (cap; capLine.split(" ")) {
                auto capName = capNameOf(cap);
                if (capName.length > 0) serverCaps ~= capName;
            }
            if (registered || isMultiline) return;
            // Request only caps we want AND the server offers, in two REQs:
            // CAP REQ is all-or-nothing, so a server that refuses one draft
            // cap must not cost us the stable ones.
            string[] stable, drafts;
            foreach (desired; desiredCapList()) {
                if (!serverCaps.canFind(desired)) continue;
                if (desired.startsWith("draft/") || desired == "chathistory") drafts ~= desired;
                else stable ~= desired;
            }
            // ── ngIRCd workaround ───────────────────────────────
            // ngIRCd 27 only offers `multi-prefix` and stalls if
            // the client sends `CAP REQ :multi-prefix` AFTER it
            // has already sent NICK/USER (which the engine does
            // immediately after CAP LS). Manual test:
            //   CAP LS + NICK+USER, LS=multi-prefix, REQ -> ACK but no 001
            //   CAP LS + NICK+USER, LS=multi-prefix, END -> immediate 001 + MOTD
            // So when the server's entire cap list is a single
            // `multi-prefix` entry, skip the REQ and go straight
            // to CAP END. The cap is non-essential for local
            // testing and this avoids a 30s registration timeout
            // that wedges the LocalIRCD network.
            const bool singleMultiPrefixOnly = serverCaps.length == 1
                && serverCaps[0] == "multi-prefix"
                && stable.length == 1 && stable[0] == "multi-prefix"
                && drafts.length == 0;
            if (singleMultiPrefixOnly) {
                logJsonMap("info", "connection",
                    "Skipping CAP REQ for single multi-prefix (ngIRCd workaround)",
                    ["network": config.name,
                     "host": config.host, "port": config.port.to!string,
                     "event": "cap_skipped_ngircd"]);
                stable = [];
            }
            foreach (req; [stable, drafts]) {
                if (req.length == 0) continue;
                sendRaw("CAP REQ :" ~ req.join(" "));
                ++capReqOutstanding;
                logJsonMap("debug", "connection",
                    "CAP REQ sent",
                    ["network": config.name,
                     "host": config.host, "port": config.port.to!string,
                     "caps": req.join(" "),
                     "event": "cap_negotiating"]);
                recordCounter("ircfiber.cap.negotiating", 1,
                    ["network": config.name, "host": config.host,
                     "port": config.port.to!string]);
            }
            if (capReqOutstanding == 0) maybeEndCap("0");
        } else if (sub == "ACK") {
            string[] newly;
            foreach (cap; capLine.split(" ")) {
                auto c = cap.strip();
                if (c.length == 0) continue;
                if (c[0] == '-') { ackedCaps.remove(capNameOf(c[1 .. $])); continue; }
                const name = capNameOf(c);
                if (!name.length) continue;
                recordCapValues(c);
                if (!hasCap(name)) newly ~= name;
                ackedCaps[name] = true;
            }
            if (registered) {
                if (newly.canFind("draft/metadata-2")) publishOwnMetadata();
                if (newly.canFind("draft/read-marker")) reseedReadMarkers();
                if (newly.canFind("draft/chathistory") || newly.canFind("chathistory")) startHistoryRecovery();
                if (newly.canFind("sasl") && lateSaslPending) sendRaw("AUTHENTICATE PLAIN");
                return;
            }
            if (capReqOutstanding > 0) --capReqOutstanding;
            // draft/extended-isupport: the full 005 before CAP END, so the
            // tokens are known before the first post-registration line.
            if (newly.canFind("draft/extended-isupport")) sendRaw("ISUPPORT");
            // If SASL was acked, start authentication
            if (newly.canFind("sasl") && !saslDone && config.sasl != SASLMechanism.none) {
                // CAP 302 servers list their mechanisms in
                // `sasl=`; one we cannot use fails every
                // attempt the same way, so park with the list
                // instead of collecting a 904.
                const offered = capValues.get("sasl", "");
                if (!saslMechanismOffered(offered, saslMechanismName(config.sasl)))
                    throw new SaslParkedException(parkOnUnsupportedMechanism(offered));
                emitLog("sasl_start",
                    "Starting SASL " ~ saslMechanismName(config.sasl) ~ " authentication");
                logJsonMap("info", "auth",
                    "SASL starting",
                    ["network": config.name, "host": config.host,
                     "port": config.port.to!string,
                     "mechanism": saslMechanismName(config.sasl),
                     "event": "sasl_start"]);
                recordCounter("ircfiber.sasl.start", 1,
                    ["network": config.name, "host": config.host,
                     "port": config.port.to!string,
                     "mechanism": saslMechanismName(config.sasl)]);
                final switch (config.sasl) {
                    case SASLMechanism.none: break;
                    case SASLMechanism.plain:
                        sendRaw("AUTHENTICATE PLAIN");
                        break;
                    case SASLMechanism.external:
                        sendRaw("AUTHENTICATE EXTERNAL");
                        break;
                    case SASLMechanism.scramSha256:
                        sendRaw("AUTHENTICATE SCRAM-SHA-256");
                        break;
                }
            } else if (!saslDone && config.sasl != SASLMechanism.none
                && !hasCap("sasl") && capReqOutstanding == 0) {
                // The server granted caps but NOT sasl — it does
                // not support SASL on this connection. Fall back to
                // no-SASL registration instead of deadlocking waiting
                // for an AUTHENTICATE that will never come (the
                // 2026-08-12 BLCKND outage: sasl configured, server
                // never granted it, CAP END never sent, server closed
                // with "Registration Timeout" after ~40s, forever).
                logWarn("SASL not granted by %s (server does not offer sasl) — proceeding without SASL",
                    config.host);
                saslDone = true;
            }
            maybeEndCap(capLine);
        } else if (sub == "NAK") {
            if (registered) {
                if (lateSaslPending && capLine.split(" ").canFind("sasl")) lateSaslPending = false;
                return;
            }
            if (capReqOutstanding > 0) --capReqOutstanding;
            // Ignore NAK'd caps; they just won't be used. If the
            // server NAK'd the request carrying sasl, the server does
            // not offer it — proceed without SASL so registration
            // cannot deadlock (BLCKND outage).
            if (!saslDone && config.sasl != SASLMechanism.none
                && capLine.split(" ").canFind("sasl")) {
                logWarn("SASL NAK'd by %s (server does not offer sasl) — proceeding without SASL",
                    config.host);
                saslDone = true;
            }
            maybeEndCap("nak: " ~ capLine);
        } else if (sub == "NEW") {
            // Server added new caps (cap-notify); request any we want.
            // UnrealIRCd also uses CAP DEL + CAP NEW to *update* a
            // value — the multiline max-lines/max-bytes change when
            // we move between its known-users and unknown-users
            // groups — so the values have to be re-read here.
            recordCapValues(capLine);
            const desired = desiredCapList();
            foreach (cap; capLine.split(" ")) {
                auto capName = capNameOf(cap);
                if (capName.length == 0 || hasCap(capName) || !desired.canFind(capName)) continue;
                // During registration SASL runs through the ACK above. After
                // it, `CAP NEW sasl` means services just (re)linked: log in
                // now if we registered without them.
                if (registered && capName == "sasl") {
                    startLateSasl();
                    continue;
                }
                sendRaw("CAP REQ :" ~ capName);
                if (!registered && !capEndSent) ++capReqOutstanding;
            }
        } else if (sub == "DEL") {
            // Server removed caps
            foreach (cap; capLine.split(" ")) {
                auto capName = capNameOf(cap);
                ackedCaps.remove(capName);
                capValues.remove(capName);
            }
        }
    }

    /// Services relinked after we registered without them. An ircd restart
    /// races Anope's uplink: the engine reconnects first, the ircd offers
    /// no `sasl`, and NickServ renames the unidentified session to Guest a
    /// minute later (2026-11-02, appreview/faggy/SisU). Log in over SASL
    /// now. PLAIN only, and never `NickServ IDENTIFY`: echo-message would
    /// write that PRIVMSG, password included, into the NickServ buffer.
    private void startLateSasl() {
        if (lateSaslPending || servicesAccount.length > 0) return;
        if (config.sasl != SASLMechanism.plain || config.saslUsername.strip().length == 0
                || config.saslPassword.length == 0) return;
        if (!saslMechanismOffered(capValues.get("sasl", ""), "PLAIN")) return;
        lateSaslPending = true;
        logJsonMap("info", "auth",
            "Services available after registration — starting SASL",
            ["network": config.name, "host": config.host,
             "account": config.saslUsername, "event": "sasl_late_start"]);
        sendRaw("CAP REQ :sasl");
    }

    /// Ends a `startLateSasl` exchange. A refusal only logs: the session is
    /// live, and parking it would disconnect a working connection over a
    /// login it never needed to register. Success takes back the nick
    /// services enforcement renamed us away from.
    private void finishLateSasl(bool ok, string detail) {
        lateSaslPending = false;
        if (!ok) {
            logJsonMap("warn", "auth",
                "Late SASL login failed",
                ["network": config.name, "host": config.host,
                 "account": config.saslUsername, "detail": detail,
                 "event": "sasl_late_fail"]);
            return;
        }
        saslSucceeded = true;
        pacer.adopt(KNOWN_USER_LIMITS);
        logJsonMap("info", "auth",
            "Late SASL login succeeded",
            ["network": config.name, "host": config.host,
             "account": config.saslUsername, "event": "sasl_late_success"]);
        recordCounter("ircfiber.sasl.late_success", 1, ["network": config.name, "host": config.host]);
        const restore = forcedFromNick;
        forcedFromNick = "";
        if (restore.length > 0 && !sameNick(sessionNick, restore)) sendRaw("NICK " ~ restore);
    }

    /// Sends `CAP END` once SASL is settled and every registration REQ has
    /// been answered. With draft/pre-away our away state goes first, so we
    /// are never seen present after a reconnect.
    private void maybeEndCap(string acks) {
        if (capEndSent || !saslDone || capReqOutstanding > 0) return;
        if (hasCap("draft/pre-away") && isAway && awayMessage.length)
            sendRaw("AWAY :" ~ awayMessage);
        sendRaw("CAP END");
        capEndSent = true;
        logJsonMap("info", "connection",
            "CAP negotiation complete",
            ["network": config.name,
             "host": config.host, "port": config.port.to!string,
             "acks": acks,
             "event": "cap_negotiated"]);
        recordCounter("ircfiber.cap.negotiated", 1,
            ["network": config.name, "host": config.host,
             "port": config.port.to!string]);
    }

    /// draft/metadata-2: subscribe to every user key we render and publish
    /// our own (avatar default/override plus the owner's profile keys).
    private void publishOwnMetadata() {
        sendRaw("METADATA * SUB " ~ USER_METADATA_KEYS.join(" "));
        foreach (l; metadataCommands("avatar", "", config.effectiveAvatarUrl())) sendRaw(l);
        foreach (k; PROFILE_KEYS)
            foreach (l; metadataCommands(k, "", config.profileMetadata.get(k, ""))) sendRaw(l);
    }

    /// draft/read-marker just became available: push the stored
    /// `irc:lastseen` marker of every joined channel. The server keeps a
    /// marker only when it is newer, so this never moves one backwards.
    private void reseedReadMarkers() {
        import ircfiber.irc.chathistory : isoTimestampMs;
        if (redis is null || ownerId == UUID.init) return;
        try {
            auto repo = new LastSeenRepository(redis);
            foreach (chan; channelState.byKey) {
                const stored = repo.get(ownerId, config.id.toString() ~ ":" ~ lastSeenBufferKey(chan));
                if (stored > 0) sendRaw("MARKREAD " ~ chan ~ " timestamp=" ~ isoTimestampMs(stored));
            }
        } catch (Exception e) {
            logWarn("Read-marker re-seed failed for %s: %s", config.name, e.msg);
        }
    }

    /// The server's advertised multiline limits, or an unusable value when
    /// the cap was not negotiated. `batch` is a hard dependency of the spec.
    private MultilineLimits multilineLimits() {
        if (!hasCap("draft/multiline") || !hasCap("batch"))
            return MultilineLimits.init;
        if (auto v = "draft/multiline" in capValues)
            return parseMultilineCap(*v);
        return MultilineLimits.init;
    }

    /// Payload bytes available for one PRIVMSG/NOTICE line to `target`.
    private size_t linePayloadBudget(string target, string command) {
        int linelen = 512;
        if (auto v = "LINELEN" in isupportMap) {
            try { linelen = (*v).to!int; } catch (Exception) { linelen = 512; }
        }
        return payloadBudget(linelen, ownHostmask, command, target);
    }

    /// Flood group we assume for the fake-lag model. UnrealIRCd promotes a
    /// user to `known-users` when they are identified to services OR have
    /// been connected over two hours; we only claim the first, because the
    /// second is not observable from here without guessing the server's
    /// `security-group` config.
    private FloodLimits assumedFloodLimits() {
        const identified = config.sasl != SASLMechanism.none && saslSucceeded;
        return identified ? KNOWN_USER_LIMITS : UNKNOWN_USER_LIMITS;
    }

    /// Resolves `IRCFIBER_FLOOD_TRUSTED_HOSTS` for this network.
    ///
    /// Everything else the pacer knows is a guess about a configuration IRC
    /// never advertises, which is why it now stays out of the way until the
    /// server complains (see `FakeLagPacer`). Our own ircd is the exception:
    /// the deploy renders the same `commandrate`/`threshold` into the
    /// InspIRCd `<connect>` block and into this env, so here the numbers are
    /// facts — and `fakelag="no"` on that class makes exceeding them a kill,
    /// not a delay, so they are respected rather than assumed away.
    private void applyFloodTrust() {
        auto cfgTrust = floodTrustSettings();
        const trusted = floodTrustedHost(cfgTrust.hosts, config.host);
        if (trusted == floodTrusted) {
            floodTrusted = trusted;
            trustedRate = cfgTrust.rate;
            return;
        }
        floodTrusted = trusted;
        trustedRate = cfgTrust.rate;
        if (!trusted) return;
        logJsonMap("info", "connection",
            "Platform ircd — pacing against its own connect class",
            ["network":     config.name,
             "networkId":   config.id.toString(),
             "host":        config.host,
             "commandRate": trustedRate.commandRateMilli.to!string,
             "threshold":   trustedRate.threshold.to!string,
             "event":       "flood_trusted_host"]);
    }

    /// Queues a user-originated message line behind the pacer.
    ///
    /// Protocol-critical traffic (PING/PONG, CAP, NICK, registration) must
    /// never be delayed and is written by `sendRaw` directly; it is still
    /// *charged* to the bucket so the model tracks the server's real view.
    private void enqueuePaced(string line, BncCommandOwner owner = BncCommandOwner.init,
            string epoch = "", string wireLabel = "") {
        if (pacedQueue.length >= MAX_PACED_QUEUE) {
            logJsonMap("warn", "connection",
                "Paced outbound queue full — dropping line",
                ["network": config.name,
                 "networkId": config.id.toString(),
                 "queued": pacedQueue.length.to!string,
                 "event": "flood_queue_full"]);
            if (owner.request.length)
                bncState().reject(owner, "TOO_MANY_PENDING", "Too many outstanding labeled requests", wireLabel, epoch);
            return;
        }
        pacedQueue ~= BncPendingWrite(line, owner, epoch, wireLabel);
        // Give the first line a chance to leave immediately rather than
        // waiting for the next 50 ms event-loop tick.
        drainPacedQueue();
    }

    /// Channel `+f` ceiling for a target, if one is known AND it applies to
    /// us. UnrealIRCd's floodprot skips the whole check for members with
    /// `hoaq` status (or a matching `~F:` exception), so holding ops means
    /// there is no per-channel ceiling to respect.
    private ChannelLineLimit floodLimitFor(string target) {
        auto key = target.toLower();
        if (auto ex = key in chanFloodExempt) if (*ex) return ChannelLineLimit.init;
        if (auto l = key in chanFloodLimit) return *l;
        return ChannelLineLimit.init;
    }

    /// Records the author's highest channel status prefix on a chat event
    /// as the `from_mode` tag (single char: `~ & @ % +`, or `*`/`!` for an
    /// IRC operator entry). No tag at all when the author holds no status,
    /// is unknown to the roster, or the target is a query — absent and
    /// empty must read the same downstream.
    ///
    /// `channelUsers` is keyed inconsistently across its write sites (JOIN
    /// normalizes, 353 uses the raw `params[2]`, MODE uses the raw target),
    /// so both the raw and the normalized/lowered key are tried. It can
    /// also hold the same member twice — the bare nick from a JOIN echo and
    /// the prefixed form from 353 — so every match contributes and the
    /// highest-ranked run wins, exactly like `refreshFloodExemption`.
    private void stampAuthorMode(ref IRCRawEvent event) {
        if (event.nick.length == 0 || event.channel.length == 0) return;
        if (event.channel[0] != '#' && event.channel[0] != '&') return;

        string[]* members = event.channel in channelUsers;
        if (members is null) {
            auto key = normalizeChannelName(event.channel).toLower();
            members = key in channelUsers;
        }
        if (members is null) return;

        string[] runs;
        foreach (entry; *members) {
            auto bare = stripNickPrefix(entry);
            if (!sameNick(bare, event.nick)) continue;
            runs ~= nickPrefix(entry);
        }
        auto best = strongestPrefix(runs);
        if (best.length) event.addTag("from_mode", best);
    }


    /// Recomputes whether our own status on `channel` exempts us from `+f`
    /// and records it. Called whenever NAMES or a MODE change could have
    /// altered our prefix.
    private void refreshFloodExemption(string channel) {
        auto key = normalizeChannelName(channel).toLower();
        auto prefixToken = isupportMap.get("PREFIX", "(qaohv)~&@%+");
        bool exempt = false;
        if (auto members = key in channelUsers) {
            // `channelUsers` can hold us twice: the bare nick appended by
            // our own JOIN echo AND the prefixed form from 353. Checking
            // only the first match therefore misses the status entirely, so
            // every matching entry contributes.
            foreach (entry; *members) {
                auto bare = stripNickPrefix(entry);
                auto bang = bare.indexOf("!");
                if (bang > 0) bare = bare[0 .. bang];
                if (!sameNick(bare, sessionNick)) continue;
                if (statusExemptsFromFlood(statusModesOf(entry, prefixToken))) {
                    exempt = true;
                    break;
                }
            }
        }
        const was = (key in chanFloodExempt) !is null && chanFloodExempt[key];
        if (exempt) chanFloodExempt[key] = true;
        else if (key in chanFloodExempt) chanFloodExempt.remove(key);
        if (exempt != was) {
            logJsonMap("info", "connection",
                exempt ? "Channel flood exemption gained"
                       : "Channel flood exemption lost",
                ["network": config.name,
                 "channel": channel,
                 "event":   "channel_flood_exempt"]);
        }
    }

    /// Grants or withdraws the fake-lag exemption from observed oper state.
    private void setOperState(bool oper, string signal) {
        if (isOper == oper) return;
        isOper = oper;
        if (services !is null) services.onOwnAuthorityChanged();
        pacer.setImmune(oper);
        logJsonMap("info", "connection",
            oper ? "IRCOp status detected — fake-lag pacing disabled"
                 : "IRCOp status lost — fake-lag pacing re-enabled",
            ["network": config.name,
             "networkId": config.id.toString(),
             "signal":  signal,
             "event":   "flood_immunity"]);
    }

    /// Asks the server for a channel's *effective* flood setting — the only
    /// way to read the numbers behind `+F <profile>`.
    ///
    /// Sent ONLY to servers that answer `MODE <chan> f` as a query
    /// (UnrealIRCd's `floodprot_override_mode`). Anywhere else the same
    /// line is a mode CHANGE with a missing parameter and the server
    /// answers with an error the user then reads in their channel —
    /// InspIRCd replies `696 <chan> f * :You must specify a parameter for
    /// the flood mode. Syntax: [*]<messages>:<period>.` on every join.
    private void probeChannelFlood(string channel) {
        if (!serverAnswersFloodQuery(serverSoftware)) return;
        auto key = normalizeChannelName(channel).toLower();
        if (key in chanFloodProbed) return;
        chanFloodProbed[key] = true;
        enqueuePaced("MODE " ~ channel ~ " f");
    }

    /// Target of a PRIVMSG/NOTICE line, for the `+f` window. Empty when the
    /// line is not a message.
    private static string messageTargetOf(string line) {
        auto l = line;
        if (l.startsWith("@")) {
            const sp = l.indexOf(" ");
            if (sp < 0) return "";
            l = l[sp + 1 .. $];
        }
        const sp1 = l.indexOf(" ");
        if (sp1 < 0) return "";
        const verb = l[0 .. sp1].toUpper();
        if (verb != "PRIVMSG" && verb != "NOTICE") return "";
        auto rest = l[sp1 + 1 .. $].stripLeft();
        const sp2 = rest.indexOf(" ");
        return sp2 < 0 ? rest : rest[0 .. sp2];
    }

    /// True when a wire line is a NOTICE (target-flood limits notices much
    /// more tightly than PRIVMSGs).
    private static bool isNoticeLine(string line) {
        auto l = line;
        if (l.startsWith("@")) {
            const sp = l.indexOf(" ");
            if (sp < 0) return false;
            l = l[sp + 1 .. $];
        }
        return l.length >= 6 && l[0 .. 6].toUpper() == "NOTICE";
    }

    /// `a` permits fewer lines per second than `b`.
    private static bool stricterLimit(ChannelLineLimit a, ChannelLineLimit b) {
        if (!b.valid()) return true;
        if (!a.valid()) return false;
        return cast(long)a.lines * b.seconds < cast(long)b.lines * a.seconds;
    }

    /// Writes as many paced lines as the server will currently accept.
    ///
    /// Called from `processOutboundQueue` on every event-loop tick (50 ms).
    ///
    /// Three gates, in order of how much we actually know:
    ///   1. the platform ircd's real `<connect>` command rate, when this is
    ///      a trusted host — a fact, and one that kills us if ignored;
    ///   2. the fake-lag/recvq model, which only paces after the server has
    ///      complained (`FakeLagPacer` is unarmed until then — IRCCloud
    ///      sends at wire speed and so do we);
    ///   3. per-target ceilings: a channel's advertised `+f`, always, and
    ///      UnrealIRCd's unadvertised `target-flood`, only on software that
    ///      has it AND only once the server has already complained. That
    ///      assumed ceiling is what throttled a 500-line paste to ~7
    ///      lines/second on an InspIRCd network that has no such limit.
    private void drainPacedQueue() {
        if (pacedQueue.length == 0) return;
        if (state != ConnectionState.connected) return;

        const now = unixMsNow();
        // Walk the tightening back once a minute has passed since the last
        // COMPLAINT, not since the last write. Keying it on write activity
        // meant a busy connection could never relax: one 707 pinned it at
        // the penalty cap until reconnect.
        if (lastFloodComplaintMs > 0 && now - lastFloodComplaintMs > 60_000) {
            pacer.relax();
            lastFloodComplaintMs = now;   // one step per minute of quiet
        }
        const startedWith = pacedQueue.length;

        while (pacedQueue.length > 0) {
            const entry = pacedQueue[0];
            const line = entry.line;
            // The server charges fake lag on the whole command it receives.
            const cmdBytes = line.length + 2;      // + CRLF
            if (floodTrusted && cmdBucket.waitMs(now, trustedRate, pacer.isImmune()) > 0) {
                reportPacing(now, startedWith);
                return;
            }
            if (pacer.waitMs(cmdBytes, now) > 0) {
                reportPacing(now, startedWith);
                return;
            }

            auto target = messageTargetOf(line);
            if (target.length > 0) {
                auto key = target.toLower();
                auto w = key in chanFloodWindow;
                if (w is null) {
                    chanFloodWindow[key] = LineRateWindow.init;
                    w = key in chanFloodWindow;
                }
                // `+f` is advertised by the channel itself, so it is always
                // honoured — exceeding it gets us kicked or the channel
                // moderated, which loses the rest of the paste. UnrealIRCd's
                // `target-flood` is neither advertised nor universal: it
                // silently DROPS messages, so it is respected once the
                // server has shown it rate-limits us, but never assumed on
                // an ircd that does not implement it at all.
                auto lim = floodLimitFor(target);
                if (pacer.isArmed() && !floodTrusted
                    && serverHasTargetFlood(ircdSoftwareFromVersion(serverSoftware))) {
                    const isChan = target[0] == '#' || target[0] == '&'
                        || target[0] == '!' || target[0] == '+';
                    auto tf = targetFloodLimit(isChan, isNoticeLine(line));
                    if (!lim.valid() || stricterLimit(tf, lim)) lim = tf;
                }
                if (lim.valid()) {
                    if (w.waitMs(now, lim) > 0) {
                        reportPacing(now, startedWith);
                        return;
                    }
                    w.record(now);
                }
            }

            pacedQueue = pacedQueue[1 .. $];
            lastPacedWriteMs = now;      // writeRaw charges the bucket
            try {
                if (entry.owner.request.length)
                    bncState().writeOwned(line, entry.owner, now, entry.epoch, entry.wireLabel);
                else writeRaw(line);
            }
            catch (Exception e) {
                logInfo("Paced write failed for %s: %s", config.name, e.msg);
                return;
            }
        }
    }

    /// Tells the user their paste is still going out, at most every 5 s.
    ///
    /// A queue that drains slowly is indistinguishable from a hung client:
    /// the reported symptom was "it posted a chunk and then waited way too
    /// long", with nothing anywhere saying why. Only fires for a backlog big
    /// enough to be worth a line in the server log.
    private void reportPacing(long nowMs, size_t startedWith) {
        enum size_t PACED_NOTICE_MIN_QUEUE = 25;
        enum long PACED_NOTICE_INTERVAL_MS = 5_000;
        if (pacedQueue.length < PACED_NOTICE_MIN_QUEUE) return;
        if (lastPacedNoticeMs > 0 && nowMs - lastPacedNoticeMs < PACED_NOTICE_INTERVAL_MS) return;
        lastPacedNoticeMs = nowMs;
        const sent = startedWith > pacedQueue.length ? startedWith - pacedQueue.length : 0;
        const reason = floodTrusted && !pacer.isImmune()
            ? "the server accepts " ~ (trustedRate.commandRateMilli / 1000).to!string
              ~ " lines/second"
            : pacer.isArmed()
                ? "the server asked us to slow down"
                : "a channel rate limit (+f)";
        emitLog("flood_pacing",
            "Sending queued lines: " ~ pacedQueue.length.to!string ~ " left ("
            ~ sent.to!string ~ " sent this pass) — " ~ reason);
        logJsonMap("info", "connection",
            "Pacing outbound queue",
            ["network":   config.name,
             "networkId": config.id.toString(),
             "queued":    pacedQueue.length.to!string,
             "trusted":   floodTrusted.to!string,
             "armed":     pacer.isArmed().to!string,
             "event":     "flood_pacing"]);
    }

    /// Server NOTICE texts that mean "you are sending too fast". Deliberately
    /// narrow: only phrases ircds emit for rate limiting, never a user's
    /// chatter (the caller also requires a server prefix).
    private static bool isFloodNotice(string text) {
        auto t = text.toLower();
        return t.canFind("flood")
            || t.canFind("throttl")
            || t.canFind("too fast")
            || t.canFind("slow down")
            || t.canFind("rate limit");
    }

    /// True when `event.prefix` names a server rather than a user: empty
    /// (synthetic events), or no `!user@host` portion with a dot in the
    /// bare name. IRC nicknames cannot contain a dot (RFC 2812), so
    /// `foo.bar.net` can only be a server hostname — the parser still
    /// assigns it to `event.nick` for lack of anywhere else to put it
    /// (see parser.d), which is why the callers above cannot just check
    /// `event.nick.length == 0`.
    private static bool isServerPrefix(ref const IRCRawEvent event) {
        if (event.nick.length == 0) return true;
        return event.prefix.indexOf("!") < 0 && event.prefix.indexOf(".") >= 0;
    }

    /// `FAIL BATCH MULTILINE_MAX_LINES <limit>` / `MULTILINE_MAX_BYTES
    /// <limit>`: the server's authoritative limit for the batch we just
    /// tried. Overwrite the CAP-derived value so the retry fits, and treat
    /// TIMEOUT as a flood signal (the batch went out too slowly).
    private void applyMultilineFail(ref IRCRawEvent event) {
        if (event.command != "FAIL") return;
        auto p = event.getParams();
        if (p.length < 3 || p[0].toUpper() != "BATCH") return;
        const code = p[1].toUpper();
        auto ml = multilineLimits();
        int newLines = ml.maxLines;
        int newBytes = ml.maxBytes;
        if (code == "MULTILINE_MAX_LINES") {
            try newLines = p[2].to!int; catch (Exception) return;
        } else if (code == "MULTILINE_MAX_BYTES") {
            try newBytes = p[2].to!int; catch (Exception) return;
        } else {
            return;
        }
        if (newBytes <= 0) return;
        capValues["draft/multiline"] =
            "max-bytes=" ~ newBytes.to!string ~ ",max-lines=" ~ newLines.to!string;
        logJsonMap("info", "connection",
            "Multiline limits corrected by server FAIL",
            ["network":  config.name,
             "code":     code,
             "maxLines": newLines.to!string,
             "maxBytes": newBytes.to!string,
             "event":    "multiline_limits_updated"]);
    }

    /// Applies the effective `+f` limit reported by a `MODE <chan> f`
    /// probe reply. The notice names the channel in single quotes, and the
    /// follow-up lines ("Plus flood setting via +f: '…'") carry no channel
    /// name — those are attributed to the channel the last one named.
    private string lastFloodNoticeChannel;
    private void applyEffectiveFloodNotice(string text) {
        if (text.length == 0) return;
        // "Channel '#x' has effective flood setting …" / "… on #x"
        foreach (chan; channelState.byKey()) {
            if (text.canFind(chan)) { lastFloodNoticeChannel = chan; break; }
        }
        if (lastFloodNoticeChannel.length == 0) return;
        if (text.canFind("No channel mode +f")) {
            auto key = lastFloodNoticeChannel.toLower();
            if (key in chanFloodLimit) chanFloodLimit.remove(key);
            return;
        }
        auto lim = parseEffectiveFloodNotice(text);
        if (!lim.valid()) return;
        auto key = lastFloodNoticeChannel.toLower();
        auto existing = key in chanFloodLimit;
        // Keep the strictest limit seen for this channel: `+f` and `+F` are
        // reported on separate notices and both apply.
        if (existing !is null
            && cast(long)existing.lines * lim.seconds <= cast(long)lim.lines * existing.seconds)
            return;
        chanFloodLimit[key] = lim;
        logJsonMap("info", "connection",
            "Effective channel flood limit learned",
            ["network": config.name,
             "channel": lastFloodNoticeChannel,
             "lines":   lim.lines.to!string,
             "seconds": lim.seconds.to!string,
             "event":   "channel_flood_effective"]);
    }

    /// Applies a channel mode change, tracking only `+f`/`-f` (the channel
    /// flood limit). `params` are the mode arguments after the mode string.
    private void applyChannelFloodMode(string channel, string modeStr, string[] params) {
        auto key = normalizeChannelName(channel).toLower();
        bool adding = true;
        size_t argIdx = 0;
        foreach (c; modeStr) {
            if (c == '+') { adding = true; continue; }
            if (c == '-') { adding = false; continue; }
            if (c == 'f') {
                if (!adding) {
                    chanFloodLimit.remove(key);
                    if (auto w = key in chanFloodWindow) w.clear();
                } else if (argIdx < params.length) {
                    auto lim = parseChannelFloodLines(params[argIdx]);
                    if (lim.valid()) {
                        chanFloodLimit[key] = lim;
                        logJsonMap("info", "connection",
                            "Channel flood limit observed",
                            ["network": config.name,
                             "channel": channel,
                             "lines":   lim.lines.to!string,
                             "seconds": lim.seconds.to!string,
                             "event":   "channel_flood_limit"]);
                    } else {
                        chanFloodLimit.remove(key);
                    }
                }
                // `f` takes an argument in both directions on UnrealIRCd.
                argIdx++;
                continue;
            }
            // Any other mode may or may not consume an argument; we cannot
            // know without CHANMODES parsing, and guessing would misalign
            // `f`'s argument. Only trust `+f` when it is the first
            // argument-taking mode in the string, which is the common case
            // (`MODE #chan +f [5t]:15`, `MODE #chan -f`).
            if (params.length > 0) break;
        }
    }

    /// A flood complaint arrived (263 / 439 / 707 / flood NOTICE / FAIL /
    /// Excess Flood). Backs the pacer off and records why.
    private void onFloodComplaint(string signal, string detail) {
        const nowMs = unixMsNow();
        lastFloodComplaintMs = nowMs;
        pacer.tighten(nowMs);
        logJsonMap("warn", "connection",
            "Server flood complaint — tightening outbound pacing",
            ["network":     config.name,
             "networkId":   config.id.toString(),
             "signal":      signal,
             "detail":      detail,
             "penaltyMs":   pacer.limits().penaltyMs.to!string,
             "steps":       pacer.penaltySteps().to!string,
             "queued":      pacedQueue.length.to!string,
             "event":       "flood_tightened"]);
        recordCounter("ircfiber.flood.tightened", 1,
            ["network": config.name, "signal": signal]);
    }

    // ── Outbound queue ────────────────────────────────────────────────────────

    private void processOutboundQueue() {
        if (state != ConnectionState.connected) return;

        // Reconnect buffer first: these lines were written while the
        // transport was down and must not be reordered behind a paste.
        if (outboundQueue.length > 0) {
            auto queue = outboundQueue;
            outboundQueue = [];
            foreach (l; queue) writeRaw(l);
        }

        // Then whatever the flood pacer is holding back.
        drainPacedQueue();
    }

    private void writeRaw(string line) {
        linesOut++;
        if (line.length >= 3 && line[0 .. 3] == "WHO") whoOut++;
        // Every byte the server reads costs us fake lag, not just paced
        // message lines: our own WHO/WHOIS probes, JOIN bursts, NICK and
        // MODE all count too. Charging here — the single point where bytes
        // reach a socket — keeps the model honest. Multiline batches are
        // charged as one clamped lump instead, so they suppress this.
        if (!chargeSuppressed) pacer.charge(line.length + 2, unixMsNow());
        // InspIRCd charges one penalty point per COMMAND, whatever its
        // length, and it charges them for our PING/WHO/JOIN/MODE traffic
        // too — unless the effective flood exemption is active. Raw oper
        // status is insufficient: a flood complaint revokes that exemption
        // without de-opering us, and must restore both admission and charging.
        if (floodTrusted) cmdBucket.record(unixMsNow(), trustedRate, 1, pacer.isImmune());
        if (transportAlive) {
            try transportWrite(line);
            catch (Exception e) {
                logJsonMap("error", "connection",
                    "Transport write failed",
                    [
                        "network":   config.name,
                        "networkId": config.id.toString(),
                        "error":     e.msg,
                        "event":     "transport_write_fail"
                    ]);
                // A server that hangs up before saying a word (a TLS-only
                // port dialled in plain text) fails our first registration
                // writes; name that instead of the socket error.
                if (state == ConnectionState.connecting && linesIn == 0)
                    throw new Exception(registrationClosedReason());
                throw e;
            }
        } else {
            // No active stream AND no live transport — the message would
            // be silently dropped. Emit one structured event PER
            // disconnect cycle (not per-message) so the operator sees
            // *that* the connection is dead but isn't drowned in
            // identical warnings. The flag is reset on successful
            // (re-)connection.
            if (!droppedNoConnWarned) {
                logJsonMap("warn", "connection",
                    "Outbound message dropped — no active connection",
                    [
                        "network":   config.name,
                        "networkId": config.id.toString(),
                        "queueLen":  outboundQueue.length.to!string,
                        "state":     state.to!string,
                        "event":     "cmd_dropped_no_conn"
                    ]);
                droppedNoConnWarned = true;
            }
            // If the engine THINKS we're connected but the transport is
            // actually dead (FD died, TLS teardown error, etc.), the
            // network state is lying. Throw an exception so the outer
            // catch block in runConnectionLoop() runs
            // handleDisconnection() (which tears down transports) and
            // then schedules a fresh reconnect with backoff. Without
            // this, new JOINs and other commands silently disappear
            // into the void and the user sees "Connected" with a
            // frozen buffer list for up to the 120 s idle-heuristic
            // window.
            if (state == ConnectionState.connected) {
                throw new Exception("Stale connection detected: transport dead but"
                    ~ " state=connected — forcing reconnect for " ~ config.name);
            }
        }
    }

    // ── Disconnect / cleanup ──────────────────────────────────────────────────

    private void handleDisconnection() {
        // A hot-swap detach is not a disconnect: the session lives on in the
        // holder and the next engine re-attaches. Nothing to emit or reset.
        if (detachedForHotSwap) return;
        if (holderConnId.length && !isShutdownRequested && lastErrorText.length == 0)
            if (recoverHolderRelay()) return;
        withSpan("irc.disconnect", ["network": config.name, "reason": lastDisconnectReason], (ref Span s) {
            // Captured before resetConnectionTelemetry() zeroes them: the
            // "disconnected" log below is the only forensic record of how
            // long the session lasted and how much we asked of the server.
            const uptimeSecs   = connectedAtMs > 0 ? (unixMsNow() - connectedAtMs) / 1000 : 0;
            const nowSecs      = Clock.currTime.toUnixTime!long;
            const idleSecs     = lastDataReceivedSecs > 0 ? nowSecs - lastDataReceivedSecs : -1;
            const egressAtDrop = activeEgressLabel.length ? activeEgressLabel : "direct";
            const linesInAtDrop  = linesIn;
            const linesOutAtDrop = linesOut;
            const whoOutAtDrop   = whoOut;
            // Settle a recovery trial while the session's uptime is known.
            settleEgressTrialOnEnd(connectedAtMs > 0 ? unixMsNow() - connectedAtMs : 0, isShutdownRequested);
            state = ConnectionState.disconnected;
            resetConnectionTelemetry();
            // When the relay ended from the holder's side (upstream EOF, TLS
            // read error, detach timeout…) the holder knows why; surface that
            // instead of the generic "Connection lost".
            if (holderConnId.length && holder !is null) {
                try {
                    auto e = holder.info(holderConnId);
                    if (e.state == "closed") {
                        lastHolderCloseReason = e.closeReason;
                        lastHolderClosedAtMs = e.closedAtMs;
                    }
                    if (e.state == "closed" && e.closeReason.length) {
                        if (lastDisconnectReason.length == 0
                            || lastDisconnectReason == "Connection closed unexpectedly"
                            || lastDisconnectReason == "Connection lost")
                            lastDisconnectReason = e.closeReason;
                        try holder.forgetClaim(holderConnId, holderInstance, holderConnectedAtMs); catch (Exception) {}
                        holderConnId = "";
                    }
                } catch (Exception) {}
            }
            try {
                transportClose();
            } catch (Exception e) {
                logWarn("Error closing transport for %s: %s", config.host, e.msg);
            }
            // Emit DISCONNECTED lifecycle event so the frontend always
            // learns about the state transition, even when the disconnect
            // happens outside the catch block (e.g. processEvents data-loss
            // detection or handleServerError squashed ERROR).
            if (!disconnectedEmitted) {
                disconnectedEmitted = true;
                try eventChannel.put(IRCRawEvent.makeDisconnected(
                    config.name, config.id.toString(),
                    lastDisconnectReason.length > 0 ? lastDisconnectReason : "Connection lost"));
                catch (Exception) {}
            }
            // W1-T01: structured fail-info emit. Sits next to the legacy
            // DISCONNECTED event so the frontend's `applyFail` and the
            // legacy `disconnectReason` write can co-exist (per plan R2
            // dual-emit).
            //
            // W1-T01-rev1: skip when the user (or admin) called
            // stop() — `isShutdownRequested == true` means the
            // disconnect was intentional and the frontend should see
            // the no-fail "disconnected" branch instead of a
            // "Disconnected: <reason>" banner with a Reconnect button.
            // Without this guard, every /quit click produced a
            // CONNECTION_FAIL event + a populated snap.failInfo,
            // leaving the banner stuck on the user until the next
            // successful reconnect.
            if (!isShutdownRequested) {
                emitConnectionFail(
                    lastDisconnectReason.length > 0 ? lastDisconnectReason : "connection_lost",
                    lastErrorText);
            }
            logJsonMap("info", "connection",
                "Disconnected",
                ["network": config.name,
                 "reason": lastDisconnectReason.length > 0 ? lastDisconnectReason : "connection_lost",
                 "attempt": backoff.currentAttempt().to!string,
                 "uptimeSecs": uptimeSecs.to!string,
                 "idleSecs": idleSecs.to!string,
                 "egress": egressAtDrop,
                 "linesIn": linesInAtDrop.to!string,
                 "linesOut": linesOutAtDrop.to!string,
                 "whoOut": whoOutAtDrop.to!string,
                 "pongAgeSecs": (lastPongReceivedSecs > 0 ? nowSecs - lastPongReceivedSecs : -1).to!string,
                 "dataAgeSecs": (lastDataReceivedSecs > 0 ? nowSecs - lastDataReceivedSecs : -1).to!string,
                 "lastError": lastErrorText,
                 "event": "disconnected"]);
            // Record host failure for the circuit breaker — unless this is
            // a shutdown (user-initiated disconnect), which shouldn't count.
            if (!isShutdownRequested && !maintenanceActive()) {
                recordHostFailure(config.host, config.port);
            }
            s.setStatusOk();
        });
    }

    private bool shouldReconnect() {
        if (isShutdownRequested) return false;
        // Bug 3 fix (Jul 8 2026): respect the disabled flag mid-loop too.
        // Without this, a network that's administratively disabled but
        // already inside the connection loop would reconnect indefinitely.
        if (config.disabled) {
            // Re-enter the idle loop in `runConnectionLoop` — it owns
            // the per-iteration config.disabled check.
            return false;
        }
        return true;
    }

    private void cleanup() { handleDisconnection(); }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private bool waitForData(Duration timeout) {
        return connection.waitForData(timeout);
    }

    private size_t readFromStream(ubyte[] buffer, Duration timeout = 0.seconds) {
        // The transport is always the holder relay (plain bytes over a vibe
        // TCPConnection; TLS lives in the holder). Gate on waitForData() with
        // a (potentially zero) timeout: calling connection.read(IOMode.once)
        // with no data available makes the vibe.d read loop busy-poll until
        // readTimeout expires on this platform (cfrunloop/kqueue), burning a
        // full CPU core per idle connection. Only enter read() when data is
        // buffered.
        //
        // During registration (performRegistration) we pass a non-zero timeout
        // so the fiber actually blocks until data arrives.  During the main
        // event loop (processEvents) we use 0.seconds and rely on the outer
        // sleep loop for pacing — the zero keeps the loop responsive.
        try {
            import vibe.core.net : WaitForDataStatus;
            const readiness = connection.waitForDataEx(timeout);
            if (readiness == WaitForDataStatus.noMoreData) {
                // EOF is not an idle timeout. Surface relay loss immediately
                // to the connected actor's same-incarnation recovery path.
                throw new Exception("Holder relay closed");
            }
            if (readiness == WaitForDataStatus.timeout) return 0;
            return connection.read(buffer, IOMode.once);
        } catch (Exception e) {
            // Resume the registration stack (CAP/SASL locals included)
            // after relay-only failure, never resend NICK/USER.
            if (state == ConnectionState.connecting && recoverHolderRelay(true)) return 0;
            throw e;
        }
    }

    private void removeFromUsers(string chan, string nick) {
        foreach (roster; [&channelUsers, &namesBurst]) {
            if (auto users = chan in *roster)
                for (size_t i = users.length; i > 0; --i)
                    if (sameNick((*users)[i - 1], nick)) *users = (*users).remove(i - 1);
        }
        namesBurstIndex.remove(chan);
    }

