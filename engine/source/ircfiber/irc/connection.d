@("egress trial: a client settles its trial only through the fenced store, and carries it across a swap")
unittest {
    auto savedStore = gAdmissionStore;
    scope(exit) gAdmissionStore = savedStore;
    auto store = new ScriptedAdmissionStore;
    gAdmissionStore = store;
    NetworkConfig cfg;
    cfg.nick = "me";
    auto ch = EngineEventChannel.create();
    scope(exit) ch.close();
    auto c = new PersistentIRCClient(cfg, ch);
    const exit = EgressEndpointRef("north", "socks-north.example", 1080);
    void claim() {
        c.egressTrialToken = "nonce:9";
        c.egressTrialExit = exit;
        store.openTrials["nonce:9"] = "north";
        store.verdicts = null;
    }

    // Registration marks the trial; the hot-swap snapshot carries ownership.
    claim();
    c.state = ConnectionState.connected;
    c.connectedAtMs = nowMsSafe();
    c.renewEgressTrialOnRegistered();
    assert("nonce:9" in store.registeredTrials && c.egressTrialToken == "nonce:9");
    auto snap = c.snapshotSession(true);
    import ircfiber.engine.session_snapshot : snapshotFromJSON = fromJSON;
    auto back = snapshotFromJSON(toJSON(snap));
    assert(back.egressTrialToken == "nonce:9" && back.egressTrialHost == "socks-north.example"
        && back.egressTrialPort == 1080 && back.egressLabel == c.activeEgressLabel);
    string pong(long sentMs) { return ":irc.example PONG irc.example :" ~ lagPingToken(sentMs); }
    // A keepalive answered inside the sustain window proves nothing.
    const inWindow = nowMsSafe();
    c.noteEgressTrialProbe(inWindow);
    c.processLine(pong(inWindow));
    assert(store.verdicts.length == 0 && c.egressTrialToken == "nonce:9");
    // Registered past the window: only the PONG to a PING sent after it heals.
    c.connectedAtMs = nowMsSafe() - EGRESS_TRIAL_SUSTAIN_MS - 1_000;
    const probe = nowMsSafe();
    c.noteEgressTrialProbe(probe);
    c.processLine(pong(probe - 1));
    assert(store.verdicts.length == 0, "an older or foreign PONG proves nothing");
    c.processLine(pong(probe));
    assert(store.verdicts == ["north:success"] && c.egressTrialToken == "" && store.openTrials.length == 0);

    // Registered well past the window but never answered (silent drop):
    // the session's end fails the trial — uptime alone never heals.
    claim();
    c.connectedAtMs = nowMsSafe() - 10 * EGRESS_TRIAL_SUSTAIN_MS;
    c.noteEgressTrialProbe(nowMsSafe());
    c.settleEgressTrialOnEnd(10 * EGRESS_TRIAL_SUSTAIN_MS, false);
    assert(store.verdicts == ["north:failure"] && c.egressTrialToken == "" && store.openTrials.length == 0);
    // An engine stop releases the claim without penalty.
    claim();
    c.settleEgressTrialOnEnd(0, true);
    assert(store.verdicts == ["north:abort"]);
    // Answered locally but refused by the store's clock: not healed, the
    // trial stays owned and needs a later probe.
    claim();
    store.refuseSuccessAsEarly = true;
    c.connectedAtMs = nowMsSafe() - 2 * EGRESS_TRIAL_SUSTAIN_MS;
    const refused = nowMsSafe();
    c.noteEgressTrialProbe(refused);
    c.processLine(pong(refused));
    assert(store.verdicts.length == 0 && c.egressTrialToken == "nonce:9");
    store.refuseSuccessAsEarly = false;
    // A trial cancelled store-side (drain) or expired stops speaking for the
    // exit: the session continues, but nothing it does settles the exit.
    claim();
    store.trialsCancelled = true;
    c.renewEgressTrialOnRegistered();
    assert(c.egressTrialToken == "" && c.state == ConnectionState.connected);
    const late = nowMsSafe();
    c.noteEgressTrialProbe(late);
    c.processLine(pong(late));
    c.settleEgressTrialOnEnd(10 * EGRESS_TRIAL_SUSTAIN_MS, false);
    assert(store.verdicts.length == 0, "a cancelled trial never heals or fails the exit");
}
// ── Nick prefix helpers ───────────────────────────────────────────────────────
//
// Every char a server can put in front of a nick in NAMES, highest rank
// first. `*` is InspIRCd's <operprefix> and `!` its <ojoin>; the rest are
// the usual status modes. With `multi-prefix` (which this engine always
// requests) a nick arrives carrying the WHOLE run it holds — an opered
// channel founder is `*~@+Zodiac` — so every one of these helpers works on
// the run, not on nick[0]. Treating only `~&@%+` as prefixes made
// `*~@+Zodiac` look like a bare nick: `sameNick` stopped matching it, and
// the 352 handler "promoted" it by replacing the run with the single char
// from the WHO flags, which is how the channel owner ended up rendered as
// an op.
private enum nickPrefixChars = "*!~&@%+";

private bool isNickPrefixChar(char c) @safe pure nothrow @nogc {
    foreach (p; nickPrefixChars) if (p == c) return true;
    return false;
}

/// Length of the leading run of prefix chars (0 when the nick is bare).
private size_t nickPrefixRun(string nick) @safe pure nothrow @nogc {
    size_t i = 0;
    while (i < nick.length && isNickPrefixChar(nick[i])) i++;
    return i;
}

private string stripNickPrefix(string nick) {
    nick = nick[nickPrefixRun(nick) .. $];
    // Strip hostmask suffix when userhost-in-names is active (nick!user@host)
    auto bang = nick.indexOf("!");
    if (bang > 0) nick = nick[0 .. bang];
    return nick;
}

private string nickPrefix(string nick) {
    return nick[0 .. nickPrefixRun(nick)];
}

/// A NAMES burst is milliseconds of wire. A pending one still open after
/// this lost its 366 (the connection dropped mid-reply), so the next NAMES
/// starts a new burst instead of appending to it — otherwise a member who
/// left in between would be resurrected by the merge.
private enum NAMES_BURST_STALE_SECS = 60;

/// Folds `entry` (`[prefix]nick[!user@host]`) into `roster`, keyed on the
/// bare nick per CASEMAPPING `mapping`: one member is one entry, whatever
/// spelling the server used.
///
/// IRC hands the same member out several ways — bare from a JOIN echo,
/// `nick!user@host` from 353 under userhost-in-names, and a re-identted
/// form once the ircd re-derives the ident from a new nick (`~Zodiac` →
/// `~Zodiac_`). An exact-string `canFind` treats all of those as strangers,
/// so the roster grew one "member" per spelling: #tclmafia held `Zodiac_`
/// three times over.
///
/// The merge keeps the richer half of each side: a prefix run the server
/// just stated wins, an absent one keeps what we already hold (a bare JOIN
/// echo must not silently deop anybody), and a hostmask is never traded
/// back for a bare nick.
string[] upsertRosterEntry(string[] roster, string entry, string mapping) {
    if (entry.length == 0) return roster;
    const bare = stripNickPrefix(entry);
    if (bare.length == 0) return roster;
    foreach (i, existing; roster) {
        if (!nicksEqualMapped(stripNickPrefix(existing), bare, mapping)) continue;
        roster[i] = mergeRosterEntry(existing, entry);
        return roster;
    }
    roster ~= entry;
    return roster;
}

private string mergeRosterEntry(string existing, string entry) {
    // `!` is itself an ojoin prefix; inspect only the body for a hostmask.
    const newBody = entry[nickPrefixRun(entry) .. $];
    const oldBody = existing[nickPrefixRun(existing) .. $];
    const newPrefix = nickPrefix(entry);
    return (newPrefix.length ? newPrefix : nickPrefix(existing))
         ~ (newBody.indexOf("!") > 0 ? newBody : oldBody);
}

/// Only indexes the pending roster, never a second array of member strings.
/// Churn invalidates it before changing positions/nicks; the next insert
/// rebuilds once. A CASEMAPPING change likewise rebuilds before lookup.
private struct NamesBurstIndex {
    size_t[string] positions;
    string mapping;
    bool whoChecked;
    bool needsWho;
}

private string upsertNamesBurstEntry(ref string[] roster, ref NamesBurstIndex index,
                                  string entry, string mapping) {
    const bare = stripNickPrefix(entry);
    if (!bare.length) return "";
    if (index.mapping != mapping) {
        index.positions = null;
        foreach (i, existing; roster) {
            const key = foldNickMapped(stripNickPrefix(existing), mapping);
            // Match the public upsert's first-match rule even if a NICK
            // collision temporarily left two entries for the same nick.
            if (key !in index.positions) index.positions[key] = i;
        }
        index.mapping = mapping;
        index.whoChecked = false;
    }
    const key = foldNickMapped(bare, mapping);
    if (auto position = key in index.positions) {
        roster[*position] = mergeRosterEntry(roster[*position], entry);
        return roster[*position];
    } else {
        index.positions[key] = roster.length;
        roster ~= entry;
        return entry;
    }
}

/// The roster a completed NAMES burst installs over the one we held.
///
/// The burst is the server's whole answer for the channel, so a member it
/// does not name is gone. That is the only thing that purges an entry no
/// event ever removed: a QUIT that landed while this engine was detached,
/// or our own pre-fallback nick after a 433 chain (`Zodiac` → `Zodiac_`),
/// which renames nothing because a pre-registration fallback gets no NICK
/// echo. Before this, 353 appended into the live roster and NAMES was
/// additive-only — a rejoin could add members but never drop one.
///
/// An empty burst is never authoritative: a truncated reply must not wipe a
/// roster (we are in the channel, so the server always names at least us).
///
/// A bare burst entry (no userhost-in-names) keeps the `!user@host` the
/// roster already held for that nick from JOIN/WHO/CHGHOST: a NAMES resync
/// must not throw away the identity peer discovery checks a source against.
string[] applyNamesBurst(string[] previous, string[] burst, string mapping = "rfc1459") {
    if (!burst.length) return previous;
    string[string] previousHosts;
    bool indexed;
    foreach (ref entry; burst) {
        if (rosterHostSuffix(entry).length) continue;
        // Build lazily: userhost-in-names needs no previous-roster index.
        if (!indexed) {
            foreach (old; previous) {
                const suffix = rosterHostSuffix(old);
                if (!suffix.length) continue;
                const key = foldNickMapped(stripNickPrefix(old), mapping);
                if (key !in previousHosts) previousHosts[key] = suffix;
            }
            indexed = true;
        }
        const key = foldNickMapped(stripNickPrefix(entry), mapping);
        if (auto suffix = key in previousHosts) entry ~= *suffix;
    }
    return burst;
}

/// The `!user@host` tail of a roster entry, "" when it carries none. `!` is
/// itself a prefix char (ojoin), so the tail is looked for past the run.
string rosterHostSuffix(string entry) @safe pure nothrow {
    const body = entry[nickPrefixRun(entry) .. $];
    const bang = body.indexOf('!');
    return bang > 0 && body.indexOf('@') > bang ? body[bang .. $] : "";
}

/// The single strongest status char across a member's prefix runs.
///
/// A roster can hold the same member more than once — the bare nick from
/// our own JOIN echo plus the prefixed form from 353 — and a run itself can
/// carry several chars (`~@`). `nickPrefixChars` is ordered most- to
/// least-privileged, so the lowest index in it wins. "" when the member
/// holds no status anywhere.
string strongestPrefix(const(string)[] runs) @safe pure nothrow {
    string best;
    size_t bestRank = nickPrefixChars.length;
    foreach (run; runs) {
        foreach (c; run) {
            size_t rank = nickPrefixChars.length;
            foreach (i, p; nickPrefixChars) if (p == c) { rank = i; break; }
            if (rank < bestRank) { bestRank = rank; best = [c].idup; }
        }
    }
    return best;
}

@safe unittest {
    // Ranking, not first-seen: 353's `@nick` must not beat `~nick`.
    assert(strongestPrefix(["@", "~"]) == "~");
    assert(strongestPrefix(["~", "@"]) == "~");
    assert(strongestPrefix(["", "+"]) == "+");
    assert(strongestPrefix(["~@+"]) == "~");
    assert(strongestPrefix(["%", "&"]) == "&");
    // An IRC operator entry outranks channel status (IRCCloud shows `*`).
    assert(strongestPrefix(["@", "*"]) == "*");
    // No status anywhere => no tag, which must read like an empty value.
    assert(strongestPrefix([]) == "");
    assert(strongestPrefix(["", ""]) == "");
    // Junk in a roster entry is ignored rather than emitted.
    assert(strongestPrefix(["z"]) == "");
}

/// Sweeps per channel per connection before the engine gives up asking.
enum int MAX_WHO_ENRICH_ATTEMPTS = 3;

/// Whether `member` (`@nick`, `nick!user@host`, or bare) still needs a
/// realname probe. `probed` records nicks the server has already answered
/// for — `realnames` cannot double as that record because an answer equal
/// to the nick is deliberately not stored.
bool memberNeedsRealname(string member, const string[string] realnames,
                         const bool[string] probed) {
    const bare = stripNickPrefix(member);
    if (bare.length == 0) return false;
    return (bare !in realnames) && (bare !in probed);
}

/// Whether the realname sweep should still issue `WHO <chan>`.
/// `attempts` = sweeps already sent for this channel on this connection.
bool channelNeedsRealnameWho(const string[] members,
                             const string[string] realnames,
                             const bool[string] probed,
                             int attempts,
                             int maxAttempts = MAX_WHO_ENRICH_ATTEMPTS) {
    if (attempts >= maxAttempts) return false;
    foreach (m; members)
        if (memberNeedsRealname(m, realnames, probed)) return true;
    return false;
}

/// One WHO written to the server whose RPL_ENDOFWHO (315) has not arrived.
/// A server answers commands in the order it reads them, so the oldest
/// pending WHO owns every 352/354 row that arrives. That ownership is what
/// separates a client's own WHO (the E2EE roster probe `WHO #chan %na`, a
/// `/raw WHO`) from the engine's realname sweep: the sweep's rows feed
/// engine state and stay unpublished, a client's rows go to the client.
struct PendingWho {
    string mask;    /// the WHO target as sent; 315 echoes it back
    string fields;  /// WHOX field letters (`na` for `%na`), "" for plain WHO
    bool   client;  /// a client sent it: its replies are published
    long   sentAt;  /// unix seconds; an answer that never comes ages out
}

/// Seconds a WHO may go unanswered before it stops owning reply rows.
enum long WHO_REPLY_TIMEOUT_SECS = 30;

/// WHOs tracked at once; past it the oldest is forgotten.
enum size_t MAX_PENDING_WHOS = 64;

/// Splits an outgoing `WHO <mask> [%fields[,token]]` line. False when
/// `line` is not a WHO with a target. `fields` is "" for a plain WHO.
bool parseWhoLine(string line, out string mask, out string fields) @safe pure {
    import std.array : split;
    import std.string : indexOf, toUpper;
    auto parts = line.split();
    if (parts.length < 2 || parts[0].toUpper != "WHO") return false;
    mask = parts[1];
    if (parts.length > 2 && parts[2].length > 1 && parts[2][0] == '%') {
        const spec = parts[2][1 .. $];
        const comma = spec.indexOf(',');
        fields = comma >= 0 ? spec[0 .. comma] : spec;
    }
    return true;
}

/// Field `f` of a WHOX (354) row answering a request for `fields`, ""
/// when the request did not ask for it. A row carries the requested
/// fields in the spec's fixed order `tcuihsnfdlaor`, whatever order the
/// request named them in; `params[0]` is our own nick.
string whoxField(const string[] params, string fields, char f) @safe pure {
    import std.string : indexOf;
    if (fields.indexOf(f) < 0) return "";
    size_t i = 1;
    foreach (c; "tcuihsnfdlaor") {
        if (c == f) return i < params.length ? params[i] : "";
        if (fields.indexOf(c) >= 0) i++;
    }
    return "";
}

@safe unittest {
    string mask, fields;
    assert(parseWhoLine("WHO #c %na", mask, fields) && mask == "#c" && fields == "na");
    assert(parseWhoLine("who #c %tcuhnfar,152", mask, fields) && fields == "tcuhnfar");
    assert(parseWhoLine("WHO #c", mask, fields) && mask == "#c" && fields == "");
    assert(parseWhoLine("WHO nick o", mask, fields) && fields == "");
    assert(!parseWhoLine("WHOIS bob", mask, fields));
    assert(!parseWhoLine("WHO", mask, fields));

    // Rows follow the spec order, not the request order.
    assert(whoxField(["me", "bob", "acct"], "an", 'n') == "bob");
    assert(whoxField(["me", "bob", "acct"], "na", 'a') == "acct");
    assert(whoxField(["me", "152", "#c", "u", "h", "bob", "H", "acct", "R"], "tcuhnfar", 'a') == "acct");
    assert(whoxField(["me", "bob"], "n", 'a') == "");
}

/// Channel status mode letter → the prefix char it renders as, `'\0'` for a
/// mode that takes no member target. `y`/`Y` are InspIRCd's operprefix and
/// ojoin modes: without them a `MODE #chan +yo nick1 nick2` consumed no
/// target for `y` and applied `o` to the wrong nick.
private char prefixForModeChar(char m) @safe pure nothrow @nogc {
    switch (m) {
        case 'q': return '~';
        case 'a': return '&';
        case 'o': case 'O': return '@';
        case 'h': return '%';
        case 'v': return '+';
        case 'y': return '*';
        case 'Y': return '!';
        default: return '\0';
    }
}

/// Add `p` to a member entry's prefix run, keeping the run in rank order.
/// Idempotent, and it never drops the other prefixes the member holds —
/// replacing the first char (what this used to do) turned `~alice` into
/// `+alice` on a `+v`, demoting an owner to voiced.
private string addNickPrefix(string entry, char p) @safe pure {
    const run = nickPrefixRun(entry);
    const bare = entry[run .. $];
    string kept;
    foreach (c; nickPrefixChars) {
        if (c == p) { kept ~= c; continue; }
        foreach (h; entry[0 .. run]) if (h == c) { kept ~= c; break; }
    }
    return kept ~ bare;
}

/// Remove exactly `p` from a member entry's prefix run, leaving any other
/// status the member still holds in place.
private string removeNickPrefix(string entry, char p) @safe pure {
    const run = nickPrefixRun(entry);
    string kept;
    foreach (c; entry[0 .. run]) if (c != p) kept ~= c;
    return kept ~ entry[run .. $];
}

@("nick prefix helpers handle a multi-prefix run")
unittest {
    assert(stripNickPrefix("*~@+Zodiac") == "Zodiac");
    assert(stripNickPrefix("Zodiac") == "Zodiac");
    assert(stripNickPrefix("@bob!user@host") == "bob");
    assert(nickPrefix("*~@+Zodiac") == "*~@+");
    assert(nickPrefix("bare") == "");
    // Rank order is preserved and an already-held prefix is a no-op.
    assert(addNickPrefix("@bob", '~') == "~@bob");
    assert(addNickPrefix("~@bob", '+') == "~@+bob");
    assert(addNickPrefix("~@bob", '@') == "~@bob");
    assert(addNickPrefix("bob", '+') == "+bob");
    // Removing one status keeps the others.
    assert(removeNickPrefix("*~@+Zodiac", '+') == "*~@Zodiac");
    assert(removeNickPrefix("*~@Zodiac", '~') == "*@Zodiac");
    assert(removeNickPrefix("bob", '@') == "bob");
}

// ── CASEMAPPING-aware nick comparison ─────────────────────────────────────────
// modern.ircdocs.horse (Implementation Notes → Casemapping) asks clients to
// discover CASEMAPPING from RPL_ISUPPORT and casefold nick/channel keys
// with it. Servers differ: "ascii" folds A-Z only, "rfc1459" additionally
// maps []\^ → {}|~, "rfc1459-strict" maps []\ → {|} but leaves ^ and ~
// distinct. Unknown values fall back to rfc1459 (the common default).

/// Fold one byte per the named CASEMAPPING. Pure — unit-testable.
char foldCaseChar(char c, string mapping) @safe pure nothrow @nogc {
    if (c >= 'A' && c <= 'Z') return cast(char)(c + ('a' - 'A'));
    if (mapping == "ascii") return c;
    switch (c) {
        case '[': return '{';
        case ']': return '}';
        case '\\': return '|';
        case '^': return (mapping == "rfc1459-strict") ? '^' : '~';
        default: return c;
    }
}

/// CASEMAPPING-aware equality for already-bare nicks. Pure.
bool nicksEqualMapped(string a, string b, string mapping) @safe pure nothrow {
    if (a.length != b.length) return false;
    foreach (i; 0 .. a.length) {
        if (foldCaseChar(a[i], mapping) != foldCaseChar(b[i], mapping))
            return false;
    }
    return true;
}

@("foldCaseChar ascii folds A-Z only")
unittest {
    assert(foldCaseChar('A', "ascii") == 'a');
    assert(foldCaseChar('[', "ascii") == '[');
    assert(foldCaseChar('^', "ascii") == '^');
}

@("foldCaseChar rfc1459 maps brackets and caret")
unittest {
    assert(foldCaseChar('[', "rfc1459") == '{');
    assert(foldCaseChar(']', "rfc1459") == '}');
    assert(foldCaseChar('\\', "rfc1459") == '|');
    assert(foldCaseChar('^', "rfc1459") == '~');
}

@("foldCaseChar strict leaves caret distinct")
unittest {
    assert(foldCaseChar('[', "rfc1459-strict") == '{');
    assert(foldCaseChar('^', "rfc1459-strict") == '^');
}

@("nicksEqualMapped folds case per mapping")
unittest {
    assert(nicksEqualMapped("Zod", "zod", "ascii"));
    assert(nicksEqualMapped("a[b", "a{b", "rfc1459"));
    assert(!nicksEqualMapped("a[b", "a{b", "ascii"));
    assert(!nicksEqualMapped("a^b", "a~b", "rfc1459-strict"));
    assert(nicksEqualMapped("a^b", "a~b", "rfc1459"));
    assert(!nicksEqualMapped("Zod", "Zod_", "rfc1459"));
}

/// `nick` folded per CASEMAPPING — the key for nick-indexed maps, so the
/// spellings `nicksEqualMapped` treats as one nick share one entry. Pure.
string foldNickMapped(string nick, string mapping) @safe pure nothrow {
    string folded;
    folded.reserve(nick.length);
    foreach (c; nick) folded ~= foldCaseChar(c, mapping);
    return folded;
}

@("foldNickMapped gives every spelling of one nick one key")
unittest {
    foreach (m; ["ascii", "rfc1459", "rfc1459-strict"])
        foreach (pair; [["Bob", "bob"], ["a[b]", "A{B}"], ["x^y", "X~Y"], ["pizza``", "p34c3"]])
            assert((foldNickMapped(pair[0], m) == foldNickMapped(pair[1], m))
                   == nicksEqualMapped(pair[0], pair[1], m));
}

/// What the server has stated about this connection's own services login.
/// Only server statements count — 900/901 RPL_LOGGEDIN/OUT, a live self
/// `ACCOUNT`, a live self WHOX account field — never the configured SASL
/// username, user modes or the website account.
enum ServicesAccountState : ubyte {
    /// Not established for the live generation (not registered, or an
    /// attached engine that could not prove the account it inherited).
    unknown,
    /// Registered with no login observed on this connection.
    none,
    /// Logged in as the observed account.
    account,
}

/// Wire names of `ServicesAccountState` (NetworkStateSnapshot,
/// SERVICES_STATE event, frontend `Network.servicesAccountState`).
string servicesAccountStateName(ServicesAccountState s) @safe pure nothrow {
    final switch (s) {
        case ServicesAccountState.unknown: return "unknown";
        case ServicesAccountState.none:    return "none";
        case ServicesAccountState.account: return "account";
    }
}

/// Inverse of `servicesAccountStateName`; anything else (legacy META) is unknown.
ServicesAccountState parseServicesAccountState(string s) @safe pure nothrow {
    switch (s) {
        case "none":    return ServicesAccountState.none;
        case "account": return ServicesAccountState.account;
        default:        return ServicesAccountState.unknown;
    }
}

@("ServicesAccountState wire names round-trip; unknown text stays unknown")
unittest {
    foreach (s; [ServicesAccountState.unknown, ServicesAccountState.none, ServicesAccountState.account])
        assert(parseServicesAccountState(servicesAccountStateName(s)) == s);
    assert(parseServicesAccountState("") == ServicesAccountState.unknown);
    assert(parseServicesAccountState("Account") == ServicesAccountState.unknown);
}

/// The live connection as the services transport sees it. Same module as
/// `PersistentIRCClient`, so it reads the client's state directly.
private final class ConnectionServicesHost : ServicesHost {
    private PersistentIRCClient c;

    this(PersistentIRCClient client) { c = client; }

    long nowMs() { return unixMsNow(); }
    string liveEpoch() { return c.getConnectionEpoch(); }
    string ownNick() { return c.sessionNick; }
    bool isOwnNick(string nick) { return c.isOwnNick(nick); }
    bool sameNick(string a, string b) { return c.sameNick(a, b); }
    ServicesActor actor() { return c.servicesActor(); }
    ServicesConfig servicesConfig() { return c.effectiveServices(); }
    string isupport(string key) { return c.isupportMap.get(key, ""); }
    bool hasCapability(string name) { return c.hasCap(name); }
    string capabilityValue(string name) { return c.capValues.get(name, ""); }
    string socketIdentity() { return c.holderConnId.length ? c.holderConnId : c.nativeSocketId; }

    size_t lineLimit() {
        if (auto v = "LINELEN" in c.isupportMap) {
            try {
                const n = (*v).to!long;
                if (n >= 64 && n <= 65_536) return cast(size_t) n;
            } catch (Exception) {}
        }
        return 512;
    }

    /// `:` + `nick!user@host` + space; the IRCv3 worst case (105) when our
    /// own prefix is not known yet.
    size_t ownPrefixBytes() {
        return 2 + (c.ownHostmask.length ? c.ownHostmask.length : 105);
    }

    bool manualLinePending(string serviceNick) {
        bool addressed(string line) {
            auto t = PersistentIRCClient.messageTargetOf(line);
            const at = t.indexOf('@');
            if (at >= 0) t = t[0 .. at];
            return t.length && c.sameNick(t, serviceNick);
        }
        foreach (entry; c.pacedQueue) if (addressed(entry.line)) return true;
        foreach (l; c.outboundQueue) if (addressed(l)) return true;
        return false;
    }

    void wake() {
        if (!c.servicesWakeDeferred) c.drainServicesQueue();
    }

    void markerChanged() {
        c.markMetaDirty();
        c.servicesMarkerDirty = true;
    }

    void adoptOwnAccount(string account) {
        if (account.length) c.observeOwnAccount(account);
    }

    bool ownChannelStatus(string channel, out string prefixes) {
        return c.ownChannelStatus(channel, prefixes);
    }
}

/// Whether the user renaming away from a tracked DM nick is the person that
/// conversation was held with, so the DM may follow the rename. A nick is
/// not an identity: anyone can take one the moment its holder drops it, and
/// following on the nick alone carried a conversation onto whoever held the
/// nick last. The services account decides when both sides carry one, else
/// user@host; when neither side proves it, the DM stays where it is. Pure.
bool dmFollowsNick(string knownAccount, string knownHostmask,
                   string account, string hostmask) @safe pure nothrow {
    if (knownAccount.length && account.length)
        return nicksEqualMapped(knownAccount, account, "ascii");
    return knownHostmask.length && hostmask.length
        && nicksEqualMapped(knownHostmask, hostmask, "ascii");
}

@("dmFollowsNick follows only the person the DM was held with")
unittest {
    // Same user@host, no services account on either side: they renamed.
    assert(dmFollowsNick("", "~user@788114F4.IP", "", "~user@788114f4.ip"));
    // Someone else briefly holding the nick (the p34c3 -> pizza` report).
    assert(!dmFollowsNick("", "~user@788114F4.IP", "", "~stillfree@B6A09300.IP"));
    // The account decides when both carry one: a new address is still them…
    assert(dmFollowsNick("p34c3", "~user@1.IP", "P34C3", "~user@2.IP"));
    // …and the old address under another account is not.
    assert(!dmFollowsNick("p34c3", "~user@1.IP", "other", "~user@1.IP"));
    // An account on one side only falls back to user@host.
    assert(dmFollowsNick("p34c3", "~user@1.IP", "", "~user@1.IP"));
    assert(!dmFollowsNick("", "~user@1.IP", "p34c3", "~user@2.IP"));
    // Nothing known about the counterparty: a nick alone never follows.
    assert(!dmFollowsNick("", "", "", "~user@1.IP"));
    assert(!dmFollowsNick("", "~user@1.IP", "", ""));
}

// ── MONITOR command builder (IRCv3 monitor) ───────────────────────────────────
// Verbs: "+" / "-" (targets required, comma-separated nicks),
// "C" (clear), "L" (list), "S" (status query). Returns null when the
// verb/target combination is invalid.

/// Build a MONITOR wire line. Pure — unit-testable.
string buildMonitorLine(string verb, string targets) @safe pure {
    import std.uni : toUpper;
    auto v = toUpper(verb);
    if (v == "+" || v == "-") {
        if (targets.length == 0) return null;
        return "MONITOR " ~ v ~ " " ~ targets;
    }
    if (v == "C" || v == "L" || v == "S") return "MONITOR " ~ v;
    return null;
}

@("buildMonitorLine builds +/- with targets")
unittest {
    assert(buildMonitorLine("+", "alice,bob") == "MONITOR + alice,bob");
    assert(buildMonitorLine("-", "alice") == "MONITOR - alice");
}

@("buildMonitorLine builds bare C/L/S verbs")
unittest {
    assert(buildMonitorLine("C", "") == "MONITOR C");
    assert(buildMonitorLine("l", "") == "MONITOR L");
    assert(buildMonitorLine("S", "") == "MONITOR S");
}

@("buildMonitorLine rejects empty targets and unknown verbs")
unittest {
    assert(buildMonitorLine("+", "") is null);
    assert(buildMonitorLine("-", "") is null);
    assert(buildMonitorLine("X", "alice") is null);
}

/// `MONITOR <verb> a,b,…` lines for `nicks`, each holding at most
/// `maxEntries` targets (0 = unlimited, the ISUPPORT `MONITOR` value) and
/// at most `maxBytes` bytes. Empty for no nicks.
string[] monitorLines(string verb, const string[] nicks, size_t maxEntries, size_t maxBytes = 400) @safe pure {
    string[] lines;
    const head = "MONITOR " ~ verb ~ " ";
    string cur;
    size_t count;
    foreach (n; nicks) {
        if (n.length == 0) continue;
        const full = (maxEntries > 0 && count >= maxEntries)
            || (count > 0 && head.length + cur.length + 1 + n.length > maxBytes);
        if (full) { lines ~= head ~ cur; cur = ""; count = 0; }
        cur = count ? cur ~ "," ~ n : n;
        ++count;
    }
    if (count) lines ~= head ~ cur;
    return lines;
}

@("monitorLines chunks by entry count and line length")
unittest {
    assert(monitorLines("+", [], 0) == []);
    assert(monitorLines("+", ["a", "b", "c"], 0) == ["MONITOR + a,b,c"]);
    assert(monitorLines("-", ["a", "b", "c"], 2) == ["MONITOR - a,b", "MONITOR - c"]);
    // "MONITOR + " is 10 bytes; 10 + "aaaa,bbbb" = 19 fits a 19-byte cap.
    assert(monitorLines("+", ["aaaa", "bbbb", "cccc"], 0, 19) == ["MONITOR + aaaa,bbbb", "MONITOR + cccc"]);
}

// ── draft/metadata-2 own keys ────────────────────────────────────────────────
// Value validation lives in `ircfiber.metadata.isValidMetadataValue`.

/// Lines that move our published metadata `key` from `oldValue` to
/// `newValue`: nothing when unchanged, a SET with value, or a valueless
/// SET to clear.
string[] metadataCommands(string key, string oldValue, string newValue) @safe pure {
    if (oldValue == newValue) return [];
    if (newValue.length) return ["METADATA * SET " ~ key ~ " :" ~ newValue];
    return ["METADATA * SET " ~ key];
}

/// Moves `m[from]` to `m[to]` (no-op when `from` is absent or equal).
void moveKey(V)(ref V[string] m, string from, string to) {
    if (from == to) return;
    if (auto p = from in m) {
        auto v = *p;
        m.remove(from);
        m[to] = v;
    }
}

/// Deep copy of an `outer → key → value` metadata map (`.dup` alone would
/// share the inner maps).
string[string][string] dupNested(const string[string][string] m) @safe pure {
    string[string][string] r;
    foreach (k, inner; m) {
        string[string] row;
        foreach (ik, iv; inner) row[ik] = iv;
        r[k] = row;
    }
    return r;
}

@("metadataCommands publishes, clears, or stays quiet")
unittest {
    assert(metadataCommands("avatar", "", "https://u") == ["METADATA * SET avatar :https://u"]);
    assert(metadataCommands("avatar", "https://u", "") == ["METADATA * SET avatar"]);
    assert(metadataCommands("avatar", "https://u", "https://u") == []);
    assert(metadataCommands("avatar", "", "") == []);
    assert(metadataCommands("pronouns", "", "they/them") == ["METADATA * SET pronouns :they/them"]);
}

// ── Lag probe + TLS detail helpers ───────────────────────────────────────────

/// Current wall-clock time in unix milliseconds.
private long unixMsNow() @safe {
    import std.datetime.systime : unixTimeToStdTime;
    return (Clock.currStdTime - unixTimeToStdTime(0)) / 10_000;
}

/// Wire token for the keepalive lag probe: `PING :LAG<sentUnixMs>`.
/// The server echoes the token back in PONG so the round trip can be
/// measured without any per-connection bookkeeping beyond the
/// outstanding send timestamp.
string lagPingToken(long sentMs) @safe pure {
    return "LAG" ~ sentMs.to!string;
}

/// Extracts the send timestamp from a PONG parameter produced by
/// `lagPingToken`. Returns -1 when the parameter is not a lag token
/// (e.g. a server-initiated PONG or a legacy `keepalive` reply).
long parseLagPongParam(string param) @safe pure nothrow {
    if (param.length <= 3 || param[0 .. 3] != "LAG") return -1;
    foreach (c; param[3 .. $]) if (c < '0' || c > '9') return -1;
    try return param[3 .. $].to!long;
    catch (Exception) return -1;
}

/// Formats a unix-ms timestamp as `YYYY-MM-DD` (UTC).
string formatUnixMsDate(long ms) @safe {
    import std.datetime.systime : SysTime;
    import std.datetime.timezone : UTC;
    return SysTime.fromUnixTime(ms / 1000, UTC()).toISOExtString()[0 .. 10];
}

/// Builds the `tls_done` server-log line. With TLS details present the
/// line reads `TLS handshake complete — <version> · <cipher> · cert <CN>
/// (issuer <issuer>, expires <YYYY-MM-DD>)`; otherwise the generic
/// fallback is returned.
string formatTlsDoneText(bool hasInfo, TlsInfo info, string fallback) @safe {
    if (!hasInfo) return fallback;
    return "TLS handshake complete — " ~ info.version_ ~ " · " ~ info.cipher
        ~ " · cert " ~ info.certCn ~ " (issuer " ~ info.certIssuer
        ~ ", expires " ~ formatUnixMsDate(info.certNotAfterMs) ~ ")";
}

@("lagPingToken / parseLagPongParam round-trip")
unittest {
    assert(lagPingToken(1_700_000_000_123) == "LAG1700000000123");
    assert(parseLagPongParam("LAG1700000000123") == 1_700_000_000_123);
    assert(parseLagPongParam("keepalive") == -1);
    assert(parseLagPongParam("LAG") == -1);
    assert(parseLagPongParam("LAGabc") == -1);
    assert(parseLagPongParam("") == -1);
}

@("formatTlsDoneText renders details or falls back")
unittest {
    auto info = TlsInfo("TLSv1.3", "TLS_AES_256_GCM_SHA384", "irc.example.org", "R11", 1_704_067_200_000);
    assert(formatTlsDoneText(true, info, "fallback")
        == "TLS handshake complete — TLSv1.3 · TLS_AES_256_GCM_SHA384 · cert irc.example.org (issuer R11, expires 2024-01-01)");
    assert(formatTlsDoneText(false, info, "fallback") == "fallback");
}

// ── mIRC color / formatting strip ────────────────────────────────────────────

/// Strip mIRC color codes and formatting characters from a string.
/// Codes: \x03 (color), \x02 (bold), \x1D (italic), \x1F (underline),
///        \x1E (strikethrough), \x11 (monospace), \x16 (reverse), \x0F (reset)
string stripMircFormatting(string s) {
    import std.array : Appender;
    Appender!string buf;
    buf.reserve(s.length);
    size_t i = 0;
    while (i < s.length) {
        char c = s[i];
        if (c == '\x03') {
            // \x03[fg[,bg]]  — skip up to 2 optional digit groups
            i++;
            if (i < s.length && s[i] >= '0' && s[i] <= '9') {
                i++;
                if (i < s.length && s[i] >= '0' && s[i] <= '9') i++;
                if (i < s.length && s[i] == ',') {
                    i++;
                    if (i < s.length && s[i] >= '0' && s[i] <= '9') {
                        i++;
                        if (i < s.length && s[i] >= '0' && s[i] <= '9') i++;
                    }
                }
            }
        } else if (c == '\x02' || c == '\x1D' || c == '\x1F' || c == '\x1E' ||
                   c == '\x11' || c == '\x16' || c == '\x0F') {
            i++;
        } else {
            buf.put(c);
            i++;
        }
    }
    return buf.data;
}

// ── CTCP helpers ──────────────────────────────────────────────────────────────

private enum CTCP_DELIM = '\x01';

private bool isCtcp(string text) {
    return text.length >= 3 && text[0] == CTCP_DELIM && text[$ - 1] == CTCP_DELIM
        && text[1] != ' ' && text[1 .. $ - 1].indexOf(CTCP_DELIM) < 0;
}

/// Extract CTCP command and optional parameter from a message text.
/// Returns ("", "") if not a CTCP message.
private string[2] parseCtcp(string text) {
    if (!isCtcp(text)) return ["", ""];
    auto inner = text[1 .. $ - 1];
    auto sp    = inner.indexOf(" ");
    if (sp >= 0) return [inner[0 .. sp], inner[sp + 1 .. $]];
    return [inner, ""];
}

/// Build a CTCP reply string (NOTICE).
private string ctcpReply(string command, string param) {
    if (param.length > 0)
        return "\x01" ~ command ~ " " ~ param ~ "\x01";
    return "\x01" ~ command ~ "\x01";
}

/// Pops the next CRLF-terminated line off `partial`, sanitized as one unit so a
/// UTF-8 sequence split across two socket reads decodes whole. False when no
/// complete line is buffered; an empty line yields "".
package(ircfiber) bool popInboundLine(ref char[] partial, out string line) {
    const idx = partial.indexOf("\r\n");
    if (idx < 0) return false;
    line = idx > 0 ? sanitizeUtf8(cast(string) partial[0 .. idx]) : "";
    partial = partial[idx + 2 .. $];
    return true;
}

// ── ISUPPORT (005) ────────────────────────────────────────────────────────────

/// Key server features extracted from 005 ISUPPORT messages. Legacy
/// struct kept for downstream code that consumes only the 6 most-used
/// tokens — new code should use `PersistentIRCClient.isupportMap`
/// (and its getter `getIsupport()`) to read the *full* feature
/// inventory that the server advertised.
struct ServerFeatures {
    string network;      /// NETWORK=<name>
    string prefix = "@+"; /// PREFIX=(ov)@+  — mode-char to symbol pairs
    string chanModes;    /// CHANMODES=A,B,C,D
    int maxChannels = 0; /// CHANLIMIT=#:N
    int maxNickLen  = 30;/// NICKLEN=N
    int topicLen    = 0; /// TOPICLEN=N
}

/// W1-T01: structured retry state surfaced from the engine's
/// reconnect loop. The frontend renders the ordinal "Nth attempt"
/// label from `attemptCount`, the 1s countdown from `nextRetryAtMs`,
/// and the "Reconnecting…" state badge from `delayMs`. Nullable in
/// the snapshot sense — zero-valued RetryStatus means "no retry
/// scheduled" so the snapshot writer can ship a uniform JSON object
/// without nullable handling (and the WS sync payload conditionally
/// omits the field when both fields are zero).
///
/// Serialised by `NetworkStateSnapshot.toJson()` / deserialised by
/// `NetworkStateSnapshot.fromJson()` in ircfiber/redis/protocol.d.
struct RetryStatus {
    /// 1-based reconnect attempt number. 0 when no retry is pending.
    int  attemptCount;
    /// Unix-ms of the scheduled next reconnect attempt. 0 when no
    /// retry is pending.
    long nextRetryAtMs;
    /// Scheduled delay in milliseconds (informational; the live
    /// countdown is derived from `nextRetryAtMs - now`).
    long delayMs;
}

/// W1-T01: structured disconnect information built by
/// `parseReasonToFailInfo` and emitted via
/// `IRCRawEvent.makeConnectionFail`. The frontend reads the nested
/// shape from the wire and renders IRCCloud-style failure messages
/// (Wave 2 renderReasons.ts) — `type` selects the branch, `reason`
/// is the IRCCloud `RENDER_REASONS` key, `killedReason` carries the
/// kill description for `type=="killed"`, and `sslVerifyError` is
/// the nested {type, error} object for SSL verification failures
/// (per plan B2 — MUST be nested, not flat).
package(ircfiber) struct FailInfo {
    /// One of: "connecting_failed" | "killed" | "socket_closed" |
    /// "ssl_verify_error" | "connecting_restricted" | "connection_blocked" |
    /// "sasl_required" | "sasl_failed" (the last two only from
    /// `parkNetwork`: the network is parked until its SASL settings change).
    string type_;
    /// Raw reason key (matches IRCCloud's RENDER_REASONS table).
    /// Examples: "econnrefused", "nxdomain", "ssl_certificate_error",
    /// "killed", "crash", "pool_lost". For the SASL types: the complete
    /// user-facing sentence.
    string reason;
    /// When `type_=="killed"`, carries the kill description
    /// (e.g. "(Ghost)" for supernets.org's UnrealIRCd ghost
    /// protection). Empty for non-kill failures.
    string killedReason;
    /// Populated only when `reason=="ssl_certificate_error"` /
    /// `"ssl_verify_error"`; carries the structured SSL verify
    /// detail nested object `{type, error}` so the frontend can
    /// look up the human string via `renderSSLVerify`. `Json.init`
    /// (default) otherwise.
    Json sslVerifyError;
}

/// W1-T01: helper that builds the nested sslVerifyError Json object
/// so call-sites stay tidy and the wire shape matches the frontend's
/// TS interface exactly. Mirrors the helper documented in plan W1-T01
/// section C — kept `package(ircfiber)` so connection.d's helpers can
/// reach it without exposing FailInfo to the rest of the engine.
package(ircfiber) void setSSLVerify(ref FailInfo dst, string type_, string error) {
    auto inner = Json.emptyObject;
    inner["type"]  = type_;
    inner["error"] = error;
    dst.sslVerifyError = inner;
}

/// Parse a single ISUPPORT token like "PREFIX=(ov)@+" or "NICKLEN=30".
///
/// Side-effects:
///   · Legacy `ServerFeatures f` — patched with the 6 commonly-consumed
///     tokens (NETWORK, PREFIX, CHANMODES, NICKLEN, TOPICLEN,
///     CHANLIMIT) for backward compatibility.
///   · `string[string] map` — receives the FULL inventory keyed upper-
///     case so the frontend (which has a knowledge base of ~80 tokens
///     from RFC 2811/2812/7194 plus every documented IRCv3 extension)
///     can render the complete feature list.
///
/// ISUPPORT keys are case-insensitive per RFC 2812 — we always
/// uppercase them so consumers can do `if ("KICKLEN" in net.isupport)`
/// without worrying about how the server happened to spell the
/// trailing token.
private bool applyIsupport(
    ref ServerFeatures f,
    ref string[string] map,
    string token,
) {
    if (token.length == 0) return false;
    const withdrawing = token[0] == '-';
    if (withdrawing) token = token[1 .. $];
    const eq = token.indexOf("=");
    const rawKey = eq >= 0 ? token[0 .. eq] : token;
    if (rawKey.length == 0 || (withdrawing && eq >= 0)) return false;
    foreach (char c; rawKey)
        if (!(c >= 'A' && c <= 'Z') && !(c >= 'a' && c <= 'z')
            && !(c >= '0' && c <= '9')) return false;
    const key = toUpper(rawKey);
    if (withdrawing) {
        bool changed = map.remove(key);
        switch (key) {
            case "NETWORK":
                changed = changed || f.network != ServerFeatures.init.network;
                f.network = ServerFeatures.init.network; break;
            case "PREFIX":
                changed = changed || f.prefix != ServerFeatures.init.prefix;
                f.prefix = ServerFeatures.init.prefix; break;
            case "CHANMODES":
                changed = changed || f.chanModes != ServerFeatures.init.chanModes;
                f.chanModes = ServerFeatures.init.chanModes; break;
            case "NICKLEN":
                changed = changed || f.maxNickLen != ServerFeatures.init.maxNickLen;
                f.maxNickLen = ServerFeatures.init.maxNickLen; break;
            case "TOPICLEN":
                changed = changed || f.topicLen != ServerFeatures.init.topicLen;
                f.topicLen = ServerFeatures.init.topicLen; break;
            case "CHANLIMIT":
                changed = changed || f.maxChannels != ServerFeatures.init.maxChannels;
                f.maxChannels = ServerFeatures.init.maxChannels; break;
            default: break;
        }
        return changed;
    }
    const val = eq >= 0 ? token[eq + 1 .. $] : "";
    if (auto previous = key in map)
        if (*previous == val) return false;
    map[key] = val;

    switch (key) {
        case "NETWORK":   f.network     = val; break;
        case "PREFIX":    f.prefix      = val; break;
        case "CHANMODES": f.chanModes   = val; break;
        case "NICKLEN":
            try { f.maxNickLen = val.to!int; } catch (Exception) {}
            break;
        case "TOPICLEN":
            try { f.topicLen = val.to!int; } catch (Exception) {}
            break;
        case "CHANLIMIT":
            // format: #:50
            auto colon = val.indexOf(":");
            if (colon >= 0) {
                try { f.maxChannels = val[colon + 1 .. $].to!int; } catch (Exception) {}
            }
            break;
        default: break;
    }
    return true;
}

// ─────────────────────────────────────────────────────────────────────────────
// PersistentIRCClient
// ─────────────────────────────────────────────────────────────────────────────

/// How long (ms) to wait before sending auto-JOINs so the configured
/// `delaySeconds` (measured from `registrationStartMs`, i.e. ≈ TCP
/// connect) is satisfied. Returns 0 when no delay is configured or the
/// window has already elapsed — callers then join immediately.
///
/// Drives the SuperNETs/DangerousIRCd auto-join fix: those IRCds reject
/// JOIN inside the first 5s after connect with 421 "You must be connected
/// for at least 5 seconds before you can use this command".
long remainingJoinDelayMs(uint delaySeconds, long nowMs, long registrationStartMs) @safe pure nothrow {
    if (delaySeconds == 0) return 0;
    const elapsed = nowMs - registrationStartMs;
    const remaining = delaySeconds * 1000L - elapsed;
    return remaining > 0 ? remaining : 0;
}

@("remainingJoinDelayMs returns 0 when no delay is configured")
unittest {
    assert(remainingJoinDelayMs(0, 1_000_000, 900_000) == 0);
}

@("remainingJoinDelayMs waits out the full window right after connect")
unittest {
    // delay 6s, connected 100ms ago → wait 5.9s
    assert(remainingJoinDelayMs(6, 900_100, 900_000) == 5_900);
}

@("remainingJoinDelayMs returns 0 once the window has elapsed")
unittest {
    assert(remainingJoinDelayMs(6, 907_000, 900_000) == 0);
    assert(remainingJoinDelayMs(6, 906_000, 900_000) == 0);
}

/// Packs channel names into `JOIN` argument strings that stay inside the
/// 512-byte IRC line limit (`maxArgLen` counts only the argument, so the
/// caller's `"JOIN "` prefix and the CRLF have room).
///
/// One comma-joined JOIN per batch instead of one JOIN per channel: a
/// server that rate-limits *per command* (SuperNETs/DangerousIRCd answers
/// `421 … connected for at least 5 seconds` to every early JOIN) then
/// produces a single refusal to wait out, and the user's server log gets
/// one line instead of one per channel.
string[] joinBatches(const(string)[] chans, size_t maxArgLen = 400) pure @safe {
    string[] out_;
    string cur;
    foreach (chan; chans) {
        if (chan.length == 0) continue;
        if (cur.length == 0) {
            cur = chan;
            continue;
        }
        if (cur.length + 1 + chan.length > maxArgLen) {
            out_ ~= cur;
            cur = chan;
            continue;
        }
        cur ~= "," ~ chan;
    }
    if (cur.length) out_ ~= cur;
    return out_;
}

/// Parses the grace period out of an ERR_UNKNOWNCOMMAND (421) JOIN throttle,
/// e.g. SuperNETs' `421 <nick> JOIN :You must be connected for at least 5
/// seconds before you can use this command` (verified on
/// irc.supernets.org, openwater.supernets.org, 2026-09-05). Returns 0 when
/// the text is not a throttle notice, so callers can tell "the server is
/// making us wait" apart from a genuinely unknown command.
///
/// The server is the authority on its own window: reading the number here
/// means a network that says 10 seconds is honoured without configuration.
uint parseJoinThrottleSeconds(string text) @safe pure nothrow {
    import std.string : indexOf, toLower;
    if (text.length == 0) return 0;
    string lower;
    try { lower = toLower(text); } catch (Exception) { return 0; }
    immutable marker = "connected for at least";
    auto at = lower.indexOf(marker);
    if (at < 0) return 0;
    uint secs = 0;
    bool sawDigit = false;
    foreach (c; lower[at + marker.length .. $]) {
        if (c >= '0' && c <= '9') {
            sawDigit = true;
            secs = secs * 10 + cast(uint)(c - '0');
            if (secs > 600) return 600; // absurd window: clamp, never spin
        } else if (sawDigit) {
            break;
        } else if (c != ' ') {
            return 0; // digits must follow the marker, not prose
        }
    }
    return sawDigit ? secs : 0;
}

@("parseJoinThrottleSeconds reads the SuperNETs 421 text")
unittest {
    assert(parseJoinThrottleSeconds(
        "You must be connected for at least 5 seconds before you can use this command") == 5);
    assert(parseJoinThrottleSeconds(
        "You must be connected for at least 10 seconds before you can use this command") == 10);
}

@("parseJoinThrottleSeconds ignores unrelated 421 text")
unittest {
    assert(parseJoinThrottleSeconds("Unknown command") == 0);
    assert(parseJoinThrottleSeconds("") == 0);
    // Same shape, no number — must not be read as "wait 0".
    assert(parseJoinThrottleSeconds("You must be connected for at least a while") == 0);
}

@("parseJoinThrottleSeconds clamps an absurd window")
unittest {
    assert(parseJoinThrottleSeconds("connected for at least 99999 seconds") == 600);
}

/// Membership flap guard. A client stuck in a reconnect or re-JOIN loop
/// makes the ircd echo a fresh JOIN/PART/QUIT (each with its own msgid, so
/// storage dedup keeps every one) per iteration — 163 JOINs and 116 QUITs
/// from one nick in under a second on 2026-10-31 — and each is a row in
/// every member's channel view.
///
/// State and display are separate: the roster takes every line, so it is
/// never wrong. Only publishing is gated, per member per channel (our own
/// membership and KICKs never are):
///  - an echo (a line that changes nothing, e.g. JOIN while joined, once we
///    have published that member) is never published and costs nothing;
///  - the first MEMBER_FLAP_BURST lines in a MEMBER_FLAP_WINDOW_MS window are
///    relayed live, so ordinary churn (quit + rejoin, even twice) shows
///    exactly as before, with no delay;
///  - past that the member is flapping and further lines are held. Once it
///    settles (MEMBER_FLAP_QUIET_MS without a line), or every
///    MEMBER_FLAP_MAX_HOLD_MS while a storm goes on, the newest held line is
///    relayed iff the roster now differs from what downstream last saw.
/// Downstream therefore always converges on the true membership, with at
/// most BURST + 1 rows per member per channel per storm.
struct MemberFlap {
    string chan;          /// roster key; "" for a QUIT from a nick in no tracked channel
    string nick;
    bool   published;     /// membership downstream last saw
    long   windowStartMs; /// start of the current burst window
    uint   relayed;       /// lines relayed live in this window
    long   lastLineMs;    /// newest line, relayed or held
    long   holdSinceMs;   /// when this storm's first line was held; 0 = not holding
    IRCRawEvent pending;  /// newest held line, relayed on settle
}

enum MEMBER_FLAP_WINDOW_MS   = 10_000;
enum MEMBER_FLAP_BURST       = 4;
enum MEMBER_FLAP_QUIET_MS    = 3_000;
enum MEMBER_FLAP_MAX_HOLD_MS = 30_000;

/// Counts one membership line against `f`'s budget. True: relay it now
/// (`f.published` becomes `isIn`). False: hold it. Once holding, a member
/// stays held until `settleMemberFlap` releases it, even across a window.
bool admitMemberFlap(ref MemberFlap f, bool isIn, long nowMs) @safe pure nothrow {
    f.lastLineMs = nowMs;
    if (nowMs - f.windowStartMs >= MEMBER_FLAP_WINDOW_MS) {
        f.windowStartMs = nowMs;
        f.relayed = 0;
    }
    if (f.holdSinceMs == 0 && f.relayed < MEMBER_FLAP_BURST) {
        f.relayed++;
        f.published = isIn;
        return true;
    }
    if (f.holdSinceMs == 0) f.holdSinceMs = nowMs;
    return false;
}

enum MemberFlapDue { wait, settle, forget }

/// What the sweep does with `f` at `nowMs`: `settle` a holding member once it
/// went quiet or has been held MAX_HOLD; `forget` an idle one whose window
/// is over (nothing held, nothing left to count); otherwise `wait`.
MemberFlapDue memberFlapDue(const ref MemberFlap f, long nowMs) @safe pure nothrow {
    if (f.holdSinceMs == 0)
        return nowMs - f.lastLineMs >= MEMBER_FLAP_WINDOW_MS ? MemberFlapDue.forget : MemberFlapDue.wait;
    if (nowMs - f.lastLineMs >= MEMBER_FLAP_QUIET_MS || nowMs - f.holdSinceMs >= MEMBER_FLAP_MAX_HOLD_MS)
        return MemberFlapDue.settle;
    return MemberFlapDue.wait;
}

@("admitMemberFlap relays ordinary churn live and holds a storm")
unittest {
    MemberFlap f;
    // quit, rejoin, quit, rejoin: all live.
    foreach (i; 0 .. MEMBER_FLAP_BURST)
        assert(admitMemberFlap(f, i % 2 == 1, 1_000 + i));
    assert(f.published);
    // The next line in the window is held, and holding sticks even after
    // the window rolls over — only the sweep ends a storm.
    assert(!admitMemberFlap(f, false, 1_100));
    assert(f.published, "a held line does not move what downstream saw");
    assert(!admitMemberFlap(f, true, 1_000 + MEMBER_FLAP_WINDOW_MS + 1));
    assert(f.holdSinceMs == 1_100);
}

@("admitMemberFlap restores the full budget once the window has passed")
unittest {
    MemberFlap f;
    foreach (i; 0 .. MEMBER_FLAP_BURST) assert(admitMemberFlap(f, i % 2 == 0, 1_000));
    // Spent but not holding: the next window is a fresh budget.
    foreach (i; 0 .. MEMBER_FLAP_BURST)
        assert(admitMemberFlap(f, i % 2 == 0, 1_000 + MEMBER_FLAP_WINDOW_MS));
    assert(!admitMemberFlap(f, true, 1_000 + MEMBER_FLAP_WINDOW_MS));
}

@("memberFlapDue settles on quiet or max hold, forgets idle members")
unittest {
    MemberFlap f;
    assert(admitMemberFlap(f, true, 1_000));
    assert(memberFlapDue(f, 1_000 + MEMBER_FLAP_WINDOW_MS - 1) == MemberFlapDue.wait);
    assert(memberFlapDue(f, 1_000 + MEMBER_FLAP_WINDOW_MS) == MemberFlapDue.forget);

    MemberFlap h;
    h.holdSinceMs = 5_000;
    h.lastLineMs = 5_000;
    assert(memberFlapDue(h, 5_000 + MEMBER_FLAP_QUIET_MS - 1) == MemberFlapDue.wait);
    assert(memberFlapDue(h, 5_000 + MEMBER_FLAP_QUIET_MS) == MemberFlapDue.settle);
    // A storm that never goes quiet still settles every MAX_HOLD.
    h.lastLineMs = 5_000 + MEMBER_FLAP_MAX_HOLD_MS - 1;
    assert(memberFlapDue(h, 5_000 + MEMBER_FLAP_MAX_HOLD_MS - 1) == MemberFlapDue.wait);
    assert(memberFlapDue(h, 5_000 + MEMBER_FLAP_MAX_HOLD_MS) == MemberFlapDue.settle);
}

/// Lower-case phrases that, next to "sasl", mark a server refusal as a
/// demand to log in rather than a ban of the address. See
/// `isSaslRequiredRefusal`.
private immutable string[] SASL_REQUIRED_MARKERS = [
    "required", "need to identify", "need to authenticate",
    "must identify", "must authenticate",
];

/// True when a server's refusal names SASL as the way in, i.e. it rejects
/// this *unauthenticated* connection rather than the address:
///   - Libera's per-network gate (NOTICE, then ERROR "Closing Link: <ip>
///     (…)"): "SASL authentication to a NickServ account with a verified
///     email address is required to connect from your current network."
///   - Libera's account-exempt K-lines (465): "You are banned from this
///     server- SASL authentication to a verified NickServ account is
///     required."
///   - Solanum `need_sasl` auth blocks and UnrealIRCd `require
///     authentication` ("You need to identify/authenticate via SASL …").
/// Both Libera forms were captured from irc.libera.chat through the prod
/// Mullvad exits on 2026-10-26. A network that logs in with SASL gets in
/// through the same address, so these must never become egress bans.
bool isSaslRequiredRefusal(string text) @safe pure nothrow {
    import std.string : indexOf, toLower;
    if (text.length == 0) return false;
    string lower;
    try { lower = toLower(text); } catch (Exception) { return false; }
    if (lower.indexOf("sasl") < 0) return false;
    foreach (marker; SASL_REQUIRED_MARKERS)
        if (lower.indexOf(marker) >= 0) return true;
    return false;
}

/// The human reason inside a server's ERROR text, or "" when it has none:
///   "Closing Link: 1.2.3.4 (Quit: bye)"                  → "bye"
///   "Closing Link: 2a02:6ea0::e012 (SASL … (x) …)"       → "SASL … (x) …"  (Solanum, UnrealIRCd)
///   "Closing link: (~u@1.2.3.4) [Registration timeout]"  → "Registration timeout" (InspIRCd)
/// Anything that is not a Closing Link line yields "": a 465 ban text such
/// as Libera's "You are banned from this server- … (2026/10/26 02.00)" ends
/// in a timestamp, which used to surface as "Disconnected: 2026/10/26 02.00".
string extractServerReason(string errorText) @safe pure nothrow {
    import std.algorithm.searching : startsWith;
    import std.string : indexOf, lastIndexOf, strip, toLower;
    try {
        auto quit = errorText.indexOf("(Quit:");
        if (quit >= 0) {
            quit += 6;
            const end = errorText.indexOf(")", quit);
            if (end > quit) return errorText[quit .. end].strip();
        }
        if (!toLower(errorText).startsWith("closing link")) return "";
        const lastParen = errorText.lastIndexOf(')');
        const lastBracket = errorText.lastIndexOf(']');
        if (lastBracket > lastParen) {
            // InspIRCd: the (user@host) group comes first, the reason is the
            // trailing [bracket] group.
            const open = errorText.lastIndexOf('[');
            if (open < 0 || open >= lastBracket) return "";
            auto reason = errorText[open + 1 .. lastBracket].strip();
            return reason.startsWith("Quit:") ? reason[5 .. $].strip() : reason;
        }
        // Solanum / UnrealIRCd: "<host> (reason)". From the first "(" so a
        // reason carrying its own parentheses stays whole.
        const open = errorText.indexOf('(');
        if (open >= 0 && lastParen > open) return errorText[open + 1 .. lastParen].strip();
    } catch (Exception) {}
    return "";
}

/// Whether a server's SASL mechanism list — the CAP 302 `sasl=` value or
/// the 908 RPL_SASLMECHS list, comma-separated — includes `mech`
/// (ASCII case-insensitive). An empty list means the server did not say,
/// which callers treat as "try it".
bool saslMechanismOffered(string offered, string mech) @safe pure nothrow @nogc {
    import std.ascii : toUpper;
    if (offered.length == 0) return true;
    size_t start = 0;
    foreach (i; 0 .. offered.length + 1) {
        if (i < offered.length && offered[i] != ',') continue;
        auto m = offered[start .. i];
        start = i + 1;
        while (m.length && m[0] == ' ') m = m[1 .. $];
        while (m.length && m[$ - 1] == ' ') m = m[0 .. $ - 1];
        if (m.length != mech.length) continue;
        bool same = true;
        foreach (j, c; m) if (toUpper(c) != toUpper(mech[j])) { same = false; break; }
        if (same) return true;
    }
    return false;
}

/// Thrown when the network must stop reconnecting until the user acts:
///   - services definitively rejected our SASL credential or mechanism
///     (904/905, or the server does not offer the configured mechanism);
///   - the server only admits SASL-authenticated connections from every
///     route we have (`applySaslGatePolicy`), or admits none even after a
///     successful login (unverified account).
/// Retrying would hammer the server with connections it has already said
/// it will refuse — the pattern that gets a whole egress K-lined as a bot.
/// The run loop catches this separately from generic failures and idles
/// (persisted `disabled`, same as the admin-disconnect path). A user
/// Reconnect, a SASL edit, or for the Fiber network a NickServ-password
/// site login re-enables it via `reconnectNetwork`.
class SaslParkedException : Exception {
    this(string msg) { super(msg); }
}

/// Cardinalities only: observing ownership must not build a session snapshot.
struct ClientMemoryCounters {
    ulong members;
    ulong namesMembers;
    ulong realnames;
    ulong realnameProbed;
    ulong idents;
    ulong accounts;
    ulong away;
    ulong bots;
    ulong userMetadata;
    ulong pendingMetaFlags;
    ulong metaBuilds;
    ulong ordinaryMetaPublishers;
}

/// Persistent IRC client with auto-reconnect and IRCv3 support.
final class PersistentIRCClient {
    private {
        NetworkConfig      config;
        /// Relay stream to the holder (AF_UNIX or TCP). Plain IRC bytes;
        /// the holder owns the upstream TCP/SOCKS5/TLS socket.
        TCPConnection      connection;
        /// Client of this engine's holder; null only in unit tests.
        HolderClient       holder;
        /// Holder id (`c-<n>`) of the live upstream connection; "" when
        /// there is none.
        string             holderConnId;
        string             holderInstance;
        long               holderConnectedAtMs;
        long               observed001AtMs;
        long               externalRefusalAtMs;
        string             externalRefusalReason;
        bool               registrationPermit;
        ulong              registrationPermitEpoch;
        bool               registrationPermitUnproven;
        bool               relayRecoveryPending;
        bool               holderGenerationLost;
        long               maintenanceDeadlineMs;
        string             frozenProvider, frozenSlot, frozenExit, frozenNativeIpv6;
        string             frozenHost, frozenTls;
        ushort             frozenPort;
        string             frozenRouteIdentity;
        RoutingPreferences frozenRouting;
        bool               frozenSlotHeld;
        bool delegate() maintenanceRegistrationGate;
        long               lastGapHandled;
        long               lastGapAcknowledged;
        long               nextGapAckAtMs;
        HolderEntry        pendingHolderGap;
        bool[string]       gapNamesPending;
        bool               gapRefreshPending;
        bool               gapReplayUncertain;
        string             lastHolderCloseReason;
        long               lastHolderClosedAtMs;

        /// unix-ms when the current registration handshake began (≈ TCP
        /// connect). The JOIN-throttle window is measured from there, and
        /// the retry below needs it after registration has returned.
        long                registrationStartedAtMs;
