    recordEstablishedEgressLoss("north", "alpha.example.org", now + 1_000, now + 1_000);
    assert(store.quarantined.length == 0, "one IRC host is a per-client signal, not exit evidence");
    recordEstablishedEgressLoss("de", "beta.example.net", now + 2_000, now + 2_000);
    assert(mullvadPool[1].recentLossAtMsByHost.length == 0 && store.quarantined.length == 0);
    recordEstablishedEgressLoss("north", "beta.example.net", now + 3_000, now + 3_000);
    assert(store.quarantined.length == 1);
    assert(store.quarantined[0] == EgressEndpointRef("north", "socks-north.example", 1080));
    assert(store.quarantineReasons[0].canFind("2 distinct IRC hosts"));
    // Live sockets succeeding on the exit never touch its circuit.
    recordMullvadSuccess("north");
    assert(store.quarantined.length == 1 && store.verdicts.length == 0);
    // A third host asks again; the store keeps the open circuit as is.
    store.quarantineReply = EgressQuarantine(false, true, false, now + 3_000 + 300_000);
    recordEstablishedEgressLoss("north", "gamma.example", now + 4_000, now + 4_000);
    assert(store.quarantined.length == 2);
    mullvadPool[0].recentLossAtMsByHost = null;
    recordEstablishedEgressLoss("north", "alpha.example.org", now, now);
    recordEstablishedEgressLoss("north", "beta.example.net", now + 91_000, now + 91_000);
    assert(store.quarantined.length == 2, "losses 91 s apart are not correlated");
    recordEstablishedEgressLoss("north", "gamma.example", now + 92_000, now + 212_001);
    assert(store.quarantined.length == 2, "stale losses are ignored");
}
private void recordMullvadFailure(string label) {
    if (gMullvadLock !is null) synchronized (gMullvadLock) {
        foreach (ref pr; mullvadPool) if (pr.label == label) {
            pr.failCount++;
            if (pr.failCount >= 3) {
                pr.deadUntilMs = Clock.currTime.toUnixTime!long * 1000 + 30_000;
                logWarn("%s proxy %s (%s:%d) marked dead for 30s after 3 fails", pr.controlSocket.length > 0 ? "Mullvad" : "NordVPN", label, pr.host, pr.port);
            }
            break;
        }
        return;
    }
    foreach (ref pr; mullvadPool) if (pr.label == label) {
        pr.failCount++;
        if (pr.failCount >= 3) {
            pr.deadUntilMs = Clock.currTime.toUnixTime!long * 1000 + 30_000;
            logWarn("%s proxy %s (%s:%d) marked dead for 30s after 3 fails", pr.controlSocket.length > 0 ? "Mullvad" : "NordVPN", label, pr.host, pr.port);
        }
        break;
    }
}

/// Is `locationId` (or the `slot:<label>` key of a slot whose location is
/// unknown, or `DIRECT_EGRESS_LABEL`) banned for this host right now?
private bool isEgressBannedForHost(string hostLower, string locationId) {
    if (hostLower.length == 0 || locationId.length == 0) return false;
    // Called only from synchronized contexts (getHealthyProxiesForHost) or with mutex held.
    if (auto outer = hostLower in hostEgressBanUntil) {
        if (auto expiry = locationId in *outer) {
            const now = Clock.currTime.toUnixTime!long * 1000;
            if (now < *expiry) return true;
            (*outer).remove(locationId);
            if ((*outer).length == 0) hostEgressBanUntil.remove(hostLower);
        }
    }
    if (auto outer = hostLower in dailyReachabilityBanned) {
        if (locationId in *outer) return true;
    }
    return false;
}

// `isEgressBannedForHost` and `dailyReachabilityBanned` are both
// module-private, so this unittest lives here rather than in
// connection_registration_test.d (a separate module — D's `private` is
// strictly module-scoped, not package-scoped, so a symbol here is
// inaccessible even via `import ircfiber.irc.connection : …;` from
// another module). Matches this file's own convention of a `unittest`
// block directly below the function it covers (see
// `remainingJoinDelayMs`/`parseJoinThrottleSeconds` further down).
@("isEgressBannedForHost consults the daily reachability sweep's findings")
unittest {
    dailyReachabilityBanned["irc.example.org"]["slot:nord-nl-ams"] = true;
    scope(exit) dailyReachabilityBanned.remove("irc.example.org");
    assert(isEgressBannedForHost("irc.example.org", "slot:nord-nl-ams"));
    assert(!isEgressBannedForHost("irc.example.org", "slot:other"));
}

/// Per-host ban key for a slot. A ban must follow the *address*, not the
/// slot: a slot is retargeted over time, so keying by label would move the
/// ban with the slot instead of leaving it on the banned exit. Slots whose
/// location the engine cannot read (static sidecars, no control socket) keep
/// a stable per-slot key so host-bans still work for them.
private string slotBanKey(const(MullvadProxy)* p) nothrow {
    if (p is null) return "";
    return p.locationId.length ? p.locationId : "slot:" ~ p.label;
}

private void banEgressForHost(string host, string locationId, long durationMs = HOST_EGRESS_BAN_MS) {
    if (host.length == 0 || locationId.length == 0) return;
    import std.string : toLower;
    auto hl = host.toLower();
    const exp = Clock.currTime.toUnixTime!long * 1000 + durationMs;
    const key = locationId.toLower();
    // The ban supersedes any dial evidence for that route: a success
    // remembered before it must not promote the route once it expires.
    void apply() {
        hostEgressBanUntil[hl][key] = exp;
        gRouteMemory.forget(hl, key);
    }
    if (gMullvadLock !is null) synchronized (gMullvadLock) apply();
    else apply();
    logWarn("Mullvad host-ban: egress %s banned for %s for %d ms (until %d)", locationId, hl, durationMs, exp);
}

/// Silent transport loss can rotate a dynamic VPN exit, but is not evidence
/// that the destination banned the shared direct address or a native source.
/// Static exits use qualified cross-host loss observations instead.
private void recordSilentEgressLoss(string host, string label, string locationId) {
    if (!label.length || isStaticProxy(label)) return;
    if (locationId.length) banEgressForHost(host, locationId);
    recordMullvadFailure(label);
}

/// Remembers that `host` refuses connections that do not log in with SASL
/// when they come from `key` (a location id, `slot:<label>` or
/// DIRECT_EGRESS_LABEL). See hostSaslGateUntil.
private void gateEgressForHost(string host, string key) {
    if (host.length == 0 || key.length == 0) return;
    import std.string : toLower;
    auto hl = host.toLower();
    const exp = Clock.currTime.toUnixTime!long * 1000 + HOST_EGRESS_BAN_MS;
    if (gMullvadLock !is null) synchronized (gMullvadLock) {
        hostSaslGateUntil[hl][key.toLower()] = exp;
    } else {
        hostSaslGateUntil[hl][key.toLower()] = exp;
    }
    logWarn("SASL gate: %s refuses unauthenticated connections via %s (remembered until %d)", hl, key, exp);
}

/// Is `key` SASL-gated for this host right now? Caller holds gMullvadLock
/// (or runs before it exists), like isEgressBannedForHost.
private bool isEgressSaslGatedLocked(string hostLower, string key) {
    import std.string : toLower;
    if (hostLower.length == 0 || key.length == 0) return false;
    auto outer = hostLower in hostSaslGateUntil;
    if (outer is null) return false;
    const k = key.toLower();
    if (auto expiry = k in *outer) {
        if (Clock.currTime.toUnixTime!long * 1000 < *expiry) return true;
        (*outer).remove(k);
        if ((*outer).length == 0) hostSaslGateUntil.remove(hostLower);
    }
    return false;
}

private bool isEgressSaslGatedForHost(string hostLower, string key) {
    if (gMullvadLock !is null) synchronized (gMullvadLock) return isEgressSaslGatedLocked(hostLower, key);
    return isEgressSaslGatedLocked(hostLower, key);
}

/// Any unexpired SASL gate recorded for this host? Caller holds the lock.
private bool hostHasSaslGatesLocked(string hostLower) {
    auto outer = hostLower in hostSaslGateUntil;
    if (outer is null) return false;
    const now = Clock.currTime.toUnixTime!long * 1000;
    foreach (_, exp; *outer) if (now < exp) return true;
    return false;
}

private bool hostHasSaslGates(string hostLower) {
    if (gMullvadLock !is null) synchronized (gMullvadLock) return hostHasSaslGatesLocked(hostLower);
    return hostHasSaslGatesLocked(hostLower);
}

private MullvadProxy*[] getHealthyProxiesForHost(string hostLower) {
    // The host-aware path skips the unlocked getHealthyProxies() wrapper, so
    // it must load the pool itself (the wrapper is the only other caller of
    // loadMullvadPool). Without this the pool stays empty and every network
    // falls back to direct egress.
    loadMullvadPool();
    // Entire read-modify is synchronized to avoid SyncError on hostEgressBanUntil (AA).
    if (gMullvadLock !is null) synchronized (gMullvadLock) {
        return getHealthyProxiesForHostLocked(hostLower);
    }
    return getHealthyProxiesForHostLocked(hostLower);
}
private MullvadProxy*[] getHealthyProxiesForHostLocked(string hostLower) {
    auto healthy = getHealthyProxiesLocked();
    if (hostLower.length == 0) return healthy;
    const now = Clock.currTime.toUnixTime!long * 1000;
    if (auto outer = hostLower in hostEgressBanUntil) {
        string[] dead;
        foreach (lbl, exp; *outer) if (now >= exp) dead ~= lbl;
        foreach (lbl; dead) {
            (*outer).remove(lbl);
            logInfo("Mullvad host-ban expired: %s for %s", lbl, hostLower);
        }
        if ((*outer).length == 0) hostEgressBanUntil.remove(hostLower);
    }
    MullvadProxy*[] out_;
    foreach (p; healthy) if (!isEgressBannedForHost(hostLower, slotBanKey(p))) out_ ~= p;
    return out_;
}

/// Pseudo-label for the un-proxied host IP. Lives in the same per-host ban
/// table as the Mullvad labels so a Z/G/K-line on the bare OVH address is
/// remembered exactly like a banned exit. A routing order containing only
/// `direct` selects this path without permitting VPN fallback.
enum DIRECT_EGRESS_LABEL = "direct";


/// True when, after `bannedKey` was just banned (or SASL-gated) for
/// `hostLower`, at least one other route to the host remains: a healthy exit
/// whose location is not host-banned, a free controllable slot that could be
/// retargeted to an unbanned location, or the direct path if that is not
/// host-banned. Drives the ban and SASL-gate policies: fail over now vs.
/// wait out the ban window / park.
///
/// `unauthenticated` (the network has no SASL) also rules out SASL-gated
/// routes, and — once the host has any SASL gate — stops counting a free
/// slot: a retarget lands on another exit of the same VPN provider, which
/// the gate refuses just the same, and the picker only retargets when no
/// exit is healthy, so counting the slot would fail over through gated
/// exits forever.
private bool hasAlternativeEgressForHost(string hostLower, string bannedKey, bool unauthenticated = false,
                                         RoutingPreferences routing = RoutingPreferences.init,
                                         string nativeSource = "") {
    auto order = configuredRoutingOrder(hostLower, routing);
    if (order.length == 0) return false;
    loadMullvadPool();
    // Read once outside the pool lock: an excluded exit is not an
    // alternative that can justify immediately retrying a ban/SASL gate.
    const admissions = poolAdmissions(order);
    order = configuredRoutingOrder(hostLower, routing);
    const now = nowMsSafe();
    bool admissible(string label) {
        auto a = label in admissions;
        return a !is null && (a.state == "healthy"
            || (a.state == "recovering" && a.trialUntilMs <= now));
    }
    bool check() {
        if (order.length == 0) return false;
        const skipGated = unauthenticated && hostHasSaslGatesLocked(hostLower);
        const nativeKey = "ipv6:" ~ nativeSource;
        if (nativeSource.length && order.canFind(RouteKind.ipv6) && nativeKey != bannedKey
                && !isEgressBannedForHost(hostLower, nativeKey)
                && !(skipGated && isEgressSaslGatedLocked(hostLower, nativeKey))) return true;
        foreach (p; getHealthyProxiesForHostLocked(hostLower)) {
            if (!order.canFind(p.provider)) continue;
            if (!admissible(p.label)) continue;
            const key = slotBanKey(p);
            if (key != bannedKey && !(skipGated && isEgressSaslGatedLocked(hostLower, key))) return true;
        }
        // A free controllable slot is an alternative in itself: it can be
        // retargeted to any city in the catalog that is not host-banned.
        if (order.canFind(RouteKind.mullvad) && !skipGated && gExitRelays.length > 0) {
            foreach (ref pr; mullvadPool)
                if (pr.provider == RouteKind.mullvad && pr.controlSocket.length > 0 && pr.activeConns == 0
                    && now >= pr.heldUntilMs && pr.state != "retargeting" && admissible(pr.label))
                    return true;
        }
        return order.canFind(RouteKind.direct) && bannedKey != DIRECT_EGRESS_LABEL && !isEgressBannedForHost(hostLower, DIRECT_EGRESS_LABEL)
            && !(skipGated && isEgressSaslGatedLocked(hostLower, DIRECT_EGRESS_LABEL));
    }
    if (gMullvadLock !is null) synchronized (gMullvadLock) return check();
    return check();
}

/// Direct path host-banned? Read under the pool lock like the proxy checks.
private bool isRouteBannedForHost(string hostLower, string key) {
    if (gMullvadLock !is null) synchronized (gMullvadLock) return isEgressBannedForHost(hostLower, key);
    return isEgressBannedForHost(hostLower, key);
}

// ── Egress slot control: read location, retarget, refcount ───────────────────
// A slot is retargeted only while it is idle: `activeConns == 0`, past its
// sticky hold, and not already reserved. That is the whole guarantee that
// choosing a location for one network never drops another network's socket.

/// Unix ms. Wrapped so the `nothrow` slot bookkeeping below can use it.
private long nowMsSafe() nothrow {
    try {
        return Clock.currTime.toUnixTime!long * 1000;
    } catch (Exception) {
        return 0;
    }
}

/// Loads the pool from `nothrow` context (the loader logs, which can throw).
private void loadMullvadPoolSafe() nothrow {
    try {
        loadMullvadPool();
    } catch (Exception) {}
}

/// Runs `action` under `gMullvadLock`, swallowing any throw so the slot
/// bookkeeping can live in `nothrow` code paths. Never yields inside the
/// lock — every `action` below is pure in-memory bookkeeping.
private void withPoolLock(scope void delegate() action) nothrow {
    try {
        if (gMullvadLock !is null) synchronized (gMullvadLock) action();
        else action();
    } catch (Exception e) {
        try { logWarn("Mullvad slot bookkeeping failed: %s", e.msg); } catch (Exception) {}
    }
}

private struct TsResult {
    /// Process exited 0.
    bool ok;
    /// stdout, whether or not the process succeeded.
    string output;
}

/// Runs `<bin> --socket=<socket> <args…>` against one slot's tailscaled with
/// a hard `timeout(1)` ceiling. Uses `vibe.core.process.execute`, which
/// yields the calling fiber instead of blocking the event-loop thread — the
/// std.process version would stall every other IRC connection for the
/// duration. Returns `ok == false` and whatever stdout was produced on
/// failure; callers that only need the payload (status reads) use `output`.
private TsResult tailscaleCmd(string socket, string[] args) nothrow {
    TsResult r;
    if (socket.length == 0) return r;
    try {
        import vibe.core.process : vibeExecute = execute;
        auto cmd = ["timeout", TS_CMD_TIMEOUT_SECS.to!string, tailscaleBin(),
                    "--socket=" ~ socket] ~ args;
        auto res = vibeExecute(cmd);
        r.ok = res.status == 0;
        r.output = res.output;
        if (!r.ok)
            logWarn("tailscale %s (%s) exited %d: %s", args.join(" "), socket, res.status,
                res.output.length > 200 ? res.output[0 .. 200] : res.output);
    } catch (Exception e) {
        try { logWarn("tailscale %s (%s) failed: %s", args.join(" "), socket, e.msg); } catch (Exception) {}
        r.ok = false;
    }
    return r;
}

/// Re-reads one slot's exit location and health from its own tailscaled, and
/// refreshes the shared relay catalog from the same payload. No-op for a
/// static slot. Must run off the connection fibers (it shells out).
private void refreshSlotFromStatus(size_t idx) nothrow {
    string socket;
    withPoolLock({
        if (idx < mullvadPool.length) socket = mullvadPool[idx].controlSocket;
    });
    if (socket.length == 0) return;
    auto st = tailscaleCmd(socket, ["status", "--json"]);
    if (st.output.length == 0) {
        withPoolLock({
            if (idx >= mullvadPool.length) return;
            auto p = &mullvadPool[idx];
            if (p.state == "retargeting") return;
            p.state = "error";
            p.lastError = "tailscale status unavailable";
        });
        return;
    }
    auto sel = parseSelectedExit(st.output);
    const online = parseExitOnline(st.output);
    auto relays = parseExitRelays(st.output);
    withPoolLock({
        if (idx >= mullvadPool.length) return;
        auto p = &mullvadPool[idx];
        if (sel.locationId.length) {
            p.locationId = sel.locationId;
            p.exitHostname = sel.hostname;
            p.exitCountry = sel.country;
            p.exitCountryCode = sel.countryCode;
            p.exitCity = sel.city;
        }
        // A retarget in flight owns the slot's state field.
        if (p.state != "retargeting") {
            if (sel.hostname.length == 0) {
                p.state = "error";
                p.lastError = "no exit node selected";
            } else if (!online) {
                p.state = "error";
                p.lastError = "exit node offline";
            } else {
                p.state = "ready";
                p.lastError = "";
            }
        }
        if (relays.length > 0) {
            gExitRelays = relays;
            gExitRelaysAtMs = nowMsSafe();
        }
    });
}

/// Points slot `idx` at the best relay for `pin` and waits for tailscaled to
/// report the new exit online. Returns false (leaving the slot in `error`
/// with its hold cleared, so it can be retried) on any failure.
/// The caller must already have reserved the slot via `acquireSlotForPin`.
private bool retargetSlot(size_t idx, string pin) nothrow {
    string socket, label;
    ExitRelay relay;
    withPoolLock({
        if (idx >= mullvadPool.length) return;
        socket = mullvadPool[idx].controlSocket;
        label = mullvadPool[idx].label;
        relay = pickRelayForPin(gExitRelays, pin);
    });
    if (socket.length == 0 || relay.ip.length == 0) return false;
    try {
        logInfo("Mullvad slot %s: retargeting to %s (%s / %s)", label, relay.locationId,
            relay.hostname, relay.ip);
    } catch (Exception) {}
    if (!tailscaleCmd(socket, ["set", "--exit-node=" ~ relay.ip]).ok) {
        withPoolLock({
            if (idx >= mullvadPool.length) return;
            auto p = &mullvadPool[idx];
            p.state = "error";
            p.lastError = "tailscale set failed";
            p.heldUntilMs = 0;
        });
        return false;
    }
    const deadline = nowMsSafe() + RETARGET_READY_TIMEOUT_MS;
    bool ready = false;
    while (nowMsSafe() < deadline) {
        auto st = tailscaleCmd(socket, ["status", "--json"]);
        if (st.output.length && parseExitOnline(st.output)
            && parseSelectedExit(st.output).hostname == relay.hostname) {
            ready = true;
            break;
        }
        try {
            sleep(RETARGET_POLL_MS.msecs);
        } catch (Exception) {
            break;
        }
    }
    withPoolLock({
        if (idx >= mullvadPool.length) return;
        auto p = &mullvadPool[idx];
        if (ready) {
            p.locationId = relay.locationId;
            p.exitHostname = relay.hostname;
            p.exitCountry = relay.country;
            p.exitCountryCode = relay.countryCode;
            p.exitCity = relay.city;
            p.state = "ready";
            p.lastError = "";
        } else {
            p.state = "error";
            p.lastError = "exit node did not come online";
            p.heldUntilMs = 0;
        }
    });
    if (!ready) {
        try {
            logWarn("Mullvad slot %s: retarget to %s timed out after %d ms", label,
                relay.locationId, RETARGET_READY_TIMEOUT_MS);
        } catch (Exception) {}
    }
    return ready;
}

/// Refreshes every controllable slot's location and the relay catalog.
/// Cheap no-op inside `EGRESS_CATALOG_TTL_MS` — retargets update slot state
/// synchronously, so a periodic read only picks up out-of-band changes.
/// Shells out: call only from the state snapshotter task, never from a
/// connection fiber's hot path.
void refreshEgressState() nothrow {
    loadMullvadPoolSafe();
    size_t[] idxs;
    long lastAt;
    withPoolLock({
        lastAt = gExitRelaysAtMs;
        foreach (i, ref p; mullvadPool) if (p.controlSocket.length > 0) idxs ~= i;
    });
    if (idxs.length == 0) return;
    if (lastAt != 0 && nowMsSafe() - lastAt < EGRESS_CATALOG_TTL_MS) return;
    foreach (i; idxs) refreshSlotFromStatus(i);
}

/// Pulls RedisKeys.egressReachabilityBanned() and replaces
/// dailyReachabilityBanned wholesale. Started as its own task from
/// app_engine.d (not state.d's 10s snapshotter) — this data only changes
/// once a day at the source, so a 10 min poll is already far more
/// frequent than it needs to be and keeps the staleness window small
/// regardless.
void startDailyReachabilityRefresh() nothrow {
    runTask(() nothrow {
        while (true) {
            try {
                if (gEgressRedis !is null) {
                    auto raw = gEgressRedis.getDb().get(RedisKeys.egressReachabilityBanned());
                    if (raw.length > 0) {
                        import vibe.data.json : parseJsonString, Json;
                        auto arr = parseJsonString(raw);
                        bool[string][string] fresh;
                        if (arr.type == Json.Type.array) {
                            foreach (item; arr) {
                                auto h = item["host"].get!string.toLower();
                                auto k = item["banKey"].get!string.toLower();
                                if (h.length && k.length) fresh[h][k] = true;
                            }
                        }
                        withPoolLock({ dailyReachabilityBanned = fresh; });
                    }
                }
            } catch (Exception e) {
                try { logWarn("daily reachability refresh failed: %s", e.msg); } catch (Exception) {}
            }
            try sleep(10.minutes); catch (Exception) {}
        }
    });
}

/// Copy-by-value snapshot of one slot, taken under the lock, for publishing.
struct EgressSlotView {
    string label;
    string provider;
    string host;
    string locationId;
    string exitHostname;
    string exitCountry;
    string exitCountryCode;
    string exitCity;
    string state;
    string lastError;
    ushort port;
    bool controllable;
    int activeConns;
    long heldUntilMs;
    /// Durable admission verdict (drain / quarantine / recovery), read
    /// after the pool lock is released. Separate from the transport `state`.
    EgressAdmission admission;
}

/// Every slot's current state, for `irc:egress:slots:<serverId>`.
EgressSlotView[] egressSlotViews() nothrow {
    loadMullvadPoolSafe();
    EgressSlotView[] views;
    withPoolLock({
        foreach (ref p; mullvadPool) {
            EgressSlotView v;
            v.label = p.label;
            v.provider = routeToken(p.provider);
            v.host = p.host;
            v.port = p.port;
            // A retargetable slot reports its real location; a static one has
            // none to report (its `slot:` ban key never leaves the engine).
            v.locationId = p.locationId;
            v.exitHostname = p.exitHostname;
            v.exitCountry = p.exitCountry;
            v.exitCountryCode = p.exitCountryCode;
            v.exitCity = p.exitCity;
            v.state = p.state;
            v.lastError = p.lastError;
            v.controllable = p.controlSocket.length > 0;
            v.activeConns = p.activeConns;
            v.heldUntilMs = p.heldUntilMs;
            views ~= v;
        }
    });
    // Redis I/O: outside the pool lock. A failed read publishes `unavailable`.
    EgressEndpointRef[] refs;
    foreach (ref v; views) refs ~= EgressEndpointRef(v.label, v.host, v.port);
    auto verdicts = readAdmissions(refs);
    foreach (i, ref v; views) v.admission = verdicts[i];
    return views;
}

/// The pickable location catalog, for `irc:egress:catalog:<serverId>`.
ExitLocation[] egressLocations() nothrow {
    ExitRelay[] relays;
    withPoolLock({ relays = gExitRelays.dup; });
    try {
        return locationsFromRelays(relays);
    } catch (Exception) {
        return null;
    }
}

/// Moves one named slot to `pin` on an operator's instruction (admin
/// "swap exit"), rather than because a connect needs it. Returns "" on
/// success, else a short reason the gateway can surface:
///   "unknown-slot" | "not-controllable" | "busy" | "retargeting"
///   | "no-catalog" | "retarget-failed"
///
/// `force` is the operator overriding the in-use lock. Without it a slot
/// carrying live connections is refused, never yanked — which is the right
/// default for an automatic pin, but on a busy deployment every slot is in
/// use, so an operator who wants to move an exit has no other way. With
/// `force`, the connections riding the slot are reconnected onto the new
/// exit right after the retarget instead of being left to notice the change
/// when their socket eventually breaks.
///
/// Shells out, so this runs on the control-consumer task, never on a
/// connection fiber.
string retargetSlotByLabel(string label, string pin, bool force = false) nothrow {
    if (label.length == 0 || pin.length == 0) return "unknown-slot";
    loadMullvadPoolSafe();
    size_t idx = size_t.max;
    string reason;
    int wasCarrying = 0;
    withPoolLock({
        const now = nowMsSafe();
        foreach (i, ref p; mullvadPool) {
            if (p.label != label) continue;
            if (auto until = p.label in maintenanceSlotUntilMs)
                if (nowMsSafe() < *until) { reason = "maintenance-frozen"; return; }
            if (p.controlSocket.length == 0) { reason = "not-controllable"; return; }
            if (p.activeConns > 0 && !force) { reason = "busy"; return; }
            if (p.state == "retargeting") { reason = "retargeting"; return; }
            if (pickRelayForPin(gExitRelays, pin).ip.length == 0) { reason = "no-catalog"; return; }
            wasCarrying = p.activeConns;
            // Reserve exactly as acquireSlotForPin does, so a connect landing
            // between here and the retarget cannot claim the same slot.
            p.state = "retargeting";
            p.heldUntilMs = now + RETARGET_RESERVE_MS;
            idx = i;
            return;
        }
        reason = "unknown-slot";
    });
    if (idx == size_t.max) return reason.length ? reason : "unknown-slot";
    if (!retargetSlot(idx, pin)) return "retarget-failed";
    // The operator asked for this location, so hold the slot briefly: a
    // connect that arrives now should use it, not move it again.
    withPoolLock({
        if (idx < mullvadPool.length) mullvadPool[idx].heldUntilMs = nowMsSafe() + SLOT_HOLD_MS;
    });
    try {
        logJsonMap("info", "connection",
            "Operator retargeted a Mullvad slot",
            ["slot": label,
             "location": pin,
             "forced": force ? "true" : "false",
             "carrying": wasCarrying.to!string,
             "event": "egress_retargeted"]);
    } catch (Exception) {}
    return "";
}

/// Finds or prepares a slot for `pin` (a country or city pin, lower-case).
/// Returns null when nothing is available, with `reason` set to one of
/// "no-pin" | "no-catalog" | "all-busy" | "retarget-failed" | "not-controllable".
///
/// A slot already sitting on a matching location is shared as-is — that is
/// the common case and it never disturbs the connections already on it. Only
/// a genuinely idle slot is ever retargeted, and it is reserved (state
/// "retargeting" + a `RETARGET_RESERVE_MS` hold) before the lock is released
/// so two concurrent connects cannot fight over the same slot.
///
/// `notAdmitted` names exits whose durable admission refuses ordinary new
/// dials (drained, quarantined, recovering, unavailable): they are neither
/// matched nor retargeted here, so a pin can never reach them this way.
private MullvadProxy* acquireSlotForPin(string hostLower, string pin, out string reason,
                                        const bool[string] notAdmitted = null) nothrow {
    reason = "";
    if (pin.length == 0) {
        reason = "no-pin";
        return null;
    }
    loadMullvadPoolSafe();
    MullvadProxy* match = null;
    size_t candidate = size_t.max;
    int controllable = 0;
    withPoolLock({
        const now = nowMsSafe();
        // A slot the engine cannot drive (no control socket) has no readable
        // location, so it is addressed by its label — the pre-slot behaviour,
        // kept for deployments whose sidecars live on another host. Only
        // non-controllable slots answer to a label, so a retargetable pool
        // never has two ways to name the same exit.
        foreach (i, ref p; mullvadPool) {
            if (p.controlSocket.length > 0 || p.label != pin || p.label in notAdmitted) continue;
            if (p.deadUntilMs != 0 && now < p.deadUntilMs) continue;
            if (isEgressBannedForHost(hostLower, slotBanKey(&mullvadPool[i]))) continue;
            match = &mullvadPool[i];
            return;
        }
        foreach (i, ref p; mullvadPool) {
            if (!locationMatches(p.locationId, pin) || p.label in notAdmitted) continue;
            if (p.deadUntilMs != 0 && now < p.deadUntilMs) continue;
            if (isEgressBannedForHost(hostLower, slotBanKey(&mullvadPool[i]))) continue;
            match = &mullvadPool[i];
            return;
        }
        long lru = long.max;
        foreach (i, ref p; mullvadPool) {
            if (p.controlSocket.length == 0 || p.label in notAdmitted) continue;
            controllable++;
            if (p.activeConns != 0 || now < p.heldUntilMs || p.state == "retargeting") continue;
            if (p.heldUntilMs <= lru) {
                lru = p.heldUntilMs;
                candidate = i;
            }
        }
        if (candidate == size_t.max) return;
        mullvadPool[candidate].state = "retargeting";
        mullvadPool[candidate].heldUntilMs = now + RETARGET_RESERVE_MS;
    });
    if (match !is null) return match;
    if (candidate == size_t.max) {
        reason = controllable > 0 ? "all-busy" : "not-controllable";
        return null;
    }
    bool haveRelay = false;
    withPoolLock({ haveRelay = pickRelayForPin(gExitRelays, pin).ip.length > 0; });
    if (!haveRelay) {
        withPoolLock({
            if (candidate >= mullvadPool.length) return;
            mullvadPool[candidate].state = "ready";
            mullvadPool[candidate].heldUntilMs = 0;
        });
        reason = "no-catalog";
        return null;
    }
    if (!retargetSlot(candidate, pin)) {
        reason = "retarget-failed";
        return null;
    }
    return &mullvadPool[candidate];
}


/// Location id of the best online relay that is not host-banned for
/// `hostLower` — the target for an automatic retarget when every existing
/// slot is banned for this host. "" when the catalog offers nothing better.
/// A city id (not a country) so the retarget cannot land on a banned city.
private string bestUnbannedLocationFor(string hostLower) nothrow {
    string best;
    long bestPriority = long.min;
    withPoolLock({
        foreach (r; gExitRelays) {
            if (!r.online || r.locationId.length == 0) continue;
            if (isEgressBannedForHost(hostLower, r.locationId)) continue;
            if (r.priority > bestPriority) {
                bestPriority = r.priority;
                best = r.locationId;
            }
        }
    });
    return best;
}

/// Takes a reference on `label`'s slot: it can no longer be retargeted, and
/// keeps a sticky hold for SLOT_HOLD_MS past the last release so a reconnect
/// loop does not lose its location to another network.
private void holdSlot(string label) nothrow {
    if (label.length == 0) return;
    withPoolLock({
        foreach (ref p; mullvadPool) if (p.label == label) {
            p.activeConns++;
            p.heldUntilMs = nowMsSafe() + SLOT_HOLD_MS;
            break;
        }
    });
}

/// Drops a reference taken by `holdSlot` (floored at zero) and starts the
/// sticky hold window.
private void releaseSlot(string label) nothrow {
    if (label.length == 0) return;
    withPoolLock({
        foreach (ref p; mullvadPool) if (p.label == label) {
            if (p.activeConns > 0) p.activeConns--;
            p.heldUntilMs = nowMsSafe() + SLOT_HOLD_MS;
            break;
        }
    });
}
private string stripHostBrackets(string host) @safe pure {
    host = host.strip();
    // Handle full ircs:// / irc:// URLs pasted into host field
    auto schemeSep = host.indexOf("://");
    if (schemeSep >= 0) {
        host = host[schemeSep + 3 .. $];
        auto slash = host.indexOf("/");
        if (slash >= 0) host = host[0 .. slash];
        auto bracketClose = host.indexOf("]");
        if (bracketClose >= 0) {
            auto open = host.indexOf("[");
            if (open >= 0) host = host[open .. bracketClose + 1];
            else host = host[0 .. bracketClose + 1];
        } else {
            auto colon = host.lastIndexOf(":");
            if (colon >= 0) {
                auto after = host[colon + 1 .. $];
                bool allDigits = after.length > 0;
                foreach (c; after) if (c < '0' || c > '9') { allDigits = false; break; }
                bool looksLikeIPv6 = host.canFind("::") || host.countUntil(":") != host.lastIndexOf(":");
                if (allDigits && !looksLikeIPv6) host = host[0 .. colon];
            }
        }
        host = host.strip();
    }
    // Standalone bracketed IPv6 literal, with or without trailing :port (no scheme)
    // e.g. "[2001:db8::1]" or "[2001:db8::1]:6697"
    if (host.length >= 2 && host[0] == '[') {
        auto close = host.indexOf("]");
        if (close > 0) return host[1 .. close];
    }
    return host;
}

/// User-visible connect progress sink: each holder dial `EVENT` (plus the
/// engine-composed `attempt`/`attempt_fail`/`info` lines) lands in the
/// network's `_server` buffer via `PersistentIRCClient.onDialEvent`.
/// Optional (null → silent) so the module-level helpers stay usable
/// without a client.
alias ConnectProgress = DialProgress;

private void report(ConnectProgress progress, string phase, string text) nothrow {
    if (progress is null) return;
    DialEvent ev;
    ev.phase = phase;
    ev.text = text;
    progress(ev);
}

/// Shortens a vibe/eventcore connect error to something a user can act on.
private string shortConnectError(string msg) @safe {
    import std.string : toLower;
    const l = msg.toLower();
    if (l.canFind("timed out") || l.canFind("timeout")) return "timed out after " ~ CONNECT_TIMEOUT_SECONDS.to!string ~ "s";
    if (l.canFind("refused")) return "connection refused";
    if (l.canFind("unreachable")) return "network unreachable";
    if (l.canFind("reset")) return "connection reset";
    if (l.canFind("socks")) return "SOCKS egress error: " ~ msg;
    return msg.length > 90 ? msg[0 .. 90] ~ "…" : msg;
}

/// Best-effort Tailnet IP of a SOCKS sidecar for admin display ("" when
/// it cannot be resolved right now).
private string resolveProxyIp(MullvadProxy* proxy) nothrow {
    try {
        auto a = getAddress(proxy.host, proxy.port);
        if (a.length > 0) return a[0].toAddrString();
    } catch (Exception) {}
    return "";
}

/// "Berlin, Germany" / "Germany" / "" for the UI.
private string proxyLocationText(const MullvadProxy* proxy) nothrow {
    return proxy.exitCity.length ? proxy.exitCity ~ ", " ~ proxy.exitCountry : proxy.exitCountry;
}

/// A transport route is explicit: an unproxied native source is not shared
/// direct, and route memory/admission may only reorder within its tier.
private struct RouteCandidate {
    RouteKind kind;
    MullvadProxy* proxy;
    string sourceAddress;
    string hostBanKey;
    bool recovery;
    string memoryKey;
    string skippedReason;
    string trialToken;
}

/// One dial through an explicit route, performed by the holder. Unproxied
/// candidates are either IPv6-only/source-bound or shared dual-stack. The
/// holder composes their DNS/attempt events; VPN routes make one SOCKS5
/// CONNECT through the sidecar (the exit resolves the name), and this
/// wrapper composes their `attempt`/`attempt_fail` lines and keeps the
/// Mullvad success/failure accounting. Every forwarded event carries the
/// candidate egress identity so the timeline can name it.
private TCPConnection happyEyeballsConnectWithProxy(HolderClient holder, DialTag tag, string host, ushort port,
                                                    string tlsMode, RouteCandidate candidate, RoutingPreferences routing,
                                                    ConnectProgress progress,
                                                    out DialResult dr,
                                                    scope DialResult delegate(DialRequest, DialProgress, RouteKind, string) ownedDial = null,
                                                    bool scoreFailures = true) {
    auto proxy = candidate.proxy;
    const providerName = proxy !is null && proxy.provider == RouteKind.mullvad ? "Mullvad" : "NordVPN";
    if (proxy !is null) logInfo("%s egress %s (%s:%d) for %s:%d", providerName, proxy.label, proxy.host, proxy.port, host, port);
    const egressLabel = proxy !is null ? providerName ~ " exit " ~ proxy.label : routeToken(candidate.kind);
    if (holder is null) throw new HolderUnavailableException("no connection holder configured");

    DialRequest req;
    req.tag = tag;
    req.tag.egressLabel = proxy !is null ? proxy.label : "";
    req.host = host;
    req.port = port;
    req.tls = tlsMode;
    req.sni = stripHostBrackets(host);
    if (proxy !is null) {
        req.hasProxy = true;
        req.proxy = DialProxy(proxy.host, proxy.port, proxy.username, proxy.password);
    }
    req.addressFamily = candidate.kind == RouteKind.ipv6 ? "ipv6" : "any";
    req.bindIp6 = candidate.sourceAddress;
    req.connectTimeoutMs = CONNECT_TIMEOUT_SECONDS * 1000;
    req.tlsTimeoutMs = TLS_HANDSHAKE_TIMEOUT_SECONDS * 1000;
    req.starttlsTimeoutMs = STARTTLS_REPLY_TIMEOUT_MS;

    // Candidate egress identity for the timeline (the holder does not know
    // which slot it is dialing through).
    string evLabel, evHost, evIp, evLocation;
    if (proxy !is null) {
        evLabel = proxy.label;
        evHost = proxy.host ~ ":" ~ proxy.port.to!string;
        evIp = resolveProxyIp(proxy);
        evLocation = proxyLocationText(proxy);
    }
    DialProgress wrapped = (ref DialEvent ev) nothrow {
        ev.egressLabel = evLabel;
        ev.egressHost = evHost;
        ev.egressIp = evIp;
        ev.egressLocationText = evLocation;
        if (progress !is null) progress(ev);
    };

    if (proxy is null) {
        // Unproxied: the holder resolves, filters/races and reports.
        requirePermittedRoute(host, routing, candidate.kind);
        dr = ownedDial is null ? holder.dial(req, wrapped) : ownedDial(req, wrapped, candidate.kind, candidate.trialToken);
        return dr.stream;
    }
    // One CONNECT with the hostname: the exit resolves it (see the holder's
    // SOCKS5 dial). Racing locally-resolved addresses through a single
    // proxy only multiplied its fail count — and on prod fed it the
    // Docker-internal address of irc.ircfiber.com.
    auto target = stripHostBrackets(host);
    immutable startMs = Clock.currTime.toUnixTime!long * 1000;
    report(wrapped, "attempt", "Trying " ~ target ~ ":" ~ port.to!string ~ " via " ~ egressLabel
        ~ " (exit resolves the name, up to " ~ HAPPY_EYEBALLS_RACE_TIMEOUT_SECONDS.to!string ~ "s)…");
    try {
        requirePermittedRoute(host, routing, proxy.provider);
        dr = ownedDial is null ? holder.dial(req, wrapped) : ownedDial(req, wrapped, candidate.kind, candidate.trialToken);
        recordMullvadSuccess(proxy.label);
        return dr.stream;
    } catch (HolderUnavailableException e) {
        // The exit was never tried — leave its counters alone.
        throw e;
    } catch (RoutingPolicyBlockedException e) {
        // No holder DIAL occurred: no transport/exit failure accounting.
        throw e;
    } catch (Exception e) {
        if (scoreFailures && countsAgainstExitHealth(e)) recordMullvadFailure(proxy.label);
        const tookMs = Clock.currTime.toUnixTime!long * 1000 - startMs;
        report(wrapped, "attempt_fail", target ~ " via " ~ egressLabel ~ ": "
            ~ shortConnectError(e.msg) ~ " (" ~ (tookMs / 1000).to!string ~ "s).");
        throw e;
    }
}

/// Does this dial failure say the exit is unhealthy for every host (the
/// 3-strike global circuit breaker)? A TLS/STARTTLS failure proves the exit
/// carried TCP to the IRC host, so it is that host rejecting the exit —
/// learned per endpoint by the route memory, never a global penalty. A
/// holder-side failure never reached the exit at all.
private bool countsAgainstExitHealth(Exception e) nothrow {
    if (cast(HolderErrorException) e) return false;
    if (auto d = cast(DialFailedException) e)
        return d.phase != "tls" && d.phase != "starttls" && d.phase != "holder";
    return true;
}

@("countsAgainstExitHealth: host-specific TLS and holder failures spare the exit")
unittest {
    assert(!countsAgainstExitHealth(new DialFailedException("tls", "connection closed")));
    assert(!countsAgainstExitHealth(new DialFailedException("starttls", "STARTTLS rejected")));
    assert(!countsAgainstExitHealth(new DialFailedException("holder", "holder dial timed out")));
    assert(!countsAgainstExitHealth(new HolderErrorException("busy", "busy")));
    assert(countsAgainstExitHealth(new DialFailedException("socks5", "general SOCKS server failure")));
    assert(countsAgainstExitHealth(new DialFailedException("tcp", "connection refused")));
    assert(countsAgainstExitHealth(new Exception("unexpected")));
}

/// Is this a typed network/TLS failure of the route itself — evidence for the
/// per-endpoint route memory? Holder-side failures (`holder` phase, ERR
/// replies, unavailable holder) and untyped errors are not.
private bool isRouteDialFailure(Exception e) nothrow {
    if (auto d = cast(DialFailedException) e) {
        switch (d.phase) {
            case "dns", "tcp", "socks5", "tls", "starttls": return true;
            default: return false;
        }
    }
    return false;
}

/// Which egress a `happyEyeballsConnect` call actually used. Returned per
/// call (not via a global) because many networks connect concurrently on
/// different fibers and the ban policy keys off the location — a crossed
/// value would ban the wrong exit.
struct EgressUsed {
    RouteKind kind;
    string fallbackReason;
    /// "" = unproxied, else the slot label ("de"). Identifies the slot whose
    /// refcount the caller now holds.
    string label;
    /// "host:port" of the SOCKS sidecar; "" for direct.
    string host;
    /// Resolved IP of the sidecar for admin display; "" for direct.
    string ip;
    /// Concrete host-ban key: direct, ipv6:<observed-source>, a VPN location
    /// ("de-ber") or `slot:<label>` when its location is unavailable.
    string locationId;
    /// Human text for the UI, e.g. "Berlin, Germany"; "" when unknown.
    string locationText;
    /// Owner token when this connection is the exit's single recovery trial
    /// ("" otherwise); the caller must renew/settle it for `trialExit`.
    string trialToken;
    EgressEndpointRef trialExit;
}

/// User-facing copy when a preferred exit cannot be used. The routing order,
/// not this preference, determines which alternative providers are allowed.
private string preferredExitFallbackCopy(string reason) nothrow {
    switch (reason) {
        case "all-busy":
            return "All exits are in use right now — connecting via another exit; "
                ~ "your location will be used when one frees up.";
        case "retarget-failed":
            return "Could not switch an exit to that location — connecting via another exit.";
        case "no-catalog":
            return "No exit locations are available on this server — connecting via another exit.";
        default:
            return "That location is not available on this server — connecting via another exit.";
    }
}

/// Every caller, including ban/SASL alternatives, uses the same fresh durable
/// policy and shared first-party rules. No defaults survive an unavailable read.
private RouteKind[] configuredRoutingOrder(string host, const RoutingPreferences routing) {
    auto effective = currentRoutingPolicy(host, routing);
    return effective.available ? effective.order : [];
}

/// Reliability tiering + smart routing for Automatic egress. Mullvad's
/// independent per-city sidecars have no shared-account contention and are
/// consistently far more reliable than a static credentialed provider's
/// exits (e.g. NordVPN), which all share one account's own
/// concurrent-session ceiling — confirmed empirically 2026-11-01: even
/// with zero self-contention in how the daily sweep measures them, only
/// ~1 of 10 configured NordVPN entries authenticated at any given moment,
/// and *which* one shifts over time.
///
/// Splits `healthy` into the Mullvad (controllable) and static
/// (NordVPN-like) tiers and returns Mullvad-first, so a user's first
/// attempt is never wasted on a static exit whose account-mate is the
/// reason it's about to fail. Within the Mullvad tier: `rrIndex` (the
/// caller's `mullvadRR`, mutated in place) rotates the start point per
/// call for load spreading — without this, every network on a
/// many-network host (e.g. 6x SuperNets) would try the same exit first,
/// hammering its 32/10m limit into "Too many unknown connections"; with
/// rotation they spread across exits and stay under per-IP limits.
/// Session-limit throttling (isThrottleError) still bans a hammered Mullvad
/// exit per host. Static candidates prefer this client's healthy alternatives,
/// unquarantined exits, proven exits and lower load. A deterministic
/// network/label hash breaks equal-load ties without reservation state.
/// Caller holds gMullvadLock while reading shared slot state.
private ulong staticTieHash(string networkId, string label) {
    ulong hash = 14695981039346656037UL;
    foreach (ubyte b; cast(const(ubyte)[]) networkId) hash = (hash ^ b) * 1099511628211UL;
    hash = (hash ^ 0) * 1099511628211UL;
    foreach (ubyte b; cast(const(ubyte)[]) label) hash = (hash ^ b) * 1099511628211UL;
    return hash;
}

/// Admission (drain/quarantine/recovery) is applied before ranking, so only
/// admitted exits reach this order.
private struct StaticRank {
    MullvadProxy* proxy;
    bool avoided, unproven;
    int activeConns;
    long lastSuccessMs;
    ulong tieHash;
}

private MullvadProxy*[] orderStaticProxies(MullvadProxy*[] candidates,
                                           string networkId, long nowMs, string avoidLabel) {
    StaticRank[] ranked;
    foreach (p; candidates) {
        if (p.controlSocket.length > 0) continue;
        ranked ~= StaticRank(p, p.label == avoidLabel,
            p.activeConns == 0 && (p.lastSuccessMs == 0 || p.lastSuccessMs > nowMs
                || nowMs - p.lastSuccessMs > 30 * 60_000L),
            p.activeConns, p.lastSuccessMs, staticTieHash(networkId, p.label));
    }
    ranked.sort!((a, b) =>
        a.avoided != b.avoided ? !a.avoided :
        a.unproven != b.unproven ? !a.unproven :
        a.activeConns != b.activeConns ? a.activeConns < b.activeConns :
        a.lastSuccessMs != b.lastSuccessMs ? a.lastSuccessMs > b.lastSuccessMs :
        a.tieHash != b.tieHash ? a.tieHash < b.tieHash :
        a.proxy.label < b.proxy.label);
    MullvadProxy*[] ordered;
    foreach (r; ranked) ordered ~= r.proxy;
    return ordered;
}

/// Mullvad rotation remains unchanged; static exits share reliability ranking.
/// Caller holds gMullvadLock while reading shared slot state and rrIndex.
private MullvadProxy*[] tierAndOrderProxies(MullvadProxy*[] healthy, ref size_t rrIndex,
                                            string networkId, long nowMs, string avoidLabel) {
    MullvadProxy*[] mullvadTier;
    foreach (p; healthy) if (p.controlSocket.length > 0) mullvadTier ~= p;
    if (mullvadTier.length > 1) {
        const startIdx = rrIndex++ % mullvadTier.length;
        if (startIdx != 0) mullvadTier = mullvadTier[startIdx .. $] ~ mullvadTier[0 .. startIdx];
    }
    return mullvadTier ~ orderStaticProxies(healthy, networkId, nowMs, avoidLabel);
}

@("tierAndOrderProxies: Mullvad first with static proof, load and deterministic ties")
unittest {
    MullvadProxy de, ch, us, nordA, nordB, nordC;
    de.label = "de"; de.controlSocket = "/ctl/de.sock";
    ch.label = "ch"; ch.controlSocket = "/ctl/ch.sock";
    us.label = "us"; us.controlSocket = "/ctl/us.sock";
    nordA.label = "nordA"; nordA.lastSuccessMs = 100;
    nordB.label = "nordB"; nordB.lastSuccessMs = 300; // most recently successful
    nordC.label = "nordC"; nordC.lastSuccessMs = 0;   // never succeeded

    auto healthy = [&de, &nordA, &ch, &nordB, &us, &nordC];
    size_t rr = 0;
    auto ordered = tierAndOrderProxies(healthy, rr, "network-a", 1_000, "");

    assert(ordered.length == 6);
    // Every Mullvad entry sorts before every static entry.
    bool[string] mullvadLabels = ["de": true, "ch": true, "us": true];
    size_t firstStaticIdx = size_t.max;
    foreach (i, p; ordered) if (p.label !in mullvadLabels) { firstStaticIdx = i; break; }
    assert(firstStaticIdx == 3, "exactly the 3 Mullvad entries lead");
    foreach (p; ordered[0 .. 3]) assert(p.label in mullvadLabels);
    // Static tier: most-recent-success first, regardless of input order.
    assert(ordered[3].label == "nordB");
    assert(ordered[4].label == "nordA");
    assert(ordered[5].label == "nordC");
    // Mullvad tier rotated by rrIndex (started at 0, length 3 -> startIdx 0 -> unrotated this call).
    assert(ordered[0].label == "de" && ordered[1].label == "ch" && ordered[2].label == "us");
    assert(rr == 1, "rrIndex advanced exactly once");

    // Next call rotates: startIdx = 1 % 3 = 1 -> ch, us, de.
    auto ordered2 = tierAndOrderProxies(healthy, rr, "network-a", 1_000, "");
    assert(ordered2[0].label == "ch" && ordered2[1].label == "us" && ordered2[2].label == "de");

    // A single Mullvad entry never rotates (nothing to rotate among) and
    // rrIndex is left untouched.
    size_t rr2 = 5;
    auto single = tierAndOrderProxies([&de], rr2, "network-a", 1_000, "");
    assert(single.length == 1 && single[0].label == "de" && rr2 == 5);
}


@("orderStaticProxies: proof, load, avoidance and last resort")
unittest {
    MullvadProxy de, a, b, never;
    de.label = "de"; de.controlSocket = "/ctl/de.sock";
    a.label = "north"; a.lastSuccessMs = 900;
    b.label = "south"; b.lastSuccessMs = 800;
    never.label = "untested";
    auto healthy = [&de, &a, &b, &never];
    auto ordered = orderStaticProxies(healthy, "network-a", 1_000, "");
    assert(ordered.length == 3 && ordered[0] is &a && ordered[1] is &b && ordered[2] is &never);
    a.activeConns = 2; b.activeConns = 1;
    assert(orderStaticProxies(healthy, "network-a", 1_000, "")[0] is &b);
    a.activeConns = 0; b.activeConns = 0;
    // Equal recency exposes the deterministic per-network tie breaker.
    b.lastSuccessMs = a.lastSuccessMs;
    bool sawA, sawB;
    foreach (i; 0 .. 100) {
        auto first = orderStaticProxies(healthy, i.to!string, 1_000, "")[0];
        if (first is &a) sawA = true;
        if (first is &b) sawB = true;
    }
    assert(sawA && sawB);
    // The client's own avoided exit goes last but stays a candidate.
    b.lastSuccessMs = 800;
    assert(orderStaticProxies(healthy, "network-a", 1_300, "north")[0] is &b);
    assert(orderStaticProxies([&a], "network-a", 1_300, "north")[0] is &a);
    assert(orderStaticProxies(healthy, "network-a", 1_300, "")[2] is &never);
    assert(orderStaticProxies([&de], "network-a", 1_000, "").length == 0);
}

/// One holder DIAL through exactly one explicit transport candidate.
private alias EgressDial = TCPConnection delegate(RouteCandidate candidate, out DialResult dr);

private TCPConnection happyEyeballsConnect(HolderClient holder, DialTag tag, string host, ushort port,
                                           string tlsMode, RoutingPreferences routing, bool unauthenticated,
                                           string ipv6BindAddr, ConnectProgress progress,
                                           string avoidLabel, out EgressUsed used, out DialResult dr,
                                           scope bool delegate() mayDial = null,
                                           scope DialResult delegate(DialRequest, DialProgress, RouteKind, string) ownedDial = null) {
    TCPConnection dialOne(RouteCandidate candidate, out DialResult r) {
        if (mayDial !is null && !mayDial()) throw new HolderUnavailableException("connection stopped before dial");
        return happyEyeballsConnectWithProxy(holder, tag, host, port, tlsMode, candidate, routing, progress, r, ownedDial);
    }
    const nativeSource = ipv6BindAddr.length && requireRoutingOrder(host, routing).canFind(RouteKind.ipv6)
        && nativeIpv6Prefix(holder).length ? ipv6BindAddr : "";
    return connectThroughEgressPlan(&dialOne, tag.networkId, host, port, tlsMode, routing,
        unauthenticated, nativeSource, progress, avoidLabel, used, dr, mayDial);
}

/// Concrete identity of one candidate route, as the route memory keys it.
/// A proxy is its slot plus sidecar address plus current exit, so a
/// retargeted slot starts without evidence instead of inheriting the old
/// exit's; direct includes the candidate source identity. Caller holds
/// gMullvadLock (slot exit fields are retargeted in place under it).
private string routeIdentityLocked(const(MullvadProxy)* p, string ipv6BindAddr) {
    if (p is null) return "direct|" ~ ipv6BindAddr;
    return "vpn|" ~ p.label ~ "|" ~ p.host ~ ":" ~ p.port.to!string ~ "|" ~ p.locationId ~ "|" ~ p.exitHostname;
}

/// Records one full-dial outcome for `selectedKey`, the identity the
/// candidate had when it was ranked — unless the slot changed exit while
/// the dial was in flight: then the evidence belongs to neither identity.
private void noteRouteOutcome(string endpointKey, string hostLower, MullvadProxy* proxy,
                              string ipv6BindAddr, string selectedKey, bool ok) nothrow {
    withPoolLock({
        if (routeIdentityLocked(proxy, ipv6BindAddr) != selectedKey) return;
        const banKey = proxy !is null ? slotBanKey(proxy).toLower()
            : ipv6BindAddr.length ? "ipv6:" ~ ipv6BindAddr : DIRECT_EGRESS_LABEL;
        gRouteMemory.record(endpointKey, hostLower, selectedKey, banKey, ok, nowMsSafe());
    });
}

/// The egress policy loop behind `happyEyeballsConnect`. `dial` performs one
/// holder dial; it is the seam unit tests replace the holder transport with.
private TCPConnection connectThroughEgressPlan(scope EgressDial dial, string networkId, string host, ushort port,
                                               string tlsMode, RoutingPreferences routing, bool unauthenticated,
                                               string ipv6BindAddr, ConnectProgress progress,
                                               string avoidLabel, out EgressUsed used, out DialResult dr,
                                               scope bool delegate() mayDial = null) {
    import std.string : toLower;
    auto hostLower = host.toLower();
    auto order = requireRoutingOrder(hostLower, routing);
    auto healthyForHost = getHealthyProxiesForHost(hostLower);
    order = requireRoutingOrder(hostLower, routing);
    const orderNowMs = unixMsNow();
    const endpointKey = routeEndpointKey(hostLower, port, tlsMode.toLower());
    // Filter the complete permitted provider set before pin resolution,
    // admission, ranking or retargeting sees a candidate.
    MullvadProxy*[] eligible;
    foreach (p; healthyForHost) if (order.canFind(p.provider)) eligible ~= p;
    auto admissions = poolAdmissions(order);
    bool[string] notAdmitted;
    withPoolLock({
        foreach (ref p; mullvadPool) {
            auto a = p.label in admissions;
            if (!order.canFind(p.provider) || a is null || !a.admitsDials)
                notAdmitted[p.label] = true;
        }
    });
    MullvadProxy*[] admitted, recovering;
    string[] admissionNotes;
    foreach (p; eligible) {
        auto a = p.label in admissions;
        if (a !is null && a.admitsDials) { admitted ~= p; continue; }
        const st = a is null ? "unavailable" : a.state;
        if (st == "recovering") recovering ~= p;
        admissionNotes ~= p.label ~ " " ~ (st == "quarantined" && a.retryAtMs > orderNowMs
            ? "quarantined (retry in " ~ ((a.retryAtMs - orderNowMs + 59_999) / 60_000).to!string ~ " min)"
            : st == "recovering" ? "awaiting a recovery trial" : st);
    }
    const admissionSummary = admissionNotes.length
        ? " (VPN exits not admitting new connections: " ~ admissionNotes.join(", ") ~ ")" : "";
    const vpnOnly = !order.canFind(RouteKind.direct);
    // A known exact exit belongs only to its configured provider. Unknown
    // country/city selectors may retarget Mullvad, never a disabled provider.
    auto preferredProvider = RouteKind.mullvad;
    withPoolLock({
        foreach (ref p; mullvadPool) if (p.label == routing.preferredExit) {
            preferredProvider = p.provider;
            break;
        }
    });
    RouteCandidate[] toTry, gatedLast;
    string[] unavailable;
    foreach (kind; order) {
        if (mayDial !is null && !mayDial()) throw new HolderUnavailableException("connection stopped during routing");
        // Admission/location lookups may yield; never resolve a pin or retarget
        // a provider disabled since the initial planning read.
        if (!requireRoutingOrder(hostLower, routing).canFind(kind)) continue;
        if (kind == RouteKind.ipv6 || kind == RouteKind.direct) {
            const source = kind == RouteKind.ipv6 ? ipv6BindAddr : "";
            if (kind == RouteKind.ipv6 && source.length == 0) {
                unavailable ~= "ipv6 [unavailable]: native transport or saved IPv6 allocation unavailable";
                continue;
            }
            const banKey = kind == RouteKind.ipv6 ? "ipv6:" ~ source : DIRECT_EGRESS_LABEL;
            if (!isRouteBannedForHost(hostLower, banKey)) {
                auto candidate = RouteCandidate(kind, null, source, banKey, false,
                    routeIdentityLocked(null, source), unavailable.join("; "));
                // A known SASL gate is ineligible until all ungated routes
                // have failed; preserve configured order within each group.
                if (unauthenticated && isEgressSaslGatedForHost(hostLower, banKey)) gatedLast ~= candidate;
                else toTry ~= candidate;
            }
            else unavailable ~= banKey ~ " [avoided]: host ban";
            continue;
        }
        MullvadProxy*[] regular, gated, trials;
        foreach (p; admitted) {
            if (p.provider != kind) continue;
            if (unauthenticated && isEgressSaslGatedForHost(hostLower, slotBanKey(p))) gated ~= p;
            else regular ~= p;
        }
        foreach (p; recovering) {
            if (p.provider != kind) continue;
            if (unauthenticated && isEgressSaslGatedForHost(hostLower, slotBanKey(p))) continue;
            trials ~= p;
        }
        auto excluded = notAdmitted.dup;
        withPoolLock({
            foreach (ref p; mullvadPool)
                if (p.provider != kind) excluded[p.label] = true;
        });
        MullvadProxy* preferredSlot;
        if (routing.preferredExit.length && preferredProvider == kind) {
            // A location match and an idle retarget must stay in this tier.
            string reason;
            if (!requireRoutingOrder(hostLower, routing).canFind(kind)) continue;
            auto slot = acquireSlotForPin(hostLower, routing.preferredExit, reason, excluded);
            if (slot !is null && slot.provider == kind
                    && !(unauthenticated && isEgressSaslGatedForHost(hostLower, slotBanKey(slot)))) {
                preferredSlot = slot;
                if (!regular.canFind(slot)) regular ~= slot;
            } else if (slot is null) {
                report(progress, "info", preferredExitFallbackCopy(reason));
            }
        } else if (kind == RouteKind.mullvad && regular.length == 0 && gated.length == 0) {
            // Retarget only an eligible Mullvad slot; durable drains and
            // quarantines still exclude it before any location lookup.
            const target = bestUnbannedLocationFor(hostLower);
            if (target.length) {
                string reason;
                if (!requireRoutingOrder(hostLower, routing).canFind(kind)) continue;
                auto slot = acquireSlotForPin(hostLower, target, reason, excluded);
                if (slot !is null && slot.provider == kind) regular ~= slot;
            }
        }
        if (!requireRoutingOrder(hostLower, routing).canFind(kind)) continue;
        void appendTier(MullvadProxy*[] tier, bool recovery, bool rankMemory) {
            tier = tierAndOrderProxies(tier, mullvadRR, networkId, orderNowMs, avoidLabel);
            auto keys = new string[tier.length];
            foreach (i, p; tier) keys[i] = routeIdentityLocked(p, "");
            // Route memory is strictly local to this configured provider
            // tier. Gated/recovery candidates cannot escape their sub-tier.
            if (rankMemory && tier.length > 1)
                rankByRouteMemory(gRouteMemory, endpointKey, tier, keys, orderNowMs,
                    (size_t i) => avoidLabel.length == 0 || tier[i].label != avoidLabel);
            // preferredExit is only a bias among admitted, ungated exits.
            if (rankMemory && preferredSlot !is null) {
                foreach (i, p; tier) if (p is preferredSlot) {
                    const key = keys[i];
                    tier = [p] ~ tier[0 .. i] ~ tier[i + 1 .. $];
                    keys = [key] ~ keys[0 .. i] ~ keys[i + 1 .. $];
                    break;
                }
            }
            foreach (i, p; tier) {
                auto candidate = RouteCandidate(kind, p, "", slotBanKey(p), recovery, keys[i], unavailable.join("; "));
                if (!recovery && !rankMemory) gatedLast ~= candidate;
                else toTry ~= candidate;
            }
        }
        if (gMullvadLock !is null) synchronized (gMullvadLock) {
            appendTier(regular, false, true);
            appendTier(trials, true, false);
            appendTier(gated, false, false);
        } else {
            appendTier(regular, false, true);
            appendTier(trials, true, false);
            appendTier(gated, false, false);
        }
    }
    toTry ~= gatedLast;
    if (toTry.length == 0)
        throw new RoutingPolicyBlockedException("routing_policy_blocked", admissionSummary
            ~ (unavailable.length ? " (" ~ unavailable.join("; ") ~ ")" : ""));
    Exception lastErr;
    string[] failures;
    foreach (candidate; toTry) {
        if (mayDial !is null && !mayDial()) throw new HolderUnavailableException("connection stopped during routing");
        auto proxy = candidate.proxy;
        const kind = candidate.kind;
        if (!requireRoutingOrder(hostLower, routing).canFind(kind)) continue;
        // Atomic re-check right before the dial: a drain or quarantine that
        // landed after planning still stops it, and only a recovery-tier
        // candidate may claim the exit's single trial.
        string trialToken;
        if (proxy !is null) {
            const adm = admitDial(exitRef(proxy), candidate.recovery);
            if (!adm.allowed) {
                failures ~= proxy.label ~ " [admission]: " ~ adm.blockedState;
                if (lastErr is null)
                    lastErr = new RoutingPolicyBlockedException("routing_policy_blocked",
                        "VPN exit " ~ proxy.label ~ " is not admitting new connections ("
                        ~ adm.blockedState ~ ")" ~ (vpnOnly ? " — not falling back to direct" : ""));
                logJsonMap("info", "connection", "Egress dial refused by admission",
                    ["host": hostLower, "label": proxy.label, "admission": adm.blockedState,
                     "event": "egress_admission_refused"]);
                continue;
            }
            trialToken = adm.trialToken;
            if (trialToken.length) {
                logJsonMap("info", "connection", "Egress recovery trial claimed",
                    ["host": hostLower, "label": proxy.label, "event": "egress_trial_claimed"]);
                report(progress, "info", "VPN exit " ~ proxy.label ~ " finished its quarantine cooldown; this "
                    ~ "connection is its single recovery trial and must stay registered for 60s before the "
                    ~ "exit takes new connections again.");
            }
        }
        candidate.trialToken = trialToken;
        try {
            // Admission and progress callbacks can yield. Check again after
            // the claim, immediately before the transport seam; the real
            // holder wrapper also checks after composing its progress event.
            requirePermittedRoute(hostLower, routing, kind);
            auto conn = dial(candidate, dr);
            // CONNECTED is observed transport evidence, not a reservation.
            noteRouteOutcome(endpointKey, hostLower, proxy, candidate.sourceAddress, candidate.memoryKey, true);
            used = EgressUsed.init;
            used.kind = kind;
            used.locationId = kind == RouteKind.ipv6 ? "ipv6:" ~ dr.localIp : candidate.hostBanKey;
            used.fallbackReason = candidate.skippedReason
                ~ (candidate.skippedReason.length && failures.length ? "; " : "") ~ failures.join("; ");
            if (proxy !is null) {
                used.label = proxy.label;
                used.host = proxy.host ~ ":" ~ proxy.port.to!string;
                // Best-effort resolve Tailnet IP for admin display.
                used.ip = resolveProxyIp(proxy);
                used.locationId = slotBanKey(proxy);
                used.locationText = proxyLocationText(proxy);
                // Take the slot's refcount: it can no longer be retargeted
                // while this connection lives. Released by the client's
                // releaseEgressSlot() on every disconnect / reconnect.
                holdSlot(proxy.label);
                used.trialToken = trialToken;
                if (trialToken.length) used.trialExit = exitRef(proxy);
            }
            return conn;
        } catch (HolderUnavailableException e) {
            // The exit was never tried: no ban, no counters — just retry
            // later from the connection loop. A claimed trial is released
            // without penalty.
            if (trialToken.length)
                settleTrial(exitRef(proxy), trialToken, EgressTrialOutcome.abort, "");
            throw e;
        } catch (RoutingPolicyBlockedException e) {
            if (trialToken.length)
                settleTrial(exitRef(proxy), trialToken, EgressTrialOutcome.abort, "");
            if (e.code != "routing_policy_blocked") throw e;
            // Another explicitly permitted tier may remain. No route/health
            // evidence is recorded for a policy refusal.
            lastErr = e;
            continue;
        } catch (Exception e) {
            lastErr = e;
            logWarn("happyEyeballsConnect via %s failed for %s:%d: %s, trying next egress",
                candidate.hostBanKey, host, port, e.msg);
            // A trial dial that reached the exit and failed reopens the
            // circuit with the next cooldown; a holder-side refusal never
            // exercised the exit and only releases the claim.
            if (trialToken.length) {
                const holderSide = cast(HolderErrorException) e !is null || dialFailurePhase(e) == "holder";
                settleTrial(exitRef(proxy), trialToken,
                    holderSide ? EgressTrialOutcome.abort : EgressTrialOutcome.failure,
                    "recovery trial dial failed [" ~ dialFailurePhase(e) ~ "]");
            }
            // Recorded before the ban checks below: a ban forgets the
            // route's memos, so no stale cooling entry outlives it.
            if (isRouteDialFailure(e))
                noteRouteOutcome(endpointKey, hostLower, proxy, candidate.sourceAddress, candidate.memoryKey, false);
            failures ~= candidate.hostBanKey ~ " [" ~ dialFailurePhase(e) ~ "]: " ~ shortConnectError(e.msg);
            // On TLS timeout specifically, ban this egress for this host so the next proxy is tried immediately
            // rather than re-cycling the same wedged exit.
            if (e.msg.canFind("TLS handshake timed out")) {
                banEgressForHost(host, candidate.hostBanKey);
            }
            // OpenSSL "wrong version number" (0A00010B) right after tcp_open
            // means the bytes we got back were not a TLS record at all — a
            // G/K/Z-lined address answered in plaintext (ERROR :Closing
            // Link: ... (Z-Lined): ...) and our TLS client never got far
            // enough to read it as text, just far enough to fail the
            // record-type parse. Confirmed live against this exact failure
            // (irc.supernets.org Z-lines Mullvad's IPv6 ranges with "ENTER
            // THE VOID"): every one of us/de/ch read back the plaintext 465
            // + NOTICE + ERROR, which OpenSSL reports only as this error
            // code. The reconnect-loop's "tunnel closed" inference
            // (consecutiveTlsClosed, 15 min) never sees it — different
            // wording — so without this the engine retried all 3 banned
            // exits on every single (re)connect before falling through to
            // NordVPN. Treat it as confirmed as a spelled-out Z-line
            // (applyBanPolicy's full HOST_EGRESS_BAN_MS), not the shorter
            // inferred ban: we are reading the same server-side rejection,
            // just through a different code path.
            if (e.msg.canFind("wrong version number")) {
                banEgressForHost(host, candidate.hostBanKey);
            }
            continue;
        }
    }
    used = EgressUsed.init;
    // Every candidate failed once: say which phase each one died in (a TLS
    // EOF on every route reads very differently from TCP refusals). The
    // route memory only learned failures here, nothing is claimed to work.
    if (failures.length > 0) {
        const summary = failures.join("; ");
        logJsonMap("warn", "connection", "Every egress route failed",
            ["host": hostLower, "port": port.to!string, "tls": tlsMode,
             "routes": summary, "event": "egress_all_failed"]);
        if (failures.length > 1)
            report(progress, "info", "No route reached " ~ stripHostBrackets(host) ~ ":" ~ port.to!string
                ~ " — " ~ summary ~ ".");
    }
    throw lastErr ? lastErr : new RoutingPolicyBlockedException("routing_policy_blocked");
}

/// Failure phase for diagnostics: the holder's typed `FAILED` phase
/// (`dns`/`tcp`/`socks5`/`tls`/`starttls`/`holder`), `holder:<code>` for an
/// `ERR` reply, `error` for anything untyped.
private string dialFailurePhase(Exception e) nothrow {
    if (auto d = cast(DialFailedException) e) return d.phase.length ? d.phase : "unknown";
    if (auto h = cast(HolderErrorException) e) return "holder:" ~ h.code;
    return "error";
}

version (EgressPlanRegressionHarness) {
    private final class ScriptedRoutingPolicySource : RoutingPolicySource {
        import ircfiber.irc.routing_policy : routingPolicyFromJson, resolveRoutingPolicy;
        import vibe.data.json : parseJsonString;
        string raw;
        bool failing;

        EffectiveRoutingPolicy read(string host, const RoutingPreferences routing) {
            if (failing) throw new Exception("policy storage unavailable");
            return resolveRoutingPolicy(routingPolicyFromJson(parseJsonString(raw)), host, routing);
        }

        void block(RouteKind[] routes) {
            auto doc = routingPolicyFromJson(parseJsonString(raw));
            doc.global.blockedRoutes = routes;
            doc.revision++;
            raw = doc.toJson().toString();
        }
    }

    private RoutingPreferences testRouting(RouteKind[] order, string preferredExit = "") {
        RoutingPreferences routing;
        routing.inherit = false;
        routing.order = order;
        routing.preferredExit = preferredExit;
        return routing;
    }
    /// Runs the real egress policy loop against a scripted holder transport.
    /// Isolates every egress table the loop reads or writes and restores
    /// them in `close()`.
    private struct EgressPlanHarness {
        MullvadProxy[] savedPool;
        bool savedLoaded;
        size_t savedRR;
        RouteMemory savedMemory;
        long[string][string] savedBans, savedGates;
        bool[string][string] savedDaily;
        ExitRelay[] savedRelays;
        EgressAdmissionStore savedStore;
        RoutingPolicySource savedPolicy;
        ScriptedRoutingPolicySource policy;
        /// Admission backend for this harness: every exit healthy until a
        /// test scripts otherwise.
        ScriptedAdmissionStore admission;
        /// route ("direct" or slot label) → outcome: a holder FAILED phase,
        /// or "holder-down" / "holder-err" / "untyped". Absent = CONNECTED.
        string[string] failWith;
        /// Called with each candidate as its dial starts.
        void delegate(MullvadProxy*) onDial;
        string[] dialed;
        RouteCandidate[] candidates;
        EgressUsed used;
        Exception failed;
        PendingQuarantine[string] savedPending;

        static EgressPlanHarness open(MullvadProxy[] pool) {
            EgressPlanHarness h;
            h.savedPool = mullvadPool; h.savedLoaded = mullvadPoolLoaded; h.savedRR = mullvadRR;
            h.savedMemory = gRouteMemory; h.savedBans = hostEgressBanUntil; h.savedGates = hostSaslGateUntil;
            h.savedDaily = dailyReachabilityBanned; h.savedRelays = gExitRelays; h.savedStore = gAdmissionStore;
            h.savedPending = gPendingQuarantines;
            h.savedPolicy = gRoutingPolicySource;
            h.policy = new ScriptedRoutingPolicySource;
            // An explicit fixture seed, not a production fallback.
            h.policy.raw = `{"schema":1,"revision":0,"global":{"order":["mullvad","nordvpn","direct"],"blockedRoutes":[]},"hosts":[]}`;
            gRoutingPolicySource = h.policy;
            mullvadPool = pool; mullvadPoolLoaded = true; gRouteMemory = RouteMemory.init;
            hostEgressBanUntil = null; hostSaslGateUntil = null; dailyReachabilityBanned = null; gExitRelays = null;
            gPendingQuarantines = null;
            h.admission = new ScriptedAdmissionStore;
            gAdmissionStore = h.admission;
            return h;
        }

        void close() {
            mullvadPool = savedPool; mullvadPoolLoaded = savedLoaded; mullvadRR = savedRR;
            gRouteMemory = savedMemory; hostEgressBanUntil = savedBans; hostSaslGateUntil = savedGates;
            dailyReachabilityBanned = savedDaily; gExitRelays = savedRelays; gAdmissionStore = savedStore;
            gPendingQuarantines = savedPending;
            gRoutingPolicySource = savedPolicy;
        }

        /// Two Mullvad slots (Mullvad tier) and one static NordVPN-style exit.
        static MullvadProxy[] standardPool() {
            MullvadProxy de, ch, nord;
            de.provider = ch.provider = RouteKind.mullvad;
            nord.provider = RouteKind.nordvpn;
            de.label = "de"; de.host = "10.64.0.1"; de.port = 1080; de.controlSocket = "/ctl/de.sock";
            de.locationId = "de-ber"; de.exitHostname = "de-ber-wg-001";
            ch.label = "ch"; ch.host = "10.64.0.2"; ch.port = 1080; ch.controlSocket = "/ctl/ch.sock";
            ch.locationId = "ch-zrh"; ch.exitHostname = "ch-zrh-wg-001";
            nord.label = "nord-se"; nord.host = "10.64.0.3"; nord.port = 1080;
            return [de, ch, nord];
        }

        TCPConnection fakeDial(RouteCandidate candidate, out DialResult r) {
            auto p = candidate.proxy;
            const name = p !is null ? p.label : candidate.kind == RouteKind.ipv6 ? "ipv6" : "direct";
            dialed ~= name;
            candidates ~= candidate;
            if (onDial !is null) onDial(p);
            if (auto outcome = name in failWith) {
                switch (*outcome) {
                    case "holder-down": throw new HolderUnavailableException("holder down");
                    case "holder-err": throw new HolderErrorException("busy", "holder busy");
                    case "untyped": throw new Exception("unexpected holder reply");
                    default: throw new DialFailedException(*outcome, "connection closed by peer");
                }
            }
            r.peerIp = "192.0.2.1";
            r.localIp = candidate.sourceAddress.length ? candidate.sourceAddress : "192.0.2.2";
            return TCPConnection.init;
        }

        /// One connect; returns the routes dialed, in order. The Mullvad
        /// rotation restarts at its first slot every call.
        string[] connect(string host, RoutingPreferences routing = RoutingPreferences.init, ushort port = 6697, string tls = "implicit",
                         bool unauthenticated = false, string avoid = "", string ipv6 = "",
                         scope bool delegate() mayDial = null) {
            dialed = null; used = EgressUsed.init; failed = null; mullvadRR = 0;
            candidates = null;
            DialResult dr;
            try connectThroughEgressPlan(&fakeDial, "network-a", host, port, tls, routing, unauthenticated,
                ipv6, null, avoid, used, dr, mayDial);
            catch (Exception e) failed = e;
            return dialed;
        }

        MullvadProxy* proxy(string label) {
            foreach (ref p; mullvadPool) if (p.label == label) return &p;
            assert(0, "no slot " ~ label);
        }

        /// Writes route evidence `agoMs` in the past, as a dial would have.
        void remember(string host, string route, bool ok, long agoMs = 0, ushort port = 6697,
                      string tls = "implicit", string ipv6 = "") {
            auto p = route == "direct" ? null : proxy(route);
            gRouteMemory.record(routeEndpointKey(host, port, tls), host, routeIdentityLocked(p, ipv6),
                p is null ? DIRECT_EGRESS_LABEL : slotBanKey(p).toLower(), ok, unixMsNow() - agoMs);
        }

        RouteStanding standing(string host, string route, ushort port = 6697, string tls = "implicit") {
            long at;
            auto p = route == "direct" ? null : proxy(route);
            return gRouteMemory.standing(routeEndpointKey(host, port, tls), routeIdentityLocked(p, ""),
                unixMsNow(), at);
        }
    }
}

version (FiberMlsWireHarness)
Ircv3Check[] silentTransportRouteChecks() {
    auto h = EgressPlanHarness.open(EgressPlanHarness.standardPool());
    scope(exit) h.close();
    bool directAvailable = true, explicitBanRespected = true;
    foreach (host; [DEFAULT_FIBER_HOST, "direct-only.example.org"]) {
        auto routing = testRouting([RouteKind.direct]);
        recordSilentEgressLoss(host, "", DIRECT_EGRESS_LABEL);
        directAvailable = directAvailable && h.connect(host, routing) == ["direct"] && h.failed is null;
        banEgressForHost(host, DIRECT_EGRESS_LABEL);
        explicitBanRespected = explicitBanRespected && h.connect(host, routing).length == 0
            && cast(RoutingPolicyBlockedException) h.failed !is null;
    }
    enum vpnHost = "silent-vpn-loss.example.org";
    recordSilentEgressLoss(vpnHost, "de", "de-ber");
    auto routes = h.connect(vpnHost, testRouting([RouteKind.mullvad]));
    return [
        Ircv3Check("silent transport loss keeps first-party and direct-only routes eligible", directAvailable),
        Ircv3Check("explicit server bans still block first-party and direct-only routes", explicitBanRespected),
        Ircv3Check("silent dynamic VPN loss still rotates away from the failed exit",
            routes.length > 0 && !routes.canFind("de") && h.failed is null)
    ];
}

