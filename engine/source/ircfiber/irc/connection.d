// ── Per-host circuit breaker ─────────────────────────────────────────────────
// Prevents hammering unresponsive servers with rapid reconnect attempts.
// Shared across all PersistentIRCClient instances in the same process.
// After HOST_FAIL_THRESHOLD consecutive failures to the same host:port within
// HOST_WINDOW_MS, the circuit opens and blocks further attempts for
// HOST_COOLDOWN_MS. Reset on any successful connection.
private struct HostCircuitBreaker {
    int failCount;
    long openedAt;   // 0 = closed
    long lastAttemptAt;
    /// How many times the breaker has opened without a successful
    /// connection in between; drives the escalating cooldown.
    int openCount;
}
private HostCircuitBreaker[string] _hostBreakers;
private __gshared Object gHostBreakerLock;
private shared static this() {
    try {
        if (gMullvadLock is null) gMullvadLock = new Object();
        gHostBreakerLock = new Object();
    } catch (Throwable) {}
}
private shared static immutable HOST_WINDOW_MS   = 30 * 60 * 1000;  // 30 min
private shared static immutable HOST_FAIL_THRESHOLD = 5;
private shared static immutable HOST_COOLDOWN_MS = 5 * 60 * 1000;  // first cooldown; doubles per re-open
private shared static immutable HOST_COOLDOWN_MAX_MS = 60 * 60 * 1000;

/// Cooldown for the Nth opening of a host breaker: 5, 10, 20, 40, 60 min.
private long hostCooldownMs(int openCount) @safe pure nothrow @nogc {
    long ms = HOST_COOLDOWN_MS;
    foreach (i; 1 .. openCount) {
        ms *= 2;
        if (ms >= HOST_COOLDOWN_MAX_MS) return HOST_COOLDOWN_MAX_MS;
    }
    return ms;
}

/// Record a connection failure to a host. Shared across all clients.
void recordHostFailure(string host, int port) {
    if (gHostBreakerLock !is null) synchronized (gHostBreakerLock) {
        recordHostFailureLocked(host, port);
        return;
    }
    recordHostFailureLocked(host, port);
}
private void recordHostFailureLocked(string host, int port) {
    auto key = host ~ ":" ~ port.to!string;
    auto now = Clock.currTime.toUnixTime!long * 1000;
    auto breaker = key in _hostBreakers;
    if (breaker !is null) {
        if (now - breaker.lastAttemptAt > HOST_WINDOW_MS) {
            breaker.failCount = 0;
            breaker.openedAt = 0;
            breaker.openCount = 0;
        }
        breaker.failCount++;
        breaker.lastAttemptAt = now;
        if (breaker.failCount >= HOST_FAIL_THRESHOLD && breaker.openedAt == 0) {
            breaker.openedAt = now;
            breaker.openCount++;
            logWarn("Host circuit breaker OPENED for %s after %d failures (opening #%d, cooling down %d ms)",
                key, breaker.failCount, breaker.openCount, hostCooldownMs(breaker.openCount));
        }
    } else {
        _hostBreakers[key] = HostCircuitBreaker(1, 0, now, 0);
    }
}

/// Record a successful connection — resets the breaker for this host.
void recordHostSuccess(string host, int port) {
    if (gHostBreakerLock !is null) synchronized (gHostBreakerLock) {
        auto key = host ~ ":" ~ port.to!string;
        if (auto breaker = key in _hostBreakers) {
            _hostBreakers.remove(key);
            logInfo("Host circuit breaker CLOSED for %s (connection succeeded)", key);
        }
        return;
    }
    auto key = host ~ ":" ~ port.to!string;
    if (auto breaker = key in _hostBreakers) {
        _hostBreakers.remove(key);
        logInfo("Host circuit breaker CLOSED for %s (connection succeeded)", key);
    }
}

/// Check if the circuit breaker allows a new connection. Returns false
/// (don't connect) when the circuit is open and still in cooldown.
bool canConnectToHost(string host, int port) {
    if (gHostBreakerLock !is null) synchronized (gHostBreakerLock) {
        return canConnectToHostLocked(host, port);
    }
    return canConnectToHostLocked(host, port);
}
private bool canConnectToHostLocked(string host, int port) {
    auto key = host ~ ":" ~ port.to!string;
    if (auto breaker = key in _hostBreakers) {
        if (breaker.openedAt > 0) {
            const now = Clock.currTime.toUnixTime!long * 1000;
            if (now - breaker.openedAt < hostCooldownMs(breaker.openCount)) {
                return false;
            }
            _hostBreakers.remove(key);
            logInfo("Host circuit breaker CLOSED for %s (cooldown expired)", key);
        }
    }
    return true;
}

// ── Enterprise connection timeouts ───────────────────────────────────────────
// These bounds prevent a single silent/black-holed peer from hanging an engine
// fiber forever. vibe.d's connectTCP defaults to Duration.max; TLS handshake
// has no timeout at all. Every blocking network step must be bounded.
private enum CONNECT_TIMEOUT_SECONDS               = 10;
private enum TLS_HANDSHAKE_TIMEOUT_SECONDS         = 10;
private enum HAPPY_EYEBALLS_RACE_TIMEOUT_SECONDS   = 15;
// Upper bounds on the CAP+NICK+USER+SASL handshake, from the first
// registration byte we send to either RPL_WELCOME (001) or a fatal error
// reply (433, 464, …). RFC 2812 §2.3: "it is not advised to wait forever
// for the reply" — this is the enforcement. Two tiers:
//
//   SILENT  (30 s): the server has sent us nothing at all. That is a
//           black-holed peer (open TCP, never replies); waiting longer only
//           wedges the network's join state.
//   OVERALL (90 s): the server has sent at least one line, so it is alive
//           and merely slow. The usual cause is the ident lookup: ircds
//           connect back to port 113 and wait out their own timer before
//           `No Ident response` → 001. Mullvad exits DROP inbound 113 (no
//           RST), so e.g. DALnet (bahamut-2.2.4) sends `Checking Ident`
//           at +0.4 s and 001 at +37 s — a 30 s cutoff never registered.
//
// Stuck states surface via ircfiber.registration.timeout in the admin API.
private enum REGISTRATION_SILENT_TIMEOUT_SECS     = 30;
private enum REGISTRATION_OVERALL_TIMEOUT_SECS    = 90;
// Cap on the auto-appended-underscore fallback chain during registration.
// After this many 433s we stop appending `_` (which produces the
// `Zod___`, `Zod____`, ... ghost member entries that accumulate in
// shared channels across reconnect cycles) and instead switch to a
// unique random-suffix nick that we persist for future reconnects.
// Reset to 0 on every 001.
private enum REGISTRATION_MAX_FALLBACK_ATTEMPTS  = 3;
// Length of the random hex suffix appended to the configured nick when
// the engine has to abandon the fallback chain. 5 hex chars → ~1M
// combinations — collision odds on a populated network are negligible,
// and the suffix is short enough to fit comfortably inside IRC's 9-31
// char nick limit on most servers.
private enum REGISTRATION_RANDOM_SUFFIX_HEX_LEN  = 5;
// How long to wait after sending `NickServ GHOST` before retrying NICK.
// Anope/Atheme process GHOST synchronously and kill the target session
// in well under a second in practice; this just gives the server a
// moment to act before we re-ask for the nick, bounded well short of
// the ~30-60s ghost-protection timeout we'd otherwise have to wait out.
private enum GHOST_RECLAIM_WAIT_MS              = 2000;
// Fractions of REGISTRATION_OVERALL_TIMEOUT_SECS at which we emit a
// warning event so operators can see the registration is in progress
// (e.g. 50% / 75%). Helps diagnose slow networks without waiting
// for the full timeout to fire.
private enum REGISTRATION_WARN_AT_FRACTION_1     = 50;
private enum REGISTRATION_WARN_AT_FRACTION_2     = 75;

// ── Happy Eyeballs (RFC 8305) ─────────────────────────────────────────────────
//
// Direct dials race IPv6 and IPv4 inside the connection holder (holder.dial):
// DNS → interleave families → 250 ms stagger → first winner. The engine only
// picks the egress and forwards the holder's timeline events.

// ── Mullvad egress (SOCKS5) slots ────────────────────────────────────────────
// A fixed pool of long-lived *slots* (one SOCKS sidecar each) configured at
// deploy time via IRCFIBER_MULLVAD_POOL. Slot count is fixed at runtime:
// happyEyeballsConnect holds raw MullvadProxy* into `mullvadPool` outside the
// lock, so the array is only ever mutated in place.
//
// Each slot is *retargeted* to a Mullvad exit location on demand
// (`tailscale --socket=<slot> set --exit-node=…`) rather than a sidecar being
// launched per location — Mullvad-over-Tailscale is device-license limited.
// A slot carrying live connections (`activeConns > 0`) or inside its sticky
// hold (`heldUntilMs`) is never retargeted, so picking a location can never
// yank another network's egress.
//
// NetworkConfig.routing supplies the complete provider order. preferredExit
// only biases an eligible exit inside its provider; it never enables a route.
// Smart picker is host-aware: when a server G/K/Z-lines an egress, that
// *location* is auto-banned for that host for 12 h (no hostname hardcode).
// Global circuit-breaker still marks a slot dead 30 s after 3 generic fails.
private struct MullvadProxy {
    string host;
    ushort port;
    string label;
    int failCount;
    long deadUntilMs;
    // ── Slot identity/state. Mutated in place under gMullvadLock only. ──
    /// tailscaled LocalAPI socket for this slot; "" = not controllable
    /// (static sidecar, no shared control volume) — never retargeted.
    string controlSocket;
    /// Current exit location id ("de-ber"); "" until the first status read.
    string locationId;
    /// Current exit relay host name ("de-ber-wg-003").
    string exitHostname;
    string exitCountry;
    string exitCountryCode;
    string exitCity;
    /// "ready" | "retargeting" | "error".
    string state = "ready";
    string lastError;
    /// Live connections currently egressing through this slot.
    int activeConns;
    /// Slot is reserved (retarget in flight) or in its post-release sticky
    /// hold until this unix-ms timestamp.
    long heldUntilMs;
    /// RFC 1929 SOCKS5 credentials for a credentialed static slot (e.g.
    /// NordVPN); "" for Mullvad's no-auth sidecars.
    string username;
    string password;
    /// Unix ms of this slot's last successful dial, any host; 0 = never
    /// (this process). Used to rank the static (NordVPN-like) tier by
    /// most-recently-proven-live instead of blind round robin — see
    /// happyEyeballsConnect's tiering comment.
    long lastSuccessMs;
    /// Correlated established-session losses, keyed by full IRC hostname.
    /// Detection evidence only: the resulting quarantine is durable admission
    /// state (ircfiber.irc.egress_admission), never a field of this slot.
    long[string] recentLossAtMsByHost;
    /// Explicit configured provider, independent of label or control support.
    RouteKind provider = RouteKind.nordvpn;
}
private __gshared MullvadProxy[] mullvadPool;
private __gshared size_t mullvadRR;
private __gshared bool mullvadPoolLoaded;
private __gshared Object gMullvadLock;
/// Set once from bootstrap.d right after the engine's Redis connection is
/// established (mirrors NetworkRepository.initRedis). Lets
/// loadNordvpnPoolUnlocked fill credential-less entries from
/// RedisKeys.nordvpnCreds() without threading redis through getHealthyProxies.
private __gshared RedisStorage gEgressRedis;

void setEgressRedis(RedisStorage redis) {
    gEgressRedis = redis;
    gAdmissionStore = redis is null ? null : new RedisAdmissionStore(redis);
    gRoutingPolicySource = redis is null ? null : new RedisRoutingPolicySource(redis);
}

/// Current durable policy, never a last-known-permissive cache. Like admission,
/// the source is initialized by setEgressRedis during bootstrap. Only the
/// unittest harness substitutes a source; production never seeds defaults.
private interface RoutingPolicySource {
    EffectiveRoutingPolicy read(string host, const RoutingPreferences routing);
}

private final class RedisRoutingPolicySource : RoutingPolicySource {
    private RedisStorage redis;
    this(RedisStorage redis) { this.redis = redis; }
    EffectiveRoutingPolicy read(string host, const RoutingPreferences routing) {
        return loadEffectiveRoutingPolicy(redis.getDb(), host, routing);
    }
}

private __gshared RoutingPolicySource gRoutingPolicySource;

/// A policy refusal is not transport/host failure evidence. Keep it distinct
/// throughout the dial loop, including refusals at the final holder boundary.
private class RoutingPolicyBlockedException : Exception {
    string code;
    this(string code, string detail = "") {
        this.code = code;
        super(code == "routing_policy_unavailable" || code == "invalid_stored_routing"
            ? code : "Routing policy permits no available route" ~ detail);
    }
}

private EffectiveRoutingPolicy currentRoutingPolicy(string host, const RoutingPreferences routing) {
    EffectiveRoutingPolicy unavailable;
    unavailable.available = false;
    unavailable.errorCode = routing.valid ? "routing_policy_unavailable" : "invalid_stored_routing";
    if (!routing.valid || gRoutingPolicySource is null) return unavailable;
    try {
        return gRoutingPolicySource.read(host, routing);
    } catch (Exception) {
        return unavailable;
    }
}

private RouteKind[] requireRoutingOrder(string host, const RoutingPreferences routing) {
    auto effective = currentRoutingPolicy(host, routing);
    if (!effective.available)
        throw new RoutingPolicyBlockedException(effective.errorCode);
    if (effective.order.length == 0)
        throw new RoutingPolicyBlockedException("routing_policy_blocked");
    return effective.order;
}

private void requirePermittedRoute(string host, const RoutingPreferences routing, RouteKind kind) {
    if (!requireRoutingOrder(host, routing).canFind(kind))
        throw new RoutingPolicyBlockedException("routing_policy_blocked");
}

// ── Durable egress admission ─────────────────────────────────────────────────
// Operator drain, correlated-loss quarantine and the single recovery trial
// live in Redis (ircfiber.irc.egress_admission), shared by every engine and
// the gateway and surviving hot swaps. They are read and written only
// outside gMullvadLock (Redis I/O yields the fiber). Without a store every
// VPN exit reads `unavailable`: new VPN dials fail closed.

/// Lock for a claimed trial before its session registers: dial, TLS or
/// STARTTLS and the whole registration budget, with margin.
private enum long EGRESS_TRIAL_CLAIM_MS = 180_000L;
/// Lock extension past registration: the sustain window, the keepalive
/// tick that sends the verifying PING (<= 30 s) and its PONG, with margin.
private enum long EGRESS_TRIAL_SETTLE_SLACK_MS = 90_000L;

/// Admission backend seam. Production is `RedisAdmissionStore`; unit tests
/// install a scripted store. Every method may throw; callers fail closed.
private interface EgressAdmissionStore {
    EgressAdmission[] read(const(EgressEndpointRef)[] exits, long nowMs);
    EgressDialAdmit admit(EgressEndpointRef exit, bool allowTrial, long claimMs, long nowMs);
    bool validateDial(EgressEndpointRef exit, string token, long nowMs);
    bool renewTrial(EgressEndpointRef exit, string token, long untilMs, long nowMs);
    string settleTrial(EgressEndpointRef exit, string token, EgressTrialOutcome outcome,
                       string reason, long nowMs);
    EgressQuarantine quarantine(EgressEndpointRef exit, string reason, long nowMs);
}

private final class RedisAdmissionStore : EgressAdmissionStore {
    private RedisStorage redis;
    this(RedisStorage redis) { this.redis = redis; }
    private RedisDatabase db() { return redis.getDb(); }
    EgressAdmission[] read(const(EgressEndpointRef)[] exits, long nowMs) {
        return readEgressAdmissions(db(), exits, nowMs);
    }
    EgressDialAdmit admit(EgressEndpointRef e, bool allowTrial, long claimMs, long nowMs) {
        return admitEgressDial(db(), e.label, e.host, e.port, allowTrial, claimMs, nowMs);
    }
    bool validateDial(EgressEndpointRef e, string token, long nowMs) {
        return validateEgressDial(db(), e.label, e.host, e.port, token, nowMs);
    }
    bool renewTrial(EgressEndpointRef e, string token, long untilMs, long nowMs) {
        return renewEgressTrial(db(), e.label, e.host, e.port, token, untilMs, nowMs);
    }
    string settleTrial(EgressEndpointRef e, string token, EgressTrialOutcome outcome, string reason, long nowMs) {
        return settleEgressTrial(db(), e.label, e.host, e.port, token, outcome, reason, nowMs);
    }
    EgressQuarantine quarantine(EgressEndpointRef e, string reason, long nowMs) {
        return quarantineEgress(db(), e.label, e.host, e.port, reason, nowMs);
    }
}

private __gshared EgressAdmissionStore gAdmissionStore;

version (unittest) version = EgressPlanRegressionHarness;
version (FiberMlsWireHarness) version = EgressPlanRegressionHarness;
version (EgressPlanRegressionHarness) {
    /// Scripted admission backend: read verdicts and pre-dial replies are
    /// set by each test; it keeps only a ledger of trial claims and settled
    /// exit verdicts so tests can assert their effect. The real state
    /// machine runs in Redis (egress-admission-redis-test).
    private final class ScriptedAdmissionStore : EgressAdmissionStore {
        /// label → read() verdict; absent = healthy.
        EgressAdmission[string] states;
        /// label → admit() reply; absent = allowed without a trial. A reply
        /// carrying a trial token is refused (`recovering`) unless the dial
        /// is a recovery-tier candidate, as the store contract requires.
        EgressDialAdmit[string] admitReplies;
        /// read()/admit() throw (store outage).
        bool failing;
        /// The store's own clock refuses a success (`early`).
        bool refuseSuccessAsEarly;
        /// Every trial was cancelled or expired store-side (`stale`).
        bool trialsCancelled;
        /// quarantine() writes are refused (read-only replica / ACL) while
        /// reads keep working.
        bool refuseQuarantineWrites;
        EgressQuarantine quarantineReply = EgressQuarantine(true, false, false, 0);
        /// Claimed and not yet settled: token → exit label.
        string[string] openTrials;
        /// Trial tokens whose session the store saw register.
        bool[string] registeredTrials;
        /// Accepted outcomes in order, "<label>:<outcome>".
        string[] verdicts;
        size_t trialSettlements;
        EgressEndpointRef[] quarantined;
        string[] quarantineReasons;
        void delegate(EgressEndpointRef) onAdmit;
        void delegate() onRead;
        string[] admittedLabels;
        string[] readLabels;

        void set(string label, string state) {
            EgressAdmission a;
            a.state = state;
            a.draining = state == "draining";
            states[label] = a;
        }

        EgressAdmission[] read(const(EgressEndpointRef)[] exits, long nowMs) {
            if (failing) throw new Exception("redis down");
            foreach (e; exits) readLabels ~= e.label;
            if (onRead !is null) onRead();
            EgressAdmission[] r;
            foreach (e; exits) r ~= (e.label in states) ? states[e.label] : EgressAdmission.init;
            return r;
        }
        EgressDialAdmit admit(EgressEndpointRef e, bool allowTrial, long claimMs, long nowMs) {
            if (failing) throw new Exception("redis down");
            admittedLabels ~= e.label;
            if (onAdmit !is null) onAdmit(e);
            EgressDialAdmit r;
            r.allowed = true;
            if (auto scripted = e.label in admitReplies) r = *scripted;
            if (r.trialToken.length && !allowTrial) return EgressDialAdmit(false, "", "recovering");
            if (r.trialToken.length) openTrials[r.trialToken] = e.label;
            return r;
        }
        bool validateDial(EgressEndpointRef e, string token, long nowMs) {
            if (failing) throw new Exception("redis down");
            const state = states.get(e.label, EgressAdmission.init).state;
            if (state == "draining" || state == "quarantined" || state == "unavailable") return false;
            if (token.length)
                return !trialsCancelled && openTrials.get(token, "") == e.label;
            return state == "healthy";
        }
        bool renewTrial(EgressEndpointRef e, string token, long untilMs, long nowMs) {
            if (trialsCancelled || token !in openTrials) return false;
            registeredTrials[token] = true;
            return true;
        }
        string settleTrial(EgressEndpointRef e, string token, EgressTrialOutcome outcome,
                           string reason, long nowMs) {
            trialSettlements++;
            if (trialsCancelled || token !in openTrials) return "stale";
            if (outcome == EgressTrialOutcome.success && refuseSuccessAsEarly) return "early";
            openTrials.remove(token);
            verdicts ~= e.label ~ ":" ~ outcome.to!string;
            return "ok";
        }
        EgressQuarantine quarantine(EgressEndpointRef e, string reason, long nowMs) {
            if (refuseQuarantineWrites) throw new Exception("READONLY You can't write against a read only replica.");
            quarantined ~= e;
            quarantineReasons ~= reason;
            return quarantineReply;
        }
    }
}

private EgressEndpointRef exitRef(const(MullvadProxy)* p) nothrow {
    return EgressEndpointRef(p.label, p.host, p.port);
}

/// A correlated-loss quarantine the store has not accepted yet (outage,
/// read-only replica, ACL refusal). Until it is persisted the exit is
/// `unavailable` to this engine: a write failure never leaves it healthy.
private struct PendingQuarantine {
    EgressEndpointRef exit;
    string reason;
    size_t distinctHosts;
}
/// label → unpersisted quarantine. Guarded by gMullvadLock (no I/O under it).
private __gshared PendingQuarantine[string] gPendingQuarantines;

private bool quarantinePending(string label) nothrow {
    bool pending;
    withPoolLock({ pending = (label in gPendingQuarantines) !is null; });
    return pending;
}

/// Persists every pending quarantine it can (Redis I/O outside the lock).
/// A persisted transition is logged and announced exactly once; a record
/// the store reports as malformed/rebound blocks dials by itself.
private void flushPendingQuarantines() nothrow {
    PendingQuarantine[] todo;
    withPoolLock({ foreach (_, p; gPendingQuarantines) todo ~= p; });
    auto store = gAdmissionStore;
    if (todo.length == 0 || store is null) return;
    foreach (p; todo) {
        const now = nowMsSafe();
        EgressQuarantine q;
        try {
            q = store.quarantine(p.exit, p.reason, now);
        } catch (Exception e) {
            try logWarn("VPN exit %s: correlated-loss quarantine still not persisted (new dials blocked): %s",
                p.exit.label, e.msg);
            catch (Exception) {}
            continue;
        }
        withPoolLock({ gPendingQuarantines.remove(p.exit.label); });
        if (!q.opened) continue;
        try {
            logJsonMap("warn", "connection", "Correlated VPN exit loss",
                ["event": "egress_quarantined", "label": p.exit.label,
                 "distinctHosts": p.distinctHosts.to!string, "retryAtMs": q.retryAtMs.to!string]);
            announceEgressQuarantine(p.exit.label, p.distinctHosts, q.retryAtMs - now, now);
        } catch (Exception) {}
    }
}

/// Admission for `exits`, aligned with them. Never throws: no store or a
/// failed read makes every entry `unavailable`, and so does a quarantine
/// this engine detected but could not persist yet.
private EgressAdmission[] readAdmissions(const(EgressEndpointRef)[] exits) nothrow {
    flushPendingQuarantines();
    auto store = gAdmissionStore;
    string failure = "no admission store configured";
    EgressAdmission[] r;
    if (store !is null) {
        try {
            r = store.read(exits, nowMsSafe());
            if (r.length != exits.length) {
                r = null;
                failure = "admission reply misaligned";
            }
        } catch (Exception e) {
            r = null;
            failure = e.msg;
        }
    }
    if (r is null) {
        r = new EgressAdmission[exits.length];
        foreach (ref a; r) a = unavailableAdmission(failure);
    }
    withPoolLock({
        foreach (i, e; exits) if (e.label in gPendingQuarantines) {
            r[i] = unavailableAdmission("");
            r[i].reason = "correlated-loss quarantine not yet persisted; new dials blocked";
        }
    });
    return r;
}

/// Snapshot only policy-eligible pool exits, outside the pool lock.
private EgressAdmission[string] poolAdmissions(const RouteKind[] order) {
    EgressEndpointRef[] refs;
    withPoolLock({
        foreach (ref p; mullvadPool) if (order.canFind(p.provider)) refs ~= exitRef(&p);
    });
    auto verdicts = readAdmissions(refs);
    EgressAdmission[string] byLabel;
    foreach (i, r; refs) byLabel[r.label] = verdicts[i];
    return byLabel;
}

/// Atomic pre-dial check (and, for the recovery tier, trial claim). Any
/// failure refuses the dial as `unavailable`.
private EgressDialAdmit admitDial(EgressEndpointRef exit, bool allowTrial) nothrow {
    EgressDialAdmit refused;
    refused.blockedState = "unavailable";
    auto store = gAdmissionStore;
    if (store is null || quarantinePending(exit.label)) return refused;
    try {
        return store.admit(exit, allowTrial, EGRESS_TRIAL_CLAIM_MS, nowMsSafe());
    } catch (Exception e) {
        try logWarn("Egress admission check for %s failed — dial refused: %s", exit.label, e.msg);
        catch (Exception) {}
        return refused;
    }
}

/// Marks a trial session registered and extends its lock. "ok" | "stale" |
/// "error" (store unreachable: the claim lock still bounds the trial).
private string renewTrial(EgressEndpointRef exit, string token) nothrow {
    auto store = gAdmissionStore;
    if (store is null || token.length == 0) return token.length ? "error" : "stale";
    try {
        const now = nowMsSafe();
        return store.renewTrial(exit, token, now + EGRESS_TRIAL_SUSTAIN_MS + EGRESS_TRIAL_SETTLE_SLACK_MS, now)
            ? "ok" : "stale";
    } catch (Exception e) {
        try logWarn("Egress recovery trial renew for %s failed: %s", exit.label, e.msg);
        catch (Exception) {}
        return "error";
    }
}

/// Settles a trial: "ok" | "stale" | "early" | "error" (store unreachable:
/// the lock expiry later settles it as a failure — fail closed).
private string settleTrial(EgressEndpointRef exit, string token, EgressTrialOutcome outcome,
                           string reason) nothrow {
    if (token.length == 0) return "stale";
    auto store = gAdmissionStore;
    if (store is null) return "error";
    try {
        const r = store.settleTrial(exit, token, outcome, reason, nowMsSafe());
        logJsonMap("info", "connection", "Egress recovery trial settled",
            ["event": "egress_trial_settled", "label": exit.label, "outcome": outcome.to!string,
             "result": r]);
        return r;
    } catch (Exception e) {
        try logWarn("Egress recovery trial settle (%s) for %s failed: %s", outcome.to!string, exit.label, e.msg);
        catch (Exception) {}
        return "error";
    }
}

/// Mullvad relay catalog as the slots' own tailscaled reports it, plus the
/// unix-ms it was last rebuilt. Guarded by gMullvadLock.
private __gshared ExitRelay[] gExitRelays;
private __gshared long gExitRelaysAtMs;
/// Per-host egress ban: hostLower -> locationId -> expiryMs. When a server
/// G/K/Z-lines an egress IP, we remember that *location* is banned for that
/// host for HOST_EGRESS_BAN_MS so future connects to the same host skip it
/// without hardcoding any hostname in the binary. Keyed by location, not by
/// slot label, because a slot's address changes when it is retargeted.
private enum HOST_EGRESS_BAN_MS = 12 * 60 * 60 * 1000L; // 12 h
// Shorter host-ban used when a ban is inferred from repeated TLS closes
// rather than read from an ERROR line (see the reconnect loop).
private enum TLS_CLOSED_ROTATE_BAN_MS = 15 * 60 * 1000L; // 15 min
private enum EGRESS_LOSS_MAX_AGE_MS = 120_000L;
private enum EGRESS_LOSS_WINDOW_MS = 90_000L;
private enum EGRESS_QUARANTINE_MS = 300_000L;
private enum TLS_CLOSED_ROTATE_AFTER  = 2;
/// Sticky hold after the last connection releases a slot, so a reconnect
/// loop keeps its location instead of losing the slot to another network.
private enum SLOT_HOLD_MS               = 120_000L;
/// Reservation held while a retarget is in flight (two concurrent connects
/// must not fight over the same free slot).
private enum RETARGET_RESERVE_MS        = 60_000L;
/// How long to wait for ExitNodeStatus.Online after `tailscale set`.
private enum RETARGET_READY_TIMEOUT_MS  = 20_000L;
private enum RETARGET_POLL_MS           = 500L;
private enum TS_CMD_TIMEOUT_SECS        = 10;
/// Catalog refresh interval — the relay list changes rarely.
private enum EGRESS_CATALOG_TTL_MS      = 15 * 60 * 1000L;
private __gshared long[string][string] hostEgressBanUntil;
/// Per-host SASL gate: hostLower -> egress key -> expiryMs. Routes a server
/// refused *unless the connection logs in with SASL* (`isSaslRequiredRefusal`,
/// e.g. Libera's "SASL … is required to connect from your current network"
/// on every Mullvad exit). Kept apart from hostEgressBanUntil because the
/// refusal does not apply to networks that authenticate: only networks
/// without SASL order these routes last and stop failing over to them.
/// Same keys and lifetime (HOST_EGRESS_BAN_MS) as the ban table.
private __gshared long[string][string] hostSaslGateUntil;
/// host(lower) -> banKey -> true, for pairs the daily gateway sweep found
/// banned (ircfiber.web.admin.egress_reachability). Replaced wholesale
/// every ~10 min by startDailyReachabilityRefresh() below — unlike
/// hostEgressBanUntil, entries have no individual expiry; "is this still
/// banned" is answered by the next refresh overwriting the whole table,
/// not a per-entry TTL. Guarded by the same gMullvadLock as every other
/// table in this file.
private __gshared bool[string][string] dailyReachabilityBanned;
/// Per-endpoint working-route memory (see ircfiber.irc.route_memory): which
/// concrete egress last completed or failed a full holder dial to one
/// host/port/TLS mode. Ranks Automatic candidates only. Guarded by
/// gMullvadLock, like every other table here.
private __gshared RouteMemory gRouteMemory;

// Event-loop admission is independent of the durable per-network dial ledger.
private RegistrationAdmission registrationAdmission;
private bool registrationRecoveryObserverRunning;


private void observeUnprovenRegistrations(HolderClient holder) {
    if (registrationRecoveryObserverRunning) return;
    registrationRecoveryObserverRunning = true;
    // Own the bounded admission ledger, not any stopped client generation.
    auto admission = registrationAdmission;
    runTask(() nothrow {
        scope(exit) registrationRecoveryObserverRunning = false;
        while (admission !is null && admission.unprovenCount > 0) {
            try {
                admission.observeIncarnation(holderDialIncarnation(holder));
                foreach (slot; 0 .. RegistrationAdmission.MAX_IN_FLIGHT) {
                    const claim = admission.terminalClaimAt(slot);
                    if (!claim.token) continue;
                    bool ended;
                    try {
                        auto entry = holder.info(claim.id);
                        scope(exit) entry.meta = Json.undefined;
                        ended = entry.state == "closed" || entry.instance != claim.incarnation
                            || entry.connectedAtMs != claim.connectedAtMs;
                    } catch (HolderErrorException e) {
                        if (e.code != "closed" && e.code != "not_found") throw e;
                        ended = true;
                    }
                    if (ended) admission.resolveTerminalClaim(slot, claim.token, claim.epoch);
                }
            } catch (Throwable) {}
            if (admission.unprovenCount > 0)
                try sleep(1.seconds); catch (Throwable) {}
        }
    });
}
private __gshared long[string] maintenanceSlotUntilMs;
private __gshared uint[string] maintenanceSlotOwners;

/// Manager-owned holds survive replacement of a client generation.
bool reserveMaintenanceSlot(string label, string identity, long deadlineMs) nothrow {
    loadMullvadPoolSafe();
    bool matches;
    withPoolLock({
        size_t found;
        foreach (ref proxy; mullvadPool) if (proxy.label == label) found++;
        if (found != 1 || deadlineMs <= nowMsSafe()) return;
        foreach (ref proxy; mullvadPool) if (proxy.label == label) {
            if (proxy.state != "ready" || routeIdentityLocked(&proxy, "") != identity) return;
            proxy.activeConns++;
            maintenanceSlotOwners[label] = maintenanceSlotOwners.get(label, 0) + 1;
            const previous = maintenanceSlotUntilMs.get(label, 0);
            maintenanceSlotUntilMs[label] = deadlineMs > previous ? deadlineMs : previous;
            matches = true;
            break;
        }
    });
    return matches;
}

void releaseMaintenanceSlot(string label) nothrow {
    withPoolLock({
        auto count = label in maintenanceSlotOwners;
        if (count is null) return;
        foreach (ref proxy; mullvadPool) if (proxy.label == label) {
            if (proxy.activeConns > 0) proxy.activeConns--;
            proxy.heldUntilMs = nowMsSafe() + SLOT_HOLD_MS;
            break;
        }
        if (*count > 1) --*count;
        else {
            maintenanceSlotOwners.remove(label);
            maintenanceSlotUntilMs.remove(label);
        }
    });
}
shared static this() {
    // Enterprise: single global mutex protects all __gshared Mullvad state.
    // vibe.d fibers are cooperative but connection loops run on different
    // task fibers concurrently (Happy Eyeballs races, TLS handshake task,
    // main loop). Unprotected __gshared access caused SyncError@(0) on
    // 2026-08-17 cnTb-fin — this mutex eliminates that class of crash.
    try { gMullvadLock = new Object(); } catch (Throwable) {}
    try { if (gIpv6Lock is null) gIpv6Lock = new Object(); } catch (Throwable) {}
}

// ── Saved-connection IPv6 reservations ───────────────────────────────────────
// A provider-owned, aligned global-unicast /64 and the persisted connection IID
// determine a reservation. It is not a source address until an IPv6-only native
// holder dial uses it; shared-direct Happy Eyeballs must not bind this pool.
private __gshared string gIpv6Prefix;
private __gshared bool gIpv6Loaded;
private __gshared Object gIpv6Lock;

private void loadIpv6Config() {
    if (gIpv6Lock !is null) synchronized (gIpv6Lock) {
        if (gIpv6Loaded) return;
        gIpv6Loaded = true;
        loadIpv6ConfigUnlocked();
        return;
    }
    if (gIpv6Loaded) return;
    gIpv6Loaded = true;
    loadIpv6ConfigUnlocked();
}
private void loadIpv6ConfigUnlocked() {
    import core.stdc.stdlib : getenv;
    import core.stdc.string : strlen;
    import std.string : toStringz;
    auto ep = getenv(toStringz("IRCFIBER_IPV6_PREFIX"));
    if (ep !is null) {
        auto raw = ep[0 .. strlen(ep)].idup;
        ubyte[16] prefix;
        if (parseRoutedIpv6Prefix(raw, prefix)) {
            gIpv6Prefix = raw;
            logInfo("IPv6 connection pool: prefix=%s (from IRCFIBER_IPV6_PREFIX)", gIpv6Prefix);
        } else if (raw.length > 0) {
            logWarn("IPv6 connection pool disabled: IRCFIBER_IPV6_PREFIX must be an aligned global-unicast /64");
        }
    }
    if (gIpv6Prefix.length == 0)
        logInfo("IPv6 connection pool: disabled");
}

/// Native transport is advertised and planned only after the node's physical
/// routing gate has passed and this holder explicitly supports family-only DIAL.
string nativeIpv6Prefix(HolderClient holder) {
    import std.process : environment;
    if (environment.get("IRCFIBER_IPV6_ROUTING_VERIFIED", "") != "1" || holder is null) return "";
    loadIpv6Config();
    string prefix;
    if (gIpv6Lock !is null) synchronized (gIpv6Lock) { prefix = gIpv6Prefix; }
    else prefix = gIpv6Prefix;
    ubyte[16] binary;
    if (!parseRoutedIpv6Prefix(prefix, binary)) return "";
    try { return holder.status().supportsFamily("ipv6") ? prefix : ""; }
    catch (Exception) { return ""; }
}

/// Pool metadata, not labels/controllability, defines provider capability.
string[] supportedRoutingRoutes(HolderClient holder, out string ipv6Prefix) {
    ipv6Prefix = nativeIpv6Prefix(holder);
    string[] routes;
    if (ipv6Prefix.length) routes ~= "ipv6";
    loadMullvadPool();
    withPoolLock({
        foreach (ref p; mullvadPool) {
            const token = routeToken(p.provider);
            if (!routes.canFind(token)) routes ~= token;
        }
    });
    routes ~= "direct";
    return routes;
}

private string restoredHeldRoute(const ref HolderEntry entry, const ref SessionSnapshot meta) {
    const label = entry.tag.egressLabel;
    if (label.length == 0) {
        // Never reinterpret an old shared IPv6 socket as a native reservation.
        return meta.activeRoute == "ipv6" && entry.localIp.length
                && entry.localIp == meta.localIp && entry.localIp.canFind(":")
            ? "ipv6" : "direct";
    }
    string provider;
    loadMullvadPool();
    withPoolLock({
        foreach (ref p; mullvadPool) if (p.label == label) {
            provider = routeToken(p.provider);
            break;
        }
    });
    if (provider.length) return provider;
    // New META can preserve a removed pool entry's explicit provider.
    return meta.egressLabel == label && (meta.activeRoute == "mullvad" || meta.activeRoute == "nordvpn")
        ? meta.activeRoute : "";
}

private string mullvadLabelFromHost(string h) {
    auto base = h.split(":")[0];
    auto dash = base.lastIndexOf("-");
    if (dash >= 0 && dash+1 < base.length) return base[dash+1 .. $].toLower();
    auto dot = base.indexOf(".");
    if (dot > 0) return base[0 .. dot].toLower();
    return base.toLower();
}

private void loadMullvadPool() {
    if (gMullvadLock !is null) synchronized (gMullvadLock) {
        if (mullvadPoolLoaded) return;
        mullvadPoolLoaded = true;
        loadMullvadPoolUnlocked();
        return;
    }
    // Fallback if mutex not yet initialized (shared static this ordering)
    if (mullvadPoolLoaded) return;
    mullvadPoolLoaded = true;
    loadMullvadPoolUnlocked();
}

/// Reads an env var via getenv. `std.process.environment` returned an empty
/// string in the deployed binary despite the variable being present in
/// /proc/self/environ, so every egress env read goes through getenv.
private string envRaw(string name) nothrow {
    import core.stdc.stdlib : getenv;
    import core.stdc.string : strlen;
    try {
        auto p = getenv(toStringz(name));
        if (p is null) return "";
        return p[0 .. strlen(p)].idup.strip();
    } catch (Exception) {
        return "";
    }
}

/// `<IRCFIBER_EGRESS_CONTROL_DIR>/<label>/tailscaled.sock` when that socket
/// exists, else "" — a slot whose sidecar does not share its control socket
/// with the engine is static and never retargeted.
private string slotControlSocketPath(string label) nothrow {
    import std.file : exists;
    try {
        auto dir = envRaw("IRCFIBER_EGRESS_CONTROL_DIR");
        if (dir.length == 0) dir = "/egress";
        auto path = dir ~ "/" ~ label ~ "/tailscaled.sock";
        return exists(path) ? path : "";
    } catch (Exception) {
        return "";
    }
}

/// tailscale CLI used to drive a slot's tailscaled (overridden by the local
/// verification shim via IRCFIBER_EGRESS_TAILSCALE_BIN).
private string tailscaleBin() nothrow {
    auto b = envRaw("IRCFIBER_EGRESS_TAILSCALE_BIN");
    return b.length ? b : "/usr/local/bin/tailscale";
}

// Reads IRCFIBER_MULLVAD_POOL directly via getenv, for the reason envRaw
// documents. Caller holds gMullvadLock and has set mullvadPoolLoaded = true.
private void loadMullvadPoolUnlocked() {
    import core.stdc.stdlib : getenv;
    import core.stdc.string : strlen;
    // Providers are independent: a static-only deployment must still
    // load its NordVPN exits when no Mullvad sidecars are configured.
    scope(exit) loadNordvpnPoolUnlocked();
    auto envp = getenv(toStringz("IRCFIBER_MULLVAD_POOL"));
    if (envp is null) {
        logWarn("Mullvad pool: IRCFIBER_MULLVAD_POOL not set (getenv null)");
        return;
    }
    auto raw = envp[0 .. strlen(envp)].idup;
    if (raw.length == 0) {
        logWarn("Mullvad pool: IRCFIBER_MULLVAD_POOL is empty");
        return;
    }
    foreach (entry; raw.split(",")) {
        auto e = entry.strip();
        if (e.length == 0) continue;
        auto p = e.indexOf("://");
        if (p >= 0) e = e[p+3 .. $];
        // Optional explicit label `de@100.94.116.56:1080` — required when
        // several sidecars share one bare IP on different ports, where
        // mullvadLabelFromHost() would collapse them all to one label and
        // pins/host-bans could no longer tell the exits apart. Must match
        // the gateway's parser (site/backend/source/ircfiber/egress.d).
        string explicitLabel;
        auto at = e.indexOf("@");
        if (at >= 0) { explicitLabel = e[0 .. at].strip().toLower(); e = e[at+1 .. $]; }
        auto colon = e.lastIndexOf(":");
        string host; ushort port = 1080;
        if (colon >= 0) {
            host = e[0 .. colon].strip();
            try { port = e[colon+1 .. $].strip().to!ushort; } catch (Exception) {}
        } else host = e;
        if (host.length == 0) continue;
        auto label = explicitLabel.length > 0 ? explicitLabel : mullvadLabelFromHost(host);
        auto sock = slotControlSocketPath(label);
        auto proxy = MullvadProxy(host, port, label, 0, 0, sock);
        proxy.provider = RouteKind.mullvad;
        mullvadPool ~= proxy;
        logInfo("Mullvad pool: %s → %s:%d (label=%s)", entry, host, port, label);
        logInfo("Mullvad slot %s: controllable=%s (socket=%s)", label,
            sock.length ? "true" : "false", sock.length ? sock : "-");
    }
    logInfo("Mullvad pool loaded: %d slots", cast(int) mullvadPool.length);
}

// Reads IRCFIBER_NORDVPN_POOL directly via getenv. Grammar:
// socks5://<label>:<username>:<password>@<host>:<port>[#<countryCode>,<country>,<city>]
// (per-entry credentials) or socks5://<label>@<host>:<port>[#...] (credential-less
// — filled from the shared IRCFIBER_NORDVPN_USERNAME/_PASSWORD env pair, or the
// admin-settable Redis override via gEgressRedis when either half of the
// env pair is empty). label is mandatory (no safe way to derive one from a
// shared public NordVPN hostname the way mullvadLabelFromHost() does for
// Mullvad). The optional `#...` suffix is this static entry's fixed exit
// location — unlike a Mullvad slot, a static entry is never retargeted
// and has no live status to query, so without this its EgressSlotView
// carries an empty city/country forever and NetworkForm/admin pages fall
// back to printing the raw label instead of "Stockholm, Sweden" the way
// Mullvad slots display. Must match the gateway's parser
// (site/backend/source/ircfiber/egress.d::parseNordvpnPool).
// Caller holds gMullvadLock (called only from loadMullvadPoolUnlocked).
private void loadNordvpnPoolUnlocked() {
    import core.stdc.stdlib : getenv;
    import core.stdc.string : strlen;
    auto envp = getenv(toStringz("IRCFIBER_NORDVPN_POOL"));
    if (envp is null) return;
    auto raw = envp[0 .. strlen(envp)].idup;
    if (raw.length == 0) return;
    string sharedUser = envRaw("IRCFIBER_NORDVPN_USERNAME");
    string sharedPass = envRaw("IRCFIBER_NORDVPN_PASSWORD");
    if ((sharedUser.length == 0 || sharedPass.length == 0) && gEgressRedis !is null) {
        try {
            auto rawCreds = gEgressRedis.getDb().get(RedisKeys.nordvpnCreds());
            if (rawCreds.length > 0) {
                import vibe.data.json : parseJsonString;
                auto j = parseJsonString(rawCreds);
                if (sharedUser.length == 0) sharedUser = j["username"].opt!string("");
                if (sharedPass.length == 0) sharedPass = j["password"].opt!string("");
            }
        } catch (Exception e) { logWarn("NordVPN pool: shared credential read failed: %s", e.msg); }
    }
    foreach (idx, entry; raw.split(",")) {
        auto e = entry.strip();
        if (e.length == 0) continue;
        auto p = e.indexOf("://");
        if (p >= 0) e = e[p+3 .. $];
        // Location suffix, if present — strip before host:port parsing so
        // it never gets mistaken for part of the port. Pipe-separated,
        // NOT comma: raw.split(",") above already split the whole pool
        // string by comma to get one `entry` per proxy, so a comma here
        // would silently fracture this one entry into several bogus ones.
        string countryCode, country, city;
        auto hash = e.indexOf("#");
        if (hash >= 0) {
            auto meta = e[hash+1 .. $].split("|");
            if (meta.length >= 1) countryCode = meta[0].strip();
            if (meta.length >= 2) country = meta[1].strip();
            if (meta.length >= 3) city = meta[2].strip();
            e = e[0 .. hash];
        }
        auto at = e.indexOf("@");
        if (at < 0) { logWarn("NordVPN pool: entry %d missing label@ — skipped", idx); continue; }
        auto userinfo = e[0 .. at].split(":");
        e = e[at+1 .. $];
        string label, username, password;
        if (userinfo.length == 1) {
            label = userinfo[0].strip().toLower();
            username = sharedUser;
            password = sharedPass;
        } else if (userinfo.length == 3) {
            label = userinfo[0].strip().toLower();
            username = userinfo[1].strip();
            password = userinfo[2].strip();
            if (username.length == 0 || password.length == 0) {
                logWarn("NordVPN pool: entry needs label:username:password — skipped (host=%s)", e); continue;
            }
        } else {
            logWarn("NordVPN pool: entry %d malformed userinfo — skipped", idx); continue;
        }
        if (label.length == 0) { logWarn("NordVPN pool: empty label — skipped"); continue; }
        auto colon = e.lastIndexOf(":");
        string host; ushort port = 1080;
        if (colon >= 0) { host = e[0 .. colon].strip(); try { port = e[colon+1 .. $].strip().to!ushort; } catch (Exception) {} }
        else host = e;
        if (host.length == 0) { logWarn("NordVPN pool: empty host for label=%s — skipped", label); continue; }
        MullvadProxy np;
        np.host = host; np.port = port; np.label = label; np.state = "ready";
        np.provider = RouteKind.nordvpn;
        np.username = username; np.password = password;
        np.exitCountryCode = countryCode; np.exitCountry = country; np.exitCity = city;
        mullvadPool ~= np;
        logInfo("NordVPN pool: %s:%d (label=%s, %s) — credentials redacted from logs", host, port, label,
            city.length > 0 ? city ~ ", " ~ country : "no location configured");
    }
}

private MullvadProxy*[] getHealthyProxies() {
    loadMullvadPool();
    if (gMullvadLock !is null) synchronized (gMullvadLock) {
        return getHealthyProxiesLocked();
    }
    return getHealthyProxiesLocked();
}
private MullvadProxy*[] getHealthyProxiesLocked() {
    if (mullvadPool.length == 0) return [];
    const now = Clock.currTime.toUnixTime!long * 1000;
    foreach (ref pr; mullvadPool) if (pr.deadUntilMs != 0 && now >= pr.deadUntilMs) { pr.failCount = 0; pr.deadUntilMs = 0; }
    MullvadProxy*[] healthy;
    foreach (ref pr; mullvadPool) if (pr.deadUntilMs == 0 || now >= pr.deadUntilMs) healthy ~= &pr;
    return healthy;
}

/// Provider display comes only from configured pool metadata. A removed or
/// unknown slot remains unknown; retargetability does not identify a provider.
private string egressProviderName(string label) {
    string name = "VPN";
    withPoolLock({
        foreach (ref pr; mullvadPool) if (pr.label == label) {
            if (pr.provider == RouteKind.mullvad) name = "Mullvad";
            else if (pr.provider == RouteKind.nordvpn) name = "NordVPN";
            break;
        }
    });
    return name;
}

@("egress provider identity is independent of labels and retargetability")
unittest {
    auto saved = mullvadPool.dup;
    scope(exit) mullvadPool = saved;
    MullvadProxy mull, nord;
    mull.label = "nordvpn-looking-label";
    mull.provider = RouteKind.mullvad;
    nord.label = "mullvad-looking-label";
    nord.provider = RouteKind.nordvpn;
    nord.controlSocket = "/ctl/available.sock";
    mullvadPool = [mull, nord];
    assert(egressProviderName(mull.label) == "Mullvad");
    assert(egressProviderName(nord.label) == "NordVPN");
    assert(egressProviderName("removed") == "VPN");
    assert(egressProviderName("") == "VPN");
}

private void recordMullvadSuccess(string label) {
    const now = Clock.currTime.toUnixTime!long * 1000;
    if (gMullvadLock !is null) synchronized (gMullvadLock) {
        foreach (ref pr; mullvadPool) if (pr.label == label) { pr.failCount = 0; pr.deadUntilMs = 0; pr.lastSuccessMs = now; break; }
        return;
    }
    foreach (ref pr; mullvadPool) if (pr.label == label) { pr.failCount = 0; pr.deadUntilMs = 0; pr.lastSuccessMs = now; break; }
}

/// Only a static exit can be quarantined; never attribute an unknown label.
private bool isStaticProxy(string label) {
    if (label.length == 0) return false;
    if (gMullvadLock !is null) synchronized (gMullvadLock) {
        foreach (ref p; mullvadPool) if (p.label == label) return p.controlSocket.length == 0;
        return false;
    }
    foreach (ref p; mullvadPool) if (p.label == label) return p.controlSocket.length == 0;
    return false;
}

/// A stable registered socket ended at the holder, not by an IRC ERROR or
/// engine shutdown. A missing holder reason is evidence only for a PONG timeout.
private bool isEstablishedEgressLoss(bool registered, long uptimeMs, bool stopping,
                                     bool serverError, string closeReason, string errorText) {
    if (!registered || uptimeMs < STABLE_SESSION_RESET_MS || stopping || serverError)
        return false;
    return closeReason == "peer_closed" || closeReason.startsWith("read_error:")
        || closeReason.startsWith("tls_read_error:") || closeReason.startsWith("write_error:")
        || (closeReason.length == 0 && errorText.canFind("PONG timeout"));
}

/// Publish only on a quarantine transition, outside the pool lock. FiberEye
/// drains this existing outbox into #staff; a Redis failure must not stop IRC.
private void announceEgressQuarantine(string label, size_t distinct, long cooldownMs, long nowMs) {
    if (gEgressRedis is null) return;
    try {
        auto db = gEgressRedis.getDb();
        const minutes = cooldownMs <= 0 ? 0 : (cooldownMs + 59_999) / 60_000;
        auto event = Json([
            "type": Json("notice"), "ts": Json(nowMs), "actor": Json("engine"),
            "text": Json("VPN exit " ~ label ~ " quarantined: excluded from new connections after established"
                ~ " sessions on " ~ distinct.to!string ~ " distinct IRC hosts lost their sockets within 90 seconds"
                ~ " (a correlation signal, not proof of an exit fault). " ~ minutes.to!string
                ~ "-minute minimum cooldown, then one verified recovery session must stay registered for"
                ~ " 60 seconds before it takes new connections again. Existing sessions are left running."),
        ]);
        db.rpush("irc:logs:outbox", event.toString());
        db.ltrim("irc:logs:outbox", -1000, -1);
    } catch (Exception e) {
        logWarn("VPN exit quarantine #staff announcement failed: %s", e.msg);
    }
}

/// Only the winning verified trial announces recovery. Announcement failure
/// must not retain the completed trial or disturb its surviving socket.
private void announceEgressRecovery(string label, long nowMs) nothrow {
    if (gEgressRedis is null) return;
    try {
        auto db = gEgressRedis.getDb();
        auto event = Json([
            "type": Json("notice"), "ts": Json(nowMs), "actor": Json("engine"),
            "kind": Json("egress_recovery"),
            "text": Json("VPN exit " ~ label ~ " recovered: registered for at least "
                ~ (EGRESS_TRIAL_SUSTAIN_MS / 1000).to!string
                ~ " seconds and answered a post-window keepalive; admission reopened."
                ~ " Existing sessions were left running."),
        ]);
        db.rpush("irc:logs:outbox", event.toString());
        db.ltrim("irc:logs:outbox", -1000, -1);
    } catch (Exception e) {
        try logWarn("VPN exit recovery #staff announcement failed: %s", e.msg);
        catch (Exception) {}
    }
}

/// Correlates established-session losses per static exit (process-local
/// detection evidence) and, at two distinct IRC hosts inside the window,
/// opens the exit's durable circuit. The quarantine is queued in-process
/// first, so until the store accepts it the exit is `unavailable` here —
/// a refused or failed write never leaves it admitting dials. The store
/// keeps an already open circuit and its cooldown unchanged, so only a real
/// transition is logged and announced. Never closes the exit's live sockets.
private void recordEstablishedEgressLoss(string label, string hostLower, long closedAtMs, long nowMs) {
    if (label.length == 0 || hostLower.length == 0 || closedAtMs <= 0
        || closedAtMs > nowMs || nowMs - closedAtMs > EGRESS_LOSS_MAX_AGE_MS) return;
    size_t distinctHosts;
    EgressEndpointRef exit;
    void update() {
        foreach (ref p; mullvadPool) if (p.label == label && p.controlSocket.length == 0) {
            string[] expired;
            foreach (host, at; p.recentLossAtMsByHost)
                if (at > nowMs || nowMs - at > EGRESS_LOSS_WINDOW_MS) expired ~= host;
            foreach (host; expired) p.recentLossAtMsByHost.remove(host);
            p.recentLossAtMsByHost[hostLower] = closedAtMs;
            // Compare close times, not arrival times: a delayed INFO response
            // must not correlate unrelated upstream closes.
            size_t distinct;
            foreach (_, at; p.recentLossAtMsByHost)
                if (at <= closedAtMs && closedAtMs - at <= EGRESS_LOSS_WINDOW_MS
                    || at > closedAtMs && at - closedAtMs <= EGRESS_LOSS_WINDOW_MS) distinct++;
            if (distinct >= 2) {
                distinctHosts = distinct;
                exit = exitRef(&p);
            }
            break;
        }
    }
    if (gMullvadLock !is null) synchronized (gMullvadLock) update();
    else update();
    if (distinctHosts < 2) return;
    const reason = "correlated loss: established sessions on " ~ distinctHosts.to!string
        ~ " distinct IRC hosts lost their sockets within 90 seconds";
    withPoolLock({ gPendingQuarantines[label] = PendingQuarantine(exit, reason, distinctHosts); });
    // Redis I/O: strictly after the pool lock is released.
    flushPendingQuarantines();
}

@("Established static losses require independent IRC hosts and a live holder close")
unittest {
    assert(isEstablishedEgressLoss(true, 60_000, false, false, "peer_closed", ""));
    assert(isEstablishedEgressLoss(true, 60_000, false, false, "", "PONG timeout"));
    assert(!isEstablishedEgressLoss(true, 60_000, false, true, "peer_closed", ""));
    assert(!isEstablishedEgressLoss(true, 60_000, true, false, "peer_closed", ""));
    assert(!isEstablishedEgressLoss(false, 60_000, false, false, "peer_closed", ""));
    assert(!isEstablishedEgressLoss(true, 59_999, false, false, "peer_closed", ""));
    assert(!isEstablishedEgressLoss(true, 60_000, false, false, "holder_shutdown", "transport dead"));
    assert(!isEstablishedEgressLoss(true, 60_000, false, false, "", "write failed"));

    auto saved = mullvadPool;
    auto savedStore = gAdmissionStore;
    auto savedPending = gPendingQuarantines;
    scope(exit) { mullvadPool = saved; gAdmissionStore = savedStore; gPendingQuarantines = savedPending; }
    gPendingQuarantines = null;
    auto store = new ScriptedAdmissionStore;
    gAdmissionStore = store;
    MullvadProxy staticExit, mullvad;
    staticExit.label = "north"; staticExit.host = "socks-north.example"; staticExit.port = 1080;
    mullvad.label = "de"; mullvad.controlSocket = "/ctl/de";
