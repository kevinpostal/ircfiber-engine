# syntax=docker/dockerfile:1.7
#
# ===================================
#
# Stage graph (engine):
#   base             : Ubuntu 22.04 + LDC toolchain (apt cache mounted)
#   builder-common   : shared `common` library sources (engine)
#   builder-engine   : engine binaries (`irc-fiber-engine`, `janitor-migrate`, `ircfiber-default-migrate`)
#   runtime-engine   : slim Ubuntu + engine binaries only
#
# Engine-only image: never compiles backend or frontend sources.
#
# Caching: the build context is a git checkout, so BuildKit's content hashing
# of every COPY is the whole invalidation story — no CACHE_BUST sentinels, no
# `dub --force`. The dub cache mounts retain fetched packages and compiled
# third-party dependencies; workspace packages rebuild whenever their BuildKit
# compile layer changes. Build identity lives in an ENV-only layer at the very
# end of runtime-engine.
#
# Build: docker buildx build --target runtime-engine -f Containerfile.engine . -t test-engine
#
# ============================================================================
# Stage: base — Ubuntu + toolchain
# ============================================================================
FROM ubuntu:22.04 AS base

ARG LDC_VERSION=1.41.0
ARG TARGETARCH

# Docker ships an apt-clean hook that empties /var/cache/apt on every RUN,
# defeating cache mounts. Remove it so the cache mount persists.
RUN rm -f /etc/apt/apt.conf.d/docker-clean

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        xz-utils \
        build-essential \
        libssl-dev \
        zlib1g-dev \
        git \
        ca-certificates

# $TARGETARCH is set automatically by buildx (amd64 | arm64 | 386 | arm/v7).
# Previous version used `uname -m` which silently broke on multi-platform
# builds (always returned the kernel arch, not the requested target).
RUN case "$TARGETARCH" in \
        amd64)  LDC_ARCH=x86_64  ;; \
        arm64)  LDC_ARCH=aarch64 ;; \
        *) echo "Unsupported TARGETARCH: $TARGETARCH"; exit 1 ;; \
    esac && \
    mkdir -p /opt && \
    curl -fsSL -o /tmp/ldc.tar.xz \
        "https://github.com/ldc-developers/ldc/releases/download/v${LDC_VERSION}/ldc2-${LDC_VERSION}-linux-${LDC_ARCH}.tar.xz" && \
    tar -xf /tmp/ldc.tar.xz -C /opt && \
    ln -s "/opt/ldc2-${LDC_VERSION}-linux-${LDC_ARCH}" /opt/ldc2 && \
    rm /tmp/ldc.tar.xz

ENV PATH="/opt/ldc2/bin:${PATH}"
WORKDIR /build
# Every RUN below fails on the first failing command; /bin/sh (dash) has no pipefail.
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]


# ============================================================================
# Stage: builder-common — shared common library sources.
#
# Compile common with its consumers below, under the same locked cache mount.
# DUB checks source mtimes, not contents, and its package/version build cache
# survives COPY changes and can contain artifacts from another checkout.
# ============================================================================
FROM base AS builder-common

COPY common/dub.sdl common/dub.selections.json ./common/
COPY common/source/ ./common/source/

# No standalone build here: a cached RUN cannot refresh the mutable DUB cache
# for a later uncached consumer build.

# ============================================================================
# Stage: builder-engine — engine binaries only (irc-fiber-engine + migrates)
# ============================================================================
FROM builder-common AS builder-engine

# dub validates EVERY declared path dependency at package load — including the
# config-scoped `irc-fiber-backend` used only by test configs — so it needs
# backend/dub.sdl present even though release/migrate builds never compile
# backend sources. Only the package files, not the sources.
COPY backend/dub.sdl backend/dub.selections.json ./backend/
COPY engine/dub.sdl engine/dub.selections.json ./engine/
COPY engine/source/ ./engine/source/
COPY engine/holder/ ./engine/holder/
# String-imported Anope message catalogs (services_grammar.d) + attribution.
COPY engine/catalogs/ ./engine/catalogs/

# Invalidate only workspace-package artifacts on an uncached compile layer.
# The irc-fiber cache also contains its holder subpackage and migrate configs.
# Keep all downloaded packages and compiled third-party dependencies cached.
RUN --mount=type=cache,target=/build/.dub,sharing=locked \
    --mount=type=cache,target=/root/.dub,sharing=locked \
    rm -rf /root/.dub/cache/irc-fiber-common /root/.dub/cache/irc-fiber && \
    dub build --root=engine --compiler=ldc2 --build=release --parallel && \
    dub build --root=engine :holder --compiler=ldc2 --build=release --parallel && \
    dub build --root=engine --config=janitor-migrate --compiler=ldc2 --build=release --parallel && \
    dub build --root=engine --config=ircfiber-default-migrate --compiler=ldc2 --build=release --parallel && \
    cp engine/irc-fiber-engine ./irc-fiber-engine && \
    cp engine/irc-fiber-holder ./irc-fiber-holder && \
    cp engine/janitor-migrate ./janitor-migrate && \
    cp engine/ircfiber-default-migrate ./ircfiber-default-migrate && \
    test -f ./irc-fiber-engine && \
    test -f ./irc-fiber-holder && \
    test -f ./janitor-migrate
RUN strip ./irc-fiber-engine ./irc-fiber-holder ./janitor-migrate ./ircfiber-default-migrate


# ============================================================================
# Stage: runtime-engine — slim Ubuntu + engine binary only (no views/public).
# COPYs come from builder-engine only — building this target never compiles
# backend sources.
# ============================================================================
FROM ubuntu:22.04 AS runtime-engine

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libssl3 \
        zlib1g \
        curl \
        procps \
        ca-certificates \
        tini \
        util-linux && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# tailscale CLI: the engine drives each Mullvad slot's tailscaled through the
# slot's own LocalAPI socket (`tailscale --socket=<slot> set --exit-node=…`)
# to retarget an idle exit to the location a user picked.
COPY --from=tailscale/tailscale:stable /usr/local/bin/tailscale /usr/local/bin/tailscale

COPY --from=builder-engine /build/irc-fiber-engine      /app/irc-fiber-engine
COPY --from=builder-engine /build/janitor-migrate       /app/janitor-migrate
# Keep the independently licensed catalog sources and notices with the
# binary that embeds their compiled translations.
COPY --from=builder-engine /build/engine/catalogs/anope/SOURCE.txt /usr/share/ircfiber/anope-catalogs/SOURCE.txt
COPY --from=builder-engine /build/engine/catalogs/anope/2.1/source/ /usr/share/ircfiber/anope-catalogs/2.1/source/
COPY --from=builder-engine /build/engine/catalogs/anope/2.1/LICENSE.txt /usr/share/ircfiber/anope-catalogs/2.1/LICENSE.txt
COPY --from=builder-engine /build/engine/catalogs/anope/2.0.20/source/ /usr/share/ircfiber/anope-catalogs/2.0.20/source/
COPY --from=builder-engine /build/engine/catalogs/anope/2.0.20/COPYING /usr/share/ircfiber/anope-catalogs/2.0.20/COPYING
COPY config/ ./config/

# Data dirs (engine needs no public/views).
RUN mkdir -p /app/data /app/uploads

# Engine entrypoint + healthcheck
COPY deploy/roles/engine/files/ircfiber-engine-entrypoint.sh /usr/local/bin/ircfiber-engine-entrypoint.sh
COPY deploy/roles/engine/files/ircfiber-engine-healthcheck.sh /usr/local/bin/ircfiber-engine-healthcheck.sh
RUN chmod 0755 /usr/local/bin/ircfiber-engine-entrypoint.sh \
              /usr/local/bin/ircfiber-engine-healthcheck.sh

# tini as init — same rationale as runtime
ENTRYPOINT ["/usr/bin/tini", "--"]

# ── Build identity ─────────────────────────────────────────────────────────
# Last, after every COPY: an ENV-only layer is metadata — no pushed bytes and
# nothing above it is invalidated when the commit changes. The engine reads
# these at runtime (ircfiber.build_info) when it registers in Redis.
ARG GIT_HASH=dev
ARG GIT_SHORT=dev
ARG GIT_DESCRIBE=dev
ARG GIT_BRANCH=dev
ARG BUILD_TIME=dev
ARG GIT_MESSAGE=""
ENV IRCFIBER_VERSION=0.3.0 \
    IRCFIBER_BUILD_COMMIT=$GIT_HASH \
    IRCFIBER_BUILD_SHORT=$GIT_SHORT \
    IRCFIBER_BUILD_DESCRIBE=$GIT_DESCRIBE \
    IRCFIBER_BUILD_BRANCH=$GIT_BRANCH \
    IRCFIBER_BUILD_TIME=$BUILD_TIME \
    IRCFIBER_BUILD_HOST=builder \
    IRCFIBER_BUILD_MESSAGE=$GIT_MESSAGE \
    IRCFIBER_BUILD_COMMIT_URL=https://github.com/kevinpostal/ircfiber-engine/commit/$GIT_HASH
LABEL org.opencontainers.image.revision=$GIT_HASH
LABEL com.ircfiber.routing-policy-version="1"

# ============================================================================
# Stage: runtime-holder — slim Ubuntu + the connection holder only.
# Owns every IRC TCP/SOCKS5/TLS socket for one engine; never redeployed by
# an engine ship (recreating it reconnects every IRC network). Needs no
# tailscale (egress policy stays in the engine) and no config/ tree.
# ============================================================================
FROM ubuntu:22.04 AS runtime-holder

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libssl3 \
        ca-certificates \
        tini && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder-engine /build/irc-fiber-holder /app/irc-fiber-holder

# Unix-socket directory shared with the engine (compose/ansible mount a
# named volume here); HEALTHCHECK (`--check`) is set by compose/ansible/k8s.
RUN mkdir -p /run/ircfiber

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/irc-fiber-holder"]

# ── Build identity ─────────────────────────────────────────────────────────
# Same block as runtime-engine: the holder reports IRCFIBER_BUILD_SHORT in
# HELLO/STATUS so `make ship-holder` can gate on the deployed build.
ARG GIT_HASH=dev
ARG GIT_SHORT=dev
ARG GIT_DESCRIBE=dev
ARG GIT_BRANCH=dev
ARG BUILD_TIME=dev
ARG GIT_MESSAGE=""
ENV IRCFIBER_VERSION=0.3.0 \
    IRCFIBER_BUILD_COMMIT=$GIT_HASH \
    IRCFIBER_BUILD_SHORT=$GIT_SHORT \
    IRCFIBER_BUILD_DESCRIBE=$GIT_DESCRIBE \
    IRCFIBER_BUILD_BRANCH=$GIT_BRANCH \
    IRCFIBER_BUILD_TIME=$BUILD_TIME \
    IRCFIBER_BUILD_HOST=builder \
    IRCFIBER_BUILD_MESSAGE=$GIT_MESSAGE \
    IRCFIBER_BUILD_COMMIT_URL=https://github.com/kevinpostal/ircfiber-engine/commit/$GIT_HASH
LABEL org.opencontainers.image.revision=$GIT_HASH
